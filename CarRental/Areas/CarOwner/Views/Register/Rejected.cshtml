@model CarRental.Models.CarOwnerRegistration
@{
    ViewData["Title"] = "Hồ sơ chưa được phê duyệt - Đối tác Chủ xe ReCar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-5" style="background-color: #f8fafc; min-height: 80vh;">
    <div class="container" style="max-width: 760px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">

            <!-- Rejected Icon -->
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle text-danger" style="width: 90px; height: 90px; background-color: #fef2f2; font-size: 2.75rem;">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
            </div>

            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold mb-3 mx-auto">
                <i class="bi bi-exclamation-octagon me-1"></i> Hồ sơ chưa đạt yêu cầu
            </span>

            <h2 class="fw-bold text-dark mb-2" style="letter-spacing: -0.5px;">Hồ sơ đối tác của bạn chưa được duyệt</h2>
            <p class="text-muted mx-auto mb-4" style="max-width: 550px; font-size: 15px;">
                Rất tiếc, hồ sơ đăng ký đối tác chủ xe của bạn chưa được Ban Quản trị ReCar phê duyệt do thông tin chưa đáp ứng quy định.
            </p>

            <!-- Lý do từ chối -->
            <div class="alert alert-danger border-danger-subtle rounded-3 text-start p-4 mb-4">
                <h6 class="fw-bold text-danger mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill"></i> Lý do từ chối từ Ban Quản trị:
                </h6>
                <div class="text-dark small" style="line-height: 1.6;">
                    @(string.IsNullOrEmpty(Model.RejectReason) ? "Thông tin ảnh CCCD hoặc Giấy phép lái xe chưa rõ ràng, hoặc số tài khoản ngân hàng không trùng khớp với tên chủ xe." : Model.RejectReason)
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center justify-content-center gap-3 flex-wrap">
                <a href="/" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 small fw-semibold">
                    <i class="bi bi-house-door me-1"></i> Quay về Trang chủ
                </a>

                <a asp-action="Index" class="btn btn-primary rounded-pill px-5 py-2.5 fw-bold shadow-sm" style="background-color: #0284c7; border: none;">
                    <i class="bi bi-arrow-repeat me-1"></i> Chỉnh sửa & Gửi lại hồ sơ
                </a>
            </div>

        </div>
    </div>
</div>
