@model CarRental.ViewModels.CartVM
@{
    ViewData["Title"] = "Xác nhận & Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<CarRentalOrder> carRentalOrders = ViewBag.Order;
    int depositPct = ViewBag.DepositPct ?? 30;
    int remainPct = 100 - depositPct;
    decimal customerBalance = ViewBag.CustomerBalance != null ? (decimal)ViewBag.CustomerBalance : 0m;
    bool canPayDepositWithWallet = customerBalance >= Model.Deposit;
    bool canPayFullWithWallet = customerBalance >= Model.Total;
}


<!-- Hero / Breadcrumb Header -->
<div class="recar-section bg-light py-4 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="font-size: 14px;">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Cart" class="text-decoration-none text-muted">Giỏ xe</a></li>
                <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">Xác nhận & Thanh toán</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1" style="color: var(--recar-dark);">Hoàn tất thủ tục đặt cọc xe</h2>
                <p class="text-muted mb-0">Thanh toán tiền đặt cọc @depositPct% để giữ chỗ xe nhanh chóng và an toàn</p>
            </div>
            <div>
                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fs-6">
                    <i class="bi bi-shield-check me-1"></i> Giao dịch bảo mật 100%
                </span>
            </div>
        </div>
    </div>
</div>

<div class="recar-section py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Cột trái: Thông tin nhận xe & Phương thức thanh toán -->
            <div class="col-lg-7">
                <!-- 1. Thủ tục giấy tờ cần thiết -->
                <div class="doc-check-box mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="fs-2 text-primary">
                            <i class="bi bi-person-vcard"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-2">Quy định giấy tờ khi nhận xe</h5>
                            <p class="text-muted small mb-2">Để đảm bảo quyền lợi và an toàn pháp lý, Quý khách cần chuẩn bị 1 trong 2 phương án đối chiếu khi nhận bàn giao xe:</p>
                            <div class="row g-2 small">
                                <div class="col-md-6">
                                    <div class="p-2 bg-white rounded border">
                                        <strong class="text-dark"><i class="bi bi-check-circle-fill text-success me-1"></i> Phương án 1 (Khuyên dùng):</strong>
                                        <div class="text-muted mt-1">GPLX bản gốc (đối chiếu) + CCCD gắn chip (xác thực qua ứng dụng VNeID).</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-2 bg-white rounded border">
                                        <strong class="text-dark"><i class="bi bi-check-circle-fill text-success me-1"></i> Phương án 2 (Du khách):</strong>
                                        <div class="text-muted mt-1">GPLX bản gốc (đối chiếu) + Hộ chiếu/Passport bản gốc (gửi lưu giữ khi nhận xe).</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <form id="checkoutForm">
                    <!-- 2. Ghi chú & Địa điểm giao xe -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <h5 class="fw-bold mb-3 d-flex align-items-center">
                            <span class="checkout-step-badge">1</span>
                            Yêu cầu bàn giao & Lời nhắn
                        </h5>
                        <div class="mb-3">
                            <label for="notes" class="form-label text-secondary fw-semibold small">Ghi chú cho chủ xe (Địa điểm giao xe, mốc giờ cụ thể, ghế trẻ em...)</label>
                            <textarea id="notes" class="form-control rounded-3" rows="4" placeholder="Ví dụ: Giao xe tại Sảnh đến T1 Sân bay Nội Bài lúc 9h30 sáng..."></textarea>
                        </div>
                        <div class="form-text text-muted small">
                            <i class="bi bi-info-circle me-1"></i> Hệ thống sẽ tự động đối chiếu Địa chỉ nhà và Giấy phép lái xe đã lưu trong Hồ sơ của bạn.
                        </div>
                    </div>

                    <!-- 2. Gói thanh toán -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <h5 class="fw-bold mb-3 d-flex align-items-center">
                            <span class="checkout-step-badge">2</span>
                            Chọn gói thanh toán đơn thuê xe
                        </h5>

                        <!-- Option 1: Đặt cọc qua ZaloPay -->
                        <label class="payment-option-card selected mb-3" for="pay-zalopay-deposit">
                            <div class="d-flex align-items-center gap-3">
                                <input type="radio" id="pay-zalopay-deposit" name="payment_choice" value="zalopay_deposit" checked>
                                <div>
                                    <div class="fw-bold text-dark d-flex align-items-center gap-2 flex-wrap">
                                        Đặt cọc @depositPct% qua ZaloPay
                                        <span class="badge bg-primary text-white small" style="font-size: 11px;">Khuyên dùng</span>
                                    </div>
                                    <div class="text-muted small">
                                        Thanh toán <strong class="text-primary">@Model.Deposit.ToString("N0") đ</strong> (@depositPct%) qua cổng ZaloPay (QR / ATM / Thẻ quốc tế) · Còn lại thanh toán khi nhận xe
                                    </div>
                                </div>
                            </div>
                            <span class="badge px-3 py-2 rounded-pill fw-semibold text-nowrap" style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
                                ZaloPay
                            </span>
                        </label>

                        <!-- Option 2c: Trọn gói 100% qua ZaloPay -->
                        <label class="payment-option-card mb-3" for="pay-zalopay-full">
                            <div class="d-flex align-items-center gap-3">
                                <input type="radio" id="pay-zalopay-full" name="payment_choice" value="zalopay_full">
                                <div>
                                    <div class="fw-bold text-dark d-flex align-items-center gap-2 flex-wrap">
                                        Thanh toán toàn bộ 100% qua ZaloPay
                                        <span class="badge bg-success text-white small" style="font-size: 11px;">Trọn gói</span>
                                    </div>
                                    <div class="text-muted small">
                                        Thanh toán trọn gói <strong class="text-success">@Model.Total.ToString("N0") đ</strong> (100%) qua ZaloPay · Không cần trả thêm khi nhận xe
                                    </div>
                                </div>
                            </div>
                            <span class="badge px-3 py-2 rounded-pill fw-semibold text-nowrap" style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
                                ZaloPay 100%
                            </span>
                        </label>

                        <!-- Option 3: Đặt cọc bằng Số dư Ví ReCar -->
                        <label class="payment-option-card mb-3 @(!canPayDepositWithWallet ? "opacity-50" : "")" for="pay-wallet-deposit" style="@(!canPayDepositWithWallet ? "cursor: not-allowed;" : "")">
                            <div class="d-flex align-items-center gap-3">
                                <input type="radio" id="pay-wallet-deposit" name="payment_choice" value="wallet_deposit" @(!canPayDepositWithWallet ? "disabled" : "")>
                                <div>
                                    <div class="fw-bold text-dark d-flex align-items-center gap-2 flex-wrap">
                                        Đặt cọc @depositPct% bằng Số dư Ví ReCar
                                        <span class="badge small rounded-pill px-2 py-1" style="font-size: 11.5px; background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">Số dư: @customerBalance.ToString("N0") đ</span>
                                    </div>
                                    <div class="text-muted small">
                                        @if (canPayDepositWithWallet)
                                        {
                                            <span>Trừ trực tiếp <strong>@Model.Deposit.ToString("N0") đ</strong> từ Ví ReCar · Xác nhận đơn ngay lập tức</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Số dư chưa đủ để đặt cọc (@Model.Deposit.ToString("N0") đ)</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <span class="badge px-3 py-2 rounded-pill fw-semibold text-nowrap" style="background-color: #eef2ff; color: #3730a3; border: 1px solid #c7d2fe;">
                                Ví ReCar
                            </span>
                        </label>

                        <!-- Option 4: Trọn gói 100% bằng Số dư Ví ReCar -->
                        <label class="payment-option-card @(!canPayFullWithWallet ? "opacity-50" : "")" for="pay-wallet-full" style="@(!canPayFullWithWallet ? "cursor: not-allowed;" : "")">
                            <div class="d-flex align-items-center gap-3">
                                <input type="radio" id="pay-wallet-full" name="payment_choice" value="wallet_full" @(!canPayFullWithWallet ? "disabled" : "")>
                                <div>
                                    <div class="fw-bold text-dark d-flex align-items-center gap-2 flex-wrap">
                                        Thanh toán trọn gói 100% bằng Số dư Ví ReCar
                                        <span class="badge small rounded-pill px-2 py-1" style="font-size: 11.5px; background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">Số dư: @customerBalance.ToString("N0") đ</span>
                                    </div>
                                    <div class="text-muted small">
                                        @if (canPayFullWithWallet)
                                        {
                                            <span>Trừ trực tiếp <strong>@Model.Total.ToString("N0") đ</strong> từ Ví ReCar · Không cần trả thêm khi nhận xe</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Số dư chưa đủ để thanh toán trọn gói (@Model.Total.ToString("N0") đ)</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <span class="badge px-3 py-2 rounded-pill fw-semibold text-nowrap" style="background-color: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;">
                                Ví 100%
                            </span>
                        </label>

                        <div class="mt-3 pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2 text-muted small">
                            <span class="d-flex align-items-center gap-2">
                                <i class="bi bi-shield-check text-success fs-5"></i>
                                Giao dịch được bảo lãnh an toàn qua Cổng thanh toán ZaloPay &amp; Ví ReCar
                            </span>
                        </div>
                    </div>

                    <!-- Nút xác nhận thanh toán -->
                    <button type="submit" id="btnSubmitCheckout" class="btn btn-primary btn-lg w-100 rounded-3 py-3 fw-bold shadow">
                        <i class="bi bi-lock-fill me-2"></i> Xác nhận & Thanh toán cọc @depositPct% (@Model.Deposit.ToString("N0") đ)
                    </button>
                    <p class="text-center text-muted small mt-2 mb-0">
                        Bằng việc bấm xác nhận, bạn đồng ý với <a href="/Home/Privacy" target="_blank" class="text-decoration-none">Điều khoản dịch vụ & Chính sách thuê xe</a> của ReCar.
                    </p>
                </form>
            </div>

            <!-- Cột phải: Bảng tính tiền & Tóm tắt đơn thuê -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-3 border-bottom pb-3">Chi tiết thanh toán</h5>

                    <div class="mb-4">
                        <div class="price-breakdown-row">
                            <span class="text-muted">Tổng giá trị đơn thuê xe</span>
                            <span class="fw-bold fs-5 text-dark">@Model.Total.ToString("N0") đ</span>
                        </div>
                        <div class="price-breakdown-row bg-light p-3 rounded-3 my-2 border-0">
                            <div>
                                <span class="fw-bold text-primary d-block" id="labelNowPay">Tiền thanh toán ngay (@depositPct%)</span>
                                <span class="small text-muted" id="sublabelNowPay">Thanh toán cọc trực tuyến qua ZaloPay</span>
                            </div>
                            <span class="fw-bold fs-4 text-primary" id="amountNowPay">@Model.Deposit.ToString("N0") đ</span>
                        </div>
                        <div class="price-breakdown-row">
                            <div>
                                <span class="fw-semibold text-dark d-block" id="labelRemainPay">Còn lại khi nhận xe (@remainPct%)</span>
                                <span class="small text-muted" id="sublabelRemainPay">Thanh toán khi ký hợp đồng & nhận xe</span>
                            </div>
                            <span class="fw-bold fs-5 text-secondary" id="amountRemainPay">@Model.Payment.ToString("N0") đ</span>
                        </div>
                    </div>

                    <!-- Cam kết dịch vụ -->
                    <div class="bg-light p-3 rounded-3 border">
                        <div class="fw-bold text-dark small mb-2"><i class="bi bi-shield-check text-success me-1"></i> Cam kết từ ReCar:</div>
                        <ul class="list-unstyled mb-0 small text-muted">
                            <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> 100% Xe đúng hình ảnh, bảo dưỡng định kỳ</li>
                            <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Đã bao gồm bảo hiểm thân vỏ và dân sự</li>
                            <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Hoàn trả 100% tiền cọc nếu hủy trước 24 giờ</li>
                            <li><i class="bi bi-check2 text-success me-1"></i> Hỗ trợ cứu hộ đường bộ 24/7 toàn quốc</li>
                        </ul>
                    </div>

                    <div class="mt-4 pt-3 border-top text-center">
                        <a href="/Cart" class="text-decoration-none text-muted small">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại kiểm tra giỏ xe
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                window.location.reload();
            }
        });

        $(document).ready(function () {
            var totalAmt = @Model.Total;
            var depositAmt = @Model.Deposit;
            var remainAmt = @Model.Payment;

            function formatVND(val) {
                return val.toLocaleString('vi-VN') + ' đ';
            }

            // Xử lý chuyển đổi phương thức thanh toán
            $('input[name="payment_choice"]').on('change', function () {
                $('.payment-option-card').removeClass('selected');
                $(this).closest('.payment-option-card').addClass('selected');

                var val = $(this).val();
                var isFull = (val === 'full_100' || val === 'wallet_full' || val === 'zalopay_full');
                var isWallet = (val === 'wallet_deposit' || val === 'wallet_full');
                var isZaloPay = (val === 'zalopay_deposit' || val === 'zalopay_full');
                var channelLabel = isWallet ? 'Ví ReCar' : (isZaloPay ? 'ZaloPay' : 'VNPay');

                if (isFull) {
                    $('#labelNowPay').text('Tiền thanh toán ngay (100%)');
                    $('#sublabelNowPay').text('Thanh toán trọn gói qua ' + channelLabel);
                    $('#amountNowPay').text(formatVND(totalAmt)).removeClass('text-primary').addClass('text-success');

                    $('#labelRemainPay').text('Còn lại khi nhận xe (0%)');
                    $('#sublabelRemainPay').text('Đã thanh toán trọn gói qua sàn ✓');
                    $('#amountRemainPay').text('0 đ').removeClass('text-secondary').addClass('text-success');

                    $('#btnSubmitCheckout').html('<i class="bi bi-shield-check me-2"></i> Xác nhận & Thanh toán trọn gói 100% (' + formatVND(totalAmt) + ')');
                } else {
                    $('#labelNowPay').text('Tiền thanh toán ngay (@depositPct%)');
                    $('#sublabelNowPay').text('Thanh toán cọc trực tuyến qua ' + channelLabel);
                    $('#amountNowPay').text(formatVND(depositAmt)).removeClass('text-success').addClass('text-primary');

                    $('#labelRemainPay').text('Còn lại khi nhận xe (@remainPct%)');
                    $('#sublabelRemainPay').text('Thanh toán khi ký hợp đồng & nhận xe');
                    $('#amountRemainPay').text(formatVND(remainAmt)).removeClass('text-success').addClass('text-secondary');

                    $('#btnSubmitCheckout').html('<i class="bi bi-lock-fill me-2"></i> Xác nhận & Thanh toán cọc @depositPct% (' + formatVND(depositAmt) + ')');
                }
            });

            // Submit form thanh toán
            $("#checkoutForm").submit(function (e) {
                e.preventDefault();

                var selectedChoice = $('input[name="payment_choice"]:checked').val() || "deposit_30";

                var formData = {
                    Notes: $("#notes").val(),
                    paymentmethod: selectedChoice
                };

                // Hiển thị loading
                Swal.fire({
                    title: 'Đang xử lý đơn đặt xe...',
                    text: 'Vui lòng chờ trong giây lát',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/Cart/Checkout',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function (response) {
                        Swal.close();
                        if (response.success) {
                            if (response.isVnpay) {
                                window.location.href = response.redirectUrl;
                            } else {
                                Swal.fire({
                                    icon: 'success',
                                    title: response.title || 'Đặt xe thành công!',
                                    text: response.message || 'Đơn thuê xe của bạn đã được ghi nhận. Chủ xe sẽ liên hệ sớm nhất.',
                                    confirmButtonText: 'Xem đơn hàng của tôi',
                                    confirmButtonColor: '#2563eb',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                }).then(() => {
                                    window.location.href = response.redirectUrl;
                                });
                            }
                        } else {
                            if (response.needAddress) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Cần cập nhật địa chỉ',
                                    text: response.message,
                                    confirmButtonText: 'Cập nhật địa chỉ ngay',
                                    confirmButtonColor: '#2563eb',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                }).then((result) => {
                                    window.location.href = response.redirectUrl;
                                });
                            } else if (response.needLicense) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Cần cập nhật Giấy phép lái xe',
                                    text: response.message,
                                    confirmButtonText: 'Cập nhật GPLX ngay',
                                    confirmButtonColor: '#2563eb',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                }).then((result) => {
                                    window.location.href = response.redirectUrl;
                                });
                            } else if (response.pendingZaloPay) {
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Đơn hàng đang chờ thanh toán',
                                    text: response.message,
                                    showCancelButton: true,
                                    confirmButtonText: 'Tiếp tục thanh toán ZaloPay',
                                    cancelButtonText: 'Xem đơn hàng của tôi',
                                    confirmButtonColor: '#2563eb',
                                    allowOutsideClick: false
                                }).then((result) => {
                                    if (result.isConfirmed && response.paymentUrl) {
                                        window.location.href = response.paymentUrl;
                                    } else {
                                        window.location.href = response.ordersUrl || '/Accounts/Index?tab=orders';
                                    }
                                });
                            } else if (response.emptyCart) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Giỏ xe đã được xử lý',
                                    text: response.message,
                                    confirmButtonText: 'Kiểm tra đơn hàng',
                                    confirmButtonColor: '#2563eb',
                                    allowOutsideClick: false
                                }).then(() => {
                                    window.location.href = response.redirectUrl || '/Accounts/Index?tab=orders';
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Không thể hoàn tất',
                                    text: response.message,
                                    confirmButtonColor: '#2563eb'
                                });
                            }
                        }
                    },
                    error: function () {
                        Swal.close();
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi kết nối',
                            text: 'Không thể kết nối đến máy chủ. Vui lòng kiểm tra lại.',
                            confirmButtonColor: '#2563eb'
                        });
                    }
                });
            });
        });
    </script>
}