@model CarRental.Models.Blog
@{
    ViewData["Title"] = "Viết bài mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 1100px;">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle p-2 text-muted me-1">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Viết bài mới</h1>
            </div>
            <p class="text-muted small mb-0 mt-1 ms-5">Soạn thảo cẩm nang du lịch, kinh nghiệm thuê xe hoặc thông báo khuyến mãi cho sàn ReCar.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3.5 py-1.5 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

        <div class="row g-4">
            <!-- Cột trái: Nội dung chính -->
            <div class="col-lg-8">
                <div class="recar-panel p-4 mb-4">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-card-heading text-primary me-2"></i> Nội dung bài viết
                    </h5>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold small">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="VD: Top 5 cung đường phượt bằng xe tự lái đẹp nhất..." required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold small">Tóm tắt ngắn (Lead / Sapo) <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" rows="3" class="form-control" placeholder="Mô tả tóm tắt nội dung chính (1 - 2 câu ngắn gọn hiển thị ở danh sách bài viết)" required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Detail" class="form-label fw-semibold small">Nội dung chi tiết bài viết <span class="text-danger">*</span></label>
                        <textarea asp-for="Detail" id="BlogDetail" rows="12" class="form-control" placeholder="Nhập nội dung bài viết đầy đủ tại đây..." required></textarea>
                        <span asp-validation-for="Detail" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Cài đặt & Ảnh bìa -->
            <div class="col-lg-4">
                <!-- Card Xuất bản -->
                <div class="recar-panel p-4 mb-4">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-send text-success me-2"></i> Trạng thái xuất bản
                    </h6>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="switchIsActive" checked>
                        <label class="form-check-label fw-semibold small text-dark" for="switchIsActive">
                            Xuất bản ngay lên sàn ReCar
                        </label>
                        <div class="form-text small text-muted">Nếu tắt, bài viết sẽ được lưu dưới dạng Bản nháp và không hiển thị ra trang chủ.</div>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex flex-column gap-2">
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                            <i class="bi bi-check2-circle me-1"></i> Xuất bản bài viết
                        </button>
                        <a asp-action="Index" class="btn btn-light w-100 rounded-pill py-2 text-muted fw-semibold border">
                            Hủy bỏ
                        </a>
                    </div>
                </div>

                <!-- Card Ảnh bìa -->
                <div class="recar-panel p-4 mb-4">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-image text-info me-2"></i> Ảnh bìa bài viết
                    </h6>
                    <p class="text-muted small mb-3">Kích thước khuyến nghị: 1200 x 630 px (Tỷ lệ 16:9 hoặc 3:2).</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Tải lên tệp ảnh từ máy tính:</label>
                        <input type="file" id="imageFileInput" name="ImageFile" accept="image/*" class="form-control form-control-sm rounded-3 mb-2" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Hoặc nhập đường dẫn ảnh (URL):</label>
                        <input asp-for="Image" id="imageInputUrl" class="form-control form-control-sm" placeholder="https://... hoặc /images/blogs/..." />
                    </div>

                    <!-- Khung xem trước ảnh Live Preview -->
                    <div class="border rounded-3 p-2 bg-light text-center">
                        <img id="imagePreview" src="/images/cars/hero.jpg" alt="Xem trước ảnh bìa" class="img-fluid rounded-3 object-fit-cover w-100 shadow-xs" style="max-height: 180px; display: none;" />
                        <div id="noPreviewText" class="text-muted small py-4">
                            <i class="bi bi-card-image fs-1 d-block text-secondary opacity-50 mb-1"></i>
                            Chưa có ảnh bìa xem trước
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Xem trước ảnh Live Preview khi chọn file
        document.getElementById('imageFileInput')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById('imagePreview');
                    const noText = document.getElementById('noPreviewText');
                    img.src = e.target.result;
                    img.style.display = 'block';
                    if (noText) noText.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });

        // Xem trước ảnh Live Preview khi nhập URL
        document.getElementById('imageInputUrl')?.addEventListener('input', function (e) {
            const url = e.target.value.trim();
            const img = document.getElementById('imagePreview');
            const noText = document.getElementById('noPreviewText');
            if (url) {
                img.src = url;
                img.style.display = 'block';
                if (noText) noText.style.display = 'none';
            } else if (!document.getElementById('imageFileInput').files.length) {
                img.style.display = 'none';
                if (noText) noText.style.display = 'block';
            }
        });
    </script>
}
