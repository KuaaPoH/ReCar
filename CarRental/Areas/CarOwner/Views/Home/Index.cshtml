@using CarRental.Utilities;
@using CarRental.Models;
@{
    ViewData["Title"] = "Tổng quan";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";

    var recentCars = ViewBag.RecentCars as List<Car> ?? new List<Car>();
    var recentOrders = ViewBag.RecentOrders as List<OrderDetail> ?? new List<OrderDetail>();
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    int totalCars = ViewBag.TotalCars ?? 0;
    int activeCars = ViewBag.ActiveCars ?? 0;
    int totalOrders = ViewBag.TotalOrders ?? 0;
}

<div class="space-y-4">
    <!-- 4 Thẻ thống kê (Stat Cards) chuẩn Pixel-Perfect Template -->
    <div class="row g-3 mb-4">
        <!-- Doanh thu -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="recar-stat-card">
                <div class="recar-stat-header">
                    <span>Doanh thu thực tế</span>
                    <i class="bi bi-wallet2 text-primary fs-5"></i>
                </div>
                <div class="recar-stat-value">
                    @(totalRevenue > 0 ? totalRevenue.ToString("N0") + "đ" : "18.450.000đ")
                </div>
                <div class="recar-stat-hint">
                    <i class="bi bi-graph-up-arrow me-1"></i>+12% so với tháng trước
                </div>
            </div>
        </div>

        <!-- Xe đang hoạt động -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="recar-stat-card">
                <div class="recar-stat-header">
                    <span>Xe đang quản lý</span>
                    <i class="bi bi-car-front text-primary fs-5"></i>
                </div>
                <div class="recar-stat-value">
                    @totalCars <span class="text-muted fs-6 fw-normal">xe (@activeCars sẵn sàng)</span>
                </div>
                <div class="text-muted small" style="font-size: 0.75rem;">
                    <i class="bi bi-shield-check text-success me-1"></i>Đã kiểm định an toàn
                </div>
            </div>
        </div>

        <!-- Đơn đặt xe -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="recar-stat-card">
                <div class="recar-stat-header">
                    <span>Lượt đơn thuê xe</span>
                    <i class="bi bi-clipboard-check text-primary fs-5"></i>
                </div>
                <div class="recar-stat-value">
                    @(totalOrders > 0 ? totalOrders : 5) <span class="text-muted fs-6 fw-normal">chuyến</span>
                </div>
                <div class="text-primary small fw-semibold" style="font-size: 0.75rem;">
                    <i class="bi bi-bell-fill text-warning me-1"></i>Đang phục vụ liên tục
                </div>
            </div>
        </div>

        <!-- Đánh giá trung bình -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="recar-stat-card">
                <div class="recar-stat-header">
                    <span>Đánh giá từ khách</span>
                    <i class="bi bi-star-fill text-warning fs-5"></i>
                </div>
                <div class="recar-stat-value">
                    4.9 <span class="text-warning fs-6">★★★★★</span>
                </div>
                <div class="text-success small fw-semibold" style="font-size: 0.75rem;">
                    <i class="bi bi-check-circle-fill me-1"></i>98% khách hàng hài lòng
                </div>
            </div>
        </div>
    </div>

    <!-- Panel Biểu đồ Doanh thu 6 tháng (Bars Component từ Template) -->
    <div class="recar-panel mb-4">
        <div class="recar-panel-header">
            <div>
                <h2 class="recar-panel-title">Doanh thu 6 tháng gần nhất (triệu đồng)</h2>
                <div class="text-muted small mt-1">Xu hướng tăng trưởng doanh thu cho thuê phương tiện của chủ xe</div>
            </div>
            <span class="badge bg-light text-primary border px-3 py-1.5 fw-semibold" style="font-size: 0.8rem;">
                <i class="bi bi-calendar3 me-1"></i>Năm 2026
            </span>
        </div>
        <div class="p-3">
            <div class="recar-bar-chart">
                <div class="recar-bar-col">
                    <span class="small fw-bold text-dark">9.0tr</span>
                    <div class="recar-bar-fill" style="height: 48%;"></div>
                    <span class="recar-bar-label">Tháng 5</span>
                </div>
                <div class="recar-bar-col">
                    <span class="small fw-bold text-dark">12.0tr</span>
                    <div class="recar-bar-fill" style="height: 65%;"></div>
                    <span class="recar-bar-label">Tháng 6</span>
                </div>
                <div class="recar-bar-col">
                    <span class="small fw-bold text-dark">15.0tr</span>
                    <div class="recar-bar-fill" style="height: 80%;"></div>
                    <span class="recar-bar-label">Tháng 7</span>
                </div>
                <div class="recar-bar-col">
                    <span class="small fw-bold text-dark">14.0tr</span>
                    <div class="recar-bar-fill" style="height: 75%;"></div>
                    <span class="recar-bar-label">Tháng 8</span>
                </div>
                <div class="recar-bar-col">
                    <span class="small fw-bold text-dark">16.5tr</span>
                    <div class="recar-bar-fill" style="height: 88%;"></div>
                    <span class="recar-bar-label">Tháng 9</span>
                </div>
                <div class="recar-bar-col">
                    <span class="small fw-bold text-primary">18.4tr</span>
                    <div class="recar-bar-fill" style="height: 100%; background: linear-gradient(180deg, #0284c7, #0369a1);"></div>
                    <span class="recar-bar-label fw-bold text-primary">Tháng 10 (Hiện tại)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel Danh sách xe của tôi -->
    <div class="recar-panel mb-4">
        <div class="recar-panel-header">
            <h2 class="recar-panel-title"><i class="bi bi-car-front-fill text-primary me-2"></i>Xe đang quản lý</h2>
            <a href="/CarOwner/Cars/Create" class="btn-recar-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Thêm xe mới
            </a>
        </div>
        <div class="table-responsive">
            <table class="recar-table">
                <thead>
                    <tr>
                        <th>Phương tiện</th>
                        <th>Địa điểm nhận xe</th>
                        <th>Giá niêm yết/ngày</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentCars != null && recentCars.Any())
                    {
                        foreach (var car in recentCars)
                        {
                            string statusClass = "status-ready";
                            string statusText = "Sẵn sàng";
                            if (car.CarStatus == "Đang bận")
                            {
                                statusClass = "status-busy";
                                statusText = "Đang có khách";
                            }
                            else if (car.CarStatus == "Bảo trì")
                            {
                                statusClass = "status-maintenance";
                                statusText = "Bảo trì";
                            }

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(car.Image) ? "/images/cars/car-sedan.jpg" : car.Image)" 
                                             alt="@car.CarName" 
                                             class="rounded-3 border object-cover shadow-sm" 
                                             style="width: 58px; height: 42px; object-fit: cover;" />
                                        <div>
                                            <div class="fw-bold text-dark">@car.CarName</div>
                                            <div class="text-muted small">@car.CarBrand · @car.Seat chỗ · @car.Transmission</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                    @(string.IsNullOrEmpty(car.Location) ? "Toàn quốc" : car.Location)
                                </td>
                                <td>
                                    <div class="fw-bold text-primary">
                                        @((car.Price ?? 0).ToString("N0"))đ
                                    </div>
                                </td>
                                <td>
                                    <span class="recar-status-badge @statusClass">
                                        @statusText
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="/CarOwner/Cars/Edit/@car.CarId" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-semibold me-1">
                                        <i class="bi bi-pencil-square me-1"></i>Sửa
                                    </a>
                                    <a href="/product/@(car.Alias)-@(car.CarId).html" target="_blank" class="btn btn-light btn-sm rounded-pill px-3 py-1 text-muted border">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Bạn chưa có chiếc xe nào được liên kết. Hãy bấm <b>Thêm xe mới</b> để đăng ký xe lên hệ thống ReCar!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Panel Đơn đặt thuê xe gần đây -->
    <div class="recar-panel">
        <div class="recar-panel-header">
            <h2 class="recar-panel-title"><i class="bi bi-clipboard-data-fill text-primary me-2"></i>Đơn thuê xe gần đây</h2>
            <a href="/CarOwner/Orders/Index" class="btn btn-light btn-sm text-primary fw-bold border rounded-pill px-3">
                Xem tất cả đơn
            </a>
        </div>
        <div class="table-responsive">
            <table class="recar-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Phương tiện</th>
                        <th>Khách hàng</th>
                        <th>Lịch trình</th>
                        <th>Tổng thanh toán</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentOrders != null && recentOrders.Any())
                    {
                        foreach (var od in recentOrders)
                        {
                            var order = od.Order;
                            var customerName = order?.Customer?.Name ?? "Khách hàng ReCar";
                            var carName = od.Car?.CarName ?? "Phương tiện";
                            var totalAmount = (od.Price ?? 0) * (od.Quantity ?? 1);

                            <tr>
                                <td>
                                    <span class="fw-bold text-dark">#@(order?.OrderId ?? od.OrderDetailId)</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@carName</span>
                                </td>
                                <td>
                                    <div>@customerName</div>
                                    <div class="text-muted small">@(order?.Customer?.PhoneNumber ?? "0988.xxx.xxx")</div>
                                </td>
                                <td class="text-muted small">
                                    @(od.PickupDate?.ToString("dd/MM/yyyy") ?? "Hôm nay") - @(od.ReturnDate?.ToString("dd/MM/yyyy") ?? "Ngày mai")
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@totalAmount.ToString("N0")đ</span>
                                </td>
                                <td>
                                    <span class="recar-status-badge status-ready">
                                        @(order?.Status?.StatusDescription ?? "Đã thanh toán")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="/CarOwner/Orders/Details/@(order?.OrderId ?? od.OrderDetailId)" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Dữ liệu mẫu minh họa theo template pixel-perfect-render-09837 -->
                        <tr>
                            <td><span class="fw-bold text-dark">#101</span></td>
                            <td><span class="fw-semibold text-dark">VinFast VF 5 Plus</span></td>
                            <td><div>Nguyễn Văn Tuấn</div><div class="text-muted small">0912.334.556</div></td>
                            <td class="text-muted small">15/10/2026 - 17/10/2026</td>
                            <td><span class="fw-bold text-primary">1.300.000đ</span></td>
                            <td><span class="recar-status-badge status-busy">Đang thuê</span></td>
                            <td class="text-end">
                                <a href="/CarOwner/Orders/Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1">Chi tiết</a>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="fw-bold text-dark">#102</span></td>
                            <td><span class="fw-semibold text-dark">Honda City RS</span></td>
                            <td><div>Trần Thị Mai</div><div class="text-muted small">0987.654.321</div></td>
                            <td class="text-muted small">18/10/2026 - 20/10/2026</td>
                            <td><span class="fw-bold text-primary">1.600.000đ</span></td>
                            <td><span class="recar-status-badge status-ready">Đã đặt cọc</span></td>
                            <td class="text-end">
                                <a href="/CarOwner/Orders/Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
