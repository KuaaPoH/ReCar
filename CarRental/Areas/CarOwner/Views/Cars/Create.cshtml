@model CarRental.ViewModels.CarCreateVM
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Thêm xe mới";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";
    var carTypes = ViewBag.CarTypes as List<SelectListItem> ?? new List<SelectListItem>();
    var carBrands = ViewBag.CarBrands as List<CarRental.Models.CarBrand> ?? new List<CarRental.Models.CarBrand>();
    var locations = ViewBag.Locations as List<CarRental.Models.Location> ?? new List<CarRental.Models.Location>();
    var dbAmenities = ViewBag.Amenities as List<CarRental.Models.Amenity> ?? new List<CarRental.Models.Amenity>();
}

<style>
    .card-surface {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    }

    /* Stepper item styles khớp 100% Ảnh 2 Template */
    .stepper-nav-btn {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 0.875rem;
        border-radius: 0.75rem;
        border: none;
        background: transparent;
        text-align: left;
        font-size: 0.875rem;
        font-weight: 500;
        color: #64748b;
        transition: all 0.15s ease;
    }
    .stepper-nav-btn:hover {
        background-color: #f1f5f9;
        color: #0f172a;
    }
    .stepper-nav-btn.active {
        background-color: #e0f2fe;
        color: #0284c7;
        font-weight: 600;
    }
    .stepper-bubble {
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 9999px;
        display: grid;
        place-items: center;
        font-size: 0.75rem;
        font-weight: 700;
        flex-shrink: 0;
        background-color: #f1f5f9;
        color: #64748b;
        transition: all 0.15s ease;
    }
    .stepper-nav-btn.active .stepper-bubble {
        background-color: #00a8e8;
        color: #ffffff;
    }
    .stepper-nav-btn.completed .stepper-bubble {
        background-color: #10b981;
        color: #ffffff;
    }

    /* Form controls tinh tế khớp Ảnh 2 */
    .form-label-recar {
        font-size: 0.84rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 0.4rem;
        display: block;
    }
    .form-control-recar, .form-select-recar {
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.95rem;
        font-size: 0.875rem;
        color: #0f172a;
        background-color: #ffffff;
        transition: all 0.15s ease;
    }
    .form-control-recar:focus, .form-select-recar:focus {
        border-color: #00a8e8;
        box-shadow: 0 0 0 3px rgba(0, 168, 232, 0.15);
        outline: none;
    }
    .form-control-recar::placeholder {
        color: #94a3b8;
    }

    /* Amenity card buttons */
    .amenity-toggle-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.875rem 0.5rem;
        border-radius: 0.85rem;
        border: 1.5px solid #e2e8f0;
        background: #ffffff;
        color: #475569;
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
        width: 100%;
        text-align: center;
    }
    .amenity-toggle-btn:hover {
        background-color: #f8fafc;
        border-color: #cbd5e1;
    }
    .amenity-toggle-btn.active {
        background-color: #f0f9ff;
        border-color: #00a8e8;
        color: #0284c7;
        font-weight: 600;
    }

    /* License plate badge */
    .plate-badge {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-weight: 700;
        background-color: #f8fafc;
        border: 1.5px solid #0f172a;
        color: #0f172a;
        padding: 0.2rem 0.55rem;
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        letter-spacing: 0.05em;
        display: inline-block;
    }

    /* Step panes */
    .form-step-pane {
        display: none;
    }
    .form-step-pane.active {
        display: block;
        animation: fadeIn 0.2s ease-in-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container-fluid px-0 pb-5">
    <!-- Page Header Khớp 100% Ảnh 2 Template -->
    <div class="mb-4">
        <h1 class="h4 fw-bold text-dark tracking-tight mb-1" style="font-size: 1.45rem;">Đăng ký xe mới</h1>
        <p class="text-muted small mb-0" style="font-size: 0.875rem;">Hoàn thành 6 bước để gửi hồ sơ xe cho Admin phê duyệt.</p>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createCarForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Cột Trái (240px): Vertical Stepper Navigation Khớp 100% Ảnh 2 -->
            <div class="col-12 col-lg-3">
                <div class="card-surface p-2 sticky-top" style="top: 80px; z-index: 10;">
                    <ol class="list-unstyled mb-0 d-flex flex-column gap-1" id="stepperNavList">
                        <li>
                            <button type="button" class="stepper-nav-btn active" data-step="0" onclick="goToStep(0)">
                                <span class="stepper-bubble" id="stepBubble-0">1</span>
                                <span>Thông tin cơ bản</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="1" onclick="goToStep(1)">
                                <span class="stepper-bubble" id="stepBubble-1">2</span>
                                <span>Giá thuê</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="2" onclick="goToStep(2)">
                                <span class="stepper-bubble" id="stepBubble-2">3</span>
                                <span>Quy định</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="3" onclick="goToStep(3)">
                                <span class="stepper-bubble" id="stepBubble-3">4</span>
                                <span>Tiện nghi</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="4" onclick="goToStep(4)">
                                <span class="stepper-bubble" id="stepBubble-4">5</span>
                                <span>Hình ảnh & giấy tờ</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="5" onclick="goToStep(5)">
                                <span class="stepper-bubble" id="stepBubble-5">6</span>
                                <span>Kiểm tra & gửi</span>
                            </button>
                        </li>
                    </ol>
                </div>
            </div>

            <!-- Cột Phải: Step Form Panes Khớp 100% Ảnh 2 -->
            <div class="col-12 col-lg-9">
                <div class="card-surface p-4 p-md-5">

                    <!-- ============================================== -->
                    <!-- BƯỚC 1: THÔNG TIN CƠ BẢN (2 CỘT ĐỀU NHAU NHƯ ẢNH 2) -->
                    <!-- ============================================== -->
                    <div class="form-step-pane active" id="stepPane-0">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 1: Thông tin cơ bản</h2>

                        <div class="row g-4">
                            <!-- Hàng 1 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="CarName" class="form-label-recar">Tên xe</label>
                                <input asp-for="CarName" class="form-control form-control-recar" id="inputCarName" placeholder="VD: Toyota Vios G 2023" required />
                                <span asp-validation-for="CarName" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="CarBrand" class="form-label-recar">Hãng xe</label>
                                <select asp-for="CarBrand" class="form-select form-select-recar" id="selectCarBrand" required>
                                    <option value="">Chọn hãng</option>
                                    @if (carBrands != null && carBrands.Any())
                                    {
                                        foreach (var b in carBrands)
                                        {
                                            <option value="@b.BrandName">@b.BrandName</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="Toyota">Toyota</option>
                                        <option value="VinFast">VinFast</option>
                                        <option value="Mitsubishi">Mitsubishi</option>
                                        <option value="Mazda">Mazda</option>
                                        <option value="Honda">Honda</option>
                                        <option value="Hyundai">Hyundai</option>
                                        <option value="Kia">Kia</option>
                                        <option value="Ford">Ford</option>
                                    }
                                </select>
                                <span asp-validation-for="CarBrand" class="text-danger small"></span>
                            </div>

                            <!-- Hàng 2 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="TypeId" class="form-label-recar">Phân khúc</label>
                                <select asp-for="TypeId" asp-items="carTypes" class="form-select form-select-recar" id="selectCarType" required>
                                    <option value="">Chọn phân khúc</option>
                                </select>
                                <span asp-validation-for="TypeId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="ModelYear" class="form-label-recar">Năm sản xuất</label>
                                <input asp-for="ModelYear" type="number" min="2010" max="2027" class="form-control form-control-recar" id="selectModelYear" value="2024" required />
                                <span asp-validation-for="ModelYear" class="text-danger small"></span>
                            </div>

                            <!-- Hàng 3 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="LicensePlate" class="form-label-recar">Biển số</label>
                                <input asp-for="LicensePlate" class="form-control form-control-recar font-monospace text-uppercase" id="inputLicensePlate" placeholder="51K-238.45" required />
                                <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Color" class="form-label-recar">Màu xe</label>
                                <input asp-for="Color" class="form-control form-control-recar" id="inputColor" placeholder="Trắng, Đen, Xám..." required />
                                <span asp-validation-for="Color" class="text-danger small"></span>
                            </div>

                            <!-- Hàng 4 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Seat" class="form-label-recar">Số chỗ ngồi</label>
                                <input asp-for="Seat" type="number" min="2" max="16" class="form-control form-control-recar" id="selectSeat" value="5" required />
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Transmission" class="form-label-recar">Hộp số</label>
                                <select asp-for="Transmission" class="form-select form-select-recar" id="selectTransmission" required>
                                    <option value="Tự động" selected>Tự động</option>
                                    <option value="Số sàn">Số sàn</option>
                                </select>
                            </div>

                            <!-- Hàng 5 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Fuel" class="form-label-recar">Nhiên liệu</label>
                                <select asp-for="Fuel" class="form-select form-select-recar" id="selectFuel" required>
                                    <option value="Xăng" selected>Xăng</option>
                                    <option value="Dầu">Dầu</option>
                                    <option value="Điện">Điện</option>
                                    <option value="Hybrid">Hybrid</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="FuelConsumption" class="form-label-recar">Mức tiêu thụ nhiên liệu</label>
                                <input asp-for="FuelConsumption" class="form-control form-control-recar" id="inputConsumption" placeholder="6L/100km" />
                            </div>

                            <!-- Hàng 6 (1 Cột Chiếm Toàn Bộ Chiều Ngang Chuẩn Ảnh 2) -->
                            <div class="col-12">
                                <label asp-for="Location" class="form-label-recar">Địa điểm nhận xe</label>
                                <input asp-for="Location" class="form-control form-control-recar" id="inputLocation" placeholder="Quận 7, TP.HCM" required />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 2: GIÁ THUÊ                               -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-1">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 2: Giá thuê</h2>

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="Price" class="form-label-recar">Giá thuê/ngày (VND)</label>
                                <input asp-for="Price" type="number" min="200000" step="10000" class="form-control form-control-recar" id="inputPrice" placeholder="VD: 850000" required />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="SalePrice" class="form-label-recar">Giá khuyến mãi/ngày (không bắt buộc)</label>
                                <input asp-for="SalePrice" type="number" min="0" step="10000" class="form-control form-control-recar" id="inputSalePrice" placeholder="Để trống nếu không có" />
                            </div>

                            <div class="col-12">
                                <div class="rounded-xl border p-4" style="background-color: #f8fafc;">
                                    <p class="text-xs text-muted mb-1 font-semibold uppercase tracking-wider">Khách sẽ thấy</p>
                                    <div class="d-flex align-items-baseline gap-2 mb-1" id="previewPriceContainer">
                                        <span class="fs-3 fw-bold text-primary" id="previewPriceDisplay">0 đ</span>
                                        <span class="text-sm text-muted text-decoration-line-through d-none" id="previewOriginalPrice"></span>
                                    </div>
                                    <p class="text-xs text-muted mb-0">/ngày · giá khuyến mãi chỉ áp dụng khi bạn bật trong Quản lý xe</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 3: QUY ĐỊNH                               -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-2">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 3: Quy định</h2>

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="MileageLimit" class="form-label-recar">Giới hạn quãng đường (km/ngày)</label>
                                <input asp-for="MileageLimit" type="number" min="0" step="10" class="form-control form-control-recar" id="inputMileageLimit" value="300" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="ExtraFeePerKm" class="form-label-recar">Phụ phí vượt km (VND/km)</label>
                                <input asp-for="ExtraFeePerKm" type="number" min="0" step="500" class="form-control form-control-recar" id="inputExtraFeePerKm" value="3000" />
                            </div>

                            <div class="col-12">
                                <div class="rounded-xl border p-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                                    <div>
                                        <div class="fw-bold text-dark text-sm">Giao xe tận nơi</div>
                                        <div class="text-xs text-muted">Tăng khả năng được chọn của xe</div>
                                    </div>
                                    <div class="form-check form-switch m-0 fs-5">
                                        <input asp-for="DeliverySupported" class="form-check-input" type="checkbox" id="checkDelivery" role="switch" onchange="toggleDeliverySwitch(this.checked)" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6 d-none" id="boxDeliveryFee">
                                <label asp-for="DeliveryFee" class="form-label-recar">Phí giao xe (VND)</label>
                                <input asp-for="DeliveryFee" type="number" min="0" step="10000" class="form-control form-control-recar" id="inputDeliveryFee" value="100000" />
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 4: TIỆN NGHI                              -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-3">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 4: Tiện nghi</h2>

                        <div class="row g-3 mb-4">
                            @{
                                var dbAmenitiesList = ViewBag.Amenities as List<CarRental.Models.Amenity> ?? new List<CarRental.Models.Amenity>();
                                string GetAmenityLucideIcon(string name)
                                {
                                    if (string.IsNullOrEmpty(name)) return "check-circle";
                                    string lower = name.ToLower();
                                    if (lower.Contains("bản đồ") || lower.Contains("gps")) return "map";
                                    if (lower.Contains("bluetooth")) return "bluetooth";
                                    if (lower.Contains("camera lùi") || lower.Contains("camera 360")) return "camera";
                                    if (lower.Contains("hành trình")) return "video";
                                    if (lower.Contains("lốp")) return "gauge";
                                    if (lower.Contains("cửa sổ trời")) return "sun";
                                    if (lower.Contains("điều hòa") || lower.Contains("lạnh")) return "snowflake";
                                    if (lower.Contains("usb") || lower.Contains("sạc")) return "zap";
                                    if (lower.Contains("trẻ em")) return "baby";
                                    if (lower.Contains("va chạm") || lower.Contains("cảnh báo")) return "shield-alert";
                                    if (lower.Contains("carplay") || lower.Contains("android")) return "smartphone";
                                    if (lower.Contains("etc") || lower.Contains("thu phí")) return "credit-card";
                                    if (lower.Contains("ghế")) return "armchair";
                                    if (lower.Contains("khóa") || lower.Contains("smartkey")) return "key";
                                    if (lower.Contains("cốp")) return "package";
                                    return "check-circle";
                                }
                            }

                            @if (dbAmenitiesList.Any())
                            {
                                @foreach (var item in dbAmenitiesList)
                                {
                                    string iconName = GetAmenityLucideIcon(item.Name);
                                    <div class="col-6 col-sm-4 col-md-3">
                                        <button type="button" class="amenity-toggle-btn" data-id="@item.AmenityId" data-name="@item.Name" onclick="toggleAmenity(this)">
                                            <i data-lucide="@iconName" class="size-5"></i>
                                            <span>@item.Name</span>
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                var fallbackCatalog = new List<(int Id, string Name, string Icon)>
                                {
                                    (1, "Bản đồ", "map"),
                                    (15, "Bluetooth", "bluetooth"),
                                    (2, "Camera lùi", "camera"),
                                    (4, "Cảm biến lốp", "gauge"),
                                    (6, "Cửa sổ trời", "sun"),
                                    (16, "Điều hòa", "snowflake"),
                                    (3, "Camera hành trình", "video"),
                                    (17, "Cổng sạc USB", "zap"),
                                    (9, "Ghế trẻ em", "baby"),
                                    (11, "Cảnh báo va chạm", "shield-alert")
                                };
                                @foreach (var item in fallbackCatalog)
                                {
                                    <div class="col-6 col-sm-4 col-md-3">
                                        <button type="button" class="amenity-toggle-btn" data-id="@item.Id" data-name="@item.Name" onclick="toggleAmenity(this)">
                                            <i data-lucide="@item.Icon" class="size-5"></i>
                                            <span>@item.Name</span>
                                        </button>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Ẩn các inputs checkbox để submit dữ liệu -->
                        <div id="hiddenAmenityInputs"></div>

                        <div class="mt-4 pt-3 border-top">
                            <label asp-for="Details" class="form-label-recar">Mô tả bổ sung & Nội quy của chủ xe</label>
                            <textarea asp-for="Details" rows="4" class="form-control form-control-recar" id="inputDetails" placeholder="Mô tả về tính năng nổi bật, trải nghiệm lái xe, các quy định giữ gìn vệ sinh (không hút thuốc, không chở thú cưng...)..."></textarea>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 5: HÌNH ẢNH & GIẤY TỜ                     -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-4">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 5: Hình ảnh & Giấy tờ</h2>

                        <!-- 1. Ảnh đại diện -->
                        <div class="mb-4 pb-3 border-bottom">
                            <label class="form-label-recar">Ảnh đại diện</label>
                            <div class="d-flex flex-wrap align-items-center gap-3 mt-2">
                                <div class="position-relative overflow-hidden rounded-xl border bg-light d-grid place-items-center" style="width: 176px; height: 112px;">
                                    <img id="previewAvatarImg" src="" alt="Ảnh đại diện" class="w-100 h-100 object-fit-cover d-none" />
                                    <div id="emptyAvatarPlaceholder" class="text-muted text-center p-2">
                                        <i data-lucide="image-plus" class="size-6 d-block mx-auto mb-1 opacity-50"></i>
                                        <span class="text-xs">Chưa có ảnh</span>
                                    </div>
                                </div>
                                <div>
                                    <label class="btn btn-sm btn-outline-primary rounded-xl px-3 py-2 cursor-pointer mb-1 d-inline-flex align-items-center gap-1.5">
                                        <i data-lucide="image-plus" class="size-4"></i>
                                        <span>Chọn ảnh đại diện</span>
                                        <input type="file" asp-for="ImageFile" id="inputImageFile" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewAvatarImg', 'emptyAvatarPlaceholder')" required />
                                    </label>
                                    <div class="text-xs text-muted">Chỉ chấp nhận JPG, PNG, WEBP (tối đa 5MB)</div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Giấy tờ pháp lý (KYC) -->
                        <div>
                            <label class="form-label-recar">Ảnh giấy tờ pháp lý (Đăng ký xe, Đăng kiểm, Bảo hiểm)</label>
                            <div class="row g-3 mt-1">
                                <!-- Đăng ký xe / Cà vẹt -->
                                <div class="col-12 col-sm-4">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 128px;">
                                        <img id="previewDocReg" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Cà vẹt xe" />
                                        <div id="placeholderDocReg" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="image-plus" class="size-5"></i>
                                            <span class="text-xs fw-semibold">Đăng ký xe / cà vẹt</span>
                                        </div>
                                        <input type="file" asp-for="RegistrationImageFile" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewDocReg', 'placeholderDocReg')" required />
                                    </label>
                                </div>

                                <!-- Sổ đăng kiểm -->
                                <div class="col-12 col-sm-4">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 128px;">
                                        <img id="previewDocInsp" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Sổ đăng kiểm" />
                                        <div id="placeholderDocInsp" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="image-plus" class="size-5"></i>
                                            <span class="text-xs fw-semibold">Sổ đăng kiểm</span>
                                        </div>
                                        <input type="file" asp-for="InspectionImageFile" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewDocInsp', 'placeholderDocInsp')" required />
                                    </label>
                                </div>

                                <!-- Bảo hiểm xe -->
                                <div class="col-12 col-sm-4">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 128px;">
                                        <img id="previewDocIns" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Bảo hiểm xe" />
                                        <div id="placeholderDocIns" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="image-plus" class="size-5"></i>
                                            <span class="text-xs fw-semibold">Bảo hiểm xe</span>
                                        </div>
                                        <input type="file" asp-for="InsuranceImageFile" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewDocIns', 'placeholderDocIns')" required />
                                    </label>
                                </div>
                            </div>
                            <p class="text-xs text-muted mt-2 mb-0">Ảnh giấy tờ chỉ Admin xét duyệt mới xem được, không hiển thị công khai trên sàn.</p>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 6: KIỂM TRA & GỬI                         -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-5">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 6: Kiểm tra & Gửi</h2>

                        <!-- Card preview tóm tắt thông tin xe -->
                        <div class="card-surface p-4 mb-4 border d-flex flex-column flex-md-row gap-4 align-items-start">
                            <div class="rounded-xl overflow-hidden flex-shrink-0" style="width: 100%; max-width: 208px; aspect-ratio: 16/10; background-color: #0f172a;">
                                <img id="summaryPreviewImg" src="/images/cars/default-car.jpg" alt="Tóm tắt xe" class="w-100 h-100 object-fit-cover" />
                            </div>

                            <div class="flex-grow-1">
                                <h3 class="fs-5 fw-bold text-dark mb-1" id="summaryCarName">Tên xe</h3>
                                <div class="text-muted text-sm mb-2" id="summarySubInfo">
                                    Hãng xe · Phân khúc · Năm 2024 · Màu xe
                                </div>

                                <div class="mb-2">
                                    <span class="plate-badge" id="summaryPlate">51K-238.45</span>
                                </div>

                                <div class="text-sm text-dark mb-2" id="summaryTechSpecs">
                                    5 chỗ · Tự động · Xăng
                                </div>

                                <div class="fs-6 fw-bold text-primary mb-2" id="summaryPriceText">
                                    0 đ / ngày
                                </div>

                                <div class="text-xs text-muted mb-2" id="summaryRuleText">
                                    Giới hạn 300 km/ngày · Vượt 3.000 đ/km · Không giao xe
                                </div>

                                <div class="text-xs text-muted" id="summaryAmenitiesText">
                                    Tiện nghi: Chưa chọn tiện nghi
                                </div>
                            </div>
                        </div>

                        <div class="rounded-xl p-4 text-sm" style="background-color: #fefce8; border: 1px solid #fef08a; color: #854d0e;">
                            <p class="fw-semibold mb-1 d-flex align-items-center gap-2">
                                <i data-lucide="info" class="size-4 text-warning"></i> Sau khi gửi
                            </p>
                            <p class="mb-0">Sau khi gửi, xe ở trạng thái <strong>Chờ duyệt</strong> và chỉ hiển thị trên sàn khi Admin phê duyệt.</p>
                        </div>
                    </div>

                    <!-- Footer Buttons Điều Hướng Khớp 100% Ảnh 2 Template -->
                    <div class="mt-5 pt-3 border-top d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-outline-secondary rounded-xl px-4 py-2 text-sm font-medium" id="btnPrevStep" onclick="prevStep()" disabled>
                            Quay lại
                        </button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary rounded-xl px-4 py-2 text-sm font-semibold d-inline-flex align-items-center gap-1.5" id="btnNextStep" onclick="nextStep()" style="background-color: #00a8e8; border-color: #00a8e8;">
                                <span>Tiếp tục</span>
                                <i data-lucide="arrow-right" class="size-4"></i>
                            </button>
                            <button type="submit" class="btn btn-primary rounded-xl px-4 py-2 text-sm font-semibold d-none" id="btnSubmitForm" style="background-color: #00a8e8; border-color: #00a8e8;">
                                <i data-lucide="check" class="size-4 d-inline me-1"></i> Gửi hồ sơ phê duyệt
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>
</div>

<script>
    let currentStep = 0;
    const totalSteps = 6;

    function goToStep(stepIndex) {
        if (stepIndex < 0 || stepIndex >= totalSteps) return;

        // Cập nhật panes
        document.querySelectorAll('.form-step-pane').forEach((p, idx) => {
            if (idx === stepIndex) {
                p.classList.add('active');
            } else {
                p.classList.remove('active');
            }
        });

        // Cập nhật Stepper nav items
        document.querySelectorAll('#stepperNavList .stepper-nav-btn').forEach((btn, idx) => {
            btn.classList.remove('active');
            const bubble = document.getElementById('stepBubble-' + idx);
            if (idx === stepIndex) {
                btn.classList.add('active');
            } else if (idx < stepIndex) {
                btn.classList.add('completed');
                if (bubble) bubble.innerHTML = '<i data-lucide="check" class="size-3.5"></i>';
            } else {
                btn.classList.remove('completed');
                if (bubble) bubble.innerText = (idx + 1);
            }
        });

        currentStep = stepIndex;

        // Nút Prev
        const btnPrev = document.getElementById('btnPrevStep');
        if (btnPrev) {
            btnPrev.disabled = (currentStep === 0);
        }

        // Nút Next vs Submit
        const btnNext = document.getElementById('btnNextStep');
        const btnSubmit = document.getElementById('btnSubmitForm');
        if (currentStep === totalSteps - 1) {
            if (btnNext) btnNext.classList.add('d-none');
            if (btnSubmit) btnSubmit.classList.remove('d-none');
            updateSummaryPreview();
        } else {
            if (btnNext) btnNext.classList.remove('d-none');
            if (btnSubmit) btnSubmit.classList.add('d-none');
        }

        // Re-render Lucide icons
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }

        // Scroll nhẹ lên đầu card nếu mobile
        if (window.innerWidth < 992) {
            window.scrollTo({ top: 80, behavior: 'smooth' });
        }
    }

    function nextStep() {
        if (currentStep < totalSteps - 1) {
            goToStep(currentStep + 1);
        }
    }

    function prevStep() {
        if (currentStep > 0) {
            goToStep(currentStep - 1);
        }
    }

    // Toggle switch Giao xe tận nơi
    function toggleDeliverySwitch(checked) {
        const box = document.getElementById('boxDeliveryFee');
        if (box) {
            if (checked) {
                box.classList.remove('d-none');
            } else {
                box.classList.add('d-none');
            }
        }
    }

    // Cập nhật giá preview ở Bước 2
    function updatePricePreview() {
        const inputPrice = document.getElementById('inputPrice');
        const inputSale = document.getElementById('inputSalePrice');
        const display = document.getElementById('previewPriceDisplay');
        const orig = document.getElementById('previewOriginalPrice');

        if (!inputPrice || !display) return;

        const price = parseInt(inputPrice.value) || 0;
        const sale = parseInt(inputSale.value) || 0;

        if (sale > 0 && sale < price) {
            display.innerText = sale.toLocaleString('vi-VN') + ' đ';
            if (orig) {
                orig.innerText = price.toLocaleString('vi-VN') + ' đ';
                orig.classList.remove('d-none');
            }
        } else {
            display.innerText = price.toLocaleString('vi-VN') + ' đ';
            if (orig) {
                orig.classList.add('d-none');
            }
        }
    }

    document.getElementById('inputPrice')?.addEventListener('input', updatePricePreview);
    document.getElementById('inputSalePrice')?.addEventListener('input', updatePricePreview);

    // Toggle tiện nghi và sync inputs vào CSDL (AmenityIds & Features)
    function toggleAmenity(btn) {
        btn.classList.toggle('active');
        const amenityId = btn.getAttribute('data-id');
        const amenityName = btn.getAttribute('data-name');
        const hiddenContainer = document.getElementById('hiddenAmenityInputs');

        let idInput = amenityId ? document.getElementById('amenityIdInput_' + amenityId) : null;
        let featInput = document.getElementById('featureInput_' + (amenityId || amenityName));

        if (btn.classList.contains('active')) {
            // 1. Đồng bộ AmenityId để lưu vào bảng CarAmenities
            if (amenityId) {
                if (!idInput) {
                    idInput = document.createElement('input');
                    idInput.type = 'checkbox';
                    idInput.name = 'AmenityIds';
                    idInput.value = amenityId;
                    idInput.checked = true;
                    idInput.className = 'd-none';
                    idInput.id = 'amenityIdInput_' + amenityId;
                    hiddenContainer.appendChild(idInput);
                } else {
                    idInput.checked = true;
                }
            }

            // 2. Đồng bộ tên tiện nghi vào chuỗi text Details/Descriptions
            if (!featInput) {
                featInput = document.createElement('input');
                featInput.type = 'checkbox';
                featInput.name = 'Features';
                featInput.value = amenityName;
                featInput.checked = true;
                featInput.className = 'd-none';
                featInput.id = 'featureInput_' + (amenityId || amenityName);
                hiddenContainer.appendChild(featInput);
            } else {
                featInput.checked = true;
            }
        } else {
            if (idInput) idInput.checked = false;
            if (featInput) featInput.checked = false;
        }
    }

    // Preview image file
    function previewImageFile(input, targetImgId, placeholderId) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const target = document.getElementById(targetImgId);
                const placeholder = document.getElementById(placeholderId);
                if (target) {
                    target.src = e.target.result;
                    target.classList.remove('d-none');
                }
                if (placeholder) {
                    placeholder.classList.add('d-none');
                }
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Cập nhật tóm tắt ở bước 6
    function updateSummaryPreview() {
        const carName = document.getElementById('inputCarName')?.value || 'Tên xe';
        const brand = document.getElementById('selectCarBrand')?.value || '';
        const year = document.getElementById('selectModelYear')?.value || '2024';
        const color = document.getElementById('inputColor')?.value || '';
        const plate = document.getElementById('inputLicensePlate')?.value || 'Biển số';
        const seat = document.getElementById('selectSeat')?.value || '5';
        const trans = document.getElementById('selectTransmission')?.value || 'Tự động';
        const fuel = document.getElementById('selectFuel')?.value || 'Xăng';
        const consumption = document.getElementById('inputConsumption')?.value || '';
        const price = parseInt(document.getElementById('inputPrice')?.value) || 0;
        const sale = parseInt(document.getElementById('inputSalePrice')?.value) || 0;
        const limitKm = document.getElementById('inputMileageLimit')?.value || '300';
        const overKm = parseInt(document.getElementById('inputExtraFeePerKm')?.value) || 0;
        const delivery = document.getElementById('checkDelivery')?.checked;
        const deliveryFee = parseInt(document.getElementById('inputDeliveryFee')?.value) || 0;

        // Ảnh đại diện preview
        const avatarPreview = document.getElementById('previewAvatarImg')?.src;
        if (avatarPreview && !document.getElementById('previewAvatarImg').classList.contains('d-none')) {
            document.getElementById('summaryPreviewImg').src = avatarPreview;
        }

        document.getElementById('summaryCarName').innerText = carName;
        document.getElementById('summarySubInfo').innerText = `${brand} · Năm ${year} · Màu ${color}`;
        document.getElementById('summaryPlate').innerText = plate.toUpperCase();
        document.getElementById('summaryTechSpecs').innerText = `${seat} chỗ · ${trans} · ${fuel} ${consumption ? '· ' + consumption : ''}`;

        if (sale > 0 && sale < price) {
            document.getElementById('summaryPriceText').innerText = `${sale.toLocaleString('vi-VN')} đ / ngày (Gốc: ${price.toLocaleString('vi-VN')} đ)`;
        } else {
            document.getElementById('summaryPriceText').innerText = `${price.toLocaleString('vi-VN')} đ / ngày`;
        }

        document.getElementById('summaryRuleText').innerText = `Giới hạn ${limitKm} km/ngày · Vượt ${overKm.toLocaleString('vi-VN')} đ/km · ${delivery ? `Giao xe ${deliveryFee.toLocaleString('vi-VN')} đ` : 'Không giao xe'}`;

        // Lấy tiện nghi đang active
        const activeAmenities = [];
        document.querySelectorAll('.amenity-toggle-btn.active').forEach(b => {
            activeAmenities.push(b.getAttribute('data-name'));
        });
        document.getElementById('summaryAmenitiesText').innerText = 'Tiện nghi: ' + (activeAmenities.length > 0 ? activeAmenities.join(', ') : 'Chưa chọn tiện nghi');
    }

    document.addEventListener('DOMContentLoaded', function() {
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
        updatePricePreview();
    });
</script>
