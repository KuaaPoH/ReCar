@using CarRental.Utilities;
@inject CarRental.Models.DbRenalCarContext _db;
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var adminName = Function.GetUserName(Context.Session);
    if (string.IsNullOrEmpty(adminName))
    {
        adminName = "Administrator";
    }
    var adminInitials = adminName.Length >= 2 ? adminName.Substring(0, 2).ToUpper() : "AD";
    
    // Đếm số lượng xe đang chờ duyệt thực tế từ CSDL
    int pendingCarsCount = 0;
    try {
        pendingCarsCount = _db.Cars.Count(c => c.CarStatus == "Chờ duyệt");
    } catch { }

    // Breadcrumb text mapping
    string pageTitle = ViewData["Title"]?.ToString() ?? "Tổng quan";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Quản trị viên") | ReCar - Admin Portal</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Chart.js & SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        :root {
            --recar-navy: #0f172a;
            --recar-navy-hover: #1e293b;
            --recar-navy-border: #334155;
            --recar-primary: #0284c7;
            --recar-primary-glow: #38bdf8;
            --recar-primary-hover: #0369a1;
            --recar-bg: #f8fafc;
            --recar-border: #e2e8f0;
            --recar-text-main: #0f172a;
            --recar-text-muted: #64748b;
            --recar-card-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px -1px rgba(0, 0, 0, 0.05);
            --recar-font-mono: 'JetBrains Mono', monospace;
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: var(--recar-bg);
            color: var(--recar-text-main);
            margin: 0;
            padding: 0;
        }

        /* Sidebar Styling */
        .recar-admin-sidebar {
            background-color: var(--recar-navy);
            color: #f8fafc;
            width: 260px;
            min-height: 100vh;
            position: sticky;
            top: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.5rem 1rem;
            z-index: 1030;
            transition: all 0.3s ease;
        }

        .recar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 0.5rem 1.25rem 0.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 1.25rem;
        }

        .recar-brand-icon {
            width: 38px;
            height: 38px;
            background: var(--recar-primary);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.25rem;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
        }

        .recar-nav-pills .nav-link {
            color: #94a3b8;
            border-radius: 8px;
            padding: 0.65rem 0.9rem;
            font-weight: 500;
            font-size: 0.88rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 4px;
            transition: all 0.2s ease;
            position: relative;
        }

        .recar-nav-pills .nav-link:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.06);
        }

        .recar-nav-pills .nav-link.active {
            color: #ffffff;
            background-color: var(--recar-navy-hover);
            font-weight: 600;
        }

        .recar-nav-pills .nav-link.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 6px;
            bottom: 6px;
            width: 3px;
            background-color: var(--recar-primary-glow);
            border-radius: 0 3px 3px 0;
        }

        .recar-nav-pills .nav-link.active i {
            color: var(--recar-primary-glow);
        }

        /* Topbar Header */
        .recar-topbar {
            background-color: #ffffff;
            border-bottom: 1px solid var(--recar-border);
            height: 68px;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .recar-search-input {
            background-color: #f1f5f9;
            border: 1px solid transparent;
            border-radius: 10px;
            padding: 0.45rem 1rem 0.45rem 2.4rem;
            font-size: 0.875rem;
            width: 280px;
            transition: all 0.2s ease;
        }

        .recar-search-input:focus {
            background-color: #ffffff;
            border-color: var(--recar-primary);
            box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.12);
            outline: none;
            width: 320px;
        }

        /* Cards & Panels */
        .recar-panel {
            background: #ffffff;
            border: 1px solid var(--recar-border);
            border-radius: 14px;
            box-shadow: var(--recar-card-shadow);
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .recar-panel-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--recar-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .recar-stat-card {
            background: #ffffff;
            border: 1px solid var(--recar-border);
            border-radius: 14px;
            padding: 1.25rem;
            box-shadow: var(--recar-card-shadow);
            height: 100%;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .recar-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
        }

        /* Status Badges */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 0.76rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .status-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: currentColor;
        }

        .badge-ready, .badge-active, .badge-paid, .badge-settled {
            background-color: #dcfce7;
            color: #166534;
        }

        .badge-rented, .badge-deposited, .badge-processing {
            background-color: #e0f2fe;
            color: #0369a1;
        }

        .badge-maintenance, .badge-pending, .badge-warning {
            background-color: #ffedd5;
            color: #c2410c;
        }

        .badge-danger, .badge-cancelled, .badge-rejected, .badge-locked {
            background-color: #fee2e2;
            color: #991b1b;
        }

        .badge-neutral, .badge-draft {
            background-color: #f1f5f9;
            color: #475569;
        }

        /* Table Styling */
        .recar-table th {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            background-color: #f8fafc;
            border-bottom: 1px solid var(--recar-border);
            padding: 0.75rem 1rem;
            font-weight: 600;
        }

        .recar-table td {
            padding: 0.85rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid var(--recar-border);
            font-size: 0.875rem;
        }

        .recar-table tr:hover td {
            background-color: #f8fafc;
        }

        .font-mono-plate {
            font-family: var(--recar-font-mono);
            font-weight: 600;
            background-color: #f1f5f9;
            padding: 3px 7px;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
            color: #1e293b;
            font-size: 0.8rem;
        }

        @@media (max-width: 991.98px) {
            .recar-admin-sidebar {
                position: fixed;
                left: -260px;
                top: 0;
                bottom: 0;
            }
            .recar-admin-sidebar.show {
                left: 0;
            }
            .recar-main-content {
                margin-left: 0 !important;
            }
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar Navigation -->
        <aside class="recar-admin-sidebar" id="adminSidebar">
            <div>
                <!-- Brand Header -->
                <div class="recar-brand">
                    <div class="recar-brand-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5 fw-bold text-white tracking-tight">ReCar</span>
                            <span class="badge" style="background-color: rgba(56, 189, 248, 0.2); color: #38bdf8; font-size: 0.65rem; letter-spacing: 0.1em;">ADMIN</span>
                        </div>
                        <div class="text-white-50 small" style="font-size: 0.75rem;">Cổng quản trị toàn sàn</div>
                    </div>
                </div>

                <div class="px-2 mb-3">
                    <span class="d-inline-flex align-items-center gap-1 px-2.5 py-1 rounded-pill small" style="background-color: var(--recar-navy-hover); color: #94a3b8; font-size: 0.75rem;">
                        <i class="bi bi-person-badge text-info"></i> Quyền: <strong>Quản trị viên</strong>
                    </span>
                </div>

                <!-- Navigation Links -->
                <nav class="nav recar-nav-pills flex-column">
                    <!-- 1. Tổng quan -->
                    <a class="nav-link @(currentController == "Home" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <span class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-grid-fill"></i> Tổng quan
                        </span>
                    </a>

                    <!-- 2. Phê duyệt xe (kèm Badge đếm xe chờ duyệt) -->
                    <a class="nav-link @(currentController == "Cars" && currentAction == "Pending" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Cars" asp-action="Pending">
                        <span class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-shield-check"></i> Phê duyệt xe
                        </span>
                        @if (pendingCarsCount > 0)
                        {
                            <span class="badge bg-warning text-dark fw-bold rounded-pill" style="font-size: 0.72rem;">@pendingCarsCount</span>
                        }
                    </a>

                    <!-- 3. Quản lý đội xe -->
                    <a class="nav-link @(currentController == "Cars" && currentAction == "Index" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Cars" asp-action="Index">
                        <span class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-car-front-fill"></i> Quản lý đội xe
                        </span>
                    </a>

                    <!-- 4. Đơn thuê xe -->
                    <a class="nav-link @(currentController == "Orders" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Orders" asp-action="Index">
                        <span class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-clipboard-check-fill"></i> Đơn thuê xe
                        </span>
                    </a>

                    <!-- 5. Tài chính & đối soát -->
                    <a class="nav-link @(currentController == "Finance" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Finance" asp-action="Index">
                        <span class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-wallet2"></i> Tài chính & đối soát
                        </span>
                    </a>

                    <!-- 6. Người dùng & đối tác -->
                    <a class="nav-link @(currentController == "UserManagement" || currentController == "Customer" ? "active" : "")" 
                       asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                        <span class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-people-fill"></i> Người dùng & đối tác
                        </span>
                    </a>

                    <!-- 7. Bài viết & tin tức -->
                    <a class="nav-link @(currentController == "Blogs" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Blogs" asp-action="Index">
                        <span class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-newspaper"></i> Bài viết & tin tức
                        </span>
                    </a>

                    <!-- 8. Cấu hình hệ thống -->
                    <a class="nav-link @(currentController == "Settings" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Settings" asp-action="Index">
                        <span class="d-flex align-items-center gap-2.5">
                            <i class="bi bi-gear-fill"></i> Cấu hình hệ thống
                        </span>
                    </a>
                </nav>
            </div>

            <!-- Bottom Actions -->
            <div class="pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                <a href="/" target="_blank" class="nav-link recar-nav-pills text-white-50 d-flex align-items-center gap-2 py-2 px-2 rounded mb-1 text-decoration-none">
                    <i class="bi bi-arrow-left-circle text-info"></i>
                    <span class="small">Quay về sàn ReCar</span>
                </a>
                <a asp-area="Admin" asp-controller="Home" asp-action="Logout" class="nav-link recar-nav-pills text-danger d-flex align-items-center gap-2 py-2 px-2 rounded text-decoration-none">
                    <i class="bi bi-box-arrow-left"></i>
                    <span class="small fw-semibold">Đăng xuất</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="flex-grow-1 d-flex flex-column recar-main-content" style="min-width: 0;">
            <!-- Topbar Header -->
            <header class="recar-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-light d-lg-none" type="button" onclick="toggleSidebar()">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <!-- Breadcrumbs -->
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 small">
                            <li class="breadcrumb-item text-muted">Admin</li>
                            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">@pageTitle</li>
                        </ol>
                    </nav>
                </div>

                <!-- Right Tools: Search, Notification, Profile -->
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative d-none d-md-block">
                        <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 9px; font-size: 0.85rem;"></i>
                        <input type="text" class="recar-search-input" placeholder="Tìm kiếm nhanh đơn, biển số, xe..." />
                    </div>

                    <!-- Notification Bell Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light position-relative rounded-circle p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell text-secondary"></i>
                            @if (pendingCarsCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                    <span class="visually-hidden">Thông báo mới</span>
                                </span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm p-2" style="width: 300px; border-radius: 12px;">
                            <li><h6 class="dropdown-header fw-bold text-dark">Thông báo hệ thống</h6></li>
                            @if (pendingCarsCount > 0)
                            {
                                <li>
                                    <a class="dropdown-item rounded py-2 small d-flex gap-2" asp-area="Admin" asp-controller="Cars" asp-action="Pending">
                                        <i class="bi bi-shield-exclamation text-warning fs-5"></i>
                                        <div>
                                            <p class="mb-0 fw-semibold">Có @pendingCarsCount xe đang chờ phê duyệt</p>
                                            <span class="text-muted" style="font-size: 0.7rem;">Vui lòng kiểm tra hồ sơ đăng kiểm</span>
                                        </div>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="text-center py-3 text-muted small">Không có thông báo mới</li>
                            }
                        </ul>
                    </div>

                    <!-- Profile Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light d-flex align-items-center gap-2 rounded-pill px-2.5 py-1.5" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                @adminInitials
                            </div>
                            <div class="text-start d-none d-sm-block">
                                <div class="fw-bold small text-dark leading-tight">@adminName</div>
                                <span class="badge" style="background-color: #e0f2fe; color: #0369a1; font-size: 0.65rem;">Super Admin</span>
                            </div>
                            <i class="bi bi-chevron-down text-muted small"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm p-2 mt-1" style="border-radius: 12px; min-width: 200px;">
                            <li class="px-2 py-1.5 border-bottom mb-1">
                                <div class="fw-bold small">@adminName</div>
                                <div class="text-muted" style="font-size: 0.72rem;">admin@recar.vn</div>
                            </li>
                            <li>
                                <a class="dropdown-item rounded small py-2" asp-area="Admin" asp-controller="Account" asp-action="Edit">
                                    <i class="bi bi-person me-2"></i> Hồ sơ cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded small py-2" asp-area="Admin" asp-controller="Settings" asp-action="Index">
                                    <i class="bi bi-gear me-2"></i> Cấu hình sàn
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item rounded small py-2 text-danger fw-semibold" asp-area="Admin" asp-controller="Home" asp-action="Logout">
                                    <i class="bi bi-box-arrow-left me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content Body -->
            <main class="flex-grow-1 p-3 p-md-4">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
                © 2026 <strong>ReCar Platform</strong> — Hệ thống quản trị nền tảng chia sẻ & cho thuê ô tô trực tuyến. Chuẩn đồ án tốt nghiệp.
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/admin/assets/vendors/jquery/jquery.min.js"></script>
    <script src="~/admin/assets/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('show');
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>