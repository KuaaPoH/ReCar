@{
    ViewData["Title"] = "Liên hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Banner -->
<div class="page-title-banner" style="background-color: #f8fafc; border-bottom: 1px solid var(--recar-border); padding: 36px 0;">
    <div class="container" style="max-width: 1280px;">
        <h1 class="fs-2 fw-bold m-0" style="color: var(--recar-navy);">Liên hệ</h1>
        <p class="text-muted small m-0 mt-2" style="font-size: 15px;">
            Chúng tôi luôn sẵn sàng hỗ trợ bạn trong mọi hành trình thuê xe.
        </p>
    </div>
</div>

<div class="container py-5" style="max-width: 1100px;">
    <div class="row g-5">
        <!-- Cột thông tin liên hệ -->
        <div class="col-lg-5">
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color: var(--recar-secondary);">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-white shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="bi bi-telephone fs-5" style="color: var(--recar-primary);"></i>
                    </div>
                    <div>
                        <p class="small text-muted m-0" style="font-size: 12px;">Hotline hỗ trợ 24/7</p>
                        <h6 class="fw-bold m-0" style="color: var(--recar-navy);">1900 6868</h6>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color: var(--recar-secondary);">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-white shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="bi bi-envelope fs-5" style="color: var(--recar-primary);"></i>
                    </div>
                    <div>
                        <p class="small text-muted m-0" style="font-size: 12px;">Email phản hồi</p>
                        <h6 class="fw-bold m-0" style="color: var(--recar-navy);">hotro@recar.example</h6>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color: var(--recar-secondary);">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-white shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="bi bi-geo-alt fs-5" style="color: var(--recar-primary);"></i>
                    </div>
                    <div>
                        <p class="small text-muted m-0" style="font-size: 12px;">Văn phòng chính</p>
                        <h6 class="fw-bold m-0" style="color: var(--recar-navy);">Cầu Giấy, Hà Nội & Quận 1, TP. Hồ Chí Minh</h6>
                    </div>
                </div>

                <div class="p-3 rounded-3 border bg-light text-muted small mt-2" style="font-size: 13px;">
                    <i class="bi bi-info-circle text-primary me-1"></i> Đội ngũ chăm sóc khách hàng ReCar tiếp nhận và hỗ trợ xử lý mọi thắc mắc hoặc sự cố 24/7.
                </div>
            </div>
        </div>

        <!-- Cột Form liên hệ -->
        <div class="col-lg-7">
            <div class="p-4 p-md-5 rounded-4 border bg-white shadow-sm">
                <h4 class="fw-bold mb-3" style="color: var(--recar-navy);">Gửi tin nhắn cho ReCar</h4>
                <p class="text-muted small mb-4">Hãy để lại thông tin, chúng tôi sẽ phản hồi trong vòng 15 phút.</p>

                <form id="contactForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Họ và tên *</label>
                            <input type="text" class="form-control rounded-3 py-2" id="contactName" placeholder="Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Số điện thoại *</label>
                            <input type="tel" class="form-control rounded-3 py-2" id="contactPhone" placeholder="0912 345 678" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Email *</label>
                            <input type="email" class="form-control rounded-3 py-2" id="contactEmail" placeholder="example@gmail.com" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Nội dung liên hệ *</label>
                            <textarea class="form-control rounded-3" id="contactMessage" rows="4" placeholder="Nhập câu hỏi hoặc nội dung bạn cần hỗ trợ..." required></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn text-white px-5 py-2 fw-semibold rounded-3" style="background-color: var(--recar-primary);">
                                Gửi liên hệ
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $('#contactForm').on('submit', function (e) {
                e.preventDefault();

                const name = $('#contactName').val();
                const phone = $('#contactPhone').val();
                const email = $('#contactEmail').val();
                const message = $('#contactMessage').val();

                $.ajax({
                    url: '/Contact/Create',
                    type: 'POST',
                    data: {
                        name: name,
                        phone: phone,
                        email: email,
                        message: message
                    },
                    success: function (res) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Gửi liên hệ thành công!',
                            text: 'Cảm ơn bạn đã liên hệ ReCar. Chúng tôi sẽ phản hồi sớm nhất.',
                            confirmButtonColor: '#0284c7'
                        });
                        $('#contactForm')[0].reset();
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'success',
                            title: 'Gửi liên hệ thành công!',
                            text: 'Cảm ơn bạn đã liên hệ ReCar. Chúng tôi sẽ phản hồi sớm nhất.',
                            confirmButtonColor: '#0284c7'
                        });
                        $('#contactForm')[0].reset();
                    }
                });
            });
        });
    </script>
}