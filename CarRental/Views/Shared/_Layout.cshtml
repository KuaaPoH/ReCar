@using CarRental.Utilities
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>ReCar – Hệ thống cho thuê xe ô tô trực tuyến</title>
    <meta name="description" content="ReCar – nền tảng cho thuê ô tô kết nối khách thuê và chủ xe.">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/favicon.ico">

    <!-- CSS Vendor & Bootstrap -->
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/assets/css/plugins/swiper-bundle.min.css">

    <!-- ReCar Core Design System -->
    <link rel="stylesheet" href="~/assets/css/recar.css" asp-append-version="true">

    @RenderSection("style", required: false)
</head>
<body>

    <!-- ReCar Header (Pixel-perfect Ảnh 1) -->
    <header class="recar-navbar">
        <div class="recar-navbar-container">
            <!-- Logo -->
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                <span style="width: 36px; height: 36px; border-radius: 8px; background-color: var(--recar-primary); color: #fff; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-car-front-fill fs-5"></i>
                </span>
                <span style="font-size: 20px; font-weight: 800; color: var(--recar-navy); letter-spacing: -0.5px;">
                    Re<span style="color: var(--recar-primary);">Car</span>
                </span>
            </a>

            <!-- Navigation Links (Pill Style) -->
            @{
                var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
            }
            <nav class="d-none d-md-flex align-items-center gap-1">
                <a href="/" class="recar-nav-pill @(currentCtrl == "Home" && currentAct == "Index" ? "active" : "")">Trang chủ</a>
                <a href="/Product" class="recar-nav-pill @(currentCtrl == "Product" && currentAct == "Index" ? "active" : "")">Thuê xe</a>
                <a href="/Blog" class="recar-nav-pill @(currentCtrl == "Blog" ? "active" : "")">Cẩm nang</a>
                <a href="/News" class="recar-nav-pill @(currentCtrl == "News" ? "active" : "")">Tin tức</a>
                <a href="/Contact" class="recar-nav-pill @(currentCtrl == "Contact" ? "active" : "")">Liên hệ</a>
            </nav>

            <!-- Navigation Actions: Khi chưa login hiện Đăng nhập/Đăng ký; sau khi login hiện avatar & tên user -->
            @{
                bool isLogged = Function.IsLogin(Context.Session);
                string userName = Function.GetUserName(Context.Session);
                if (string.IsNullOrEmpty(userName) && isLogged)
                {
                    userName = Function._UserName;
                }

                string initials = "U";
                if (!string.IsNullOrEmpty(userName))
                {
                    var words = userName.Trim().Split(' ');
                    if (words.Length >= 2)
                    {
                        initials = $"{words[0][0]}{words[words.Length - 1][0]}".ToUpper();
                    }
                    else if (words.Length == 1 && words[0].Length >= 2)
                    {
                        initials = words[0].Substring(0, 2).ToUpper();
                    }
                    else if (words.Length == 1 && words[0].Length == 1)
                    {
                        initials = words[0].ToUpper();
                    }
                }
            }

            @if (isLogged)
            {
                <div class="d-flex align-items-center gap-2">
                    <!-- Icon Chat / Tin nhắn với Chủ xe -->
                    <div class="dropdown">
                        <button type="button" aria-label="Tin nhắn" class="btn btn-link position-relative p-2 text-decoration-none" id="btnHeaderChat" data-bs-toggle="dropdown" aria-expanded="false" style="color: var(--recar-navy);">
                            <i class="bi bi-chat-dots fs-5"></i>
                            <span id="chatNotificationDot" class="position-absolute bg-primary rounded-circle" style="top: 8px; right: 8px; width: 8px; height: 8px;"></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end recar-chat-dropdown p-2" aria-labelledby="btnHeaderChat">
                            <div class="d-flex justify-content-between align-items-center px-2 py-2 border-bottom mb-1">
                                <span class="fw-bold small text-dark"><i class="bi bi-chat-dots-fill text-primary me-1"></i> Tin nhắn trao đổi</span>
                                <span class="badge bg-light text-primary border" style="font-size: 11px;">Hoạt động</span>
                            </div>
                            <div id="recentChatList">
                                <div class="chat-item" onclick="openChatBox('Trần Quốc Bảo', 'Chào bạn! VinFast VF 5 Plus dự kiến về vào sáng mai nhé.', 1, 6, 'VinFast VF 5 Plus')">
                                    <div class="chat-avatar">QB</div>
                                    <div class="flex-grow-1 overflow-hidden" style="font-size: 13px;">
                                        <div class="d-flex justify-content-between">
                                            <strong class="text-truncate">Trần Quốc Bảo (VF 5)</strong>
                                            <span class="text-muted" style="font-size: 11px;">Mới</span>
                                        </div>
                                        <p class="text-muted text-truncate m-0" style="font-size: 12px;">Chào bạn! Xe dự kiến về sáng mai...</p>
                                    </div>
                                </div>
                                <div class="chat-item" onclick="openChatBox('Nguyễn Minh Anh', 'Chào bạn! Toyota Vios G 2023 luôn sẵn sàng giao nhận.', 2, 8, 'Toyota Vios G 2023')">
                                    <div class="chat-avatar">MA</div>
                                    <div class="flex-grow-1 overflow-hidden" style="font-size: 13px;">
                                        <div class="d-flex justify-content-between">
                                            <strong class="text-truncate">Nguyễn Minh Anh (Vios)</strong>
                                            <span class="text-muted" style="font-size: 11px;">10:30</span>
                                        </div>
                                        <p class="text-muted text-truncate m-0" style="font-size: 12px;">Toyota Vios G 2023 luôn sẵn sàng...</p>
                                    </div>
                                </div>
                                <div class="chat-item" onclick="openChatBox('Lê Thu Hà', 'Mazda 3 Luxury bên em đã sẵn sàng phục vụ anh/chị.', 4, 20, 'Mazda 3 Luxury')">
                                    <div class="chat-avatar">TH</div>
                                    <div class="flex-grow-1 overflow-hidden" style="font-size: 13px;">
                                        <div class="d-flex justify-content-between">
                                            <strong class="text-truncate">Lê Thu Hà (Mazda 3)</strong>
                                            <span class="text-muted" style="font-size: 11px;">Hôm qua</span>
                                        </div>
                                        <p class="text-muted text-truncate m-0" style="font-size: 12px;">Mazda 3 Luxury bên em đã sẵn sàng...</p>
                                    </div>
                                </div>
                            </div>
                            <div class="border-top pt-2 mt-1 text-center">
                                <button type="button" class="btn btn-link btn-sm text-decoration-none small p-0" onclick="openChatBox('CSKH ReCar Support', 'Xin chào! Đội ngũ hỗ trợ ReCar có thể giúp gì cho chuyến đi của bạn?')">
                                    <i class="bi bi-headset me-1"></i> Trò chuyện với Hỗ trợ viên ReCar
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Chuông thông báo -->
                    <button type="button" aria-label="Thông báo" class="btn btn-link position-relative p-2 text-decoration-none" style="color: var(--recar-navy);">
                        <i class="bi bi-bell fs-5"></i>
                        <span class="position-absolute bg-danger rounded-circle" style="top: 8px; right: 8px; width: 8px; height: 8px;"></span>
                    </button>

                    <!-- User Dropdown Menu -->
                    <div class="dropdown">
                        <button class="user-pill-btn dropdown-toggle" type="button" id="recarUserMenu" data-bs-toggle="dropdown" aria-expanded="false" style="border: 1px solid #e2e8f0;">
                            <span class="user-avatar-circle">@initials</span>
                            <span class="text-sm fw-medium d-none d-sm-inline" style="font-size: 14px; font-weight: 500;">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border p-2 mt-2" aria-labelledby="recarUserMenu" style="border-radius: 12px; min-width: 220px; z-index: 1060;">
                            <li>
                                <div class="px-3 py-2 border-bottom mb-1">
                                    <p class="small fw-bold text-dark m-0">@userName</p>
                                    <p class="text-muted m-0" style="font-size: 12px;">@Function.GetEmail(Context.Session)</p>
                                </div>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium" href="/Accounts">
                                    <i class="bi bi-person me-2"></i> Tài khoản của tôi
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium" href="/Accounts?tab=orders">
                                    <i class="bi bi-file-earmark-text me-2"></i> Đơn thuê xe
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium" href="/CarOwner/Home/Index">
                                    <i class="bi bi-speedometer2 me-2"></i> Trang chủ xe
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium" href="/Admin/Home/Index">
                                    <i class="bi bi-shield-check me-2"></i> Quản trị
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium text-danger" href="/Accounts/Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2">
                    <a href="/Login" class="btn btn-sm rounded-pill px-3 py-1 fw-medium" style="border: 1px solid #cbd5e1; color: var(--recar-navy); background: #ffffff; font-size: 13px;">
                        Đăng nhập
                    </a>
                    <a href="/Register" class="btn btn-sm rounded-pill px-3 py-1 fw-medium text-white" style="background-color: var(--recar-primary); border: 1px solid var(--recar-primary); font-size: 13px;">
                        Đăng ký
                    </a>
                </div>
            }
        </div>
    </header>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- ReCar Footer (Pixel-perfect) -->
    <footer style="margin-top: 96px; background-color: var(--recar-navy); color: #f8fafc;">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span style="width: 36px; height: 36px; border-radius: 8px; background-color: var(--recar-primary); color: #fff; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-car-front-fill fs-5"></i>
                        </span>
                        <span style="font-size: 20px; font-weight: 800; color: #ffffff;">
                            Re<span style="color: var(--recar-primary);">Car</span>
                        </span>
                    </div>
                    <p class="small opacity-75 mb-0">Chuyến đi của bạn, lựa chọn của bạn. Nền tảng kết nối khách thuê và chủ xe hàng đầu Việt Nam.</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-white">Khám phá</h6>
                    <ul class="list-unstyled small opacity-75 mb-0 d-flex flex-column gap-2">
                        <li><a href="/Product" class="text-white text-decoration-none">Thuê xe tự lái</a></li>
                        <li><a href="/Blog" class="text-white text-decoration-none">Cẩm nang du lịch</a></li>
                        <li><a href="/News" class="text-white text-decoration-none">Tin tức thị trường</a></li>
                        <li><a href="/Contact" class="text-white text-decoration-none">Liên hệ hỗ trợ</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-white">Chính sách</h6>
                    <ul class="list-unstyled small opacity-75 mb-0 d-flex flex-column gap-2">
                        <li><a href="/Home/Privacy" class="text-white text-decoration-none">Chính sách thuê xe</a></li>
                        <li><a href="/Home/Privacy" class="text-white text-decoration-none">Điều khoản sử dụng</a></li>
                        <li><a href="/Home/Privacy" class="text-white text-decoration-none">Chính sách bảo mật</a></li>
                        <li><a href="/Contact" class="text-white text-decoration-none">Hỗ trợ khách hàng</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-white">
                        Liên hệ <span class="badge bg-warning text-dark ms-1 small" style="font-size: 10px;">Dữ liệu mẫu</span>
                    </h6>
                    <div class="small opacity-75 d-flex flex-column gap-2">
                        <div>Hotline: 1900 6868</div>
                        <div>Email: hotro@recar.example</div>
                        <div>Hà Nội & TP. Hồ Chí Minh</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="border-top border-secondary py-3 text-center small opacity-60" style="border-color: rgba(255,255,255,0.1) !important;">
            © 2026 ReCar. Nền tảng cho thuê ô tô trực tuyến (Đồ án tốt nghiệp).
        </div>
    </footer>

    <!-- Floating Chat Window (Trao đổi trực tiếp với Chủ xe) -->
    <div class="recar-chat-window" id="recarChatWindow">
        <div class="chat-header">
            <div class="d-flex align-items-center gap-2">
                <span class="rounded-circle bg-success" style="width: 8px; height: 8px;"></span>
                <span class="fw-bold small text-truncate" id="chatPartnerName" style="max-width: 220px;">Đối tác Chủ xe ReCar</span>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-link text-white p-0 me-1" onclick="minimizeChat()"><i class="bi bi-dash-lg"></i></button>
                <button type="button" class="btn btn-sm btn-link text-white p-0" onclick="closeChat()"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div class="chat-body" id="chatMessages">
            <div class="chat-bubble from-owner" id="chatFirstMessage">
                Chào bạn! Tôi là đối tác chủ xe trên ReCar. Bạn có thắc mắc gì về thủ tục nhận xe, thời gian hay cung đường di chuyển không?
            </div>
        </div>
        <div id="chatTypingIndicator" style="display: none; padding: 5px 16px; font-size: 11px; color: #64748b; font-style: italic; background: #f8fafc; border-top: 1px dashed #e2e8f0;">
            <span class="spinner-grow spinner-grow-sm text-primary me-1" style="width: 8px; height: 8px;" role="status"></span>
            <span id="chatTypingText">Chủ xe đang soạn tin...</span>
        </div>
        <div class="chat-footer">
            <input type="text" class="form-control form-control-sm rounded-pill border" id="chatInputText" placeholder="Nhập tin nhắn..." autocomplete="off">
            <button class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" id="btnSendChat" style="width: 32px; height: 32px; flex-shrink: 0;">
                <i class="bi bi-send-fill" style="font-size: 12px;"></i>
            </button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script src="~/assets/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/plugins/swiper-bundle.min.js"></script>
    <script src="~/assets/js/vendor/signalr.min.js"></script>
    <script>
        // Thiết lập thông tin người dùng hiện tại phục vụ kết nối SignalR
        window.RECAR_CURRENT_USER = {
            accountId: @(Function.GetAccountId(Context.Session) > 0 ? Function.GetAccountId(Context.Session).ToString() : "null"),
            role: '@(Function.IsAdmin(Context.Session) ? "Admin" : (Function.GetCarOwnerAccountId(Context.Session) > 0 ? "CarOwner" : "Customer"))',
            userName: '@(Function.GetUserName(Context.Session) ?? "Khách hàng")'
        };
    </script>
    <script src="~/assets/js/recar-realtime.js"></script>
    
    <script>
        var currentChatCarId = null;
        var currentChatOwnerId = null;
        var currentChatCarName = null;
        var currentChatPartnerName = 'Đối tác Chủ xe ReCar';

        function openChatBox(partnerName, greeting, carId, ownerId, carName) {
            currentChatPartnerName = partnerName || 'Đối tác Chủ xe ReCar';
            currentChatCarId = carId || null;
            currentChatOwnerId = ownerId || null;
            currentChatCarName = carName || null;

            $('#chatPartnerName').text(currentChatPartnerName);
            $('#recarChatWindow').addClass('open');
            $('#chatMessages').html('<div class="text-center py-3 text-muted small"><div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div> Đang tải lịch sử tin nhắn...</div>');

            // Nạp lịch sử tin nhắn từ CSDL
            $.ajax({
                url: '/Chat/GetMessages',
                type: 'GET',
                data: { carId: currentChatCarId, ownerId: currentChatOwnerId },
                success: function(res) {
                    $('#chatMessages').empty();
                    if (res && res.success && res.messages && res.messages.length > 0) {
                        res.messages.forEach(function(m) {
                            var bubbleClass = m.isFromOwner ? 'chat-bubble from-owner' : 'chat-bubble from-user';
                            var bubble = $('<div class="' + bubbleClass + '"></div>');
                            bubble.append($('<div class="fw-bold mb-1" style="font-size: 11px; opacity: 0.85;"></div>').text(m.senderName + ' · ' + m.sentAt));
                            bubble.append($('<div></div>').text(m.messageText));
                            $('#chatMessages').append(bubble);
                        });
                    } else {
                        var defaultMsg = greeting || ('Chào bạn! Cảm ơn bạn đã quan tâm đến phương tiện của chúng tôi. Bạn có thắc mắc gì về thủ tục hay lịch trình cần hỗ trợ không?');
                        var bubble = $('<div class="chat-bubble from-owner"></div>');
                        bubble.append($('<div class="fw-bold mb-1" style="font-size: 11px; opacity: 0.85;"></div>').text(currentChatPartnerName));
                        bubble.append($('<div></div>').text(defaultMsg));
                        $('#chatMessages').append(bubble);
                    }
                    $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
                },
                error: function() {
                    $('#chatMessages').html('<div class="chat-bubble from-owner"><div class="fw-bold mb-1" style="font-size: 11px;">' + currentChatPartnerName + '</div>' + (greeting || 'Chào bạn! Rất vui được hỗ trợ bạn.') + '</div>');
                }
            });

            setTimeout(function() { $('#chatInputText').focus(); }, 200);
        }

        function closeChat() {
            $('#recarChatWindow').removeClass('open');
        }

        function minimizeChat() {
            $('#recarChatWindow').toggleClass('open');
        }

        function sendChatMessage() {
            var msg = $('#chatInputText').val().trim();
            if (!msg) return;

            // 1. Hiển thị ngay bong bóng tin nhắn của khách
            var nowStr = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
            var userBubble = $('<div class="chat-bubble from-user"></div>');
            userBubble.append($('<div class="fw-bold mb-1" style="font-size: 11px; opacity: 0.85;">Bạn · ' + nowStr + '</div>'));
            userBubble.append($('<div></div>').text(msg));
            $('#chatMessages').append(userBubble);
            $('#chatInputText').val('');
            $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);

            // 2. Gửi AJAX lên ChatController để lưu CSDL và nhận phản hồi từ chủ xe
            $.ajax({
                url: '/Chat/SendMessage',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    carId: currentChatCarId,
                    ownerId: currentChatOwnerId,
                    carName: currentChatCarName,
                    messageText: msg
                }),
                success: function(res) {
                    if (res && res.success && res.ownerReply) {
                        setTimeout(function() {
                            var reply = res.ownerReply;
                            var ownerBubble = $('<div class="chat-bubble from-owner"></div>');
                            ownerBubble.append($('<div class="fw-bold mb-1" style="font-size: 11px; opacity: 0.85;"></div>').text(reply.senderName + ' · ' + reply.sentAt));
                            ownerBubble.append($('<div></div>').text(reply.messageText));
                            $('#chatMessages').append(ownerBubble);
                            $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
                            loadRecentChats();
                        }, 800);
                    }
                },
                error: function(err) {
                    console.error("Lỗi gửi tin nhắn:", err);
                }
            });
        }

        function loadRecentChats() {
            $.ajax({
                url: '/Chat/GetRecentConversations',
                type: 'GET',
                success: function(res) {
                    if (res && res.success && res.conversations && res.conversations.length > 0) {
                        var container = $('#recentChatList');
                        if (container.length) {
                            container.empty();
                            res.conversations.forEach(function(c) {
                                var initials = c.partnerName ? c.partnerName.substring(0, 2).toUpperCase() : 'CX';
                                var item = $('<div class="chat-item"></div>');
                                item.html('<div class="chat-avatar">' + initials + '</div>' +
                                    '<div class="flex-grow-1 overflow-hidden" style="font-size: 13px;">' +
                                        '<div class="d-flex justify-content-between">' +
                                            '<strong class="text-truncate" style="max-width: 140px;">' + c.partnerName + '</strong>' +
                                            '<span class="text-muted" style="font-size: 11px;">' + c.time + '</span>' +
                                        '</div>' +
                                        '<p class="text-muted text-truncate m-0" style="font-size: 12px;">' + c.lastMessage + '</p>' +
                                    '</div>');
                                item.on('click', function() {
                                    openChatBox(c.partnerName, c.lastMessage, c.carId, c.ownerId, c.title);
                                });
                                container.append(item);
                            });
                        }
                    }
                }
            });
        }

        // --- XỬ LÝ SỰ KIỆN TỪ SIGNALR CHO CỬA SỔ CHAT ---
        window.handleIncomingChatMessage = function(msg) {
            // Kiểm tra xem tin nhắn có thuộc cuộc hội thoại đang mở không
            var isCurrentConversation = false;
            if (currentChatCarId && msg.carId == currentChatCarId) {
                isCurrentConversation = true;
            } else if (currentChatOwnerId && (msg.senderId == currentChatOwnerId || msg.receiverId == currentChatOwnerId)) {
                isCurrentConversation = true;
            }

            if (isCurrentConversation && $('#recarChatWindow').hasClass('open')) {
                // Ẩn typing indicator
                $('#chatTypingIndicator').hide();

                // Tạo bong bóng tin nhắn
                var bubbleClass = msg.isFromOwner ? 'chat-bubble from-owner' : 'chat-bubble from-user';
                var bubble = $('<div class="' + bubbleClass + '"></div>');
                bubble.append($('<div class="fw-bold mb-1" style="font-size: 11px; opacity: 0.85;"></div>').text(msg.senderName + ' · ' + msg.sentAt));
                bubble.append($('<div></div>').text(msg.messageText));
                $('#chatMessages').append(bubble);
                $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
                loadRecentChats();
                return true; // Đã xử lý
            }

            loadRecentChats();
            return false; // Chưa mở khung chat, để realtime.js hiện toast
        };

        window.handleIncomingTyping = function(data) {
            var isCurrent = (currentChatCarId && data.carId == currentChatCarId);
            if (isCurrent && $('#recarChatWindow').hasClass('open')) {
                if (data.isTyping) {
                    $('#chatTypingText').text((data.senderName || 'Đối tác') + ' đang soạn tin...');
                    $('#chatTypingIndicator').stop(true, true).fadeIn(150);
                    $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
                } else {
                    $('#chatTypingIndicator').stop(true, true).fadeOut(150);
                }
            }
        };

        // Gửi trạng thái đang gõ phím khi người dùng nhập vào input
        var typingTimer = null;
        $('#chatInputText').on('input', function() {
            if (!window.recarRealtimeHub || window.recarRealtimeHub.state !== 'Connected') return;

            var myName = (window.RECAR_CURRENT_USER && window.RECAR_CURRENT_USER.userName) || 'Khách hàng';
            window.recarRealtimeHub.invoke('SendTyping', currentChatCarId, currentChatOwnerId, myName, true).catch(function(){});

            clearTimeout(typingTimer);
            typingTimer = setTimeout(function() {
                if (window.recarRealtimeHub && window.recarRealtimeHub.state === 'Connected') {
                    window.recarRealtimeHub.invoke('SendTyping', currentChatCarId, currentChatOwnerId, myName, false).catch(function(){});
                }
            }, 2000);
        });

        $(document).on('click', '.btn-open-owner-chat', function() {
            var owner = $(this).data('owner') || 'Đối tác Chủ xe ReCar';
            var car = $(this).data('car') || 'xe';
            var carId = $(this).data('car-id') || null;
            var ownerId = $(this).data('owner-id') || null;
            openChatBox(owner, 'Chào bạn! Cảm ơn bạn đã quan tâm đến mẫu ' + car + '. Bạn muốn hỏi về lịch trình, địa điểm nhận xe hay hình thức thuê xe ạ?', carId, ownerId, car);
        });

        $('#btnSendChat').on('click', sendChatMessage);
        $('#chatInputText').on('keypress', function(e) {
            if (e.which === 13) {
                sendChatMessage();
            }
        });

        // Tắt chấm đỏ thông báo khi bấm mở dropdown chat
        $('#btnHeaderChat').on('click', function() {
            $('#chatNotificationDot').fadeOut();
        });

        $(document).ready(function() {
            loadRecentChats();
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>