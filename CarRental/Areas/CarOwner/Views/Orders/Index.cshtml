@model IEnumerable<CarRental.Models.CarRentalOrder>
@using CarRental.Utilities
@{
    ViewData["Title"] = "Đơn đặt xe";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";
    var orderStatuses = ViewBag.OrderStatuses as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="space-y-4">
    <!-- Panel Quản lý Đơn đặt xe (Pixel-Perfect Template) -->
    <div class="recar-panel">
        <div class="recar-panel-header flex-wrap gap-2">
            <div>
                <h2 class="recar-panel-title">Danh sách đơn đặt thuê xe</h2>
                <div class="text-muted small mt-1">Theo dõi các đơn khách hàng đặt cọc giữ xe và xác nhận lịch trình bàn giao xe.</div>
            </div>

            <!-- Bộ lọc trạng thái nhanh -->
            <form method="get" class="d-flex align-items-center gap-2">
                <select name="filterStatusId" class="recar-input py-1 px-3 small" style="width: auto;" onchange="this.form.submit()">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var s in orderStatuses)
                    {
                        <option value="@s.Value" selected="@(s.Selected)">@s.Text</option>
                    }
                </select>
            </form>
        </div>

        <div class="table-responsive">
            <table class="recar-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày tạo đơn</th>
                        <th>Đặt cọc (30%)</th>
                        <th>Tổng tiền thuê</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string statusClass = "status-ready";
                            string statusName = item.Status?.StatusDescription ?? "Đã thanh toán cọc";

                            if (item.StatusId == 1 || item.StatusId == 2)
                            {
                                statusClass = "status-pending"; // Chờ duyệt / Chờ thanh toán
                            }
                            else if (item.StatusId == 3)
                            {
                                statusClass = "status-ready"; // Đã thanh toán cọc
                            }
                            else if (item.StatusId == 4)
                            {
                                statusClass = "status-busy"; // Đang thực hiện
                            }
                            else if (item.StatusId == 5)
                            {
                                statusClass = "status-maintenance"; // Đã hủy
                            }

                            <tr>
                                <td>
                                    <span class="fw-bold text-dark font-monospace fs-6">#@item.OrderId</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@(item.Customer?.Name ?? "Khách hàng ReCar")</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-telephone text-secondary me-1"></i>@(item.Customer?.PhoneNumber ?? "0988.xxx.xxx")
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    <i class="bi bi-clock-history me-1"></i>
                                    @(item.OrderDate?.ToString("HH:mm - dd/MM/yyyy") ?? "Gần đây")
                                </td>
                                <td>
                                    <span class="fw-bold text-success">
                                        @((item.Deposit ?? 0).ToString("N0"))đ
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary fs-6">
                                        @((item.Payment ?? 0).ToString("N0"))đ
                                    </span>
                                </td>
                                <td>
                                    <span class="recar-status-badge @statusClass">
                                        @statusName
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="/CarOwner/Orders/Details/@item.OrderId" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-semibold">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                        @if (item.StatusId == 1 || item.StatusId == 2)
                                        {
                                            <a href="/CarOwner/Orders/Confirm/@item.OrderId" class="btn btn-success btn-sm rounded-pill px-2.5 py-1 text-white" title="Xác nhận đơn">
                                                <i class="bi bi-check-lg"></i>
                                            </a>
                                            <a href="/CarOwner/Orders/Cancel/@item.OrderId" class="btn btn-outline-danger btn-sm rounded-pill px-2.5 py-1" onclick="return confirm('Bạn có chắc muốn từ chối đơn này?');" title="Từ chối">
                                                <i class="bi bi-x-lg"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="mb-3">
                                    <i class="bi bi-clipboard-x fs-1 text-secondary opacity-50"></i>
                                </div>
                                <h5>Chưa có đơn đặt xe nào</h5>
                                <p class="small text-muted">Khi khách hàng đặt cọc giữ xe của bạn, các thông báo và lịch trình sẽ xuất hiện tại đây.</p>
                                <a href="/CarOwner/Home/Index" class="btn btn-light rounded-pill px-4 py-2 border text-primary fw-bold">
                                    Quay về Tổng quan
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
