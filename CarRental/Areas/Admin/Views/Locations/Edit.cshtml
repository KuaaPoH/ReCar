@model CarRental.Models.Location
@{
    ViewData["Title"] = "Chỉnh sửa địa điểm";
}

<div class="container-fluid px-0" style="max-width: 800px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-0 text-dark">Chỉnh sửa địa điểm nhận xe</h1>
            <p class="text-muted small mb-0 mt-1">Cập nhật thông tin địa điểm #@Model.LocationId</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="recar-panel p-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LocationId" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="CityName" class="form-label fw-semibold small">Tên Tỉnh / Thành phố <span class="text-danger">*</span></label>
                <input asp-for="CityName" class="form-control" required />
                <span asp-validation-for="CityName" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Region" class="form-label fw-semibold small">Khu vực vùng miền</label>
                    <select asp-for="Region" class="form-select">
                        <option value="Miền Bắc">Miền Bắc</option>
                        <option value="Miền Trung">Miền Trung</option>
                        <option value="Miền Nam">Miền Nam</option>
                    </select>
                    <span asp-validation-for="Region" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold small">Thứ tự hiển thị (ưu tiên số nhỏ)</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsPopular" class="form-check-input" type="checkbox" id="checkPopular">
                        <label class="form-check-label fw-semibold small" for="checkPopular">Đánh dấu là điểm nhận xe Phổ biến (Nổi bật)</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="checkActive">
                        <label class="form-check-label fw-semibold small" for="checkActive">Kích hoạt hiển thị cho khách hàng chọn</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary px-4 fw-semibold" style="background-color: var(--recar-primary); border: none;">
                    <i class="bi bi-check2-circle me-1"></i> Cập nhật thay đổi
                </button>
            </div>
        </form>
    </div>
</div>
