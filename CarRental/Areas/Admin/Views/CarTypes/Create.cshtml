@model CarRental.Models.CarType
@{
    ViewData["Title"] = "Thêm kiểu xe mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 1100px;">
    <!-- Header chuẩn Admin ReCar -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle p-2 text-muted me-1 shadow-xs" title="Quay lại danh sách">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Thêm kiểu xe mới</h1>
                <span class="badge bg-light text-primary border font-monospace">+ Khởi tạo</span>
            </div>
            <p class="text-muted small mb-0 mt-1 ms-5">Khởi tạo dòng phân khúc xe mới cho sàn cho thuê xe ReCar.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3.5 py-1.5 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Form chính 2 cột đồng nhất với Admin Blogs / Cars / UserManagement -->
    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createCarTypeForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

        <div class="row g-4">
            <!-- Cột trái: Thông tin chính của kiểu xe -->
            <div class="col-lg-7">
                <div class="recar-panel p-4 mb-4 shadow-sm border rounded-4 bg-white">
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-car-front-fill text-primary me-2"></i> Thông tin kiểu xe & phân khúc
                        </h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small">
                            Khởi tạo mới
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CarTypeName" class="form-label fw-semibold small text-dark">
                            Tên kiểu xe / phân khúc <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CarTypeName" class="form-control rounded-3" placeholder="VD: Sedan, SUV 7 chỗ, Crossover đô thị, MPV..." required autofocus />
                        <span asp-validation-for="CarTypeName" class="text-danger small"></span>
                        <div class="form-text small text-muted">Tên phân khúc xe hiển thị trên bộ lọc và sàn cho thuê xe.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Seats" class="form-label fw-semibold small text-dark">Số chỗ ngồi tiêu chuẩn</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                    <i class="bi bi-people"></i>
                                </span>
                                <input asp-for="Seats" type="number" min="2" max="54" class="form-control border-start-0 rounded-end-3" placeholder="VD: 4, 5, 7, 16..." />
                            </div>
                            <span asp-validation-for="Seats" class="text-danger small"></span>
                            <div class="form-text small text-muted">Số chỗ mặc định cho dòng xe này.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Manufacturer" class="form-label fw-semibold small text-dark">Hãng xe tiêu biểu đại diện</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                    <i class="bi bi-tag"></i>
                                </span>
                                <input asp-for="Manufacturer" class="form-control border-start-0 rounded-end-3" placeholder="VD: Toyota, Mazda, Hyundai, VinFast..." />
                            </div>
                            <span asp-validation-for="Manufacturer" class="text-danger small"></span>
                            <div class="form-text small text-muted">Hãng xe đặc trưng nhất của dòng này.</div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mt-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle text-primary fs-5"></i>
                            <div class="small text-muted">
                                Sau khi khởi tạo kiểu xe, các Chủ xe có thể chọn kiểu xe này khi đăng ký xe mới hoặc chỉnh sửa thông tin xe của họ.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Cài đặt, Hành động & Ảnh minh họa -->
            <div class="col-lg-5">
                <!-- Card 1: Hành động lưu & Trạng thái -->
                <div class="recar-panel p-4 mb-4 shadow-sm border rounded-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-sliders text-success me-2"></i> Trạng thái & Hành động
                    </h6>

                    <div class="p-3 bg-light rounded-3 small text-muted mb-3 border">
                        <div class="d-flex justify-content-between mb-1.5">
                            <span>Phân loại:</span>
                            <strong class="text-dark">Phân khúc xe ReCar</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1.5">
                            <span>Trạng thái:</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5">Sẵn sàng áp dụng</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Quyền thao tác:</span>
                            <span class="text-dark fw-semibold">Quản trị viên (Admin)</span>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                            <i class="bi bi-check2-circle me-1.5"></i> Hoàn tất & Lưu kiểu xe
                        </button>
                        <a asp-action="Index" class="btn btn-light w-100 rounded-pill py-2 text-muted fw-semibold border">
                            Hủy bỏ & Quay lại
                        </a>
                    </div>
                </div>

                <!-- Card 2: Hình ảnh minh họa kiểu xe -->
                <div class="recar-panel p-4 mb-4 shadow-sm border rounded-4 bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-image text-info me-2"></i> Hình ảnh minh họa
                        </h6>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 small" id="badgeStatus">
                            Tải từ máy tính
                        </span>
                    </div>
                    <p class="text-muted small mb-3">Tải ảnh đại diện từ máy tính hoặc dán đường dẫn ảnh.</p>

                    <!-- Khung Preview Ảnh Live -->
                    <div class="border rounded-4 p-2 bg-light text-center mb-3 position-relative overflow-hidden shadow-xs">
                        <img id="imagePreview" src="/images/cars/hero.jpg" alt="Xem trước" 
                             class="img-fluid rounded-3 object-fit-cover w-100 d-none" 
                             style="max-height: 180px; object-fit: cover;" />
                        <div id="noPreviewText" class="text-muted small py-4">
                            <i class="bi bi-cloud-arrow-up text-primary fs-1 d-block mb-1 opacity-75"></i>
                            <span class="fw-medium d-block">Chưa có ảnh</span>
                            <span style="font-size: 0.72rem;" class="text-secondary">PNG, JPG, WEBP (Tối đa 5MB)</span>
                        </div>
                    </div>

                    <!-- Nút chọn file từ máy -->
                    <div class="mb-3">
                        <input type="file" id="imageFileInput" name="imageFile" 
                               accept="image/png, image/jpeg, image/jpg, image/webp" class="d-none" />
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill py-2 fw-semibold" 
                                    onclick="document.getElementById('imageFileInput').click()">
                                <i class="bi bi-folder2-open me-1.5"></i> Chọn ảnh từ thư viện máy
                            </button>
                            <button type="button" class="btn btn-light btn-sm rounded-pill py-1.5 border text-danger d-none" 
                                    id="btnRemoveFile" onclick="clearSelectedFile()">
                                <i class="bi bi-x-circle me-1"></i> Xóa ảnh đã chọn
                            </button>
                        </div>
                        <div class="text-muted mt-1.5 text-center" style="font-size: 0.72rem;" id="fileInfoText">
                            Nhấp nút phía trên để mở ảnh trên máy tính của bạn
                        </div>
                    </div>

                    <!-- Tùy chọn URL mở rộng -->
                    <div class="pt-2 border-top">
                        <label asp-for="Image" class="form-label fw-semibold small text-secondary mb-1">
                            <i class="bi bi-link-45deg me-1"></i> Hoặc đường dẫn ảnh (URL / CDN):
                        </label>
                        <input asp-for="Image" id="imageInputUrl" class="form-control form-control-sm rounded-3" 
                               placeholder="https://... hoặc /images/cartypes/..." />
                        <span asp-validation-for="Image" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Xem trước ảnh Live Preview khi chọn file từ máy
        document.getElementById('imageFileInput')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp', 'image/gif'];
                if (!validTypes.includes(file.type)) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Định dạng không hỗ trợ',
                        text: 'Vui lòng chọn file hình ảnh có đuôi .JPG, .PNG, .WEBP hoặc .GIF!'
                    });
                    this.value = '';
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Dung lượng ảnh quá lớn',
                        text: 'Dung lượng hình ảnh không được vượt quá 5MB!'
                    });
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById('imagePreview');
                    const noText = document.getElementById('noPreviewText');
                    const btnRemove = document.getElementById('btnRemoveFile');
                    const fileInfo = document.getElementById('fileInfoText');
                    const badgeStatus = document.getElementById('badgeStatus');

                    img.src = e.target.result;
                    img.classList.remove('d-none');
                    if (noText) noText.classList.add('d-none');
                    btnRemove.classList.remove('d-none');

                    badgeStatus.className = 'badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 small';
                    badgeStatus.innerHTML = '<i class="bi bi-check-circle me-1"></i>Đã chọn từ máy';

                    const fileSizeKB = (file.size / 1024).toFixed(1);
                    fileInfo.innerHTML = '<span class="text-success fw-semibold"><i class="bi bi-check2 me-1"></i>Đã chọn:</span> ' + file.name + ' (' + fileSizeKB + ' KB)';
                };
                reader.readAsDataURL(file);
            }
        });

        // Xem trước khi gõ link URL
        document.getElementById('imageInputUrl')?.addEventListener('input', function (e) {
            const fileInput = document.getElementById('imageFileInput');
            if (fileInput.files && fileInput.files.length > 0) return;

            const url = e.target.value.trim();
            const img = document.getElementById('imagePreview');
            const noText = document.getElementById('noPreviewText');
            const badgeStatus = document.getElementById('badgeStatus');

            if (url) {
                img.src = url;
                img.classList.remove('d-none');
                if (noText) noText.classList.add('d-none');
                badgeStatus.className = 'badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-0.5 small';
                badgeStatus.innerText = 'Xem trước từ URL';
            } else {
                clearSelectedFile();
            }
        });

        function clearSelectedFile() {
            const fileInput = document.getElementById('imageFileInput');
            fileInput.value = '';

            const img = document.getElementById('imagePreview');
            const noText = document.getElementById('noPreviewText');
            const btnRemove = document.getElementById('btnRemoveFile');
            const fileInfo = document.getElementById('fileInfoText');
            const badgeStatus = document.getElementById('badgeStatus');

            img.src = '';
            img.classList.add('d-none');
            if (noText) noText.classList.remove('d-none');
            badgeStatus.className = 'badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 small';
            badgeStatus.innerText = 'Tải từ máy tính';
            fileInfo.innerText = 'Nhấp nút phía trên để mở ảnh trên máy tính của bạn';
            btnRemove.classList.add('d-none');
        }
    </script>
}
