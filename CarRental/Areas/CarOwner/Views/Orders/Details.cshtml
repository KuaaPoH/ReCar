@model CarRental.Models.CarRentalOrder
@using CarRental.Utilities
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.OrderId}";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";

    string statusClass = "status-ready";
    string statusName = Model.Status?.StatusDescription ?? "Đã thanh toán cọc";
    if (Model.StatusId == 1 || Model.StatusId == 2)
    {
        statusClass = "status-pending";
    }
    else if (Model.StatusId == 4)
    {
        statusClass = "status-busy";
    }
    else if (Model.StatusId == 5)
    {
        statusClass = "status-maintenance";
    }
}

<div class="space-y-4">
    <!-- Header Thao tác -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a href="/CarOwner/Orders/Index" class="text-secondary text-decoration-none small fw-bold d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn thuê
            </a>
            <h2 class="recar-owner-page-title">Đơn đặt xe #@Model.OrderId</h2>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="recar-status-badge @statusClass px-3 py-1.5 fs-6">
                @statusName
            </span>
            <a href="/CarOwner/Orders/Index" class="btn btn-light rounded-pill px-3 border text-secondary small fw-semibold">
                Đóng
            </a>
        </div>
    </div>

    <!-- Thông báo nếu có -->
    @if (!string.IsNullOrEmpty(Function._Message))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 py-2.5 rounded-3 mb-4">
            <i class="bi bi-check-circle-fill"></i>
            <div>@Function._Message</div>
        </div>
        Function._Message = string.Empty;
    }

    <div class="row g-4">
        <!-- Cột trái: Thông tin phương tiện và chi tiết đơn -->
        <div class="col-12 col-lg-8">
            <!-- Panel Danh sách xe thuê -->
            <div class="recar-panel mb-4">
                <div class="recar-panel-header">
                    <h3 class="recar-panel-title"><i class="bi bi-car-front-fill text-primary me-2"></i>Phương tiện bàn giao</h3>
                    <span class="text-muted small">Thời gian thuê thực tế</span>
                </div>
                <div class="table-responsive">
                    <table class="recar-table">
                        <thead>
                            <tr>
                                <th>Phương tiện</th>
                                <th>Ngày nhận - trả xe</th>
                                <th>Số ngày</th>
                                <th>Đơn giá/ngày</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                            {
                                foreach (var od in Model.OrderDetails)
                                {
                                    var days = 1;
                                    if (od.PickupDate.HasValue && od.ReturnDate.HasValue)
                                    {
                                        days = Math.Max(1, (int)(od.ReturnDate.Value.Date - od.PickupDate.Value.Date).TotalDays);
                                    }
                                    var itemTotal = (od.Price ?? 0) * (od.Quantity ?? days);

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(string.IsNullOrEmpty(od.Car?.Image) ? "/images/cars/car-sedan.jpg" : od.Car.Image)" 
                                                     alt="@od.Car?.CarName" 
                                                     class="rounded-3 border shadow-sm" 
                                                     style="width: 60px; height: 44px; object-fit: cover;" />
                                                <div>
                                                    <div class="fw-bold text-dark">@(od.Car?.CarName ?? "Phương tiện")</div>
                                                    <div class="text-muted small">@od.Car?.LicensePlate · @od.Car?.Transmission</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-dark">
                                                <i class="bi bi-box-arrow-in-right text-success me-1"></i>@(od.PickupDate?.ToString("HH:mm - dd/MM/yyyy") ?? "N/A")
                                            </div>
                                            <div class="small text-muted mt-1">
                                                <i class="bi bi-box-arrow-left text-danger me-1"></i>@(od.ReturnDate?.ToString("HH:mm - dd/MM/yyyy") ?? "N/A")
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@days ngày</span>
                                        </td>
                                        <td>
                                            <span class="text-muted">@((od.Price ?? 0).ToString("N0"))đ</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-bold text-primary">@itemTotal.ToString("N0")đ</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Không tìm thấy chi tiết phương tiện của đơn này.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Panel Ghi chú & Lịch trình -->
            <div class="recar-panel">
                <div class="recar-panel-header">
                    <h3 class="recar-panel-title"><i class="bi bi-card-text text-primary me-2"></i>Ghi chú giao nhận xe</h3>
                </div>
                <div class="p-4">
                    <p class="text-muted small mb-3">
                        @(string.IsNullOrEmpty(Model.Notes) ? "Không có ghi chú thêm từ khách hàng. Bàn giao phương tiện theo hợp đồng chuẩn ReCar." : Model.Notes)
                    </p>
                    <div class="alert alert-light border small text-secondary d-flex align-items-center gap-2 m-0 rounded-3">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>
                            Chủ xe cần kiểm tra đối chiếu bản gốc CCCD và Giấy phép lái xe (GPLX) của khách hàng trước khi ký biên bản bàn giao chìa khóa xe.
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông tin khách hàng & Bảng thanh toán -->
        <div class="col-12 col-lg-4">
            <!-- Panel Khách hàng -->
            <div class="recar-panel mb-4">
                <div class="recar-panel-header">
                    <h3 class="recar-panel-title"><i class="bi bi-person-fill text-primary me-2"></i>Khách hàng thuê xe</h3>
                </div>
                <div class="p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="user-avatar-circle" style="width: 48px; height: 48px; font-size: 16px; font-weight: 700; background: linear-gradient(135deg, #0284c7, #0ea5e9); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            @(string.IsNullOrEmpty(Model.Customer?.Name) ? "KH" : Model.Customer.Name.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6">@(Model.Customer?.Name ?? "Khách hàng ReCar")</div>
                            <div class="text-muted small"><i class="bi bi-check-circle-fill text-success"></i> Đã xác thực CCCD</div>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2.5 text-sm pt-2 border-top">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Điện thoại:</span>
                            <span class="fw-bold text-dark">@(Model.Customer?.PhoneNumber ?? "0988.xxx.xxx")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Email:</span>
                            <span class="text-dark">@(Model.Customer?.Email ?? "khachhang@recar.example")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Địa chỉ:</span>
                            <span class="text-dark text-end">@(string.IsNullOrEmpty(Model.Customer?.Address) ? "Hà Nội" : Model.Customer.Address)</span>
                        </div>
                    </div>

                    <div class="pt-3 mt-3 border-top">
                        <a href="tel:@(Model.Customer?.PhoneNumber ?? "")" class="btn btn-outline-primary w-100 rounded-pill py-2 fw-semibold small">
                            <i class="bi bi-telephone-fill me-1"></i> Gọi điện cho khách hàng
                        </a>
                    </div>
                </div>
            </div>

            <!-- Panel Thanh toán & Quyết toán -->
            <div class="recar-panel">
                <div class="recar-panel-header">
                    <h3 class="recar-panel-title"><i class="bi bi-cash-stack text-primary me-2"></i>Chi phí đơn thuê</h3>
                </div>
                <div class="p-4">
                    <div class="d-flex flex-column gap-2.5 small mb-3">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Tổng tiền thuê:</span>
                            <span class="fw-bold text-dark">@((Model.Payment ?? 0).ToString("N0"))đ</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Tiền cọc giữ xe (30%):</span>
                            <span class="fw-bold text-success">@((Model.Deposit ?? 0).ToString("N0"))đ</span>
                        </div>
                        <div class="d-flex justify-content-between pt-2 border-top">
                            <span class="fw-bold text-dark">Khách trả khi nhận xe (70%):</span>
                            <span class="fw-bold text-danger fs-6">
                                @(((Model.Payment ?? 0) - (Model.Deposit ?? 0)).ToString("N0"))đ
                            </span>
                        </div>
                    </div>

                    <div class="pt-3 border-top d-flex flex-column gap-2">
                        @if (Model.StatusId == 1 || Model.StatusId == 2)
                        {
                            <a href="/CarOwner/Orders/Confirm/@Model.OrderId" class="btn btn-success w-100 rounded-pill py-2 fw-semibold text-white">
                                <i class="bi bi-check-circle-fill me-1"></i> Xác nhận bàn giao xe
                            </a>
                            <a href="/CarOwner/Orders/Cancel/@Model.OrderId" class="btn btn-outline-danger w-100 rounded-pill py-2 fw-semibold" onclick="return confirm('Bạn có chắc muốn từ chối đơn này?');">
                                Từ chối nhận đơn
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-light w-100 rounded-pill py-2 fw-semibold border text-muted" disabled>
                                <i class="bi bi-check-all me-1"></i> Đơn đã hoàn tất tiếp nhận
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
