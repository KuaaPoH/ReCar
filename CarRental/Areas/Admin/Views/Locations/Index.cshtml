@model IEnumerable<CarRental.Models.Location>
@{
    ViewData["Title"] = "Quản lý địa điểm nhận xe";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Quản lý địa điểm nhận xe</h1>
                <span class="badge bg-light text-dark border rounded-pill fw-semibold px-2.5 py-1">@Model.Count() tỉnh thành</span>
            </div>
            <p class="text-muted small mb-0 mt-1">Danh mục các tỉnh, thành phố hiển thị ở thanh tìm kiếm xe và bộ lọc sàn ReCar.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3.5 py-2 fw-semibold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                <i class="bi bi-geo-alt-fill me-1"></i> Thêm địa điểm mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 small fw-medium mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table -->
    <div class="recar-panel mb-0">
        <div class="table-responsive">
            <table class="table recar-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">Thứ tự</th>
                        <th>Tên Tỉnh / Thành phố</th>
                        <th>Khu vực miền</th>
                        <th>Nổi bật</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-geo-alt fs-2 text-secondary d-block mb-2"></i>
                                Chưa có địa điểm nào trong CSDL.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            bool isActive = item.IsActive;
                            <tr id="row-location-@item.LocationId">
                                <td class="fw-bold text-muted">@item.DisplayOrder</td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        <i class="bi bi-geo-alt-fill text-primary me-1"></i> @item.CityName
                                    </div>
                                    <div class="text-muted" style="font-size: 0.72rem;">Khu vực: @(string.IsNullOrEmpty(item.Region) ? "Toàn quốc" : item.Region)</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(string.IsNullOrEmpty(item.Region) ? "Toàn quốc" : item.Region)
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsPopular)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-star-fill me-1"></i> Phổ biến
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Bình thường</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" 
                                            class="btn btn-sm rounded-pill px-2.5 py-0.5 border fw-semibold @(isActive ? "btn-success-subtle text-success border-success-subtle" : "btn-light text-muted border")" 
                                            style="font-size: 0.75rem;" 
                                            id="btn-status-location-@item.LocationId" 
                                            onclick="toggleLocationStatus(@item.LocationId, this)" 
                                            title="Bấm để chuyển đổi hiển thị">
                                        <i class="bi @(isActive ? "bi-check-circle-fill" : "bi-pause-circle") me-1"></i>
                                        <span>@(isActive ? "Hiển thị" : "Tạm ẩn")</span>
                                    </button>
                                </td>
                                <td class="text-end pe-3">
                                    <!-- Menu 3 chấm chuẩn Admin ReCar -->
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-light btn-sm rounded-circle p-1.5 border" 
                                                type="button" 
                                                data-bs-toggle="dropdown" 
                                                aria-expanded="false" 
                                                title="Thao tác" 
                                                style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm p-1.5 small" style="border-radius: 12px; min-width: 175px;">
                                            <li>
                                                <a asp-action="Edit" asp-route-id="@item.LocationId" class="dropdown-item py-2 d-flex align-items-center gap-2">
                                                    <i class="bi bi-pencil-square text-primary"></i> Chỉnh sửa
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:void(0)" onclick="toggleLocationStatus(@item.LocationId, document.getElementById('btn-status-location-@item.LocationId'))" class="dropdown-item py-2 d-flex align-items-center gap-2">
                                                    <i class="bi bi-arrow-repeat text-secondary"></i> Đổi trạng thái
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider my-1"></li>
                                            <li>
                                                <a href="javascript:void(0)" onclick="confirmDeleteLocation(@item.LocationId, '@Html.Raw(item.CityName?.Replace("'", "\\'"))')" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger">
                                                    <i class="bi bi-trash"></i> Xóa địa điểm
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true
        });

        // Bật / Tắt trạng thái hiển thị địa điểm qua AJAX
        function toggleLocationStatus(id, btn) {
            const $btn = $(btn);
            $btn.prop('disabled', true);

            $.ajax({
                url: '/Admin/Locations/ToggleStatus/' + id,
                type: 'POST',
                success: function (res) {
                    $btn.prop('disabled', false);
                    if (res && res.success) {
                        if (res.isActive) {
                            $btn.removeClass('btn-light text-muted')
                                .addClass('btn-success-subtle text-success border-success-subtle')
                                .html('<i class="bi bi-check-circle-fill me-1"></i><span>Hiển thị</span>');
                        } else {
                            $btn.removeClass('btn-success-subtle text-success border-success-subtle')
                                .addClass('btn-light text-muted')
                                .html('<i class="bi bi-pause-circle me-1"></i><span>Tạm ẩn</span>');
                        }
                        Toast.fire({
                            icon: 'success',
                            title: res.message || 'Cập nhật trạng thái thành công'
                        });
                    } else {
                        Toast.fire({
                            icon: 'error',
                            title: (res && res.message) || 'Có lỗi xảy ra khi đổi trạng thái'
                        });
                    }
                },
                error: function () {
                    $btn.prop('disabled', false);
                    Toast.fire({
                        icon: 'error',
                        title: 'Lỗi kết nối máy chủ'
                    });
                }
            });
        }

        // Xác nhận xóa địa điểm bằng SweetAlert2 qua AJAX
        function confirmDeleteLocation(id, name) {
            Swal.fire({
                title: 'Xóa địa điểm này?',
                html: 'Bạn có chắc chắn muốn xóa địa điểm <strong>"' + name + '"</strong> khỏi danh sách địa điểm nhận xe?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="bi bi-trash me-1"></i> Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/Locations/Delete/' + id,
                        type: 'POST',
                        success: function (res) {
                            if (res && res.success) {
                                $('#row-location-' + id).fadeOut(300, function () {
                                    $(this).remove();
                                });
                                Toast.fire({
                                    icon: 'success',
                                    title: res.message || 'Đã xóa địa điểm thành công'
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Không thể xóa',
                                    text: (res && res.message) || 'Có lỗi xảy ra khi xóa địa điểm.'
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi kết nối',
                                text: 'Không thể kết nối đến máy chủ.'
                            });
                        }
                    });
                }
            });
        }
    </script>
}
