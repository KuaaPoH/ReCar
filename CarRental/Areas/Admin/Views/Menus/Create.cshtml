@model CarRental.Models.Menu
@{
    ViewData["Title"] = "Thêm menu mới";
}

<div class="container-fluid px-0" style="max-width: 800px;">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Thêm menu mới</h1>
            <p class="text-muted small mb-0 mt-1">Tạo mục điều hướng mới cho thanh menu sàn ReCar.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-medium">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- Form Panel -->
    <div class="recar-panel p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 mb-3" style="display:none;"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold small text-dark">Tiêu đề hiển thị <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="Ví dụ: Giới thiệu, Bảng giá..." required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Alias" class="form-label fw-semibold small text-dark">Đường dẫn (Alias/Slug)</label>
                <input asp-for="Alias" class="form-control" placeholder="Ví dụ: /about, /pricing..." />
                <span asp-validation-for="Alias" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold small text-dark">Mô tả ngắn</label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Ghi chú thêm về mục menu"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Levels" class="form-label fw-semibold small text-dark">Cấp bậc (Level)</label>
                    <input asp-for="Levels" type="number" class="form-control" value="1" min="1" max="5" />
                    <span asp-validation-for="Levels" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ParentId" class="form-label fw-semibold small text-dark">Menu cha (ID)</label>
                    <input asp-for="ParentId" type="number" class="form-control" placeholder="0 nếu là menu gốc" />
                    <span asp-validation-for="ParentId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Position" class="form-label fw-semibold small text-dark">Thứ tự hiển thị</label>
                    <input asp-for="Position" type="number" class="form-control" value="1" min="1" />
                    <span asp-validation-for="Position" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="IsActiveSwitch" name="IsActive" value="true" checked />
                    <label class="form-check-label fw-semibold small text-dark" for="IsActiveSwitch">Hiển thị menu này trên website</label>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light border px-4 py-2">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" style="background-color: var(--recar-primary); border: none;">
                    <i class="bi bi-check-lg me-1"></i> Lưu menu
                </button>
            </div>
        </form>
    </div>
</div>
