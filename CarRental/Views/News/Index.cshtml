@{
    ViewData["Title"] = "Tin tức thị trường xe & Hành trình";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Banner -->
<div class="page-title-banner" style="background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%); border-bottom: 1px solid var(--recar-border); padding: 40px 0;">
    <div class="container" style="max-width: 1280px;">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb m-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tin tức</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-2 fw-semibold">
                    <i class="bi bi-newspaper me-1"></i> Bản tin ReCar
                </span>
                <h1 class="fs-2 fw-bold m-0" style="color: var(--recar-navy);">Tin tức thị trường xe &amp; Xu hướng di chuyển</h1>
                <p class="text-muted m-0 mt-2" style="font-size: 15px;">
                    Cập nhật tin tức ô tô mới nhất, xu hướng xe điện thông minh, gợi ý cung đường đẹp và thông báo từ hệ thống ReCar.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Blog" class="btn btn-outline-secondary bg-white rounded-pill px-4 fw-semibold small">
                    <i class="bi bi-book-half me-1"></i> Cẩm nang
                </a>
                <a href="/News" class="btn btn-primary rounded-pill px-4 fw-semibold small shadow-sm">
                    <i class="bi bi-newspaper me-1"></i> Tin tức
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Thanh tìm kiếm & Bộ lọc chủ đề -->
<div class="container pt-4 pb-5" style="max-width: 1280px;">
    <div class="bg-white p-3 p-md-4 rounded-4 border shadow-sm mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" id="newsSearchInput" class="form-control bg-light border-start-0" placeholder="Tìm kiếm tin tức ô tô, hành trình du lịch..." />
                </div>
            </div>
            <div class="col-lg-7">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end" id="newsTopicPills">
                    <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold news-filter-pill btn-primary text-white" data-topic="all">
                        Tất cả tin tức
                    </button>
                    <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold news-filter-pill btn-light border text-secondary" data-topic="Hành trình du lịch">
                        Hành trình du lịch
                    </button>
                    <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold news-filter-pill btn-light border text-secondary" data-topic="Công nghệ & Xe điện">
                        Công nghệ &amp; Xe điện
                    </button>
                    <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold news-filter-pill btn-light border text-secondary" data-topic="Tin tức ReCar">
                        Tin tức ReCar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách tin tức -->
    <div class="row g-4" id="newsArticlesContainer">
        @await Component.InvokeAsync("News")
    </div>

    <!-- Trạng thái không tìm thấy bài viết khi lọc -->
    <div id="newsEmptyFilterState" class="text-center py-5 d-none">
        <div class="p-5 bg-white rounded-4 border shadow-sm">
            <i class="bi bi-newspaper text-muted fs-1 mb-3 d-block"></i>
            <h5 class="fw-bold text-dark">Không tìm thấy bản tin phù hợp</h5>
            <p class="text-muted small mb-3">Hãy thử từ khóa khác hoặc chọn lại danh mục "Tất cả tin tức".</p>
            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4" onclick="resetNewsFilter()">Xem tất cả tin tức</button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var activeNewsTopic = 'all';

        function applyNewsFilter() {
            var keyword = ($('#newsSearchInput').val() || '').toLowerCase().trim();
            var visibleCount = 0;

            $('.news-article-item').each(function () {
                var itemTopic = ($(this).data('topic') || '').toString();
                var itemSearch = ($(this).data('search') || '').toString().toLowerCase();

                var matchTopic = (activeNewsTopic === 'all') || (itemTopic === activeNewsTopic);
                var matchKeyword = !keyword || itemSearch.indexOf(keyword) !== -1;

                if (matchTopic && matchKeyword) {
                    $(this).removeClass('d-none');
                    visibleCount++;
                } else {
                    $(this).addClass('d-none');
                }
            });

            if (visibleCount === 0) {
                $('#newsEmptyFilterState').removeClass('d-none');
            } else {
                $('#newsEmptyFilterState').addClass('d-none');
            }
        }

        function resetNewsFilter() {
            $('#newsSearchInput').val('');
            activeNewsTopic = 'all';
            $('.news-filter-pill').removeClass('btn-primary text-white').addClass('btn-light border text-secondary');
            $('.news-filter-pill[data-topic="all"]').removeClass('btn-light border text-secondary').addClass('btn-primary text-white');
            applyNewsFilter();
        }

        $(document).ready(function () {
            $('#newsSearchInput').on('input', applyNewsFilter);
            $('.news-filter-pill').on('click', function () {
                activeNewsTopic = $(this).data('topic');
                $('.news-filter-pill').removeClass('btn-primary text-white').addClass('btn-light border text-secondary');
                $(this).removeClass('btn-light border text-secondary').addClass('btn-primary text-white');
                applyNewsFilter();
            });
        });
    </script>
}
