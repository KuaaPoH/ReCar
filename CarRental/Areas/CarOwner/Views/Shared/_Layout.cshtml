@using CarRental.Utilities;
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var ownerName = Function.GetUserName(Context.Session);
    if (string.IsNullOrEmpty(ownerName))
    {
        ownerName = "Đối tác Chủ xe";
    }
    var ownerInitials = ownerName.Length >= 2 ? ownerName.Substring(0, 2).ToUpper() : "CX";
    var ownerAccountId = Function.GetCarOwnerAccountId(Context.Session) > 0 ? Function.GetCarOwnerAccountId(Context.Session) : Function.GetAccountId(Context.Session);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Quản lý xe") | ReCar Host - Trung tâm Quản trị Phương tiện</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <style>
        :root {
            --recar-dark: #0b132b;
            --recar-dark-subtle: #1c2541;
            --recar-dark-card: #222d4a;
            --recar-primary: #0284c7;
            --recar-primary-hover: #0369a1;
            --recar-cyan: #06b6d4;
            --recar-emerald: #10b981;
            --recar-amber: #f59e0b;
            --recar-rose: #f43f5e;
            --recar-bg: #f8fafc;
            --recar-border: #e2e8f0;
            --recar-border-subtle: #edf2f7;
            --recar-card-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.04);
            --recar-glow-primary: 0 8px 24px -4px rgba(2, 132, 199, 0.35);
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: var(--recar-bg);
            color: #334155;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        /* Sidebar Styling (High-End Midnight Tech) */
        .recar-owner-sidebar {
            background: linear-gradient(180deg, #0b132b 0%, #111a36 100%);
            color: #f8fafc;
            width: 275px;
            min-height: 100vh;
            position: sticky;
            top: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.5rem 1.15rem;
            z-index: 1030;
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.12);
            transition: all 0.3s ease;
        }

        .recar-owner-logo {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            color: #fff;
            padding: 0.25rem 0.5rem;
        }

        .recar-owner-logo-icon {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.35rem;
            box-shadow: 0 4px 14px rgba(2, 132, 199, 0.45);
        }

        .recar-owner-brand {
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -0.6px;
            color: #ffffff;
            line-height: 1.1;
        }

        .recar-owner-badge {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1.8px;
            color: #38bdf8;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 4px;
            margin-top: 2px;
        }

        /* Host Profile Mini Card in Sidebar */
        .recar-host-profile-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 0.85rem;
            margin-top: 1.25rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            backdrop-filter: blur(8px);
        }

        .recar-host-avatar {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #0284c7, #0ea5e9);
            color: #fff;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3);
        }

        .recar-host-info {
            min-width: 0;
            flex: 1;
        }

        .recar-host-name {
            font-size: 0.85rem;
            font-weight: 700;
            color: #f1f5f9;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0;
        }

        .recar-host-verified {
            font-size: 0.7rem;
            color: #10b981;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 3px;
        }

        /* Navigation Links */
        .recar-owner-nav {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .recar-owner-nav-heading {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 700;
            color: #64748b;
            padding: 0.5rem 0.85rem 0.2rem 0.85rem;
        }

        .recar-owner-nav-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 12px;
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 600;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .recar-owner-nav-item .nav-link-left {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .recar-owner-nav-item i {
            font-size: 1.2rem;
            transition: transform 0.2s ease;
        }

        .recar-owner-nav-item:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.07);
            transform: translateX(3px);
        }

        .recar-owner-nav-item:hover i {
            color: #38bdf8;
        }

        .recar-owner-nav-item.active {
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            box-shadow: 0 4px 16px rgba(2, 132, 199, 0.4);
        }

        .recar-owner-nav-item.active i {
            color: #ffffff;
        }

        .recar-owner-nav-item .nav-badge {
            background: rgba(255, 255, 255, 0.15);
            font-size: 0.72rem;
            padding: 0.15rem 0.5rem;
            border-radius: 999px;
            font-weight: 700;
        }

        /* Content Area */
        .recar-owner-main {
            flex: 1;
            min-width: 0;
            padding: 2rem 2.5rem;
            background-color: var(--recar-bg);
        }

        .recar-owner-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .recar-owner-page-title {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--recar-dark);
            letter-spacing: -0.6px;
            margin: 0;
            line-height: 1.2;
        }

        .recar-owner-breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8rem;
            color: #64748b;
            margin-top: 0.35rem;
        }

        .recar-owner-breadcrumb a {
            color: #64748b;
            text-decoration: none;
            transition: color 0.15s;
        }

        .recar-owner-breadcrumb a:hover {
            color: var(--recar-primary);
        }

        /* Common Premium Panel */
        .recar-panel {
            background: #ffffff;
            border: 1px solid var(--recar-border);
            border-radius: 18px;
            box-shadow: var(--recar-card-shadow);
            overflow: hidden;
            margin-bottom: 2rem;
            transition: box-shadow 0.25s ease;
        }

        .recar-panel:hover {
            box-shadow: 0 8px 30px -4px rgba(15, 23, 42, 0.08);
        }

        .recar-panel-header {
            padding: 1.25rem 1.65rem;
            border-bottom: 1px solid var(--recar-border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #ffffff;
        }

        .recar-panel-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--recar-dark);
            margin: 0;
            letter-spacing: -0.3px;
        }

        /* Primary Action Button */
        .btn-recar-action {
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff !important;
            border: none;
            border-radius: 12px;
            padding: 0.65rem 1.35rem;
            font-size: 0.88rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
            transition: all 0.2s ease;
        }

        .btn-recar-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.4);
            color: #ffffff;
        }

        /* Status Badges */
        .recar-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.2px;
        }

        .status-ready {
            background-color: #ecfdf5;
            color: #059669;
            border: 1px solid #a7f3d0;
        }
        .status-ready::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        }

        .status-busy {
            background-color: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }
        .status-busy::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }

        .status-pending {
            background-color: #fffbeb;
            color: #b45309;
            border: 1px solid #fde68a;
        }
        .status-pending::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #f59e0b;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
        }

        .status-maintenance {
            background-color: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }
        .status-maintenance::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
        }

        /* Recar Table System */
        .recar-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-bottom: 0;
        }

        .recar-table th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 700;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1.1rem 1.25rem;
            border-bottom: 2px solid #e2e8f0;
            white-space: nowrap;
        }

        .recar-table td {
            padding: 1.1rem 1.25rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            background-color: #ffffff;
            color: #334155;
            font-size: 0.9rem;
        }

        .recar-table tbody tr:hover td {
            background-color: #f8fafc;
        }

        .recar-table tbody tr:last-child td {
            border-bottom: none;
        }

        @@media (max-width: 991px) {
            .recar-owner-sidebar {
                width: 100%;
                min-height: auto;
                position: relative;
                flex-direction: row;
                align-items: center;
                flex-wrap: wrap;
                padding: 1rem;
            }
            .recar-host-profile-card {
                display: none;
            }
            .recar-owner-nav {
                flex-direction: row;
                overflow-x: auto;
                width: 100%;
                margin-top: 0.75rem;
                padding-bottom: 0.5rem;
            }
            .recar-owner-main {
                padding: 1.25rem 1rem;
            }
        }
    </style>
</head>

<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <!-- Sidebar Navigation (ReCar Host Pro) -->
        <aside class="recar-owner-sidebar">
            <div>
                <!-- Brand Logo -->
                <a href="/CarOwner/Home/Index" class="recar-owner-logo">
                    <div class="recar-owner-logo-icon">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <div>
                        <div class="recar-owner-brand">Re<span style="color: #38bdf8;">Car</span> <span style="font-size: 0.75rem; font-weight: 600; opacity: 0.8; letter-spacing: 0;">Host</span></div>
                        <div class="recar-owner-badge">
                            <i class="bi bi-shield-fill-check"></i> Đối tác Chủ xe
                        </div>
                    </div>
                </a>

                <!-- Host Profile Mini Card -->
                <div class="recar-host-profile-card">
                    <div class="recar-host-avatar">
                        @ownerInitials
                    </div>
                    <div class="recar-host-info">
                        <div class="recar-host-name">@ownerName</div>
                        <div class="recar-host-verified">
                            <i class="bi bi-patch-check-fill"></i> Chủ xe uy tín
                        </div>
                    </div>
                </div>

                <!-- Navigation Links -->
                <nav class="recar-owner-nav">
                    <div class="recar-owner-nav-heading">Quản trị phương tiện</div>

                    <a href="/CarOwner/Home/Index" class="recar-owner-nav-item @(currentController == "Home" ? "active" : "")">
                        <div class="nav-link-left">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Tổng quan</span>
                        </div>
                    </a>

                    <a href="/CarOwner/Cars/Index" class="recar-owner-nav-item @((currentController == "Cars" && currentAction == "Index") ? "active" : "")">
                        <div class="nav-link-left">
                            <i class="bi bi-speedometer2"></i>
                            <span>Quản lý xe</span>
                        </div>
                    </a>

                    <a href="/CarOwner/Cars/Create" class="recar-owner-nav-item @((currentController == "Cars" && currentAction == "Create") ? "active" : "")">
                        <div class="nav-link-left">
                            <i class="bi bi-plus-circle-fill text-info"></i>
                            <span>Thêm xe mới</span>
                        </div>
                        <span class="badge bg-primary rounded-pill px-2" style="font-size: 0.65rem;">+ Mới</span>
                    </a>

                    <div class="recar-owner-nav-heading mt-2">Kinh doanh & Thu nhập</div>

                    <a href="/CarOwner/Orders/Index" class="recar-owner-nav-item @(currentController == "Orders" ? "active" : "")">
                        <div class="nav-link-left">
                            <i class="bi bi-calendar2-check-fill"></i>
                            <span>Lịch trình & Đơn xe</span>
                        </div>
                    </a>

                    <a href="/CarOwner/Register/Pending" class="recar-owner-nav-item @(currentController == "Register" ? "active" : "")">
                        <div class="nav-link-left">
                            <i class="bi bi-person-vcard-fill"></i>
                            <span>Hồ sơ pháp lý & Bank</span>
                        </div>
                    </a>
                </nav>
            </div>

            <div class="pt-3 border-top border-secondary" style="border-color: rgba(255,255,255,0.08) !important;">
                <a href="/" class="recar-owner-nav-item mb-1 text-white text-decoration-none">
                    <div class="nav-link-left">
                        <i class="bi bi-arrow-left-right text-info"></i>
                        <span>Về sàn khách thuê</span>
                    </div>
                </a>

                <a href="/CarOwner/Home/Logout" class="recar-owner-nav-item text-danger text-decoration-none opacity-85">
                    <div class="nav-link-left">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </div>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="recar-owner-main">
            <!-- Topbar Header -->
            <div class="recar-owner-topbar">
                <div>
                    <h1 class="recar-owner-page-title">@(ViewData["Title"] ?? "Tổng quan")</h1>
                    <div class="recar-owner-breadcrumb">
                        <a href="/CarOwner/Home/Index"><i class="bi bi-house-door me-1"></i>ReCar Host</a>
                        <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i>
                        <span>@(ViewData["Title"] ?? "Dashboard")</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a href="/CarOwner/Cars/Create" class="btn-recar-action d-none d-sm-inline-flex">
                        <i class="bi bi-plus-lg"></i>
                        <span>Đăng xe cho thuê</span>
                    </a>

                    <!-- Chuông thông báo Real-time cho Chủ xe -->
                    <div class="dropdown">
                        <button class="btn btn-white position-relative rounded-pill px-3 py-2 border shadow-sm d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btnOwnerBell" style="background: #ffffff;">
                            <i class="bi bi-bell text-secondary fs-6"></i>
                            <span class="small fw-semibold text-dark d-none d-md-inline">Thông báo</span>
                            <span id="ownerNotificationDot" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="display: none;">
                                <span class="visually-hidden">Thông báo mới</span>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg p-2 border-0" style="width: 340px; border-radius: 16px; margin-top: 10px;">
                            <li>
                                <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bell-fill text-primary me-1"></i> Thông báo đối tác</h6>
                                    <span class="badge bg-light text-muted small">Realtime</span>
                                </div>
                            </li>
                            <li id="ownerNotificationEmpty" class="text-center py-4 text-muted small">
                                <i class="bi bi-inbox fs-3 d-block text-secondary opacity-50 mb-1"></i>
                                Chưa có thông báo mới nào
                            </li>
                            <div id="ownerNotificationList"></div>
                        </ul>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <div class="d-flex align-items-center gap-2 bg-white px-3 py-1.5 rounded-pill border shadow-sm" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-circle" style="width: 34px; height: 34px; font-size: 13px; font-weight: 700; background: linear-gradient(135deg, #0ea5e9, #0284c7); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                @ownerInitials
                            </div>
                            <span class="fw-bold text-dark small d-none d-md-inline">@ownerName</span>
                            <i class="bi bi-chevron-down text-muted small ms-1"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-2" style="border-radius: 14px; min-width: 220px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold text-dark">@ownerName</div>
                                <div class="text-muted small">Đối tác Chủ xe ReCar</div>
                            </li>
                            <li><a class="dropdown-item rounded-3 py-2 small" href="/Accounts/Index"><i class="bi bi-person me-2"></i>Tài khoản cá nhân</a></li>
                            <li><a class="dropdown-item rounded-3 py-2 small" href="/CarOwner/Register/Pending"><i class="bi bi-bank2 me-2"></i>Tài khoản thụ hưởng</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item rounded-3 py-2 small text-danger" href="/CarOwner/Home/Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script src="~/assets/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/vendor/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.RECAR_CURRENT_USER = {
            accountId: @(ownerAccountId > 0 ? ownerAccountId.ToString() : "null"),
            role: 'CarOwner',
            userName: '@ownerName'
        };

        // Bật chấm đỏ thông báo khi có đơn mới
        if (window.recarRealtimeHub) {
            window.recarRealtimeHub.on("ReceiveNewOrderNotification", function(data) {
                var dot = document.getElementById('ownerNotificationDot');
                if (dot) dot.style.display = 'inline-block';

                var empty = document.getElementById('ownerNotificationEmpty');
                if (empty) empty.style.display = 'none';

                var list = document.getElementById('ownerNotificationList');
                if (list) {
                    var item = document.createElement('li');
                    item.innerHTML = `
                        <a class="dropdown-item rounded-3 py-2.5 small d-flex gap-2 border-bottom" href="${data.detailUrl || '/CarOwner/Orders/Index'}">
                            <div class="rounded-circle bg-success bg-opacity-10 p-2 text-success flex-shrink-0">
                                <i class="bi bi-bag-check-fill fs-5"></i>
                            </div>
                            <div>
                                <p class="mb-0 fw-bold text-dark">Đơn mới #${data.orderId}: ${data.carName}</p>
                                <span class="text-muted" style="font-size: 0.72rem;">Khách: ${data.customerName} · Cọc: ${data.depositFormatted}</span>
                            </div>
                        </a>
                    `;
                    list.insertBefore(item, list.firstChild);
                }

                // Hiển thị Toast thông báo nhanh
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: `Có đơn đặt xe mới #${data.orderId}!`,
                    text: `${data.carName} - ${data.customerName}`,
                    showConfirmButton: false,
                    timer: 5000,
                    timerProgressBar: true
                });
            });
        }

        document.getElementById('btnOwnerBell')?.addEventListener('click', function() {
            var dot = document.getElementById('ownerNotificationDot');
            if (dot) dot.style.display = 'none';
        });
    </script>
    <script src="~/assets/js/recar-realtime.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
