@model List<CarRental.Models.CarRentalOrder>
@{
    ViewData["Title"] = "Đơn thuê xe";
    var statuses = ViewBag.OrderStatuses as List<CarRental.Models.OrderStatus> ?? new List<CarRental.Models.OrderStatus>();
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Quản lý đơn thuê xe</h1>
                <span class="badge bg-light text-dark border rounded-pill fw-semibold px-2.5 py-1">@Model.Count đơn</span>
            </div>
            <p class="text-muted small mb-0 mt-1">Giám sát hợp đồng thuê xe, thời hạn nhận trả, tiền cọc 30% giữ trên sàn và trạng thái thanh toán VNPay.</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="recar-panel mb-4 p-3">
        <form method="get" asp-area="Admin" asp-controller="Orders" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 10px; font-size: 0.85rem;"></i>
                    <input type="text" name="q" value="@ViewBag.FilterQ" class="form-control form-control-sm ps-5 rounded-3" placeholder="Tìm theo mã đơn (#RC-...), tên khách, SĐT..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="filterStatusId" class="form-select form-select-sm rounded-3">
                    <option value="">-- Tất cả trạng thái đơn --</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s.StatusId" selected="@(ViewBag.FilterStatusId == s.StatusId)">@s.StatusDescription</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm rounded-3 flex-grow-1" style="background-color: var(--recar-primary); border: none;">
                    <i class="bi bi-funnel"></i> Lọc đơn
                </button>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-light btn-sm rounded-3 border" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Data Table Panel -->
    <div class="recar-panel mb-0">
        <div class="table-responsive">
            <table class="table recar-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Xe thuê</th>
                        <th>Khách thuê xe</th>
                        <th>Lịch trình thuê</th>
                        <th>Tổng tiền</th>
                        <th>Tiền cọc (30%)</th>
                        <th>Còn lại (70%)</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-clipboard-x fs-2 text-secondary d-block mb-2"></i>
                                Không tìm thấy đơn thuê xe nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var order in Model)
                        {
                            var detail = order.OrderDetails != null && order.OrderDetails.Count > 0 ? order.OrderDetails.FirstOrDefault() : null;
                            var car = detail?.Car;
                            decimal total = (order.Deposit ?? 0) + (order.Payment ?? 0);
                            decimal deposit = order.Deposit ?? (total * 0.3m);
                            decimal remaining = total - deposit;

                            var statusName = order.Status?.StatusDescription ?? "Chờ xử lý";
                            var badgeClass = "badge-neutral";
                            if (order.StatusId == 1) { badgeClass = "badge-pending"; }
                            else if (order.StatusId == 2) { badgeClass = "badge-rented"; }
                            else if (order.StatusId == 3) { badgeClass = "badge-ready"; }
                            else if (order.StatusId == 4) { badgeClass = "badge-danger"; }

                            <tr>
                                <td>
                                    <span class="font-mono-plate">#RC-@order.OrderId</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(car?.Image ?? "/images/cars/car-sedan.jpg")" alt="Car" class="rounded object-fit-cover" style="width: 44px; height: 32px;" />
                                        <div>
                                            <div class="fw-bold small text-dark">@(car?.CarName ?? "Thuê xe ReCar")</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@(car?.LicensePlate ?? "Đang cập nhật")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold small">@(order.Customer?.Name ?? "Khách hàng")</div>
                                    <div class="text-muted" style="font-size: 0.72rem;"><i class="bi bi-telephone text-primary me-1"></i>@(order.Customer?.PhoneNumber ?? "09xx.xxx.xxx")</div>
                                </td>
                                <td>
                                    <div class="small fw-medium text-dark">@(order.OrderDate?.ToString("dd/MM/yyyy") ?? "Hôm nay")</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">Đến @(order.ReturnDate?.ToString("dd/MM/yyyy") ?? "Đang thuê")</div>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark small">@(total.ToString("N0")) đ</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-primary small">@(deposit.ToString("N0")) đ</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@(remaining.ToString("N0")) đ</span>
                                </td>
                                <td>
                                    <span class="status-badge @badgeClass">@statusName</span>
                                </td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="Orders" asp-action="Edit" asp-route-id="@order.OrderId" class="btn btn-light btn-sm rounded-pill px-2.5 py-1 text-primary fw-semibold" style="font-size: 0.78rem;">
                                        <i class="bi bi-pencil-square me-1"></i> Cập nhật
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>