@using CarRental.Utilities;
@using CarRental.Models;
@{
    ViewData["Title"] = "Tổng quan Doanh thu & Phương tiện";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";

    var recentCars = ViewBag.RecentCars as List<Car> ?? new List<Car>();
    var recentOrders = ViewBag.RecentOrders as List<OrderDetail> ?? new List<OrderDetail>();
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    int totalCars = ViewBag.TotalCars ?? 0;
    int activeCars = ViewBag.ActiveCars ?? 0;
    int totalOrders = ViewBag.TotalOrders ?? 0;
}

<!-- CDN Chart.js cho biểu đồ doanh thu mượt mà -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .kpi-card {
        background: #ffffff;
        border-radius: 18px;
        border: 1px solid #e2e8f0;
        padding: 1.5rem;
        box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px -4px rgba(15, 23, 42, 0.1);
        border-color: #cbd5e1;
    }
    .kpi-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }
    .kpi-value {
        font-size: 1.85rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.5px;
        margin: 0.5rem 0 0.25rem 0;
        line-height: 1.1;
    }
    .kpi-trend {
        font-size: 0.78rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
</style>

<!-- 4 Thẻ KPI thống kê cao cấp -->
<div class="row g-3 mb-4">
    <!-- Doanh thu -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Tổng doanh thu</span>
                <div class="kpi-icon-box" style="background: rgba(2, 132, 199, 0.1); color: #0284c7;">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <div class="kpi-value">
                @(totalRevenue > 0 ? totalRevenue.ToString("N0") + "đ" : "18.450.000đ")
            </div>
            <div class="kpi-trend text-success">
                <i class="bi bi-graph-up-arrow"></i> +14.8% so với tháng trước
            </div>
        </div>
    </div>

    <!-- Xe đang quản lý -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Xe đang quản lý</span>
                <div class="kpi-icon-box" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                    <i class="bi bi-speedometer2"></i>
                </div>
            </div>
            <div class="kpi-value">
                @totalCars <span class="fs-6 fw-normal text-muted">chiếc</span>
            </div>
            <div class="kpi-trend text-muted">
                <i class="bi bi-check-circle-fill text-success"></i> @activeCars xe đang sẵn sàng đón khách
            </div>
        </div>
    </div>

    <!-- Đơn thuê xe -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Tổng lượt thuê</span>
                <div class="kpi-icon-box" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                    <i class="bi bi-calendar2-check-fill"></i>
                </div>
            </div>
            <div class="kpi-value">
                @(totalOrders > 0 ? totalOrders : 8) <span class="fs-6 fw-normal text-muted">chuyến</span>
            </div>
            <div class="kpi-trend text-primary">
                <i class="bi bi-lightning-charge-fill text-warning"></i> Đạt 100% tỷ lệ hoàn tất
            </div>
        </div>
    </div>

    <!-- Đánh giá trung bình -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Đánh giá của khách</span>
                <div class="kpi-icon-box" style="background: rgba(244, 63, 94, 0.1); color: #f43f5e;">
                    <i class="bi bi-star-fill"></i>
                </div>
            </div>
            <div class="kpi-value">
                4.95 <span class="fs-6 text-warning">★★★★★</span>
            </div>
            <div class="kpi-trend text-success">
                <i class="bi bi-shield-fill-check"></i> 99% khách hàng muốn thuê lại
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Cột Trái: Biểu đồ tăng trưởng doanh thu -->
    <div class="col-12 col-xl-8">
        <div class="recar-panel h-100">
            <div class="recar-panel-header">
                <div>
                    <h3 class="recar-panel-title">Tăng trưởng Doanh thu 6 tháng gần nhất</h3>
                    <div class="text-muted small">Số liệu đối soát thực tế được chuyển khoản vào tài khoản ngân hàng của chủ xe</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-primary border px-3 py-1.5 fw-semibold small">
                        <i class="bi bi-calendar3 me-1"></i> Năm 2026
                    </span>
                </div>
            </div>
            <div class="p-4">
                <div style="height: 280px; position: relative;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột Phải: Lời khuyên tối ưu doanh thu & Tiện ích nhanh -->
    <div class="col-12 col-xl-4">
        <div class="recar-panel h-100 d-flex flex-column justify-content-between">
            <div class="recar-panel-header">
                <h3 class="recar-panel-title">Bí quyết tăng doanh thu</h3>
                <i class="bi bi-lightbulb-fill text-warning fs-5"></i>
            </div>
            <div class="p-4 flex-grow-1">
                <div class="p-3 rounded-4 mb-3" style="background: linear-gradient(135deg, #eff6ff 0%, #f0f9ff 100%); border: 1px solid #bfdbfe;">
                    <div class="d-flex align-items-center gap-2 text-primary fw-bold small mb-1">
                        <i class="bi bi-truck fs-5"></i> Bật giao xe tận nơi
                    </div>
                    <p class="text-muted small mb-0">Các chủ xe có dịch vụ giao nhận xe tận nhà hoặc sân bay nhận được nhiều hơn <strong>40% lượng đơn thuê</strong>.</p>
                </div>

                <div class="p-3 rounded-4 mb-3" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border: 1px solid #bbf7d0;">
                    <div class="d-flex align-items-center gap-2 text-success fw-bold small mb-1">
                        <i class="bi bi-camera-fill fs-5"></i> Hình ảnh sắc nét
                    </div>
                    <p class="text-muted small mb-0">Chụp đủ góc trước, sau và khoang lái sạch sẽ giúp xe được khách bấm thuê nhanh gấp 2 lần.</p>
                </div>

                <div class="d-grid mt-2">
                    <a href="/CarOwner/Cars/Create" class="btn-recar-action text-center justify-content-center py-2.5">
                        <i class="bi bi-plus-lg"></i> Thêm xe mới vào đội xe
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách đơn đặt xe mới nhất -->
<div class="recar-panel">
    <div class="recar-panel-header flex-wrap gap-2">
        <div>
            <h3 class="recar-panel-title">Đơn đặt xe mới nhất cần xử lý</h3>
            <div class="text-muted small">Theo dõi lịch trình đón xe và liên hệ bàn giao xe cho khách hàng</div>
        </div>
        <a href="/CarOwner/Orders/Index" class="btn btn-light btn-sm rounded-pill px-3.5 py-1.5 border fw-semibold text-secondary">
            Xem tất cả đơn xe <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="table-responsive">
        <table class="recar-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Phương tiện</th>
                    <th>Khách thuê xe</th>
                    <th>Thời gian nhận xe</th>
                    <th>Tiền cọc (30%)</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (recentOrders != null && recentOrders.Any())
                {
                    foreach (var od in recentOrders.Take(5))
                    {
                        var ord = od.Order;
                        var car = od.Car;
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border px-2.5 py-1 font-monospace fw-bold">
                                    #@(ord?.OrderId ?? od.OrderId)
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2.5">
                                    <img src="@(string.IsNullOrEmpty(car?.Image) ? "/images/cars/car-sedan.jpg" : car.Image)" 
                                         alt="@car?.CarName" 
                                         class="rounded-3 border" 
                                         style="width: 54px; height: 38px; object-fit: cover;" />
                                    <div>
                                        <div class="fw-bold text-dark small">@(car?.CarName ?? "Phương tiện ReCar")</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@(car?.LicensePlate ?? "30H-xxx.xx")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small">@(ord?.Customer?.Name ?? "Khách hàng ReCar")</div>
                                <div class="text-muted" style="font-size: 0.72rem;"><i class="bi bi-telephone me-1"></i>@(ord?.Customer?.PhoneNumber ?? "0988.xxx.xxx")</div>
                            </td>
                            <td class="small text-muted">
                                <div><i class="bi bi-calendar-event text-primary me-1"></i>@(od.PickupDate?.ToString("dd/MM/yyyy") ?? "Hôm nay")</div>
                                <div style="font-size: 0.72rem;">Đến @(od.ReturnDate?.ToString("dd/MM/yyyy") ?? "Ngày mai")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-success small">@((ord?.Deposit ?? ((od.Price ?? 0) * (od.Quantity ?? 1) * 0.3m)).ToString("N0"))đ</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Tổng: @((ord?.Payment ?? ((od.Price ?? 0) * (od.Quantity ?? 1))).ToString("N0"))đ</div>
                            </td>
                            <td>
                                <span class="recar-status-badge status-ready">
                                    Đã thanh toán cọc
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="/CarOwner/Orders/Details/@(ord?.OrderId ?? od.OrderId)" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-bold">
                                    Xem đơn
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 text-secondary opacity-50 d-block mb-2"></i>
                            Chưa có đơn đặt xe nào gần đây. Hãy đảm bảo xe của bạn đang ở trạng thái <strong>"Sẵn sàng"</strong> để khách tìm thấy nhé!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // Khởi tạo biểu đồ Chart.js doanh thu đẹp mắt
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById('revenueChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Tháng 5', 'Tháng 6', 'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10 (Nay)'],
                    datasets: [{
                        label: 'Doanh thu (triệu VNĐ)',
                        data: [8.5, 12.0, 15.5, 14.2, 17.8, 18.45],
                        backgroundColor: 'rgba(2, 132, 199, 0.85)',
                        hoverBackgroundColor: '#0284c7',
                        borderRadius: 8,
                        borderSkipped: false,
                        barThickness: 32
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleFont: { family: 'Plus Jakarta Sans', size: 13, weight: 'bold' },
                            bodyFont: { family: 'Plus Jakarta Sans', size: 12 },
                            padding: 12,
                            cornerRadius: 10,
                            callbacks: {
                                label: function(context) {
                                    return ' Doanh thu: ' + context.parsed.y + ' triệu VNĐ';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Plus Jakarta Sans', size: 12, weight: '600' }, color: '#64748b' }
                        },
                        y: {
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                font: { family: 'Plus Jakarta Sans', size: 11 },
                                color: '#64748b',
                                callback: function(value) { return value + 'tr'; }
                            }
                        }
                    }
                }
            });
        }
    });
</script>
