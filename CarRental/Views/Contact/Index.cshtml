@{
    ViewData["Title"] = "Liên hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var settings = ViewBag.Settings as CarRental.Models.SystemSetting;
    bool isLoggedIn = ViewBag.IsLoggedIn == true;
    var customer = ViewBag.Customer as CarRental.Models.Customer;

    string hotline = !string.IsNullOrWhiteSpace(settings?.Hotline) ? settings.Hotline : "1900 6868";
    string supportEmail = !string.IsNullOrWhiteSpace(settings?.SupportEmail) ? settings.SupportEmail : "hotro@recar.vn";
    string address = !string.IsNullOrWhiteSpace(settings?.Address) ? settings.Address : "Hà Nội & TP. Hồ Chí Minh";
    string displayName = !string.IsNullOrWhiteSpace(customer?.FullName) ? customer.FullName : (customer?.Username ?? "Thành viên ReCar");
}

<!-- Page Banner -->
<div class="page-title-banner" style="background-color: #f8fafc; border-bottom: 1px solid var(--recar-border); padding: 36px 0;">
    <div class="container" style="max-width: 1280px;">
        <h1 class="fs-2 fw-bold m-0" style="color: var(--recar-navy);">Liên hệ</h1>
        <p class="text-muted small m-0 mt-2" style="font-size: 15px;">
            Chúng tôi luôn sẵn sàng hỗ trợ bạn trong mọi hành trình thuê xe.
        </p>
    </div>
</div>

<div class="container py-5" style="max-width: 1100px;">
    <div class="row g-5">
        <!-- Cột thông tin liên hệ -->
        <div class="col-lg-5">
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color: var(--recar-secondary);">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-white shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="bi bi-telephone fs-5" style="color: var(--recar-primary);"></i>
                    </div>
                    <div>
                        <p class="small text-muted m-0" style="font-size: 12px;">Hotline hỗ trợ 24/7</p>
                        <h6 class="fw-bold m-0" style="color: var(--recar-navy);">@hotline</h6>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color: var(--recar-secondary);">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-white shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="bi bi-envelope fs-5" style="color: var(--recar-primary);"></i>
                    </div>
                    <div>
                        <p class="small text-muted m-0" style="font-size: 12px;">Email phản hồi</p>
                        <h6 class="fw-bold m-0" style="color: var(--recar-navy);">@supportEmail</h6>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color: var(--recar-secondary);">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-white shadow-sm" style="width: 44px; height: 44px; flex-shrink: 0;">
                        <i class="bi bi-geo-alt fs-5" style="color: var(--recar-primary);"></i>
                    </div>
                    <div>
                        <p class="small text-muted m-0" style="font-size: 12px;">Văn phòng chính</p>
                        <h6 class="fw-bold m-0" style="color: var(--recar-navy);">@address</h6>
                    </div>
                </div>

                <div class="p-3 rounded-3 border bg-light text-muted small mt-2" style="font-size: 13px;">
                    <i class="bi bi-info-circle text-primary me-1"></i> Đội ngũ chăm sóc khách hàng ReCar tiếp nhận và phản hồi trực tiếp qua email tài khoản của bạn.
                </div>
            </div>
        </div>

        <!-- Cột Form liên hệ -->
        <div class="col-lg-7">
            <div class="p-4 p-md-5 rounded-4 border bg-white shadow-sm">
                <h4 class="fw-bold mb-2" style="color: var(--recar-navy);">Gửi tin nhắn cho ReCar</h4>

                @if (!isLoggedIn)
                {
                    <p class="text-muted small mb-4">Để đảm bảo xác thực thông tin và phản hồi chính xác qua Email, vui lòng đăng nhập tài khoản trước khi gửi liên hệ.</p>

                    <div class="p-4 rounded-4 text-center border" style="background-color: #f8fafc;">
                        <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 64px; height: 64px;">
                            <i class="bi bi-shield-lock fs-3"></i>
                        </div>
                        <h6 class="fw-bold mb-2" style="color: var(--recar-navy);">Bạn chưa đăng nhập</h6>
                        <p class="text-muted small mb-4">Đăng nhập ngay để hệ thống tự động điền thông tin liên hệ và gửi yêu cầu tới bộ phận CSKH.</p>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a href="/Login?returnUrl=/Contact" class="btn text-white px-4 py-2 fw-semibold rounded-3" style="background-color: var(--recar-primary);">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                            </a>
                            <a href="/Register" class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-3">
                                Đăng ký tài khoản
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-4">Hãy nhập nội dung cần hỗ trợ, đội ngũ ReCar sẽ phản hồi qua Email của bạn sớm nhất.</p>

                    <!-- Thẻ thông tin tài khoản đã đăng nhập -->
                    <div class="p-3 rounded-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background-color: #f0f9ff; border: 1px solid #bae6fd;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px; flex-shrink: 0;">
                                @(displayName.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">@displayName</div>
                                <div class="text-muted" style="font-size: 12.5px;">
                                    <i class="bi bi-envelope me-1"></i>@(string.IsNullOrWhiteSpace(customer?.Email) ? "Chưa cập nhật email" : customer.Email)
                                </div>
                            </div>
                        </div>
                        <span class="badge bg-white text-primary border border-primary-subtle rounded-pill px-3 py-1">
                            <i class="bi bi-patch-check-fill me-1"></i> Đã xác thực tài khoản
                        </span>
                    </div>

                    <form id="contactForm">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-muted">Số điện thoại liên hệ</label>
                                <input type="tel" class="form-control rounded-3 py-2" id="contactPhone" value="@(customer?.PhoneNumber ?? "")" placeholder="Nhập số điện thoại để CSKH tiện liên hệ" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-muted">Nội dung liên hệ *</label>
                                <textarea class="form-control rounded-3" id="contactMessage" rows="5" placeholder="Nhập câu hỏi, góp ý hoặc vấn đề bạn cần ReCar hỗ trợ..." required></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" id="btnSubmitContact" class="btn text-white px-5 py-2 fw-semibold rounded-3" style="background-color: var(--recar-primary);">
                                    <i class="bi bi-send me-1"></i> Gửi liên hệ
                                </button>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $('#contactForm').on('submit', function (e) {
                e.preventDefault();

                const phone = $('#contactPhone').val();
                const message = $('#contactMessage').val();
                const $btn = $('#btnSubmitContact');
                $btn.prop('disabled', true);

                $.ajax({
                    url: '/Contact/Create',
                    type: 'POST',
                    data: {
                        phone: phone,
                        message: message
                    },
                    success: function (res) {
                        if (res.status) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Gửi liên hệ thành công!',
                                text: 'Cảm ơn bạn đã liên hệ ReCar. Chúng tôi sẽ phản hồi qua Email sớm nhất.',
                                confirmButtonColor: '#0284c7'
                            });
                            $('#contactMessage').val('');
                        } else if (res.requireLogin) {
                            window.location.href = '/Login?returnUrl=/Contact';
                        } else {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Không thể gửi',
                                text: res.message || 'Vui lòng kiểm tra lại nội dung.',
                                confirmButtonColor: '#0284c7'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi kết nối',
                            text: 'Không thể gửi tin nhắn lúc này. Vui lòng thử lại sau.'
                        });
                    },
                    complete: function () {
                        $btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
