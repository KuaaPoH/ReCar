@using CarRental.Utilities
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>ReCar – Hệ thống cho thuê xe ô tô trực tuyến</title>
    <meta name="description" content="ReCar – nền tảng cho thuê ô tô kết nối khách thuê và chủ xe.">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/favicon.ico">

    <!-- CSS Vendor & Bootstrap -->
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/assets/css/plugins/swiper-bundle.min.css">

    <!-- ReCar Core Design System -->
    <link rel="stylesheet" href="~/assets/css/recar.css">

    @RenderSection("style", required: false)
</head>
<body>

    <!-- ReCar Header (Pixel-perfect Ảnh 1) -->
    <header class="recar-navbar">
        <div class="recar-navbar-container">
            <!-- Logo -->
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                <span style="width: 36px; height: 36px; border-radius: 8px; background-color: var(--recar-primary); color: #fff; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-car-front-fill fs-5"></i>
                </span>
                <span style="font-size: 20px; font-weight: 800; color: var(--recar-navy); letter-spacing: -0.5px;">
                    Re<span style="color: var(--recar-primary);">Car</span>
                </span>
            </a>

            <!-- Navigation Links (Pill Style) -->
            @{
                var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
            }
            <nav class="d-none d-md-flex align-items-center gap-1">
                <a href="/" class="recar-nav-pill @(currentCtrl == "Home" && currentAct == "Index" ? "active" : "")">Trang chủ</a>
                <a href="/Product" class="recar-nav-pill @(currentCtrl == "Product" ? "active" : "")">Thuê xe</a>
                <a href="/Blog" class="recar-nav-pill @(currentCtrl == "Blog" ? "active" : "")">Cẩm nang</a>
                <a href="/News" class="recar-nav-pill @(currentCtrl == "News" ? "active" : "")">Tin tức</a>
                <a href="/Contact" class="recar-nav-pill @(currentCtrl == "Contact" ? "active" : "")">Liên hệ</a>
            </nav>

            <!-- Navigation Actions: Khi chưa login hiện Đăng nhập/Đăng ký; sau khi login hiện avatar & tên user -->
            @{
                bool isLogged = Function.IsLogin(Context.Session);
                string userName = Function.GetUserName(Context.Session);
                if (string.IsNullOrEmpty(userName) && isLogged)
                {
                    userName = Function._UserName;
                }

                string initials = "U";
                if (!string.IsNullOrEmpty(userName))
                {
                    var words = userName.Trim().Split(' ');
                    if (words.Length >= 2)
                    {
                        initials = $"{words[0][0]}{words[words.Length - 1][0]}".ToUpper();
                    }
                    else if (words.Length == 1 && words[0].Length >= 2)
                    {
                        initials = words[0].Substring(0, 2).ToUpper();
                    }
                    else if (words.Length == 1 && words[0].Length == 1)
                    {
                        initials = words[0].ToUpper();
                    }
                }
            }

            @if (isLogged)
            {
                <div class="d-flex align-items-center gap-2">
                    <!-- Chuông thông báo -->
                    <button type="button" aria-label="Thông báo" class="btn btn-link position-relative p-2 text-decoration-none" style="color: var(--recar-navy);">
                        <i class="bi bi-bell fs-5"></i>
                        <span class="position-absolute bg-danger rounded-circle" style="top: 8px; right: 8px; width: 8px; height: 8px;"></span>
                    </button>

                    <!-- User Dropdown Menu -->
                    <div class="dropdown">
                        <button class="user-pill-btn dropdown-toggle" type="button" id="recarUserMenu" data-bs-toggle="dropdown" aria-expanded="false" style="border: 1px solid #e2e8f0;">
                            <span class="user-avatar-circle">@initials</span>
                            <span class="text-sm fw-medium d-none d-sm-inline" style="font-size: 14px; font-weight: 500;">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border p-2 mt-2" aria-labelledby="recarUserMenu" style="border-radius: 12px; min-width: 220px;">
                            <li>
                                <div class="px-3 py-2 border-bottom mb-1">
                                    <p class="small fw-bold text-dark m-0">@userName</p>
                                    <p class="text-muted m-0" style="font-size: 12px;">@Function.GetEmail(Context.Session)</p>
                                </div>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium" href="/Accounts">
                                    <i class="bi bi-person me-2"></i> Tài khoản của tôi
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium" href="/Accounts?tab=orders">
                                    <i class="bi bi-file-earmark-text me-2"></i> Đơn thuê xe
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium" href="/CarOwner/Home/Index">
                                    <i class="bi bi-speedometer2 me-2"></i> Trang chủ xe
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium" href="/Admin/Home/Index">
                                    <i class="bi bi-shield-check me-2"></i> Quản trị
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item py-2 rounded-2 small fw-medium text-danger" href="/Accounts/Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2">
                    <a href="/Login" class="btn btn-sm rounded-pill px-3 py-1 fw-medium" style="border: 1px solid #cbd5e1; color: var(--recar-navy); background: #ffffff; font-size: 13px;">
                        Đăng nhập
                    </a>
                    <a href="/Register" class="btn btn-sm rounded-pill px-3 py-1 fw-medium text-white" style="background-color: var(--recar-primary); border: 1px solid var(--recar-primary); font-size: 13px;">
                        Đăng ký
                    </a>
                </div>
            }
        </div>
    </header>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- ReCar Footer (Pixel-perfect) -->
    <footer style="margin-top: 96px; background-color: var(--recar-navy); color: #f8fafc;">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span style="width: 36px; height: 36px; border-radius: 8px; background-color: var(--recar-primary); color: #fff; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-car-front-fill fs-5"></i>
                        </span>
                        <span style="font-size: 20px; font-weight: 800; color: #ffffff;">
                            Re<span style="color: var(--recar-primary);">Car</span>
                        </span>
                    </div>
                    <p class="small opacity-75 mb-0">Chuyến đi của bạn, lựa chọn của bạn. Nền tảng kết nối khách thuê và chủ xe hàng đầu Việt Nam.</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-white">Khám phá</h6>
                    <ul class="list-unstyled small opacity-75 mb-0 d-flex flex-column gap-2">
                        <li><a href="/Product" class="text-white text-decoration-none">Thuê xe tự lái</a></li>
                        <li><a href="/Blog" class="text-white text-decoration-none">Cẩm nang du lịch</a></li>
                        <li><a href="/News" class="text-white text-decoration-none">Tin tức thị trường</a></li>
                        <li><a href="/Contact" class="text-white text-decoration-none">Liên hệ hỗ trợ</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-white">Chính sách</h6>
                    <ul class="list-unstyled small opacity-75 mb-0 d-flex flex-column gap-2">
                        <li><a href="/Home/Privacy" class="text-white text-decoration-none">Chính sách thuê xe</a></li>
                        <li><a href="/Home/Privacy" class="text-white text-decoration-none">Điều khoản sử dụng</a></li>
                        <li><a href="/Home/Privacy" class="text-white text-decoration-none">Chính sách bảo mật</a></li>
                        <li><a href="/Contact" class="text-white text-decoration-none">Hỗ trợ khách hàng</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3 text-white">
                        Liên hệ <span class="badge bg-warning text-dark ms-1 small" style="font-size: 10px;">Dữ liệu mẫu</span>
                    </h6>
                    <div class="small opacity-75 d-flex flex-column gap-2">
                        <div>Hotline: 1900 6868</div>
                        <div>Email: hotro@recar.example</div>
                        <div>Hà Nội & TP. Hồ Chí Minh</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="border-top border-secondary py-3 text-center small opacity-60" style="border-color: rgba(255,255,255,0.1) !important;">
            © 2026 ReCar. Nền tảng cho thuê ô tô trực tuyến (Đồ án tốt nghiệp).
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script src="~/assets/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/plugins/swiper-bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>