@using CarRental.Utilities;
@inject CarRental.Models.DbRenalCarContext _db;
@{
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
    var act = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();

    bool isHome = ctrl == "home";
    bool isPendingCars = ctrl == "cars" && act == "pending";
    bool isPendingOwners = ctrl == "carowners";
    bool isCars = ctrl == "cars" && act != "pending";
    bool isCarTypes = ctrl == "cartypes";
    bool isCarBrands = ctrl == "carbrands";
    bool isOrders = ctrl == "orders";
    bool isFinance = ctrl == "finance";
    bool isBlogs = ctrl == "blogs";
    bool isNews = ctrl == "news";
    bool isMenus = ctrl == "menus";
    bool isReviews = ctrl == "reviews";
    bool isLocations = ctrl == "locations";
    bool isUsers = ctrl == "usermanagement" || ctrl == "customer";
    bool isSettings = ctrl == "settings";

    var adminName = Function.GetUserName(Context.Session);
    if (string.IsNullOrEmpty(adminName))
    {
        adminName = "Administrator";
    }
    var adminInitials = adminName.Length >= 2 ? adminName.Substring(0, 2).ToUpper() : "AD";
    var adminAvatar = Function.GetAdminAvatar(Context.Session);
    if (string.IsNullOrEmpty(adminAvatar))
    {
        try {
            adminAvatar = _db.Customers.Where(c => c.RoleId == 1).Select(c => c.Avartar).FirstOrDefault() ?? "";
            if (!string.IsNullOrEmpty(adminAvatar)) {
                Function.SetAdminAvatar(Context.Session, adminAvatar);
            }
        } catch { }
    }
    
    // Đếm số lượng xe và hồ sơ chủ xe đang chờ duyệt thực tế từ CSDL
    int pendingCarsCount = 0;
    int pendingOwnersCount = 0;
    try {
        pendingCarsCount = _db.Cars.Count(c => c.CarStatus == "Chờ duyệt" || c.CarStatus == "Chờ cập nhật" || c.CarStatus == "pending_update");
        pendingOwnersCount = _db.CarOwnerRegistrations.Count(r => r.Status == "Pending");
    } catch { }

    // Breadcrumb text mapping
    string pageTitle = ViewData["Title"]?.ToString() ?? "Tổng quan";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Quản trị viên") | ReCar - Admin Portal</title>
    
    <!-- Khôi phục trạng thái thu gọn ngay lập tức trước khi render, tránh giật lag hoặc bị reset khi chuyển trang -->
    <script>
        (function() {
            try {
                if (localStorage.getItem('recar_admin_sidebar_collapsed') === 'true' && window.innerWidth >= 992) {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch(e) {}
        })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Chart.js & SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- ReCar Admin CSS -->
    <link rel="stylesheet" href="~/assets/css/recar-admin.css" asp-append-version="true">
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar Navigation -->
        <aside class="recar-admin-sidebar" id="adminSidebar">
            <div>
                <!-- Brand Header -->
                <div class="recar-brand">
                    <div class="recar-brand-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5 fw-bold text-white tracking-tight">ReCar</span>
                            <span class="badge" style="background-color: rgba(56, 189, 248, 0.2); color: #38bdf8; font-size: 0.65rem; letter-spacing: 0.1em;">ADMIN</span>
                        </div>
                        <div class="text-white-50 small" style="font-size: 0.75rem;">Cổng quản trị toàn sàn</div>
                    </div>
                </div>

                <div class="px-2 mb-3 admin-user-pill">
                    <span class="d-inline-flex align-items-center gap-1 px-2.5 py-1 rounded-pill small" style="background-color: var(--recar-navy-hover); color: #94a3b8; font-size: 0.75rem;">
                        <i class="bi bi-person-badge text-info"></i> Quyền: <strong>Quản trị viên</strong>
                    </span>
                </div>

                <!-- Navigation Links Rendered Dynamically from DB -->
                <nav class="nav recar-nav-pills flex-column">
                    @{
                        var rawAdminMenus = _db.Menus
                            .Where(m => m.Subsystem == "Admin" && (m.IsActive ?? false))
                            .OrderBy(m => m.Position)
                            .ToList();

                        var adminParentGroups = rawAdminMenus
                            .Where(m => m.ParentId == null || m.ParentId == 0)
                            .OrderBy(m => m.Position)
                            .ToList();

                        var adminCurPath = Context.Request.Path.Value ?? "";

                        foreach (var group in adminParentGroups)
                        {
                            var children = rawAdminMenus
                                .Where(m => m.ParentId == group.MenuId)
                                .OrderBy(m => m.Position)
                                .ToList();

                            bool isGroupHeader = string.IsNullOrWhiteSpace(group.Url) || group.Url == "#";

                            if (isGroupHeader)
                            {
                                <div class="sidebar-category-header">@group.Title</div>
                                foreach (var item in children)
                                {
                                    string itemUrl = !string.IsNullOrWhiteSpace(item.Url) ? item.Url : ("/" + item.Alias);
                                    bool isItemActive = false;
                                    if (!string.IsNullOrEmpty(itemUrl) && itemUrl != "#")
                                    {
                                        isItemActive = adminCurPath.Equals(itemUrl, StringComparison.OrdinalIgnoreCase) ||
                                                       (itemUrl.Length > 6 && adminCurPath.StartsWith(itemUrl, StringComparison.OrdinalIgnoreCase));
                                    }

                                    string iconClass = !string.IsNullOrWhiteSpace(item.Icon) ? item.Icon : "bi-circle";

                                    <a class="nav-link @(isItemActive ? "active" : "")" href="@itemUrl" title="@item.Title">
                                        <i class="bi @iconClass"></i>
                                        <span class="nav-label">@item.Title</span>

                                        @if (itemUrl.Contains("Cars/Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span id="pendingCarsBadge" class="badge bg-warning text-dark fw-bold rounded-pill ms-auto" style="font-size: 0.72rem; @(pendingCarsCount > 0 ? "" : "display:none;")">@pendingCarsCount</span>
                                        }
                                        else if (itemUrl.Contains("CarOwners/Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span id="pendingOwnersBadge" class="badge bg-warning text-dark fw-bold rounded-pill ms-auto" style="font-size: 0.72rem; @(pendingOwnersCount > 0 ? "" : "display:none;")">@pendingOwnersCount</span>
                                        }
                                    </a>
                                }
                            }
                            else
                            {
                                string pUrl = !string.IsNullOrWhiteSpace(group.Url) ? group.Url : ("/" + group.Alias);
                                bool isPActive = adminCurPath.Equals(pUrl, StringComparison.OrdinalIgnoreCase);
                                string pIcon = !string.IsNullOrWhiteSpace(group.Icon) ? group.Icon : "bi-circle";
                                <a class="nav-link @(isPActive ? "active" : "")" href="@pUrl" title="@group.Title">
                                    <i class="bi @pIcon"></i>
                                    <span class="nav-label">@group.Title</span>
                                </a>
                            }
                        }
                    }
                </nav>
            </div>

            <!-- Bottom Actions -->
            <div class="pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                <a href="/" target="_blank" class="nav-link recar-nav-pills text-white-50 d-flex align-items-center gap-2 py-2 px-2 rounded mb-1 text-decoration-none">
                    <i class="bi bi-arrow-left-circle text-info"></i>
                    <span class="small sidebar-footer-text">Quay về sàn ReCar</span>
                </a>
                <a asp-area="Admin" asp-controller="Home" asp-action="Logout" class="nav-link recar-nav-pills text-danger d-flex align-items-center gap-2 py-2 px-2 rounded text-decoration-none">
                    <i class="bi bi-box-arrow-left"></i>
                    <span class="small fw-semibold sidebar-footer-text">Đăng xuất</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="flex-grow-1 d-flex flex-column recar-main-content" style="min-width: 0;">
            <!-- Topbar Header -->
            <header class="recar-topbar">
                <div class="d-flex align-items-center gap-3">
                    <!-- Nút thu vào / bật ra Sidebar (dùng chung cho cả Desktop và Mobile) -->
                    <button class="btn btn-sm btn-light border-0 shadow-none rounded-circle d-flex align-items-center justify-content-center" id="btnToggleSidebar" type="button" style="width: 38px; height: 38px; background: #f1f5f9; color: #334155;" title="Thu gọn / Mở rộng menu">
                        <i class="bi bi-text-indent-left fs-5" id="sidebarToggleIcon"></i>
                    </button>
                    <!-- Breadcrumbs -->
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 small">
                            <li class="breadcrumb-item text-muted">Admin</li>
                            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">@pageTitle</li>
                        </ol>
                    </nav>
                </div>

                <!-- Right Tools: Search, Notification, Profile -->
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative d-none d-md-block">
                        <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 9px; font-size: 0.85rem;"></i>
                        <input type="text" class="recar-search-input" placeholder="Tìm kiếm nhanh đơn, biển số, xe..." />
                    </div>

                    <!-- Direct Chat Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light position-relative rounded-circle p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btnAdminChat" title="Tin nhắn trực tiếp">
                            <i class="bi bi-chat-dots text-secondary"></i>
                            <span id="chatNotificationDot" class="position-absolute top-0 start-100 translate-middle p-1 bg-primary border border-light rounded-circle" style="display:none; width: 8px; height: 8px; margin-top: 6px; margin-left: -6px;"></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg p-2 border-0" style="width: 350px; max-width: 90vw; border-radius: 16px; margin-top: 10px;">
                            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1.5" style="font-size: 0.88rem;">
                                    <i class="bi bi-chat-dots-fill text-primary" style="font-size: 15px;"></i> Tin nhắn trao đổi
                                </h6>
                                <span class="badge bg-light text-primary border" style="font-size: 11px;">Trực tuyến</span>
                            </div>
                            <div id="recentChatList" style="max-height: 320px; overflow-y: auto;">
                                <div class="text-center py-4 text-muted small" id="emptyChatNotice">
                                    <i class="bi bi-chat-dots fs-2 text-secondary opacity-50 d-block mb-2"></i>
                                    Chưa có cuộc trò chuyện nào
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notification Bell Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light position-relative rounded-circle p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btnAdminBell" title="Thông báo hệ thống">
                            <i class="bi bi-bell text-secondary"></i>
                            <span id="adminNotificationDot" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="display:none; width: 8px; height: 8px; margin-top: 6px; margin-left: -6px;">
                                <span class="visually-hidden">Thông báo mới</span>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg p-2 border-0" style="width: 360px; max-width: 90vw; border-radius: 16px;">
                            <li>
                                <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1.5" style="font-size: 0.88rem;">
                                        <i class="bi bi-bell-fill text-primary"></i> Thông báo hệ thống
                                    </h6>
                                    <button type="button" class="btn btn-link p-0 text-decoration-none text-muted small" id="btnAdminMarkAllRead" title="Đánh dấu tất cả đã đọc" style="font-size: 0.75rem;">
                                        <i class="bi bi-check2-all me-1"></i>Đọc tất cả
                                    </button>
                                </div>
                            </li>
                            <div style="max-height: 380px; overflow-y: auto;">
                                <li id="adminNotificationEmpty" class="text-center py-4 text-muted small">
                                    <i class="bi bi-inbox fs-2 text-secondary opacity-50 d-block mb-2"></i>
                                    Không có thông báo mới
                                </li>
                                <div id="adminNotificationList" class="p-1"></div>
                            </div>
                        </ul>
                    </div>

                    <!-- Profile Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light d-flex align-items-center gap-2 rounded-pill px-2.5 py-1.5" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (!string.IsNullOrEmpty(adminAvatar))
                            {
                                <img src="@adminAvatar" alt="@adminName" class="rounded-circle object-fit-cover shadow-xs border" style="width: 32px; height: 32px;" onerror="this.onerror=null; this.src='/images/default-avatar.png';" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    @adminInitials
                                </div>
                            }
                            <div class="text-start d-none d-sm-block">
                                <div class="fw-bold small text-dark leading-tight">@adminName</div>
                                <span class="badge" style="background-color: #e0f2fe; color: #0369a1; font-size: 0.65rem;">Quản trị viên</span>
                            </div>
                            <i class="bi bi-chevron-down text-muted small"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm p-2 mt-1" style="border-radius: 12px; min-width: 220px;">
                            <li class="px-2 py-2 border-bottom mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(adminAvatar))
                                    {
                                        <img src="@adminAvatar" alt="@adminName" class="rounded-circle object-fit-cover shadow-xs border" style="width: 36px; height: 36px;" onerror="this.onerror=null; this.src='/images/default-avatar.png';" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                            @adminInitials
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-bold small text-dark text-truncate" style="max-width: 140px;">@adminName</div>
                                        <div class="text-muted text-truncate" style="font-size: 0.72rem; max-width: 140px;">@(Function.GetEmail(Context.Session) ?? "admin@recar.vn")</div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                <a class="dropdown-item rounded small py-2" asp-area="Admin" asp-controller="Account" asp-action="Edit">
                                    <i class="bi bi-person me-2"></i> Hồ sơ cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded small py-2" asp-area="Admin" asp-controller="Settings" asp-action="Index">
                                    <i class="bi bi-gear me-2"></i> Cấu hình sàn
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item rounded small py-2 text-danger fw-semibold" asp-area="Admin" asp-controller="Home" asp-action="Logout">
                                    <i class="bi bi-box-arrow-left me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content Body -->
            <main class="flex-grow-1 p-3 p-md-4">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
                © 2026 <strong>ReCar Platform</strong> — Hệ thống quản trị nền tảng chia sẻ & cho thuê ô tô trực tuyến. Chuẩn đồ án tốt nghiệp.
            </footer>
        </div>
    </div>

    <!-- Floating Chat Window (Trao đổi trực tiếp của Admin với Chủ xe & Khách hàng) -->
    <div class="recar-chat-window" id="recarChatWindow">
        <div class="chat-header">
            <div class="d-flex align-items-center gap-2">
                <span class="rounded-circle bg-success" style="width: 8px; height: 8px;"></span>
                <span class="fw-bold small text-truncate" id="chatPartnerName" style="max-width: 220px;">Đối tác ReCar</span>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-link text-white p-0 me-1" onclick="minimizeChat()"><i class="bi bi-dash-lg"></i></button>
                <button type="button" class="btn btn-sm btn-link text-white p-0" onclick="closeChat()"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div class="chat-body" id="chatMessages">
            <div class="chat-bubble from-owner" id="chatFirstMessage">
                Chào bạn! Tôi là Quản trị viên ReCar. Tôi có thể hỗ trợ gì cho bạn về xe hoặc các thủ tục trên sàn?
            </div>
        </div>
        <div id="chatTypingIndicator" style="display: none; padding: 5px 16px; font-size: 11px; color: #64748b; font-style: italic; background: #f8fafc; border-top: 1px dashed #e2e8f0;">
            <span class="spinner-grow spinner-grow-sm text-primary me-1" style="width: 8px; height: 8px;" role="status"></span>
            <span id="chatTypingText">Đối tác đang soạn tin...</span>
        </div>
        <div class="chat-footer">
            <input type="text" class="form-control form-control-sm rounded-pill border" id="chatInputText" placeholder="Nhập tin nhắn..." autocomplete="off">
            <button class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" id="btnSendChat" style="width: 32px; height: 32px; flex-shrink: 0;">
                <i class="bi bi-send-fill" style="font-size: 12px;"></i>
            </button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/admin/assets/vendors/jquery/jquery.min.js"></script>
    <script src="~/admin/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/vendor/signalr.min.js"></script>
    <script>
        window.RECAR_CURRENT_USER = {
            accountId: @(Function.GetAdminAccountId(Context.Session) > 0 ? Function.GetAdminAccountId(Context.Session) : (Function.GetAccountId(Context.Session) > 0 ? Function.GetAccountId(Context.Session) : 1)),
            role: 'Admin',
            userName: '@(Function.GetUserName(Context.Session) ?? "Quản Trị Viên")'
        };

        var currentChatCarId = null;
        var currentChatPartnerId = null;
        var currentChatPartnerName = 'Đối tác ReCar';

        function openChatBox(partnerName, greeting, carId, partnerId, carName) {
            currentChatPartnerName = partnerName || 'Đối tác ReCar';
            currentChatCarId = carId || null;
            currentChatPartnerId = partnerId || null;

            $('#chatPartnerName').text(currentChatPartnerName);
            $('#recarChatWindow').addClass('open');
            $('#chatMessages').html('<div class="text-center py-3 text-muted small"><div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div> Đang tải lịch sử tin nhắn...</div>');

            $.ajax({
                url: '/Chat/GetMessages',
                type: 'GET',
                data: { carId: currentChatCarId, partnerId: currentChatPartnerId, asAdmin: true },
                success: function(res) {
                    $('#chatMessages').empty();
                    if (res && res.success && res.messages && res.messages.length > 0) {
                        res.messages.forEach(function(m) {
                            var bubbleClass = m.isMe ? 'chat-bubble from-user' : 'chat-bubble from-owner';
                            var bubble = $('<div class="' + bubbleClass + '"></div>');
                            var senderHeader = m.isMe ? 'Bạn' : m.senderName;
                            bubble.append($('<div class="fw-bold mb-1" style="font-size: 11px; opacity: 0.85;"></div>').text(senderHeader + ' · ' + m.sentAt));
                            bubble.append($('<div></div>').text(m.messageText));
                            $('#chatMessages').append(bubble);
                        });
                    } else {
                        var defaultMsg = greeting || 'Chào bạn! Tôi là Quản trị viên ReCar. Tôi có thể hỗ trợ gì cho bạn?';
                        var bubble = $('<div class="chat-bubble from-owner"></div>');
                        bubble.append($('<div class="fw-bold mb-1" style="font-size: 11px; opacity: 0.85;"></div>').text(currentChatPartnerName));
                        bubble.append($('<div></div>').text(defaultMsg));
                        $('#chatMessages').append(bubble);
                    }
                    $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
                },
                error: function() {
                    $('#chatMessages').html('<div class="chat-bubble from-owner"><div class="fw-bold mb-1" style="font-size: 11px;">' + currentChatPartnerName + '</div>' + (greeting || 'Chào bạn! Rất vui được hỗ trợ bạn.') + '</div>');
                }
            });
            setTimeout(function() { $('#chatInputText').focus(); }, 200);
        }

        window.openChatBox = openChatBox;
        window.closeChat = closeChat;
        window.minimizeChat = minimizeChat;
        window.loadRecentChats = loadRecentChats;

        function closeChat() {
            $('#recarChatWindow').removeClass('open');
        }

        function minimizeChat() {
            $('#recarChatWindow').toggleClass('open');
        }

        function sendChatMessage() {
            var msg = $('#chatInputText').val().trim();
            if (!msg || !currentChatPartnerId) return;

            var nowStr = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
            var userBubble = $('<div class="chat-bubble from-user"></div>');
            userBubble.append($('<div class="fw-bold mb-1" style="font-size: 11px; opacity: 0.85;">Bạn · ' + nowStr + '</div>'));
            userBubble.append($('<div></div>').text(msg));
            $('#chatMessages').append(userBubble);
            $('#chatInputText').val('');
            $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);

            $.ajax({
                url: '/Chat/SendMessage',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    carId: currentChatCarId,
                    receiverId: currentChatPartnerId,
                    messageText: msg,
                    asAdmin: true
                }),
                success: function(res) {
                    if (res && res.success) {
                        loadRecentChats();
                    }
                }
            });
        }

        function safeDecodeName(str) {
            if (!str) return 'Đối tác';
            var s = String(str).replace(/&#x([0-9a-fA-F]+);/g, function(m, h) {
                return String.fromCharCode(parseInt(h, 16));
            }).replace(/&#([0-9]+);/g, function(m, d) {
                return String.fromCharCode(parseInt(d, 10));
            });
            try {
                var ta = document.createElement("textarea");
                ta.innerHTML = s;
                var res = ta.value;
                if (res.indexOf('&') !== -1) {
                    ta.innerHTML = res;
                    res = ta.value;
                }
                return res;
            } catch(e) {
                return s;
            }
        }

        function loadRecentChats() {
            $.ajax({
                url: '/Chat/GetRecentConversations',
                data: { asAdmin: true },
                type: 'GET',
                success: function(res) {
                    if (res && typeof res.unreadCount !== 'undefined') {
                        if (res.unreadCount > 0) {
                            $('#chatNotificationDot').show();
                        } else {
                            $('#chatNotificationDot').hide();
                        }
                    }

                    var container = $('#recentChatList');
                    if (!container.length) return;

                    if (res && res.success && res.conversations && res.conversations.length > 0) {
                        container.empty();
                        res.conversations.forEach(function(c) {
                            var pName = safeDecodeName(c.partnerName);
                            var initials = pName ? pName.substring(0, 2).toUpperCase() : 'DT';
                            var item = $('<div class="chat-item"></div>');
                            item.html('<div class="chat-avatar">' + initials + '</div>' +
                                '<div class="flex-grow-1 overflow-hidden" style="font-size: 13px;">' +
                                    '<div class="d-flex justify-content-between">' +
                                        '<strong class="text-truncate" style="max-width: 140px;">' + pName + '</strong>' +
                                        '<span class="text-muted" style="font-size: 11px;">' + c.time + '</span>' +
                                    '</div>' +
                                    '<p class="text-muted text-truncate m-0" style="font-size: 12px;">' + c.lastMessage + '</p>' +
                                '</div>');
                            item.on('click', function() {
                                openChatBox(pName, c.lastMessage, c.carId, c.partnerId, c.title);
                            });
                            container.append(item);
                        });
                    } else {
                        container.html('<div class="text-center py-4 text-muted small" id="emptyChatNotice"><i class="bi bi-chat-dots fs-2 text-secondary opacity-50 d-block mb-2"></i>Chưa có cuộc trò chuyện nào</div>');
                    }
                }
            });
        }

        window.handleIncomingChatMessage = function(msg) {
            var isCurrentConversation = false;
            if (currentChatPartnerId && (msg.senderId == currentChatPartnerId || msg.receiverId == currentChatPartnerId)) {
                isCurrentConversation = true;
            }

            if (isCurrentConversation && $('#recarChatWindow').hasClass('open')) {
                $('#chatTypingIndicator').hide();
                var isMe = (window.RECAR_CURRENT_USER && window.RECAR_CURRENT_USER.accountId == msg.senderId);
                var bubbleClass = isMe ? 'chat-bubble from-user' : 'chat-bubble from-owner';
                var bubble = $('<div class="' + bubbleClass + '"></div>');
                var senderHeader = isMe ? 'Bạn' : msg.senderName;
                bubble.append($('<div class="fw-bold mb-1" style="font-size: 11px; opacity: 0.85;">' + senderHeader + ' · ' + msg.sentAt + '</div>'));
                bubble.append($('<div></div>').text(msg.messageText));
                $('#chatMessages').append(bubble);
                $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
                loadRecentChats();
                return true;
            }
            loadRecentChats();
            return false;
        };

        window.handleIncomingTyping = function(data) {
            var isCurrent = (currentChatPartnerId && data.senderId == currentChatPartnerId);
            if (isCurrent && $('#recarChatWindow').hasClass('open')) {
                if (data.isTyping) {
                    var sName = data.senderName || 'Đối tác';
                    $('#chatTypingText').text(sName + ' đang soạn tin...');
                    $('#chatTypingIndicator').stop(true, true).fadeIn(150);
                    $('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
                } else {
                    $('#chatTypingIndicator').stop(true, true).fadeOut(150);
                }
            }
        };

        $('#btnSendChat').on('click', sendChatMessage);
        $('#chatInputText').on('keypress', function(e) {
            if (e.which === 13) sendChatMessage();
        });
        $('#btnAdminChat').on('click', function() {
            $('#chatNotificationDot').fadeOut();
            loadRecentChats();
        });

        function toggleSidebar() {
            if (window.innerWidth < 992) {
                var sb = document.getElementById('adminSidebar');
                if (sb) sb.classList.toggle('show');
            } else {
                // Bật class animating tạm thời trong 250ms để hiệu ứng co giãn mượt mà chỉ khi bấm nút
                document.body.classList.add('sidebar-animating');

                var isCurrentlyCollapsed = document.documentElement.classList.contains('sidebar-collapsed') || document.body.classList.contains('sidebar-collapsed');
                var willCollapse = !isCurrentlyCollapsed;
                
                if (willCollapse) {
                    document.documentElement.classList.add('sidebar-collapsed');
                    document.body.classList.add('sidebar-collapsed');
                    localStorage.setItem('recar_admin_sidebar_collapsed', 'true');
                } else {
                    document.documentElement.classList.remove('sidebar-collapsed');
                    document.body.classList.remove('sidebar-collapsed');
                    localStorage.setItem('recar_admin_sidebar_collapsed', 'false');
                }
                
                var icon = document.getElementById('sidebarToggleIcon');
                if (icon) {
                    icon.className = willCollapse ? 'bi bi-text-indent-right fs-5' : 'bi bi-text-indent-left fs-5';
                }

                setTimeout(function() {
                    document.body.classList.remove('sidebar-animating');
                }, 250);
            }
        }

        // Khôi phục trạng thái thu gọn và icon từ localStorage
        (function() {
            var isSavedCollapsed = localStorage.getItem('recar_admin_sidebar_collapsed') === 'true';
            if (isSavedCollapsed && window.innerWidth >= 992) {
                document.documentElement.classList.add('sidebar-collapsed');
                document.body.classList.add('sidebar-collapsed');
                var icon = document.getElementById('sidebarToggleIcon');
                if (icon) icon.className = 'bi bi-text-indent-right fs-5';
            } else {
                document.documentElement.classList.remove('sidebar-collapsed');
                document.body.classList.remove('sidebar-collapsed');
                var icon = document.getElementById('sidebarToggleIcon');
                if (icon) icon.className = 'bi bi-text-indent-left fs-5';
            }
        })();

        // Lưu & Khôi phục vị trí cuộn của Sidebar (giữ nguyên vị trí khi chọn các mục ở dưới, không bao giờ bị reset)
        (function() {
            var sb = document.getElementById('adminSidebar');
            if (!sb) return;

            // 1. Khôi phục vị trí cuộn đã lưu
            var savedScroll = sessionStorage.getItem('recar_admin_sidebar_scroll');
            if (savedScroll !== null) {
                sb.scrollTop = parseInt(savedScroll, 10);
            }

            // 2. Đảm bảo mục đang active luôn xuất hiện rõ ràng trong khung nhìn (nếu đang bị khuất bên dưới)
            var activeLink = sb.querySelector('.nav-link.active');
            if (activeLink) {
                var rect = activeLink.getBoundingClientRect();
                var sbRect = sb.getBoundingClientRect();
                if (rect.top < sbRect.top || rect.bottom > sbRect.bottom) {
                    activeLink.scrollIntoView({ block: 'nearest', behavior: 'instant' });
                }
            }

            // 3. Lắng nghe sự kiện cuộn để lưu vị trí
            sb.addEventListener('scroll', function() {
                sessionStorage.setItem('recar_admin_sidebar_scroll', sb.scrollTop);
            }, { passive: true });

            // 4. Lưu lại ngay lập tức khi click vào bất kỳ liên kết nào trong sidebar
            sb.querySelectorAll('a').forEach(function(link) {
                link.addEventListener('click', function() {
                    sessionStorage.setItem('recar_admin_sidebar_scroll', sb.scrollTop);
                });
            });
        })();

        document.getElementById('btnToggleSidebar')?.addEventListener('click', toggleSidebar);

        // Tắt chấm đỏ chuông khi Admin bấm xem
        document.getElementById('btnAdminBell')?.addEventListener('click', function() {
            var dot = document.getElementById('adminNotificationDot');
            if (dot) dot.style.display = 'none';
        });
    </script>
    <script src="~/assets/js/recar-realtime.js"></script>
    <script src="~/assets/js/recar-notifications.js"></script>
    <script>
        $(document).ready(function() {
            if (typeof RecarNotificationManager !== 'undefined') {
                RecarNotificationManager.init({
                    bellBtnId: 'btnAdminBell',
                    dotId: 'adminNotificationDot',
                    listId: 'adminNotificationList',
                    emptyId: 'adminNotificationEmpty',
                    markAllBtnId: 'btnAdminMarkAllRead'
                });
            }
            if (typeof loadRecentChats === 'function') {
                loadRecentChats();
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>