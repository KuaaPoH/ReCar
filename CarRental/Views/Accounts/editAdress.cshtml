@model CarRental.ViewModels.EditAddressVM
@{
    ViewData["Title"] = "Cập nhật địa chỉ nhận xe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Breadcrumb Area -->
<div class="recar-section bg-light py-4 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="font-size: 14px;">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Accounts/Index" class="text-decoration-none text-muted">Tài khoản</a></li>
                <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">Địa chỉ nhận xe</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1" style="color: var(--recar-dark);">Cập nhật địa chỉ & Số điện thoại</h2>
        <p class="text-muted mb-0">Thông tin địa chỉ thường trú hoặc địa chỉ nhận bàn giao xe ô tô</p>
    </div>
</div>

<div class="recar-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Thông tin giao nhận xe</h5>
                            <p class="text-muted small mb-0">Địa chỉ này dùng để lập hợp đồng thuê xe và đối chiếu khi giao nhận</p>
                        </div>
                    </div>

                    <form id="editAddressForm" method="post" accept-charset="UTF-8" asp-controller="Accounts" asp-action="editAdress">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CustomerID" />

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold text-secondary small">
                                Địa chỉ cụ thể (Số nhà, Tên đường, Phường/Xã, Quận/Huyện, Tỉnh/TP) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Address" class="form-control form-control-lg rounded-3 fs-6" placeholder="Ví dụ: 123 Cầu Giấy, P. Dịch Vọng, Q. Cầu Giấy, Hà Nội" required />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label fw-semibold text-secondary small">
                                Số điện thoại liên hệ nhận xe <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Phone" type="tel" class="form-control form-control-lg rounded-3 fs-6" placeholder="Ví dụ: 0912345678" required />
                            <div class="form-text text-muted small">
                                <i class="bi bi-shield-lock me-1"></i> Số điện thoại sẽ được dùng để chủ xe gọi xác nhận trước giờ giao xe 30 phút.
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-3 border-top gap-3">
                            <a href="javascript:history.back()" class="btn btn-light rounded-3 px-4 py-2 text-secondary fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary rounded-3 px-5 py-2 fw-bold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $("#editAddressForm").submit(function (e) {
                e.preventDefault();

                var formData = $(this).serialize();

                $.ajax({
                    url: '/Accounts/editAdress',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (typeof response === 'string') {
                            try {
                                response = JSON.parse(response);
                            } catch (e) {
                                return;
                            }
                        }

                        if (response.success) {
                            var returnUrl = response.returnUrl || '/Cart/Checkout';
                            var hasReturnUrl = returnUrl && returnUrl.includes('/Cart/Checkout');

                            Swal.fire({
                                icon: 'success',
                                title: 'Cập nhật thành công!',
                                text: response.message || 'Địa chỉ của bạn đã được lưu vào hệ thống.',
                                confirmButtonText: hasReturnUrl ? 'Tiếp tục đặt xe ngay' : 'Về trang cá nhân',
                                confirmButtonColor: '#2563eb',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            }).then((result) => {
                                window.location.href = returnUrl;
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: response.message || 'Có lỗi xảy ra. Vui lòng kiểm tra lại.',
                                confirmButtonColor: '#2563eb'
                            });
                        }
                    },
                    error: function (xhr) {
                        var errorMessage = 'Có lỗi xảy ra trong quá trình lưu dữ liệu.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }

                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi kết nối',
                            text: errorMessage,
                            confirmButtonColor: '#2563eb'
                        });
                    }
                });
            });
        });
    </script>
}
