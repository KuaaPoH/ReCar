@model IEnumerable<CarRental.ViewModels.CartItemsVM>
@{
    ViewData["Title"] = "Xe đang giữ chỗ – ReCar";
    decimal total = Model != null ? Model.Sum(p => p.PriceTotal) : 0;
    decimal deposit = total * 0.3m;
    decimal remaining = total - deposit;
}

<!-- Breadcrumb Area Start -->
<div class="py-3 bg-light border-bottom mb-4">
    <div class="container" style="max-width: 1280px;">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb m-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-decoration-none">Thuê xe</a></li>
                <li class="breadcrumb-item active" aria-current="page">Danh sách xe đang chọn</li>
            </ol>
        </nav>
        <h1 class="fs-4 fw-bold text-dark mt-2 mb-0">Xe đang chọn thuê</h1>
        <p class="text-muted small m-0">Kiểm tra thông tin lịch trình và tiến hành đặt cọc giữ chỗ 30%</p>
    </div>
</div>
<!-- Breadcrumb Area End -->

<div class="container mb-5" style="max-width: 1280px;">
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <!-- Cột trái: Bảng xe đã chọn -->
            <div class="col-lg-8">
                <div class="card p-3 border rounded-3 shadow-sm bg-white mb-3">
                    <div class="table-responsive">
                        <table class="table align-middle m-0">
                            <thead class="bg-light small text-uppercase text-muted">
                                <tr>
                                    <th scope="col" style="min-width: 120px;">Hình ảnh</th>
                                    <th scope="col">Thông tin xe</th>
                                    <th scope="col">Lịch trình thuê</th>
                                    <th scope="col" class="text-end">Thành tiền</th>
                                    <th scope="col" class="text-center">Xóa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    int days = (item.returnDate - item.pickupDate).Days;
                                    if (days <= 0) days = 1;

                                    <tr>
                                        <td>
                                            <img src="@item.Image" alt="@item.CarName" class="rounded-2" style="width: 100px; height: 65px; object-fit: cover;" />
                                        </td>
                                        <td>
                                            <a href="/product/@item.CartId" class="fw-bold text-dark text-decoration-none d-block">@item.CarName</a>
                                            <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                                                @if (item.DriveMode == "Có tài xế")
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-person-badge"></i> Có tài xế</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary text-white"><i class="bi bi-car-front"></i> Tự lái</span>
                                                }
                                            </div>
                                            @if (item.DriverFee > 0)
                                            {
                                                <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                                    Phí tài xế: <span class="fw-semibold text-primary">+@item.DriverFee.ToString("N0")đ</span> (@days ngày)
                                                </div>
                                            }
                                        </td>
                                        <td class="small text-muted">
                                            <div><i class="bi bi-calendar-event text-primary me-1"></i>Nhận: <strong>@item.pickupDate.ToString("dd/MM/yyyy")</strong></div>
                                            <div><i class="bi bi-calendar-check text-success me-1"></i>Trả: <strong>@item.returnDate.ToString("dd/MM/yyyy")</strong></div>
                                            <div class="text-primary fw-semibold mt-1">(@days ngày)</div>
                                        </td>
                                        <td class="text-end">
                                            <div class="fw-bold text-primary fs-6">@item.PriceTotal.ToString("N0")đ</div>
                                        </td>
                                        <td class="text-center">
                                            <a asp-controller="Cart" asp-action="removeCart" asp-route-id="@item.CartId" class="btn btn-sm btn-outline-danger" title="Xóa khỏi danh sách">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn xe khác
                    </a>
                </div>
            </div>

            <!-- Cột phải: Bảng thanh toán tiền cọc 30% -->
            <div class="col-lg-4">
                <div class="card p-4 border rounded-4 shadow-sm bg-white sticky-top" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-receipt text-primary me-1"></i> Tóm tắt chi phí</h5>
                    
                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="text-muted">Tiền thuê xe:</span>
                        <span class="fw-bold text-dark">@((total - Model.Sum(p => p.DriverFee)).ToString("N0"))đ</span>
                    </div>

                    @if (Model.Any(p => p.DriverFee > 0))
                    {
                        <div class="d-flex justify-content-between py-2 border-bottom small">
                            <span class="text-muted">Phụ phí tài xế:</span>
                            <span class="fw-bold text-primary">+@Model.Sum(p => p.DriverFee).ToString("N0")đ</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between py-2 border-bottom small">
                        <span class="fw-bold text-dark">Tổng tiền dự kiến:</span>
                        <span class="fw-bold text-dark fs-6">@total.ToString("N0")đ</span>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="fw-bold text-primary">Tiền đặt cọc giữ chỗ (30%):</span>
                        <span class="fw-bold text-primary fs-5">@deposit.ToString("N0")đ</span>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom small text-muted">
                        <span>Thanh toán cho chủ xe khi nhận (70%):</span>
                        <span class="fw-semibold text-dark">@remaining.ToString("N0")đ</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 my-3 small border">
                        <div class="d-flex align-items-start gap-2 text-muted">
                            <i class="bi bi-shield-check text-success fs-5"></i>
                            <div>
                                <strong>Bảo vệ đặt cọc ReCar (Trung gian):</strong>
                                <p class="m-0 mt-1" style="font-size: 0.78rem;">
                                    ReCar là nền tảng trung gian bảo vệ giao dịch. Tiền cọc 30% được giữ an toàn qua cổng VNPay và chỉ giải ngân sau khi hai bên ký kết biên bản bàn giao xe.
                                </p>
                            </div>
                        </div>
                    </div>

                    <a asp-controller="Cart" asp-action="Checkout" class="btn btn-warning w-100 py-2 fw-bold text-dark fs-6 rounded-3 shadow-sm">
                        Tiến hành đặt cọc & thanh toán <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="p-5 bg-white rounded-4 border shadow-sm mx-auto" style="max-width: 500px;">
                <i class="bi bi-cart-x text-muted" style="font-size: 3.5rem;"></i>
                <h4 class="fw-bold text-dark mt-3">Danh sách thuê xe đang trống</h4>
                <p class="text-muted small mb-4">Bạn chưa chọn chiếc xe nào để đặt cọc giữ chỗ. Hãy khám phá ngay hàng trăm mẫu xe đang sẵn sàng!</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2 fw-semibold rounded-3">
                    <i class="bi bi-search me-1"></i> Khám phá xe ngay
                </a>
            </div>
        </div>
    }
</div>
