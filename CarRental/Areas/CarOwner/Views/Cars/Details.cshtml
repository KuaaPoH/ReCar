@model CarRental.Models.Car
@using CarRental.Utilities
@{
    ViewData["Title"] = $"Chi tiết xe: {Model.CarName}";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";

    var galleryImages = ViewBag.GalleryImages as List<string> ?? new List<string>();
    var amenityItems = ViewBag.AmenityItems as List<CarRental.Models.Amenity> ?? new List<CarRental.Models.Amenity>();
    var amenities = ViewBag.Amenities as List<string> ?? new List<string>();
    var carPolicy = ViewBag.CarPolicy as CarRental.Utilities.CarPolicy ?? CarRental.Utilities.CarPolicy.Parse(Model);
    var carOrders = ViewBag.CarOrders as List<CarRental.Models.OrderDetail> ?? new List<CarRental.Models.OrderDetail>();

    var reviews = Model.CarReviews?.OrderByDescending(r => r.CreatedDate ?? DateTime.MinValue).ThenByDescending(r => r.CarReviewId).ToList() ?? new List<CarRental.Models.CarReview>();
    double avgRating = reviews.Any() ? reviews.Average(r => (double)(r.Star ?? 5)) : (Model.Rate ?? 5.0);

    string status = Model.CarStatus ?? "Sẵn sàng";
    bool isAvailable = status == "Sẵn sàng" || (status == "active" && Model.IsActive);
    bool isBusy = status == "Đang bận" || status == "Đang có khách" || status == "busy";
    bool isPending = status == "Chờ duyệt" || status == "pending";
    bool isPendingUpdate = status == "Chờ cập nhật" || status == "pending_update";
    bool isPaused = status == "Tạm ngưng" || status == "paused";
    bool isRejected = status == "Từ chối" || status == "rejected";

    // Bóc tách lý do từ chối từ Quản trị viên nếu có
    string rejectionReason = "";
    string rejectionTime = "";
    if (isRejected && !string.IsNullOrWhiteSpace(Model.Descriptions))
    {
        string desc = Model.Descriptions;
        if (desc.Contains("Lý do từ chối:"))
        {
            int startIdx = desc.IndexOf("Lý do từ chối:") + "Lý do từ chối:".Length;
            int timeIdx = desc.LastIndexOf("(Cập nhật lúc");
            if (timeIdx > startIdx)
            {
                rejectionReason = desc.Substring(startIdx, timeIdx - startIdx).Trim();
                rejectionTime = desc.Substring(timeIdx).Replace("(", "").Replace(")", "").Replace("Cập nhật lúc", "").Trim();
            }
            else
            {
                rejectionReason = desc.Substring(startIdx).Trim();
            }
        }
        else
        {
            rejectionReason = desc.Trim();
        }
    }

    decimal regularPrice = Model.Price ?? 0;
    decimal? salePrice = Model.SalePrice;
    bool hasSale = Model.IsSale && salePrice.HasValue && salePrice.Value > 0 && salePrice.Value < regularPrice;
}

<div class="space-y-4">
    <!-- Breadcrumb / Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark tracking-tight mb-1">Chi tiết xe</h1>
            <p class="text-muted small mb-0">Hồ sơ phương tiện, thông số, giá thuê và lịch sử giao dịch.</p>
        </div>
        <a href="/CarOwner/Cars/Index" class="btn btn-light border rounded-pill px-3 py-1.5 fw-semibold text-secondary small d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Thông báo nếu xe đang chờ duyệt -->
    @if (isPending || isPendingUpdate)
    {
        <div class="alert border-0 rounded-4 shadow-sm mb-4 p-4" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border-left: 5px solid #f59e0b !important;">
            <div class="d-flex align-items-start gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #fde68a; color: #b45309;">
                    <i class="bi bi-hourglass-split fs-5"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                        <span>Hồ sơ xe đang chờ Quản trị viên ReCar kiểm duyệt</span>
                        <span class="badge rounded-pill bg-warning text-dark px-2.5 py-1" style="font-size: 0.72rem;">Chờ thẩm định</span>
                    </h6>
                    <p class="text-secondary small mb-2">
                        Hồ sơ đăng ký của bạn đã được chuyển tới Ban Kiểm duyệt ReCar. Đội ngũ thẩm định sẽ kiểm tra thông tin pháp lý (Cà vẹt, Đăng kiểm, Bảo hiểm) và hình ảnh xe trong vòng <strong>24 giờ làm việc</strong>.
                    </p>
                    <div class="d-flex flex-wrap gap-2 pt-1">
                        <a href="/CarOwner/Cars/Edit/@Model.CarId" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 fw-semibold">
                            <i class="bi bi-pencil me-1.5"></i>Chỉnh sửa bổ sung thông tin
                        </a>
                        <a href="/CarOwner/Cars" class="btn btn-sm btn-light border rounded-pill px-3 text-secondary">
                            <i class="bi bi-arrow-left me-1.5"></i>Quay lại danh sách xe
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Thông báo nếu bị từ chối -->
    @if (isRejected)
    {
        <div class="alert border-0 rounded-4 shadow-sm mb-4 p-4" style="background: linear-gradient(135deg, #fff5f5 0%, #fee2e2 100%); border-left: 5px solid #ef4444 !important;">
            <div class="d-flex align-items-start gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; background: #fecaca; color: #dc2626;">
                    <i class="bi bi-x-octagon-fill fs-5"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1.5">
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <span>Hồ sơ xe không được phê duyệt</span>
                            <span class="badge rounded-pill bg-danger text-white px-2.5 py-1" style="font-size: 0.72rem;">Bị từ chối kiểm duyệt</span>
                        </h6>
                        @if (!string.IsNullOrEmpty(rejectionTime))
                        {
                            <span class="text-muted small" style="font-size: 0.76rem;">
                                <i class="bi bi-clock me-1"></i>Thời gian: @rejectionTime
                            </span>
                        }
                    </div>

                    <div class="p-3 my-2.5 rounded-3 bg-white border border-danger-subtle shadow-xs">
                        <div class="d-flex align-items-center gap-2 text-danger fw-bold small mb-1.5">
                            <i class="bi bi-chat-quote-fill"></i> Lý do từ chối từ Quản trị viên:
                        </div>
                        <div class="text-dark fw-medium ps-3 border-start border-3 border-danger" style="font-size: 0.92rem; line-height: 1.55;">
                            @(string.IsNullOrWhiteSpace(rejectionReason) ? "Thông tin phương tiện hoặc hình ảnh giấy tờ pháp lý chưa đạt tiêu chuẩn kiểm duyệt. Vui lòng kiểm tra lại ảnh chụp cà vẹt, sổ đăng kiểm và bảo hiểm xe." : rejectionReason)
                        </div>
                    </div>

                    <p class="text-secondary small mb-3" style="line-height: 1.45;">
                        Bạn có thể bấm <strong>Chỉnh sửa & Cập nhật lại hồ sơ</strong> bên dưới để cập nhật lại thông tin xe hoặc tải lại hình ảnh giấy tờ pháp lý rõ nét hơn. Sau khi lưu, hồ sơ sẽ được tự động gửi lại để Ban Quản trị ReCar thẩm định.
                    </p>

                    <div class="d-flex flex-wrap gap-2 pt-1">
                        <a href="/CarOwner/Cars/Edit/@Model.CarId" class="btn btn-sm btn-danger rounded-pill px-3.5 py-1.5 fw-semibold shadow-xs">
                            <i class="bi bi-pencil-square me-1.5"></i>Chỉnh sửa & Cập nhật lại hồ sơ
                        </a>
                        <a href="/CarOwner/Cars" class="btn btn-sm btn-light border rounded-pill px-3 py-1.5 text-secondary">
                            <i class="bi bi-arrow-left me-1.5"></i>Quay lại danh sách xe
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Phần 1: Ảnh lớn & Thẻ thông tin nhanh -->
    <div class="row g-4 mb-4">
        <!-- Cột Trái: Ảnh xe 16:9 + Album 4 ảnh -->
        <div class="col-12 col-xl-7">
            <div class="card-surface overflow-hidden h-100 p-3">
                <img src="@(string.IsNullOrEmpty(Model.Image) ? "/images/cars/car-sedan.jpg" : Model.Image)" 
                     alt="@Model.CarName" 
                     class="w-100 rounded-3 object-fit-cover shadow-xs mb-3" 
                     style="aspect-ratio: 16 / 9; max-height: 380px;" />

                <div class="row g-2">
                    @if (galleryImages.Any())
                    {
                        foreach (var img in galleryImages.Take(4))
                        {
                            <div class="col-3">
                                <img src="@img" alt="Chi tiết" class="w-100 rounded-2 border object-fit-cover" style="aspect-ratio: 4 / 3;" />
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Fallback gallery thumbnails -->
                        for (int i = 0; i < 4; i++)
                        {
                            <div class="col-3">
                                <img src="@(string.IsNullOrEmpty(Model.Image) ? "/images/cars/car-sedan.jpg" : Model.Image)" 
                                     alt="Chi tiết" class="w-100 rounded-2 border object-fit-cover opacity-75" style="aspect-ratio: 4 / 3;" />
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Cột Phải: Thẻ thông tin, Giá & Thao tác -->
        <div class="col-12 col-xl-5">
            <div class="card-surface p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
                        <div>
                            <h2 class="h4 fw-bold text-dark mb-1">@Model.CarName</h2>
                            <span class="plate">@(string.IsNullOrEmpty(Model.LicensePlate) ? "CHƯA CẤP" : Model.LicensePlate)</span>
                        </div>
                        <div>
                            @if (isAvailable)
                            {
                                <span class="status-badge status-badge-ready">Sẵn sàng</span>
                            }
                            else if (isBusy)
                            {
                                <span class="status-badge status-badge-busy">Đang có khách</span>
                            }
                            else if (isPending)
                            {
                                <span class="status-badge status-badge-pending">Chờ duyệt</span>
                            }
                            else if (isPaused)
                            {
                                <span class="status-badge status-badge-paused">Tạm ngưng</span>
                            }
                            else if (isRejected)
                            {
                                <span class="status-badge status-badge-rejected">Từ chối</span>
                            }
                            else
                            {
                                <span class="status-badge status-badge-paused">@status</span>
                            }
                        </div>
                    </div>

                    <p class="text-muted small d-flex align-items-center gap-1.5 mb-3">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                        <span>@(string.IsNullOrEmpty(Model.Location) ? "Toàn quốc" : Model.Location)</span>
                    </p>

                    <div class="d-flex align-items-baseline gap-2 mb-4">
                        @if (hasSale)
                        {
                            <span class="h2 fw-bold text-primary mb-0">@salePrice!.Value.ToString("N0")đ</span>
                            <span class="text-muted text-decoration-line-through small">@regularPrice.ToString("N0")đ</span>
                        }
                        else
                        {
                            <span class="h2 fw-bold text-dark mb-0">@regularPrice.ToString("N0")đ</span>
                        }
                        <span class="text-muted small">/ngày</span>
                    </div>

                    <!-- 2 Hộp chỉ số mini -->
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="text-muted small" style="font-size: 0.72rem;">Chuyến hoàn thành</div>
                                <div class="h4 fw-bold text-dark mb-0 mt-1">@(Model.Trips ?? 0)</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="text-muted small" style="font-size: 0.72rem;">Đánh giá của khách</div>
                                <div class="h4 fw-bold text-dark mb-0 mt-1 d-flex align-items-center gap-1">
                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                    <span>@avgRating.ToString("0.0")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thao tác hành động -->
                <div class="d-flex flex-wrap gap-2 pt-3 border-top">
                    <a href="/CarOwner/Cars/Edit/@Model.CarId" class="btn btn-primary rounded-pill px-3.5 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background: #0284c7; border-color: #0284c7;">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa xe
                    </a>
                    <a href="/product/@(Model.Alias)-@(Model.CarId).html" target="_blank" class="btn btn-light border rounded-pill px-3.5 py-2 fw-semibold text-secondary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Xem trên sàn
                    </a>
                    <a href="/CarOwner/Cars/Delete/@Model.CarId" class="btn btn-outline-danger rounded-pill px-3.5 py-2 fw-semibold d-inline-flex align-items-center gap-2 ms-auto">
                        <i class="bi bi-trash3 me-1"></i> Gỡ xe
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Phần 2: Thông số kỹ thuật & Đánh giá của khách -->
    <div class="row g-4 mb-4">
        <!-- Thông số kỹ thuật & Tiện nghi -->
        <div class="col-12 col-lg-6">
            <div class="card-surface p-4 h-100">
                <h3 class="h5 fw-bold text-dark mb-3">Thông số kỹ thuật</h3>
                <dl class="row g-2 mb-4" style="font-size: 0.88rem;">
                    <dt class="col-6 text-muted fw-normal">Hãng sản xuất:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@(Model.CarBrand ?? "Đang cập nhật")</dd>

                    <dt class="col-6 text-muted fw-normal">Phân khúc / Kiểu xe:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@(Model.Type?.CarTypeName ?? "Sedan")</dd>

                    <dt class="col-6 text-muted fw-normal">Năm sản xuất:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@(Model.Model > 0 ? Model.Model.ToString() : "2024")</dd>

                    <dt class="col-6 text-muted fw-normal">Màu sắc:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@(string.IsNullOrEmpty(Model.Color) ? "Trắng" : Model.Color)</dd>

                    <dt class="col-6 text-muted fw-normal">Số chỗ ngồi:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@(Model.Seat ?? 5) chỗ</dd>

                    <dt class="col-6 text-muted fw-normal">Hộp số:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@(string.IsNullOrEmpty(Model.Transmission) ? "Tự động" : Model.Transmission)</dd>

                    <dt class="col-6 text-muted fw-normal">Nhiên liệu:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@(string.IsNullOrEmpty(Model.Fuel) ? "Xăng" : Model.Fuel)</dd>

                    <dt class="col-6 text-muted fw-normal">Mức tiêu thụ:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@(carPolicy.FuelConsumption ?? "6.5L/100km")</dd>

                    <dt class="col-6 text-muted fw-normal">Giới hạn quãng đường:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@carPolicy.MileageLimit km/ngày</dd>

                    <dt class="col-6 text-muted fw-normal">Phụ phí vượt quãng đường:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@carPolicy.ExtraFeePerKm.ToString("N0")đ/km</dd>

                    <dt class="col-6 text-muted fw-normal">Hỗ trợ giao xe tận nơi:</dt>
                    <dd class="col-6 fw-semibold text-dark mb-1">@(carPolicy.DeliverySupported ? $"Có hỗ trợ ({carPolicy.DeliveryFee:N0}đ)" : "Nhận xe trực tiếp tại bãi")</dd>
                </dl>

                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h4 class="h6 fw-bold text-dark mb-0">Tiện nghi trang bị (@(amenityItems.Any() ? amenityItems.Count : amenities.Count))</h4>
                    <span class="badge bg-light text-muted border small" style="font-size: 0.7rem;">Đồng bộ từ CSDL</span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (amenityItems.Any())
                    {
                        foreach (var am in amenityItems)
                        {
                            <span class="rounded-pill px-3 py-1.5 text-xs fw-semibold text-dark d-inline-flex align-items-center gap-1.5" style="background: #f0f9ff; border: 1px solid #bae6fd; font-size: 0.8rem;">
                                <i class="bi @(string.IsNullOrEmpty(am.Icon) ? "bi-check-circle-fill" : am.Icon) @(string.IsNullOrEmpty(am.IconColor) ? "text-primary" : am.IconColor)"></i>
                                <span>@am.Name</span>
                            </span>
                        }
                    }
                    else if (amenities.Any())
                    {
                        foreach (var am in amenities)
                        {
                            <span class="rounded-pill px-3 py-1 text-xs fw-semibold text-primary" style="background: #f0f9ff; border: 1px solid #bae6fd; font-size: 0.78rem;">
                                <i class="bi bi-check-circle-fill me-1"></i>@am
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small fst-italic">Chưa cập nhật tiện nghi cho xe này. Bấm Chỉnh sửa xe để chọn tiện nghi.</span>
                    }
                </div>

                <div class="mt-4 pt-3 border-top">
                    <h4 class="h6 fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                        <i class="bi bi-chat-left-quote-fill text-primary"></i> Mô tả & Nội quy của xe
                    </h4>
                    <div class="p-3 bg-light rounded-3 border text-secondary small" style="line-height: 1.6; white-space: pre-line;">
                        @(string.IsNullOrWhiteSpace(carPolicy.ExtraDescription) ? "Bạn chưa nhập mô tả hoặc nội quy riêng cho xe này. Bấm nút Chỉnh sửa xe ở trên để bổ sung." : carPolicy.ExtraDescription)
                    </div>
                </div>
            </div>
        </div>

        <!-- Đánh giá của khách & Phản hồi -->
        <div class="col-12 col-lg-6">
            <div class="card-surface p-4 h-100 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div>
                        <h3 class="h5 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-star-half text-warning"></i>
                            <span>Đánh giá từ khách hàng</span>
                        </h3>
                        <span class="text-muted small" style="font-size: 0.78rem;">Nhận xét thực tế và phản hồi trực tiếp từ chủ xe</span>
                    </div>
                    <div class="d-flex align-items-center gap-1.5 px-3 py-1 rounded-pill fw-bold border shadow-xs" 
                         style="background-color: #fffbeb; border-color: #fde68a !important; color: #b45309; font-size: 0.82rem;">
                        <i class="bi bi-star-fill text-warning"></i>
                        <span>@(reviews.Any() ? avgRating.ToString("0.0") : "5.0") ★</span>
                        <span class="text-muted fw-normal" style="font-size: 0.75rem;">(@reviews.Count)</span>
                    </div>
                </div>

                @if (reviews.Any())
                {
                    <div class="d-flex flex-column gap-3 pe-1 flex-grow-1" style="max-height: 580px; overflow-y: auto;">
                        @foreach (var r in reviews)
                        {
                            <div class="p-3 bg-white rounded-3 border shadow-xs review-box" id="review-box-@r.CarReviewId" style="border-color: #e2e8f0 !important;">
                                <!-- Review Header -->
                                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-xs flex-shrink-0" 
                                             style="width: 36px; height: 36px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); font-size: 0.85rem;">
                                            @(string.IsNullOrWhiteSpace(r.Name) ? "K" : r.Name.Trim().Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small leading-tight">
                                                @(string.IsNullOrWhiteSpace(r.Name) ? "Khách hàng ReCar" : r.Name)
                                                @if (r.OrderId.HasValue && r.OrderId.Value > 0)
                                                {
                                                    <span class="badge bg-light text-muted border ms-1" style="font-size: 0.68rem; font-weight: 500;">
                                                        <i class="bi bi-receipt me-0.5"></i>#@r.OrderId
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-muted" style="font-size: 0.72rem;">
                                                <i class="bi bi-clock me-1"></i>@(r.CreatedDate.HasValue ? r.CreatedDate.Value.ToString("dd/MM/yyyy HH:mm") : "Gần đây")
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Số sao gọn gàng [Star] ★ -->
                                    <div class="d-inline-flex align-items-center gap-1 px-2 py-0.5 rounded-pill fw-bold border flex-shrink-0" 
                                         style="background-color: #fffbeb; border-color: #fde68a !important; color: #b45309; font-size: 0.75rem;">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <span>@(r.Star ?? 5) ★</span>
                                    </div>
                                </div>

                                <!-- Review Detail -->
                                <p class="text-secondary small mb-2 ps-1" style="line-height: 1.55;">
                                    @(string.IsNullOrWhiteSpace(r.Detail) ? "Khách hàng không để lại nhận xét chi tiết bằng lời." : r.Detail)
                                </p>

                                <!-- Host Reply Container -->
                                <div id="reply-container-@r.CarReviewId">
                                    @if (!string.IsNullOrWhiteSpace(r.Reply))
                                    {
                                        <div class="mt-3 ms-2 ms-md-3 p-3 rounded-4 border position-relative" 
                                             style="background: linear-gradient(135deg, #f0fdf4 0%, #f8fafc 100%); border-color: #bbf7d0 !important; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.05);">
                                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2 pb-1.5 border-bottom" style="border-color: rgba(187, 247, 208, 0.7) !important;">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center shadow-xs flex-shrink-0" 
                                                         style="width: 28px; height: 28px; background: linear-gradient(135deg, #059669 0%, #047857 100%); font-size: 13px;">
                                                        <i class="bi bi-person-check-fill"></i>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                        <strong class="text-dark small" style="font-size: 13px;">Phản hồi của bạn</strong>
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 10.5px;">
                                                            <i class="bi bi-patch-check-fill text-success me-0.5"></i> Chủ xe
                                                        </span>
                                                        @if (r.ReplyDate.HasValue)
                                                        {
                                                            <span class="text-muted ms-1" style="font-size: 11px;">
                                                                <i class="bi bi-clock me-0.5"></i>@r.ReplyDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="dropdown">
                                                    <button class="btn btn-light btn-sm rounded-circle p-1 border shadow-xs" 
                                                            type="button" 
                                                            data-bs-toggle="dropdown" 
                                                            aria-expanded="false" 
                                                            title="Tùy chọn phản hồi"
                                                            style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">
                                                        <i class="bi bi-three-dots-vertical" style="font-size: 0.75rem;"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm p-1 small" style="border-radius: 12px; min-width: 140px;">
                                                        <li>
                                                            <button type="button" 
                                                                    class="dropdown-item py-1.5 px-3 d-flex align-items-center gap-2 text-primary btn-trigger-edit-reply" 
                                                                    data-review-id="@r.CarReviewId" 
                                                                    data-reviewer="@(r.Name ?? "Khách hàng")"
                                                                    data-reply="@r.Reply">
                                                                <i class="bi bi-pencil-square"></i> Sửa phản hồi
                                                            </button>
                                                        </li>
                                                        <li>
                                                            <button type="button" 
                                                                    class="dropdown-item py-1.5 px-3 d-flex align-items-center gap-2 text-danger btn-trigger-delete-reply" 
                                                                    data-review-id="@r.CarReviewId">
                                                                <i class="bi bi-trash"></i> Xóa phản hồi
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <div class="text-dark small ps-1" id="reply-text-@r.CarReviewId" style="white-space: pre-line; line-height: 1.65; font-size: 13.5px; color: #1e293b !important;">
                                                @r.Reply
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-2 text-end">
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1.5 btn-trigger-add-reply" 
                                                    data-review-id="@r.CarReviewId" 
                                                    data-reviewer="@(r.Name ?? "Khách hàng")" 
                                                    style="font-size: 0.78rem;">
                                                <i class="bi bi-reply-fill"></i> Phản hồi đánh giá
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted my-auto">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 bg-light border" style="width: 54px; height: 54px;">
                            <i class="bi bi-chat-heart text-secondary fs-4" style="opacity: 0.6;"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Chưa có đánh giá nào</h6>
                        <p class="small text-muted mb-0">Khi khách hàng hoàn thành chuyến đi và để lại nhận xét, bạn sẽ có thể đọc và gửi phản hồi tại đây.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Phần 3: Lịch sử đơn thuê của xe -->
    <div class="card-surface p-4">
        <h3 class="h5 fw-bold text-dark mb-3">Lịch sử đơn thuê của xe</h3>
        @if (carOrders.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="bg-light text-muted text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="py-2.5">Mã đơn</th>
                            <th class="py-2.5">Khách thuê</th>
                            <th class="py-2.5">Thời gian nhận - trả</th>
                            <th class="py-2.5">Doanh thu</th>
                            <th class="py-2.5">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        @foreach (var od in carOrders)
                        {
                            var ord = od.Order;
                            var customer = ord?.Customer;

                            <tr>
                                <td class="py-3">
                                    <a href="/CarOwner/Orders/Details/@(ord?.OrderId ?? od.OrderId)" class="font-monospace fw-bold text-primary text-decoration-none">
                                        #@(ord?.OrderId ?? od.OrderId)
                                    </a>
                                </td>
                                <td class="py-3 fw-semibold text-dark">
                                    @(customer?.Name ?? "Khách hàng")
                                </td>
                                <td class="py-3 text-muted small">
                                    @(od.PickupDate?.ToString("dd/MM/yyyy") ?? "Hôm nay") → @(od.ReturnDate?.ToString("dd/MM/yyyy") ?? "Ngày mai")
                                </td>
                                <td class="py-3 fw-bold text-dark">
                                    @(((od.Price ?? 0) * (od.Quantity ?? 1)).ToString("N0"))đ
                                </td>
                                <td class="py-3">
                                    @if (ord?.StatusId == 3)
                                    {
                                        <span class="status-badge status-badge-pending">Chờ bàn giao</span>
                                    }
                                    else if (ord?.StatusId == 4)
                                    {
                                        <span class="status-badge status-badge-busy">Đang cho thuê</span>
                                    }
                                    else if (ord?.StatusId == 5)
                                    {
                                        <span class="status-badge status-badge-completed">Đã hoàn tất</span>
                                    }
                                    else if (ord?.StatusId == 2)
                                    {
                                        <span class="status-badge status-badge-rejected">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-badge-ready">@(ord?.Status?.StatusDescription ?? "Đã đặt")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted small mb-0 py-3 text-center">Xe chưa phát sinh đơn đặt thuê nào.</p>
        }
    </div>
</div>

<!-- Modal Phản hồi đánh giá xe từ Chủ xe -->
<div class="modal fade" id="modalReplyReview" tabindex="-1" aria-labelledby="modalReplyReviewLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header border-bottom py-3 px-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff;">
                <h5 class="modal-title fs-6 fw-bold text-white d-flex align-items-center gap-2" id="modalReplyReviewLabel">
                    <i class="bi bi-reply-fill text-info"></i>
                    <span id="replyModalTitle">Phản hồi đánh giá của khách hàng</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="replyReviewId" value="" />
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark small mb-1">
                        Nội dung phản hồi từ Chủ xe <span class="text-danger">*</span>
                    </label>
                    <textarea id="replyReviewContent" class="form-control shadow-none" rows="4" 
                              placeholder="Cảm ơn quý khách đã tin tưởng và sử dụng xe! Rất mong được phục vụ quý khách trong những chuyến đi tiếp theo..." 
                              style="border-radius: 10px; font-size: 0.88rem; line-height: 1.5;"></textarea>
                    <div class="form-text text-muted small mt-2 d-flex align-items-center gap-1.5">
                        <i class="bi bi-info-circle text-primary"></i>
                        <span>Phản hồi của bạn sẽ hiển thị công khai dưới nhận xét của khách trên trang chi tiết xe.</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top py-2.5 px-4 bg-light">
                <button type="button" class="btn btn-light border rounded-pill px-3 py-1.5 text-secondary small fw-semibold" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 py-1.5 small fw-semibold d-inline-flex align-items-center gap-1.5" id="btnSubmitReply">
                    <i class="bi bi-send-fill"></i>
                    <span>Lưu phản hồi</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        let replyModalInstance = null;
        const modalEl = document.getElementById('modalReplyReview');
        if (modalEl && typeof bootstrap !== 'undefined') {
            replyModalInstance = new bootstrap.Modal(modalEl);
        }

        // Bấm nút "Phản hồi đánh giá"
        $(document).on('click', '.btn-trigger-add-reply', function() {
            const reviewId = $(this).data('review-id');
            const reviewer = $(this).data('reviewer') || 'khách hàng';
            $('#replyReviewId').val(reviewId);
            $('#replyReviewContent').val('');
            $('#replyModalTitle').text('Phản hồi đánh giá của ' + reviewer);
            $('#btnSubmitReply').html('<i class="bi bi-send-fill me-1"></i> Gửi phản hồi');
            if (replyModalInstance) {
                replyModalInstance.show();
            } else {
                $('#modalReplyReview').modal('show');
            }
        });

        // Bấm nút "Sửa phản hồi"
        $(document).on('click', '.btn-trigger-edit-reply', function() {
            const reviewId = $(this).data('review-id');
            const reply = $(this).attr('data-reply') || '';
            const reviewer = $(this).data('reviewer') || 'khách hàng';
            $('#replyReviewId').val(reviewId);
            $('#replyReviewContent').val(reply);
            $('#replyModalTitle').text('Chỉnh sửa phản hồi cho ' + reviewer);
            $('#btnSubmitReply').html('<i class="bi bi-check2-circle me-1"></i> Cập nhật phản hồi');
            if (replyModalInstance) {
                replyModalInstance.show();
            } else {
                $('#modalReplyReview').modal('show');
            }
        });

        // Gửi AJAX lưu phản hồi
        $('#btnSubmitReply').on('click', function() {
            const reviewId = $('#replyReviewId').val();
            const replyText = $('#replyReviewContent').val().trim();

            if (!replyText) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Vui lòng nhập nội dung',
                    text: 'Nội dung phản hồi không được để trống.',
                    confirmButtonColor: '#0284c7'
                });
                return;
            }

            const $btn = $(this);
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...');

            $.ajax({
                url: '/CarOwner/Cars/ReplyReview',
                type: 'POST',
                data: {
                    reviewId: reviewId,
                    replyText: replyText
                },
                success: function(res) {
                    $btn.prop('disabled', false).html('<i class="bi bi-send-fill me-1"></i> Lưu phản hồi');
                    if (res && res.success) {
                        if (replyModalInstance) {
                            replyModalInstance.hide();
                        } else {
                            $('#modalReplyReview').modal('hide');
                        }
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: res.message || 'Gửi phản hồi thành công!',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: (res && res.message) || 'Có lỗi xảy ra khi lưu phản hồi.',
                            confirmButtonColor: '#0284c7'
                        });
                    }
                },
                error: function(err) {
                    $btn.prop('disabled', false).html('<i class="bi bi-send-fill me-1"></i> Lưu phản hồi');
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi kết nối',
                        text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.',
                        confirmButtonColor: '#0284c7'
                    });
                }
            });
        });

        // Bấm nút "Xóa phản hồi"
        $(document).on('click', '.btn-trigger-delete-reply', function() {
            const reviewId = $(this).data('review-id');
            Swal.fire({
                title: 'Xóa phản hồi này?',
                text: 'Phản hồi của bạn đối với đánh giá này sẽ bị gỡ bỏ.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="bi bi-trash me-1"></i> Xác nhận xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/CarOwner/Cars/ReplyReview',
                        type: 'POST',
                        data: {
                            reviewId: reviewId,
                            replyText: ''
                        },
                        success: function(res) {
                            if (res && res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã xóa',
                                    text: 'Đã xóa phản hồi thành công.',
                                    timer: 1200,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Thất bại',
                                    text: (res && res.message) || 'Không thể xóa phản hồi.'
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: 'Có lỗi xảy ra khi kết nối máy chủ.'
                            });
                        }
                    });
                }
            });
        });
    });
</script>
}
