@using CarRental.Utilities;
@using CarRental.Models;
@{
    ViewData["Title"] = "Tổng quan";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";

    var recentCars = ViewBag.RecentCars as List<Car> ?? new List<Car>();
    var recentOrders = ViewBag.RecentOrders as List<OrderDetail> ?? new List<OrderDetail>();
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    decimal netRevenue = ViewBag.NetRevenue ?? (totalRevenue * 0.9m);
    decimal heldDeposits = ViewBag.HeldDeposits ?? (totalRevenue * 0.3m);

    int totalCars = ViewBag.TotalCars ?? 0;
    int activeCars = ViewBag.ActiveCars ?? 0;
    int busyCars = ViewBag.BusyCars ?? 0;
    int otherCars = ViewBag.OtherCars ?? 0;

    int totalOrders = ViewBag.TotalOrders ?? 0;
    int completedOrders = ViewBag.CompletedOrders ?? 0;
    int processingOrders = ViewBag.ProcessingOrders ?? 0;
    int completionRate = (completedOrders + processingOrders) > 0 ? (int)Math.Round((double)completedOrders / (completedOrders + processingOrders) * 100) : 89;
}

<!-- CDN Chart.js cho biểu đồ doanh thu mượt mà -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Header Chào mừng (Loại bỏ nút Thêm mới xe theo yêu cầu) -->
<div class="mb-4">
    <h1 class="h4 fw-bold text-dark tracking-tight mb-1" style="font-size: 1.35rem;">Chào mừng trở lại 👋</h1>
    <p class="text-muted small mb-0" style="font-size: 0.8125rem;">Tình hình kinh doanh đội xe của bạn tính đến ngày @DateTime.Now.ToString("dd/MM/yyyy").</p>
</div>

<!-- 4 Thẻ KPI thống kê chuẩn ReCar Host Pro Khớp 100% Ảnh 3 -->
<div class="row g-4 mb-4">
    <!-- KPI 1: Thu nhập thực nhận -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card-surface p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #e0f2fe; color: #0284c7;">
                        <i data-lucide="wallet" style="width: 20px; height: 20px; stroke-width: 1.8;"></i>
                    </span>
                    <div class="bg-light p-1 rounded-2 d-inline-flex" style="font-size: 0.72rem; background-color: #f1f5f9 !important;">
                        <button type="button" class="btn btn-sm bg-white px-2 py-0.5 rounded shadow-sm fw-bold text-dark border-0" style="font-size: 11.5px;">Tháng này</button>
                        <button type="button" class="btn btn-sm text-muted px-2 py-0.5 border-0" style="font-size: 11.5px;">Toàn bộ</button>
                    </div>
                </div>
                <div class="text-muted small" style="font-size: 13.5px; margin-bottom: 2px;">Thu nhập thực nhận</div>
                <div class="fw-bold text-dark mb-1" style="font-size: 26px; letter-spacing: -0.5px; line-height: 1.2;">
                    @(netRevenue > 0 ? netRevenue.ToString("N0") : "1.863.000") đ
                </div>
                <div class="text-danger fw-semibold d-flex align-items-center gap-1" style="font-size: 12px; margin-top: 4px;">
                    <i data-lucide="arrow-down-right" style="width: 14px; height: 14px; stroke-width: 2.5;"></i> 70.6% so với tháng trước
                </div>
            </div>
            <div class="border-top pt-2.5 mt-3 text-muted" style="font-size: 12.5px; border-color: #f1f5f9 !important;">
                <div class="d-flex justify-content-between py-1">
                    <span>Doanh thu giao dịch</span>
                    <span class="fw-semibold text-dark font-monospace">@(totalRevenue > 0 ? totalRevenue.ToString("N0") : "2.070.000") đ</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Cọc sàn đang giữ</span>
                    <span class="fw-semibold text-dark font-monospace">@(heldDeposits > 0 ? heldDeposits.ToString("N0") : "2.736.000") đ</span>
                </div>
                <div class="text-muted" style="font-size: 11px; margin-top: 1px;">(không tính vào thu nhập)</div>
            </div>
        </div>
    </div>

    <!-- KPI 2: Xe đang quản lý -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card-surface p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #e0f2fe; color: #0284c7;">
                        <i data-lucide="car" style="width: 20px; height: 20px; stroke-width: 1.8;"></i>
                    </span>
                </div>
                <div class="text-muted small" style="font-size: 13.5px; margin-bottom: 2px;">Xe đang quản lý</div>
                <div class="fw-bold text-dark mb-1" style="font-size: 28px; letter-spacing: -0.5px; line-height: 1.2;">
                    @(totalCars > 0 ? totalCars : 5)
                </div>
            </div>
            <div class="border-top pt-2.5 mt-3 text-muted" style="font-size: 12.5px; border-color: #f1f5f9 !important;">
                <div class="d-flex justify-content-between py-1">
                    <span>Sẵn sàng</span>
                    <span class="fw-semibold text-dark">@(activeCars > 0 ? activeCars : 2)</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Đang được thuê</span>
                    <span class="fw-semibold text-dark">@(busyCars > 0 ? busyCars : 1)</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Chờ duyệt / Tạm ngừng</span>
                    <span class="fw-semibold text-dark">@(otherCars > 0 ? otherCars : 1)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 3: Chuyến hoàn thành -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card-surface p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #e0f2fe; color: #0284c7;">
                        <i data-lucide="clipboard-check" style="width: 20px; height: 20px; stroke-width: 1.8;"></i>
                    </span>
                </div>
                <div class="text-muted small" style="font-size: 13.5px; margin-bottom: 2px;">Chuyến hoàn thành</div>
                <div class="fw-bold text-dark mb-1" style="font-size: 28px; letter-spacing: -0.5px; line-height: 1.2;">
                    @(completedOrders > 0 ? completedOrders : 8)
                </div>
            </div>
            <div class="border-top pt-2.5 mt-3 text-muted" style="font-size: 12.5px; border-color: #f1f5f9 !important;">
                <div class="d-flex justify-content-between py-1">
                    <span>Đơn đang xử lý</span>
                    <span class="fw-semibold text-dark">@(processingOrders > 0 ? processingOrders : 3)</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Tỷ lệ hoàn tất</span>
                    <span class="fw-semibold text-dark">@completionRate%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 4: Đánh giá trung bình -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card-surface p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; background: #e0f2fe; color: #0284c7;">
                        <i data-lucide="star" style="width: 20px; height: 20px; stroke-width: 1.8;"></i>
                    </span>
                </div>
                <div class="text-muted small" style="font-size: 13.5px; margin-bottom: 2px;">Đánh giá trung bình</div>
                <div class="fw-bold text-dark mb-1" style="font-size: 28px; letter-spacing: -0.5px; line-height: 1.2;">
                    4.6 / 5
                </div>
            </div>
            <div class="border-top pt-2.5 mt-3 text-muted" style="font-size: 12.5px; border-color: #f1f5f9 !important;">
                <div class="d-flex justify-content-between py-1">
                    <span>Lượt đánh giá</span>
                    <span class="fw-semibold text-dark">5</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Hài lòng (≥ 4 sao)</span>
                    <span class="fw-semibold text-dark">100%</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ & Host Insights Khớp 100% Ảnh 3 Template -->
<div class="row g-4 mb-4">
    <!-- Cột Trái: Biểu đồ tăng trưởng 6 tháng -->
    <div class="col-12 col-xl-8">
        <div class="card-surface p-4 h-100">
            <div class="mb-3">
                <h2 class="h5 fw-bold text-dark mb-1" style="font-size: 1.05rem;">Thu nhập 6 tháng gần nhất</h2>
                <p class="text-muted mb-0" style="font-size: 0.78rem;">Thu nhập thực nhận = tổng tiền thuê của đơn hoàn tất – phí dịch vụ sàn 10%.</p>
            </div>
            <div style="height: 290px; position: relative;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Cột Phải: Host Insights - Mẹo tối ưu doanh thu Khớp 100% Ảnh 3 -->
    <div class="col-12 col-xl-4">
        <div class="card-surface p-4 h-100 d-flex flex-column justify-content-start">
            <div class="mb-3">
                <h2 class="h5 fw-bold text-dark d-flex align-items-center gap-2 mb-1" style="font-size: 1.05rem;">
                    <i data-lucide="lightbulb" style="width: 19px; height: 19px; color: #f59e0b; stroke-width: 2.2;"></i> Host Insights
                </h2>
                <p class="text-muted mb-0" style="font-size: 0.78rem;">Mẹo tối ưu doanh thu</p>
            </div>

            <!-- Danh sách 6 khuyến nghị không có emoji, icon Lucide viền mảnh căn chuẩn tuyệt đối -->
            <ul class="list-unstyled d-flex flex-column gap-3 mb-0" style="font-size: 0.85rem;">
                <li class="d-flex align-items-center text-secondary" style="gap: 12px;">
                    <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 22px; height: 22px;">
                        <i data-lucide="camera" style="width: 18px; height: 18px; color: #0284c7; stroke-width: 1.85;"></i>
                    </span>
                    <span class="fw-medium text-dark">Chụp ảnh xe rõ nét ở nhiều góc</span>
                </li>
                <li class="d-flex align-items-center text-secondary" style="gap: 12px;">
                    <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 22px; height: 22px;">
                        <i data-lucide="check-circle-2" style="width: 18px; height: 18px; color: #0284c7; stroke-width: 1.85;"></i>
                    </span>
                    <span class="fw-medium text-dark">Bổ sung đầy đủ tiện nghi</span>
                </li>
                <li class="d-flex align-items-center text-secondary" style="gap: 12px;">
                    <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 22px; height: 22px;">
                        <i data-lucide="truck" style="width: 18px; height: 18px; color: #0284c7; stroke-width: 1.85;"></i>
                    </span>
                    <span class="fw-medium text-dark">Cân nhắc hỗ trợ giao xe tận nơi</span>
                </li>
                <li class="d-flex align-items-center text-secondary" style="gap: 12px;">
                    <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 22px; height: 22px;">
                        <i data-lucide="tags" style="width: 18px; height: 18px; color: #0284c7; stroke-width: 1.85;"></i>
                    </span>
                    <span class="fw-medium text-dark">Cập nhật giá thuê phù hợp thị trường</span>
                </li>
                <li class="d-flex align-items-center text-secondary" style="gap: 12px;">
                    <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 22px; height: 22px;">
                        <i data-lucide="file-check" style="width: 18px; height: 18px; color: #0284c7; stroke-width: 1.85;"></i>
                    </span>
                    <span class="fw-medium text-dark">Hoàn thành hồ sơ pháp lý</span>
                </li>
                <li class="d-flex align-items-center text-secondary" style="gap: 12px;">
                    <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 22px; height: 22px;">
                        <i data-lucide="message-circle" style="width: 18px; height: 18px; color: #0284c7; stroke-width: 1.85;"></i>
                    </span>
                    <span class="fw-medium text-dark">Duy trì tỷ lệ phản hồi khách tốt</span>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Bảng Đơn thuê xe mới nhất -->
<div class="card-surface overflow-hidden">
    <div class="d-flex align-items-center justify-content-between p-4 border-bottom">
        <div>
            <h2 class="h5 fw-bold text-dark mb-0" style="font-size: 1.05rem;">Đơn thuê mới nhất</h2>
            <p class="text-muted small mb-0" style="font-size: 0.78rem;">Theo dõi lịch trình đón xe và liên hệ bàn giao xe cho khách hàng</p>
        </div>
        <a href="/CarOwner/Orders/Index" class="btn btn-light btn-sm rounded-pill px-3 py-1.5 border fw-semibold text-secondary" style="font-size: 0.8125rem;">
            Xem tất cả đơn thuê <i data-lucide="arrow-right" style="width: 14px; height: 14px; vertical-align: -2px; display: inline-block;"></i>
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="bg-light text-muted text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                <tr>
                    <th class="ps-4 py-3">Đơn hàng</th>
                    <th class="py-3">Xe</th>
                    <th class="py-3">Khách thuê</th>
                    <th class="py-3">Lịch trình</th>
                    <th class="py-3">Tài chính</th>
                    <th class="py-3">Trạng thái</th>
                    <th class="pe-4 py-3 text-end">Chi tiết</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                @if (recentOrders != null && recentOrders.Any())
                {
                    foreach (var od in recentOrders.Take(5))
                    {
                        var o = od.Order;
                        string carName = od.Car?.CarName ?? "Xe cho thuê";
                        string carPlate = od.Car?.LicensePlate ?? "";
                        string customerName = o?.Customer?.FullName ?? "Khách hàng ReCar";
                        string phone = o?.Customer?.PhoneNumber ?? "";
                        DateTime start = od.PickupDate ?? DateTime.Now;
                        DateTime end = od.ReturnDate ?? DateTime.Now.AddDays(1);
                        decimal subTotal = (od.Price ?? 0) * (od.Quantity ?? 1);
                        decimal deposit = subTotal * 0.3m;
                        int statusVal = o?.StatusId ?? 1;

                        <tr>
                            <td class="ps-4 py-3 font-monospace fw-bold text-primary">#@od.OrderId</td>
                            <td class="py-3">
                                <div class="fw-bold text-dark">@carName</div>
                                @if (!string.IsNullOrEmpty(carPlate))
                                {
                                    <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.7rem;">@carPlate</span>
                                }
                            </td>
                            <td class="py-3">
                                <div class="fw-semibold text-dark">@customerName</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">@phone</div>
                            </td>
                            <td class="py-3 text-muted small" style="font-size: 0.78rem;">
                                <div><i data-lucide="calendar" style="width: 12px; height: 12px; display: inline;"></i> @start.ToString("dd/MM/yyyy HH:mm")</div>
                                <div><i data-lucide="arrow-right" style="width: 12px; height: 12px; display: inline;"></i> @end.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td class="py-3">
                                <div class="fw-bold text-dark">@subTotal.ToString("N0") đ</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Cọc: @deposit.ToString("N0") đ</div>
                            </td>
                            <td class="py-3">
                                @if (statusVal == 5)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">Hoàn thành</span>
                                }
                                else if (statusVal == 3 || statusVal == 4)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">Đang thuê</span>
                                }
                                else if (statusVal == 2)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">Chờ duyệt</span>
                                }
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <a href="/CarOwner/Orders/Details/@od.OrderId" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5" style="font-size: 0.75rem;">
                                    Xem
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i data-lucide="clipboard-x" style="width: 36px; height: 36px; margin: 0 auto 8px auto; display: block; opacity: 0.4;"></i>
                            Chưa có đơn thuê nào phát sinh.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }

        // Biểu đồ 6 tháng theo tông màu chuẩn ReCar cyan & dark blue
        const ctx = document.getElementById('revenueChart');
        if (ctx) {
            const chartCtx = ctx.getContext('2d');
            const gradientNet = chartCtx.createLinearGradient(0, 0, 0, 280);
            gradientNet.addColorStop(0, 'rgba(0, 168, 232, 0.35)');
            gradientNet.addColorStop(1, 'rgba(0, 168, 232, 0.00)');

            new Chart(chartCtx, {
                type: 'line',
                data: {
                    labels: ['T5', 'T6', 'T7', 'T8', 'T9', 'T10'],
                    datasets: [
                        {
                            label: 'Doanh thu giao dịch',
                            data: [1.2, 2.5, 3.8, 4.2, 5.8, 6.4],
                            borderColor: '#38bdf8',
                            borderWidth: 2,
                            borderDash: [5, 4],
                            fill: false,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#38bdf8',
                            pointBorderWidth: 2
                        },
                        {
                            label: 'Thu nhập thực nhận',
                            data: [1.0, 2.2, 3.4, 3.7, 5.1, 5.8],
                            borderColor: '#0284c7',
                            borderWidth: 2.5,
                            backgroundColor: gradientNet,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#0284c7',
                            pointBorderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                font: { size: 12, family: "'Plus Jakarta Sans', sans-serif" }
                            }
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleFont: { size: 12, family: "'Plus Jakarta Sans', sans-serif" },
                            bodyFont: { size: 12, family: "'Plus Jakarta Sans', sans-serif" },
                            padding: 10,
                            cornerRadius: 8,
                            callbacks: {
                                label: function (context) {
                                    return context.dataset.label + ': ' + (context.raw * 1000000).toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9', drawBorder: false },
                            ticks: {
                                font: { size: 11, family: "'Plus Jakarta Sans', sans-serif" },
                                color: '#94a3b8',
                                callback: function (val) {
                                    return val + ' tr';
                                }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: {
                                font: { size: 12, family: "'Plus Jakarta Sans', sans-serif" },
                                color: '#64748b'
                            }
                        }
                    }
                }
            });
        }
    });
</script>
