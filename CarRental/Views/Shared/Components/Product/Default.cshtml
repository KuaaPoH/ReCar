@model IEnumerable<CarRental.Models.Car>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        string detailUrl = $"/product/{item.Alias}-{item.CarId}.html";
        string checkoutUrl = $"/Product/Details/{item.CarId}"; // Đi vào chi tiết chọn ngày hoặc checkout

        // Xác định badge từ database
        string tag = item.Badge ?? item.Descriptions;
        string tagClass = "recar-badge-featured";
        if (tag == "Xe điện" || (item.Fuel != null && item.Fuel.Contains("Điện")) || (item.CarBrand != null && item.CarBrand.ToLower().Contains("vinfast")))
        {
            tag = "Xe điện";
            tagClass = "recar-badge-electric";
        }
        else if (tag == "Ưu đãi" || item.IsSale)
        {
            tag = "Ưu đãi";
            tagClass = "recar-badge-promo";
        }
        else if (tag == "Nổi bật")
        {
            tagClass = "recar-badge-featured";
        }

        // Lấy trực tiếp từ database
        string gear = item.Transmission ?? "Tự động";
        string fuel = item.Fuel ?? "Xăng";
        string location = item.Location ?? "Hà Nội";
        int reviews = item.Trips ?? 50;

        decimal finalPrice = (item.SalePrice > 0 ? item.SalePrice : item.Price) ?? 0;

        <div class="col-sm-6 col-lg-4 mb-4">
            <article class="recar-car-card">
                <div class="recar-car-media">
                    <img src="@(string.IsNullOrEmpty(item.Image) ? "/images/cars/car-sedan.jpg" : item.Image)" alt="@item.CarName" class="recar-car-img" loading="lazy">
                    @if (!string.IsNullOrEmpty(tag) && tag != "Tiêu chuẩn")
                    {
                        <span class="recar-badge-tag @tagClass">@tag</span>
                    }
                </div>
                <div class="recar-car-content">
                    <div>
                        <p class="recar-car-brand">@(string.IsNullOrEmpty(item.CarBrand) ? "Ô TÔ" : item.CarBrand)</p>
                        <h3 class="recar-car-name">@item.CarName</h3>
                    </div>
                    <div class="recar-specs-grid">
                        <span class="recar-spec-item"><i class="bi bi-people"></i> @(item.Seat ?? 5) chỗ</span>
                        <span class="recar-spec-item"><i class="bi bi-gear"></i> @gear</span>
                        <span class="recar-spec-item"><i class="bi bi-fuel-pump"></i> @fuel</span>
                    </div>
                    <div class="recar-meta-row">
                        <span class="recar-location-txt"><i class="bi bi-geo-alt"></i> @location</span>
                        <span class="recar-rating-txt"><i class="bi bi-star-fill text-warning"></i> @(item.Rate?.ToString("0.0") ?? "4.8") (@reviews)</span>
                    </div>
                    <div class="recar-price-box">
                        <span class="recar-price-amount">@finalPrice.ToString("N0")đ</span>
                        <span class="recar-price-unit">/ngày</span>
                    </div>
                    <div class="recar-card-actions">
                        <a href="@detailUrl" class="btn-card-outline">Xem chi tiết</a>
                        <a href="@detailUrl" class="btn-card-primary">Thuê ngay</a>
                    </div>
                </div>
            </article>
        </div>
    }
}
else
{
    <div class="col-12 text-center py-5">
        <div class="p-5 bg-light rounded-4 border text-center">
            <i class="bi bi-search text-muted fs-1 mb-3 d-block"></i>
            <h5 class="fw-bold text-dark">Không tìm thấy xe phù hợp</h5>
            <p class="text-muted small mb-0">Hãy thử nới rộng khoảng giá hoặc bỏ bớt bộ lọc để xem nhiều xe hơn.</p>
        </div>
    </div>
}
