@using CarRental.Models;
@model IList<Blog>
@{
    ViewData["Title"] = "Bài viết & tin tức";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Bài viết & Tin tức</h1>
                <span class="badge bg-light text-dark border rounded-pill fw-semibold px-2.5 py-1">@Model.Count bài viết</span>
            </div>
            <p class="text-muted small mb-0 mt-1">Quản lý cẩm nang du lịch, kinh nghiệm thuê xe và các thông báo khuyến mãi trên sàn ReCar.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                <i class="bi bi-pencil-square me-1"></i> Viết bài mới
            </a>
        </div>
    </div>

    <!-- Data Table Panel -->
    <div class="recar-panel mb-0">
        <div class="table-responsive">
            <table class="table recar-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">Ảnh bìa</th>
                        <th>Tiêu đề bài viết</th>
                        <th>Tóm tắt nội dung</th>
                        <th>Tác giả / Ngày đăng</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-2 text-secondary d-block mb-2"></i>
                                Chưa có bài viết nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(item.Image) ? "/images/cars/hero.jpg" : item.Image)" 
                                         alt="@item.Title" class="rounded object-fit-cover" style="width: 60px; height: 42px;" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark small" style="max-width: 320px;">@item.Title</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">Alias: /blog/@item.Alias</div>
                                </td>
                                <td>
                                    <div class="text-muted small text-truncate" style="max-width: 360px;" title="@item.Description">
                                        @item.Description
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-medium text-dark">@(item.CreatedBy ?? "ReCar Editorial")</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">@(item.CreatedDate?.ToString("dd/MM/yyyy") ?? "Mới cập nhật")</div>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge badge-ready">Đã xuất bản</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-draft">Bản nháp</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.BlogId" class="btn btn-light btn-sm rounded-pill px-2.5 py-1 text-primary fw-medium" style="font-size: 0.75rem;">
                                            <i class="bi bi-pencil me-1"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.BlogId" class="btn btn-outline-danger btn-sm rounded-pill px-2.5 py-1 fw-medium" style="font-size: 0.75rem;">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
