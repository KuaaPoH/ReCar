@model IEnumerable<CarRental.ViewModels.OrderDetailVM>
@using CarRental.Utilities;
@using CarRental.Models;
@{
    ViewData["Title"] = "Chi tiết đơn thuê xe #" + ViewBag.OrderId;
    Layout = "~/Views/Shared/_Layout.cshtml";
    int statusId = ViewBag.StatusId != null ? (int)ViewBag.StatusId : 0;
    string statusDescription = ViewBag.StatusDescription != null ? ViewBag.StatusDescription.ToString() : "";
    string statusLower = !string.IsNullOrEmpty(statusDescription) ? statusDescription.ToLower() : "";
    bool isCancelled = statusId == 2 || (!string.IsNullOrEmpty(statusDescription) && (statusLower.Contains("hủy") || statusLower.Contains("huy") || statusDescription.Contains("Huỷ")));
    string orderNotes = ViewBag.Notes != null ? ViewBag.Notes.ToString() : "";
    bool isWithDriver = orderNotes.Contains("Có tài xế");

    var handover = ViewBag.HandoverInspection as VehicleInspection;
    var returnInsp = ViewBag.ReturnInspection as VehicleInspection;
    var carPolicy = ViewBag.CarPolicy as CarPolicy ?? new CarPolicy();
    var carObj = ViewBag.Car as Car;
    int rentalDays = ViewBag.RentalDays != null ? (int)ViewBag.RentalDays : 1;
    int allowedKmTotal = ViewBag.AllowedKmTotal != null ? (int)ViewBag.AllowedKmTotal : (rentalDays * carPolicy.MileageLimit);
    int? drivenKm = ViewBag.DrivenKm as int?;
    int overKm = ViewBag.OverKm != null ? (int)ViewBag.OverKm : 0;
    decimal overKmFee = ViewBag.OverKmFee != null ? (decimal)ViewBag.OverKmFee : 0;
    int? fuelDiff = ViewBag.FuelDiff as int?;
}

<style>
    .order-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 16px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 13px;
    }
    .status-badge-pending { background: #fef3c7; color: #92400e; }
    .status-badge-cancelled { background: #fee2e2; color: #991b1b; }
    .status-badge-paid { background: #dcfce7; color: #166534; }
    .status-badge-delivery { background: #dbeafe; color: #1e40af; }

    /* Modal Hợp đồng điện tử khổ A4 */
    @@media print {
        body * { visibility: hidden; }
        #printableContract, #printableContract * { visibility: visible; }
        #printableContract { position: absolute; left: 0; top: 0; width: 100%; }
    }
    .contract-paper {
        background: #ffffff;
        color: #1e293b;
        font-family: "Times New Roman", Times, serif;
        line-height: 1.6;
        padding: 40px;
        border: 1px solid #cbd5e1;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    }
    .contract-header-title {
        font-size: 18px;
        font-weight: bold;
        text-transform: uppercase;
        text-align: center;
        margin-bottom: 5px;
    }
    .contract-subtitle {
        font-size: 14px;
        text-align: center;
        font-style: italic;
        margin-bottom: 25px;
    }
    .contract-section-title {
        font-size: 15px;
        font-weight: bold;
        margin-top: 20px;
        margin-bottom: 8px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 4px;
    }

    .insp-photo-thumb {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .insp-photo-thumb:hover {
        transform: scale(1.03);
        box-shadow: 0 6px 14px rgba(0,0,0,0.12);
    }
</style>

<!-- Breadcrumb Area -->
<div class="recar-section bg-light py-4 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="font-size: 14px;">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Accounts/Index?tab=orders" class="text-decoration-none text-muted">Đơn hàng của tôi</a></li>
                <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">Đơn thuê xe #@ViewBag.OrderId</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1" style="color: var(--recar-dark);">Đơn thuê xe #@ViewBag.OrderId</h2>
                <p class="text-muted mb-0">Theo dõi thông tin phương tiện, lịch trình nhận - trả xe, biên bản ODO và hợp đồng điện tử</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (isCancelled)
                {
                    <span class="order-status-pill status-badge-cancelled">
                        <i class="bi bi-x-circle-fill"></i> Đã hủy
                    </span>
                }
                else if (statusId == 3)
                {
                    <span class="order-status-pill" style="background: #fef3c7; color: #92400e;">
                        <i class="bi bi-clock-history"></i> Đã cọc 30% · Chờ nhận xe
                    </span>
                }
                else if (statusId == 4)
                {
                    <span class="order-status-pill status-badge-delivery">
                        <i class="bi bi-key-fill"></i> Đang cho thuê
                    </span>
                }
                else if (statusId == 5)
                {
                    <span class="order-status-pill status-badge-paid">
                        <i class="bi bi-check-circle-fill"></i> Chuyến đi hoàn tất
                    </span>
                }
                else
                {
                    <span class="order-status-pill status-badge-pending">
                        <i class="bi bi-hourglass-split"></i> @(string.IsNullOrEmpty(statusDescription) ? "Đang xử lý" : statusDescription)
                    </span>
                }
            </div>
        </div>
    </div>
</div>

<div class="recar-section py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Cột trái: Danh sách xe trong đơn & Biên bản bàn giao ODO -->
            <div class="col-lg-8">
                <!-- Card 1: Phương tiện trong đơn -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center">
                        <i class="bi bi-car-front text-primary me-2"></i>
                        Phương tiện trong hợp đồng thuê
                    </h5>

                    <div class="d-flex flex-column gap-3">
                        @foreach(var item in Model) {
                            <div class="p-3 bg-light rounded-3 border d-flex flex-column flex-md-row gap-3 align-items-md-center">
                                <div style="width: 140px; height: 95px; flex-shrink: 0;" class="rounded-3 overflow-hidden bg-white border">
                                    <img src="@item.Image" alt="@item.CarName" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/cars/car-sedan.jpg'">
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                        <h6 class="fw-bold text-dark mb-0">@item.CarName</h6>
                                        @if (isWithDriver)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-person-badge"></i> Có tài xế</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary text-white"><i class="bi bi-car-front"></i> Tự lái</span>
                                        }
                                        @if (carObj != null && !string.IsNullOrEmpty(carObj.LicensePlate))
                                        {
                                            <span class="badge bg-dark-subtle text-dark font-monospace"><i class="bi bi-credit-card-2-front me-1"></i>@carObj.LicensePlate</span>
                                        }
                                    </div>
                                    <div class="row g-2 small text-muted mt-1">
                                        <div class="col-sm-6">
                                            <i class="bi bi-calendar-check text-success me-1"></i> <strong>Nhận xe:</strong> @item.pickupDate.ToString("dd/MM/yyyy")
                                        </div>
                                        <div class="col-sm-6">
                                            <i class="bi bi-calendar-x text-danger me-1"></i> <strong>Trả xe:</strong> @item.returnDate.ToString("dd/MM/yyyy")
                                        </div>
                                        <div class="col-sm-6">
                                            <i class="bi bi-clock-history text-primary me-1"></i> <strong>Thời gian:</strong> @rentalDays ngày
                                        </div>
                                        <div class="col-sm-6">
                                            <i class="bi bi-cash-stack text-warning me-1"></i> <strong>Số lượng:</strong> @item.Quantity xe
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Card 2: Biên bản Bàn giao & Đối chiếu ODO Hiện trạng Xe (Check-in / Check-out) -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                        <div>
                            <h5 class="fw-bold mb-1 d-flex align-items-center">
                                <i class="bi bi-speedometer2 text-primary me-2"></i>
                                Biên bản Bàn giao & Đối chiếu ODO Hiện trạng Xe
                            </h5>
                            <p class="text-muted small mb-0">Minh bạch chỉ số công tơ mét, mức nhiên liệu/pin và đối chiếu quãng đường thực tế</p>
                        </div>
                        <div>
                            @if (handover != null && returnInsp != null)
                            {
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-check-all me-1"></i> Đã hoàn tất đối chiếu 2 chiều
                                </span>
                            }
                            else if (handover != null)
                            {
                                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-key-fill me-1"></i> Đã nhận xe · Chờ trả xe
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-clock me-1"></i> Chờ bàn giao chìa khóa
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Dải tóm tắt hạn mức & quy định hành trình -->
                    <div class="bg-light rounded-3 p-3 mb-4 border">
                        <div class="row g-3 small">
                            <div class="col-md-4">
                                <div class="text-muted">Hạn mức di chuyển:</div>
                                <div class="fw-bold text-dark fs-6">@carPolicy.MileageLimit km <span class="fw-normal text-muted" style="font-size: 13px;">/ ngày</span></div>
                                <div class="text-secondary" style="font-size: 12px;">(Tổng hạn mức chuyến @rentalDays ngày: <strong>@allowedKmTotal km</strong>)</div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted">Phụ phí quá quãng đường:</div>
                                <div class="fw-bold text-danger fs-6">@carPolicy.ExtraFeePerKm.ToString("N0") đ <span class="fw-normal text-muted" style="font-size: 13px;">/ km</span></div>
                                <div class="text-secondary" style="font-size: 12px;">(Tự động tính khi ODO trả vượt hạn mức)</div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted">Mức tiêu hao công bố:</div>
                                <div class="fw-bold text-dark fs-6">@(string.IsNullOrEmpty(carPolicy.FuelConsumption) ? "Tiêu chuẩn nhà sản xuất" : carPolicy.FuelConsumption)</div>
                                <div class="text-secondary" style="font-size: 12px;">(Hoàn trả tương đương mức lúc nhận)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Bảng 2 cột đối chiếu: Lúc nhận vs Lúc trả -->
                    <div class="row g-3">
                        <!-- Cột Lúc Nhận Xe (Check-in) -->
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge bg-primary text-white"><i class="bi bi-box-arrow-in-down-right me-1"></i> Lúc Nhận Xe (Check-in)</span>
                                    @if (handover != null)
                                    {
                                        <span class="text-muted small">@handover.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                </div>

                                @if (handover != null)
                                {
                                    <div class="my-3">
                                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                                            <span class="text-muted small">Đồng hồ ODO nhận:</span>
                                            <span class="font-monospace fw-bold text-dark fs-5">@handover.Odometer.ToString("N0") km</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-muted small">Nhiên liệu / Pin:</span>
                                            <span class="fw-bold text-success">@handover.FuelLevel%</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-success" style="width: @handover.FuelLevel%;"></div>
                                        </div>
                                        <div class="mt-3">
                                            <span class="text-muted small d-block">Ghi chú hiện trạng:</span>
                                            <div class="bg-light p-2 rounded small text-secondary fst-italic">
                                                @(string.IsNullOrWhiteSpace(handover.Notes) ? "Xe sạch sẽ, hiện trạng vận hành bình thường." : handover.Notes)
                                            </div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(handover.FrontImage) || !string.IsNullOrEmpty(handover.RearImage) ||
                                         !string.IsNullOrEmpty(handover.LeftImage) || !string.IsNullOrEmpty(handover.RightImage))
                                    {
                                        <div class="mt-3">
                                            <div class="text-muted small mb-2"><i class="bi bi-camera me-1"></i> Ảnh chụp lúc nhận xe:</div>
                                            <div class="row g-2">
                                                @if (!string.IsNullOrEmpty(handover.FrontImage))
                                                {
                                                    <div class="col-3">
                                                        <img src="@handover.FrontImage" alt="Đầu xe" class="insp-photo-thumb" onclick="showLightbox(this.src, 'Ảnh đầu xe (Lúc nhận)')">
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(handover.RearImage))
                                                {
                                                    <div class="col-3">
                                                        <img src="@handover.RearImage" alt="Đuôi xe" class="insp-photo-thumb" onclick="showLightbox(this.src, 'Ảnh đuôi xe (Lúc nhận)')">
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(handover.LeftImage))
                                                {
                                                    <div class="col-3">
                                                        <img src="@handover.LeftImage" alt="Thân trái" class="insp-photo-thumb" onclick="showLightbox(this.src, 'Ảnh thân trái (Lúc nhận)')">
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(handover.RightImage))
                                                {
                                                    <div class="col-3">
                                                        <img src="@handover.RightImage" alt="Thân phải" class="insp-photo-thumb" onclick="showLightbox(this.src, 'Ảnh thân phải (Lúc nhận)')">
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-clock-history fs-3 d-block mb-2 text-secondary opacity-50"></i>
                                        <div class="fw-semibold small">Chưa bàn giao chìa khóa</div>
                                        <div style="font-size: 12px;" class="mt-1">Chủ xe sẽ ghi nhận số ODO và mức xăng/pin cùng bạn khi giao xe.</div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Cột Lúc Trả Xe (Check-out) -->
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge bg-success text-white"><i class="bi bi-box-arrow-up-left me-1"></i> Lúc Trả Xe (Check-out)</span>
                                    @if (returnInsp != null)
                                    {
                                        <span class="text-muted small">@returnInsp.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                </div>

                                @if (returnInsp != null)
                                {
                                    <div class="my-3">
                                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                                            <span class="text-muted small">Đồng hồ ODO hoàn trả:</span>
                                            <span class="font-monospace fw-bold text-primary fs-5">@returnInsp.Odometer.ToString("N0") km</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-muted small">Nhiên liệu / Pin:</span>
                                            <span class="fw-bold @(fuelDiff.HasValue && fuelDiff.Value < 0 ? "text-danger" : "text-success")">@returnInsp.FuelLevel%</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @(fuelDiff.HasValue && fuelDiff.Value < 0 ? "bg-warning" : "bg-success")" style="width: @returnInsp.FuelLevel%;"></div>
                                        </div>
                                        <div class="mt-3">
                                            <span class="text-muted small d-block">Ghi chú lúc trả xe:</span>
                                            <div class="bg-light p-2 rounded small text-secondary fst-italic">
                                                @(string.IsNullOrWhiteSpace(returnInsp.Notes) ? "Hoàn trả xe đúng hiện trạng." : returnInsp.Notes)
                                            </div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(returnInsp.FrontImage) || !string.IsNullOrEmpty(returnInsp.RearImage) ||
                                         !string.IsNullOrEmpty(returnInsp.LeftImage) || !string.IsNullOrEmpty(returnInsp.RightImage))
                                    {
                                        <div class="mt-3">
                                            <div class="text-muted small mb-2"><i class="bi bi-camera me-1"></i> Ảnh chụp lúc trả xe:</div>
                                            <div class="row g-2">
                                                @if (!string.IsNullOrEmpty(returnInsp.FrontImage))
                                                {
                                                    <div class="col-3">
                                                        <img src="@returnInsp.FrontImage" alt="Đầu xe" class="insp-photo-thumb" onclick="showLightbox(this.src, 'Ảnh đầu xe (Lúc trả)')">
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(returnInsp.RearImage))
                                                {
                                                    <div class="col-3">
                                                        <img src="@returnInsp.RearImage" alt="Đuôi xe" class="insp-photo-thumb" onclick="showLightbox(this.src, 'Ảnh đuôi xe (Lúc trả)')">
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(returnInsp.LeftImage))
                                                {
                                                    <div class="col-3">
                                                        <img src="@returnInsp.LeftImage" alt="Thân trái" class="insp-photo-thumb" onclick="showLightbox(this.src, 'Ảnh thân trái (Lúc trả)')">
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(returnInsp.RightImage))
                                                {
                                                    <div class="col-3">
                                                        <img src="@returnInsp.RightImage" alt="Thân phải" class="insp-photo-thumb" onclick="showLightbox(this.src, 'Ảnh thân phải (Lúc trả)')">
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted">
                                        @if (statusId == 4)
                                        {
                                            <i class="bi bi-car-front-fill fs-3 d-block mb-2 text-primary"></i>
                                            <div class="fw-semibold small text-primary">Xe đang trong hành trình</div>
                                            <div style="font-size: 12px;" class="mt-1">Khi kết thúc hành trình, chủ xe sẽ đối chiếu số ODO trả xe để chốt quyết toán.</div>
                                        }
                                        else
                                        {
                                            <i class="bi bi-hourglass fs-3 d-block mb-2 text-secondary opacity-50"></i>
                                            <div class="fw-semibold small">Chưa đến lịch hoàn trả</div>
                                            <div style="font-size: 12px;" class="mt-1">Chỉ số ODO trả xe sẽ được cập nhật khi kết thúc chuyến đi.</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Khối Tự Động Đối Chiếu Quãng Đường & Phụ Phí Phát Sinh -->
                    @if (handover != null && returnInsp != null && drivenKm.HasValue)
                    {
                        <div class="mt-4 pt-3 border-top">
                            <h6 class="fw-bold mb-3 d-flex align-items-center">
                                <i class="bi bi-calculator text-primary me-2"></i>
                                Tổng kết Đối chiếu Hành trình & Phụ phí
                            </h6>

                            <div class="row g-3">
                                <div class="col-sm-4">
                                    <div class="p-2 bg-light rounded text-center">
                                        <div class="text-muted small">Quãng đường đã đi:</div>
                                        <div class="fs-5 fw-bold text-dark font-monospace">@drivenKm.Value.ToString("N0") km</div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-2 bg-light rounded text-center">
                                        <div class="text-muted small">Hạn mức hợp đồng:</div>
                                        <div class="fs-5 fw-bold text-primary font-monospace">@allowedKmTotal.ToString("N0") km</div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-2 bg-light rounded text-center">
                                        <div class="text-muted small">Chênh lệch xăng/pin:</div>
                                        <div class="fs-5 fw-bold font-monospace @(fuelDiff.HasValue && fuelDiff.Value < 0 ? "text-danger" : "text-success")">
                                            @(fuelDiff.HasValue ? (fuelDiff.Value >= 0 ? "+" + fuelDiff.Value : fuelDiff.Value.ToString()) : "0")%
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (overKm > 0)
                            {
                                <div class="alert alert-warning border-warning d-flex align-items-center justify-content-between p-3 rounded-3 mt-3 mb-0">
                                    <div>
                                        <strong class="text-dark"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Vượt hạn mức hành trình: @overKm.ToString("N0") km</strong>
                                        <div class="small text-muted mt-1">Phụ phí phát sinh (@carPolicy.ExtraFeePerKm.ToString("N0") đ/km) được thanh toán trực tiếp cho chủ xe khi trả xe.</div>
                                    </div>
                                    <div class="text-end ps-3">
                                        <span class="fs-4 fw-bold text-danger">@overKmFee.ToString("N0") đ</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success border-success d-flex align-items-center p-3 rounded-3 mt-3 mb-0">
                                    <i class="bi bi-check-circle-fill fs-4 text-success me-2"></i>
                                    <div>
                                        <strong class="text-success">Quãng đường nằm trong hạn mức cho phép (@allowedKmTotal km)</strong>
                                        <div class="small text-muted">Không phát sinh bất kỳ khoản phụ phí quãng đường nào cho chuyến đi này ✓</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Trao đổi trực tiếp với Chủ xe & Hỗ trợ hành trình -->
                @{
                    var ownerObj = carObj?.Owner;
                    var ownerDisplayName = !string.IsNullOrEmpty(ownerObj?.FullName) ? ownerObj.FullName : (ownerObj?.Username ?? "Chủ xe ReCar");
                    var ownerPhone = !string.IsNullOrEmpty(ownerObj?.Phone) ? ownerObj.Phone : "1900 6868";
                    int ownerAccId = ownerObj?.AccountId ?? (carObj?.OwnerId ?? 6);
                    string carTitle = carObj?.CarName ?? "Phương tiện thuê";
                }
                <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 52px; height: 52px; font-size: 24px;">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h6 class="fw-bold mb-0 text-white fs-6">Chủ xe: @ownerDisplayName</h6>
                                    <span class="badge bg-white text-primary fw-bold" style="font-size: 10px;">Đối tác ReCar</span>
                                </div>
                                <p class="small mb-0 text-white-50">Trao đổi trực tiếp với chủ xe về điểm đón, nhận/trả xe hoặc các thỏa thuận phát sinh.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-light rounded-pill px-3.5 py-2 fw-bold text-primary shadow-sm d-inline-flex align-items-center gap-2" 
                                    onclick="openChatBox('@ownerDisplayName', 'Chào bạn! Tôi là khách thuê xe @carTitle ở đơn hàng #@ViewBag.OrderId.', @(carObj?.CarId ?? 0), @ownerAccId, '@carTitle')">
                                <i class="bi bi-chat-dots-fill"></i>
                                <span>Chat với chủ xe</span>
                            </button>
                            <a href="tel:@ownerPhone" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold small text-nowrap d-inline-flex align-items-center gap-1">
                                <i class="bi bi-telephone-fill"></i> Gọi @ownerPhone
                            </a>
                            <a href="tel:19006868" class="btn btn-link text-white-50 text-decoration-none small text-nowrap" title="Tổng đài khẩn cấp ReCar">
                                Cứu hộ 1900 6868
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thông tin người nhận, Thao tác Hợp đồng -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-3">Thông tin nhận xe</h5>

                    <div class="mb-3">
                        <label class="text-muted small d-block">Người nhận xe:</label>
                        <span class="fw-bold text-dark fs-6">@Function.GetUserName(Context.Session)</span>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small d-block">Số điện thoại liên hệ:</label>
                        <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Function.GetPhone(Context.Session)) ? "Chưa cập nhật" : Function.GetPhone(Context.Session))</span>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small d-block">Địa chỉ giao nhận xe:</label>
                        <span class="text-secondary small">@(string.IsNullOrEmpty(Function.GetAddress(Context.Session)) ? "Nhận tại địa chỉ bàn giao ReCar" : Function.GetAddress(Context.Session))</span>
                    </div>

                    @{
                        decimal depositVal = (decimal)(ViewBag.Deposit ?? 0);
                        decimal paymentVal = (decimal)(ViewBag.Payment ?? 0);
                        bool isOrderFullPaid = paymentVal == 0 && depositVal > 0;
                    }
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">@(isOrderFullPaid ? "Đã thanh toán qua sàn (100%):" : "Tiền cọc giữ chỗ (30%):")</span>
                            <span class="fw-bold text-success">@depositVal.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">Thanh toán khi nhận xe:</span>
                            <span class="fw-bold @(isOrderFullPaid ? "text-success" : "text-primary")">@(isOrderFullPaid ? "0 đ (Đã thanh toán đủ)" : paymentVal.ToString("N0") + " đ")</span>
                        </div>
                        @if (overKmFee > 0)
                        {
                            <div class="d-flex justify-content-between small border-top pt-2 mt-2">
                                <span class="text-danger fw-semibold">Phụ phí vượt km (@overKm km):</span>
                                <span class="fw-bold text-danger">+@overKmFee.ToString("N0") đ</span>
                            </div>
                        }
                    </div>

                    @if (statusId == 5 && (ViewBag.IsRenter as bool? ?? false))
                    {
                        var exReview = ViewBag.ExistingReview as CarRental.Models.CarReview;
                        if (exReview == null)
                        {
                            <button type="button" class="btn btn-warning w-100 rounded-3 py-2.5 fw-bold mb-3 shadow-sm text-dark d-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#modalReviewOrder">
                                <i class="bi bi-star-fill text-dark"></i>
                                <span>Đánh giá chuyến đi</span>
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-success border-success-subtle p-3 rounded-3 mb-3 bg-white shadow-xs">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="fw-bold small text-success"><i class="bi bi-check-circle-fill me-1"></i> Đã đánh giá chuyến đi</span>
                                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@exReview.Star ★</span>
                                </div>
                                <p class="small text-secondary mb-0 fst-italic">"@exReview.Detail"</p>
                            </div>
                        }
                    }

                    <!-- Nút xem hợp đồng điện tử -->
                    <button type="button" class="btn btn-outline-primary w-100 rounded-3 py-2 fw-bold mb-3" data-bs-toggle="modal" data-bs-target="#contractModal">
                        <i class="bi bi-file-earmark-text-fill me-1"></i> Xem Hợp đồng & Biên bản
                    </button>

                    @if (isCancelled)
                    {
                        <div class="alert alert-secondary text-center small mb-0 rounded-3">
                            <i class="bi bi-info-circle me-1"></i> Đơn hàng này đã được hủy thành công.
                        </div>
                    }
                    else if (statusId == 1 || statusId == 3)
                    {
                        <form id="cancelOrderForm">
                            <input type="hidden" id="orderId" value="@ViewBag.OrderId" />
                            <button type="submit" class="btn btn-outline-danger w-100 rounded-3 py-2 fw-semibold small">
                                <i class="bi bi-x-circle me-1"></i> Yêu cầu hủy đơn thuê xe
                            </button>
                        </form>
                    }
                </div>

                <div class="text-center">
                    <a href="/Accounts/Index?tab=orders" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đơn hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL HỢP ĐỒNG ĐIỆN TỬ CHUẨN A4 -->
<div class="modal fade" id="contractModal" tabindex="-1" aria-labelledby="contractModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="contractModalLabel">
                    <i class="bi bi-file-earmark-check text-primary me-2"></i>
                    Hợp đồng điện tử & Biên bản bàn giao #@ViewBag.OrderId
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div id="printableContract" class="contract-paper rounded-3">
                    <div class="text-center mb-4">
                        <div class="fw-bold" style="font-size: 14px;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                        <div class="fw-semibold" style="font-size: 13px;">Độc lập – Tự do – Hạnh phúc</div>
                        <div style="letter-spacing: 2px;">---------o0o---------</div>
                    </div>

                    <div class="contract-header-title">HỢP ĐỒNG ĐIỆN TỬ THUÊ XE Ô TÔ (SÀN KẾT NỐI RECAR)</div>
                    <div class="contract-subtitle">Số hợp đồng: HD-RECAR-@ViewBag.OrderId / 2026</div>

                    <p>Hôm nay, ngày @DateTime.Now.ToString("dd") tháng @DateTime.Now.ToString("MM") năm @DateTime.Now.ToString("yyyy"), tại hệ thống Sàn giao dịch thương mại điện tử ReCar, các bên tham gia thỏa thuận gồm có:</p>

                    <div class="contract-section-title">BÊN A (CHỦ SỞ HỮU PHƯƠNG TIỆN / BÊN CHO THUÊ):</div>
                    <ul class="list-unstyled mb-2">
                        <li><strong>Đại diện:</strong> Đối tác Chủ xe cá nhân/Hộ kinh doanh đã được xác thực trên nền tảng ReCar</li>
                        <li><strong>Tình trạng xe:</strong> Phương tiện đã được phê duyệt đăng kiểm, bảo hiểm và hồ sơ pháp lý bởi Admin ReCar</li>
                        <li><strong>Trách nhiệm:</strong> Bàn giao phương tiện đúng hẹn và trực tiếp phục vụ lái xe nếu khách chọn gói Có tài xế</li>
                    </ul>

                    <div class="contract-section-title">BÊN B (BÊN THUÊ XE):</div>
                    <ul class="list-unstyled mb-2">
                        <li><strong>Họ và tên:</strong> @Function.GetUserName(Context.Session)</li>
                        <li><strong>Số điện thoại:</strong> @Function.GetPhone(Context.Session)</li>
                        <li><strong>Địa chỉ liên hệ:</strong> @Function.GetAddress(Context.Session)</li>
                        @if (isWithDriver)
                        {
                            <li><strong>Hình thức dịch vụ:</strong> <span class="badge bg-warning text-dark">Thuê xe có tài xế</span> (Tài xế phục vụ điều khiển phương tiện, khách hàng không cần xuất trình GPLX).</li>
                        }
                        else
                        {
                            <li><strong>Hình thức dịch vụ:</strong> <span class="badge bg-primary">Thuê xe tự lái</span> (Khách hàng nhận xe từ chủ xe và tự điều khiển, cam kết có GPLX B1/B2 hợp lệ).</li>
                        }
                    </ul>

                    <div class="contract-section-title">ĐƠN VỊ VẬN HÀNH NỀN TẢNG (TRUNG GIAN BẢO LÃNH):</div>
                    <ul class="list-unstyled mb-2">
                        <li><strong>Đơn vị:</strong> Công ty TNHH Dịch vụ Công nghệ ReCar Việt Nam (ReCar Platform)</li>
                        <li><strong>Vai trò:</strong> Cung cấp nền tảng kết nối trực tuyến, xác minh danh tính hai bên, giữ tiền cọc an toàn và bảo vệ quyền lợi hợp đồng</li>
                    </ul>

                    <div class="contract-section-title">ĐIỀU 1: PHƯƠNG TIỆN VÀ THỜI GIAN THUÊ</div>
                    <p class="mb-2">Bên A đồng ý giao và Bên B đồng ý thuê phương tiện theo chi tiết sau:</p>
                    <table class="table table-bordered table-sm small mb-3">
                        <thead class="table-light">
                            <tr>
                                <th>Tên xe</th>
                                <th>Biển số</th>
                                <th>Hình thức</th>
                                <th>Ngày nhận</th>
                                <th>Ngày hoàn trả</th>
                                <th>Số lượng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model) {
                                <tr>
                                    <td><strong>@item.CarName</strong></td>
                                    <td>@(carObj != null && !string.IsNullOrEmpty(carObj.LicensePlate) ? carObj.LicensePlate : "N/A")</td>
                                    <td>@(isWithDriver ? "Có tài xế" : "Tự lái")</td>
                                    <td>@item.pickupDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.returnDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Quantity xe</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="contract-section-title">ĐIỀU 2: GIÁ THUÊ VÀ ĐẶT CỌC</div>
                    <ul>
                        @if (isOrderFullPaid)
                        {
                            <li>Bên B đã hoàn tất thanh toán <strong>100% trọn gói giá trị hợp đồng thuê xe (@depositVal.ToString("N0") VNĐ)</strong> qua cổng thanh toán VNPay do sàn ReCar bảo lãnh.</li>
                            <li>Bên B không cần thanh toán thêm tiền thuê xe khi nhận bàn giao xe từ Bên A (ngoại trừ phụ phí vượt hạn mức km hoặc chi phí nhiên liệu phát sinh thực tế nếu có).</li>
                        }
                        else
                        {
                            <li>Bên B có nghĩa vụ thanh toán khoản tiền cọc 30% (@depositVal.ToString("N0") VNĐ) qua cổng thanh toán do ReCar bảo lãnh để xác nhận đặt xe.</li>
                            <li>Số tiền còn lại 70% (@paymentVal.ToString("N0") VNĐ) sẽ được Bên B thanh toán trực tiếp cho Chủ xe (Bên A) ngay khi nhận bàn giao xe và đối chiếu thực tế.</li>
                        }
                        @if (isWithDriver)
                        {
                            <li>Chi phí đơn hàng đã bao gồm tiền thuê phương tiện và <strong>phụ phí tài xế</strong> (500.000đ/ngày).</li>
                        }
                    </ul>

                    <div class="contract-section-title">ĐIỀU 3: QUY ĐỊNH HÀNH TRÌNH & ĐỐI CHIẾU CÔNG TƠ MÉT (ODO)</div>
                    <ul>
                        <li><strong>Giới hạn quãng đường:</strong> @carPolicy.MileageLimit km/ngày. Tổng hạn mức chuyến đi @rentalDays ngày là <strong>@allowedKmTotal km</strong>.</li>
                        <li><strong>Phụ phí vượt quãng đường:</strong> Nếu vượt quá hạn mức trên, Bên B có nghĩa vụ thanh toán phụ phí <strong>@carPolicy.ExtraFeePerKm.ToString("N0") VNĐ/km</strong> trực tiếp cho Bên A khi bàn giao hoàn trả xe.</li>
                        @if (handover != null)
                        {
                            <li><strong>Chỉ số ODO lúc nhận xe:</strong> <span class="fw-bold">@handover.Odometer.ToString("N0") km</span> (Mức nhiên liệu: @handover.FuelLevel%) ghi nhận lúc @handover.CreatedAt.ToString("dd/MM/yyyy HH:mm").</li>
                        }
                        @if (returnInsp != null)
                        {
                            <li><strong>Chỉ số ODO lúc trả xe:</strong> <span class="fw-bold">@returnInsp.Odometer.ToString("N0") km</span> (Mức nhiên liệu: @returnInsp.FuelLevel%) ghi nhận lúc @returnInsp.CreatedAt.ToString("dd/MM/yyyy HH:mm").</li>
                            @if (drivenKm.HasValue)
                            {
                                <li><strong>Quãng đường thực tế đã đi:</strong> @drivenKm.Value.ToString("N0") km. @(overKm > 0 ? $"Vượt hạn mức {overKm:N0} km ➜ Phụ phí phát sinh: {overKmFee:N0} VNĐ." : "Nằm trong hạn mức cho phép (Không phát sinh phụ phí).")</li>
                            }
                        }
                    </ul>

                    <div class="contract-section-title">ĐIỀU 4: TRÁCH NHIỆM VÀ CAM KẾT CỦA CÁC BÊN</div>
                    <ul>
                        @if (isWithDriver)
                        {
                            <li><strong>Bên A (Chủ xe & Tài xế):</strong> Chịu trách nhiệm cung cấp phương tiện tiêu chuẩn kỹ thuật an toàn, tài xế điều khiển xe an toàn, lịch sự, đúng giờ. Mọi sự cố va chạm hoặc vi phạm Luật Giao thông trong quá trình phục vụ thuộc trách nhiệm của Bên A.</li>
                            <li><strong>Bên B (Khách hàng):</strong> Sử dụng phương tiện đúng lịch trình và mục đích thỏa thuận, không mang chất cấm, chất cháy nổ lên xe; thanh toán đủ tiền thuê cho chủ xe theo thỏa thuận.</li>
                        }
                        else
                        {
                            <li><strong>Bên A (Chủ xe):</strong> Bàn giao xe đúng chủng loại, đảm bảo xe sạch sẽ, an toàn kỹ thuật, đầy đủ giấy tờ đăng ký và bảo hiểm hợp lệ.</li>
                            <li><strong>Bên B (Khách tự lái):</strong> Cam kết người điều khiển phương tiện có Giấy phép lái xe hợp lệ, trực tiếp lái xe đúng mục đích, chấp hành nghiêm chỉnh Luật Giao thông và tự chịu trách nhiệm về các vi phạm giao thông phát sinh trong thời gian thuê.</li>
                        }
                        <li><strong>Nền tảng ReCar:</strong> Giám sát giao dịch, bảo vệ tiền cọc minh bạch và hỗ trợ hòa giải nếu phát sinh tranh chấp giữa Chủ xe và Khách thuê.</li>
                    </ul>

                    <div class="row mt-5 pt-3">
                        <div class="col-4 text-center">
                            <strong>ĐẠI DIỆN BÊN B (BÊN THUÊ)</strong>
                            <div class="text-muted small mt-1">(Đã ký xác nhận điện tử)</div>
                            <div class="mt-4 fw-bold text-primary">@Function.GetUserName(Context.Session)</div>
                        </div>
                        <div class="col-4 text-center">
                            <strong>ĐẠI DIỆN BÊN A (CHỦ XE)</strong>
                            <div class="text-muted small mt-1">(Đã xác nhận bàn giao)</div>
                            <div class="mt-4 fw-bold text-dark">Đối tác Chủ xe ReCar</div>
                        </div>
                        <div class="col-4 text-center">
                            <strong>XÁC THỰC BỞI RECAR</strong>
                            <div class="text-muted small mt-1">(Bảo lãnh nền tảng)</div>
                            <div class="mt-4 text-success fw-bold">
                                <i class="bi bi-patch-check-fill me-1"></i> PLATFORM VERIFIED
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top bg-white">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary rounded-3 px-4 fw-bold" onclick="window.print()">
                    <i class="bi bi-printer-fill me-1"></i> In / Xuất PDF Hợp đồng
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Lightbox Xem Ảnh Biên Bản Phóng To -->
<div class="modal fade" id="inspPhotoLightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="inspPhotoLightboxTitle">Ảnh hiện trạng bàn giao</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-3">
                <img id="inspPhotoLightboxImg" src="" alt="Ảnh hiện trạng" class="img-fluid rounded-3 shadow-sm" style="max-height: 75vh; object-fit: contain;">
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function showLightbox(imgUrl, title) {
            document.getElementById('inspPhotoLightboxImg').src = imgUrl;
            document.getElementById('inspPhotoLightboxTitle').innerText = title || 'Ảnh hiện trạng bàn giao xe';
            const modal = new bootstrap.Modal(document.getElementById('inspPhotoLightboxModal'));
            modal.show();
        }

        $(document).on('submit', '#cancelOrderForm', function (e) {
            e.preventDefault();
            var orderId = $('#orderId').val();

            Swal.fire({
                title: 'Hủy đơn thuê xe này?',
                text: 'Nếu đã đặt cọc trước 24h, tiền cọc sẽ được hoàn lại theo chính sách của ReCar.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý hủy đơn',
                cancelButtonText: 'Không, giữ lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Accounts/CancelOrder',
                        type: 'POST',
                        data: { orderId: orderId },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    title: 'Đã hủy thành công!',
                                    text: response.message,
                                    icon: 'success',
                                    confirmButtonText: 'OK',
                                    confirmButtonColor: '#2563eb'
                                }).then(() => {
                                    window.location.href = "/Accounts/Index?tab=orders";
                                });
                            } else {
                                Swal.fire({
                                    title: 'Không thể hủy!',
                                    text: response.message,
                                    icon: 'error',
                                    confirmButtonText: 'Đóng',
                                    confirmButtonColor: '#2563eb'
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                title: 'Lỗi',
                                text: 'Đã xảy ra lỗi khi hủy đơn. Vui lòng thử lại sau.',
                                icon: 'error',
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#2563eb'
                            });
                        }
                    });
                }
            });
        });
    </script>
}


<!-- MODAL ĐÁNH GIÁ CHUYẾN ĐI (CHỈ KHÁCH THUÊ MỚI CÓ THỂ ĐÁNH GIÁ) -->
<div class="modal fade" id="modalReviewOrder" tabindex="-1" aria-labelledby="modalReviewOrderLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="modalReviewOrderLabel">Đánh giá chuyến đi</h5>
                    <p class="text-muted small mb-0">Chia sẻ trải nghiệm của bạn về chiếc xe <strong>@(carObj?.CarName)</strong></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <form id="formSubmitReview">
                    <input type="hidden" id="reviewOrderId" value="@ViewBag.OrderId" />
                    <input type="hidden" id="reviewCarId" value="@(carObj?.CarId ?? 0)" />
                    <input type="hidden" id="reviewStarValue" value="5" />

                    <!-- Rating Stars -->
                    <div class="text-center mb-4">
                        <div class="d-flex justify-content-center gap-2 mb-2" id="starRatingContainer">
                            <i class="bi bi-star-fill text-warning fs-2 rating-star" data-val="1" style="cursor: pointer;"></i>
                            <i class="bi bi-star-fill text-warning fs-2 rating-star" data-val="2" style="cursor: pointer;"></i>
                            <i class="bi bi-star-fill text-warning fs-2 rating-star" data-val="3" style="cursor: pointer;"></i>
                            <i class="bi bi-star-fill text-warning fs-2 rating-star" data-val="4" style="cursor: pointer;"></i>
                            <i class="bi bi-star-fill text-warning fs-2 rating-star" data-val="5" style="cursor: pointer;"></i>
                        </div>
                        <span id="starRatingLabel" class="fw-bold text-warning small">5 sao - Rất hài lòng</span>
                    </div>

                    <!-- Review Textarea -->
                    <div class="mb-3">
                        <label for="reviewComment" class="form-label fw-semibold small text-muted">Nhận xét chi tiết:</label>
                        <textarea class="form-control rounded-3" id="reviewComment" rows="3" maxlength="200" placeholder="Xe chạy êm, chủ xe nhiệt tình và đúng giờ..."></textarea>
                        <div class="d-flex justify-content-between mt-1 text-muted" style="font-size: 11px;">
                            <span>Đánh giá của bạn giúp cộng đồng chọn xe tốt hơn.</span>
                            <span id="reviewCharCount">0/200</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end pt-2">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Để sau</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold" id="btnSubmitReview">
                            <i class="bi bi-send-fill me-1"></i> Gửi đánh giá
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const starLabels = {
            1: '1 sao - Rất tệ',
            2: '2 sao - Chưa hài lòng',
            3: '3 sao - Bình thường',
            4: '4 sao - Hài lòng',
            5: '5 sao - Rất hài lòng'
        };

        const stars = document.querySelectorAll('.rating-star');
        const starInput = document.getElementById('reviewStarValue');
        const starLabel = document.getElementById('starRatingLabel');
        const commentInput = document.getElementById('reviewComment');
        const charCount = document.getElementById('reviewCharCount');

        function updateStars(val) {
            stars.forEach(s => {
                const sVal = parseInt(s.getAttribute('data-val'));
                if (sVal <= val) {
                    s.classList.remove('bi-star');
                    s.classList.add('bi-star-fill', 'text-warning');
                } else {
                    s.classList.remove('bi-star-fill', 'text-warning');
                    s.classList.add('bi-star', 'text-secondary');
                }
            });
            if (starLabel) starLabel.innerText = starLabels[val] || (val + ' sao');
        }

        stars.forEach(s => {
            s.addEventListener('click', function () {
                const val = parseInt(this.getAttribute('data-val'));
                if (starInput) starInput.value = val;
                updateStars(val);
            });
        });

        if (commentInput && charCount) {
            commentInput.addEventListener('input', function () {
                charCount.innerText = this.value.length + '/200';
            });
        }

        const reviewForm = document.getElementById('formSubmitReview');
        if (reviewForm) {
            reviewForm.addEventListener('submit', function (e) {
                e.preventDefault();
                const orderId = parseInt(document.getElementById('reviewOrderId')?.value || '0');
                const carId = parseInt(document.getElementById('reviewCarId')?.value || '0');
                const star = parseInt(starInput?.value || '5');
                const detail = commentInput?.value || '';

                const submitBtn = document.getElementById('btnSubmitReview');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang gửi...';
                }

                fetch('/Accounts/SubmitReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderId: orderId,
                        carId: carId,
                        star: star,
                        detail: detail
                    })
                })
                .then(res => res.json())
                .then(data => {
                    if (data && data.success) {
                        Swal.fire({
                            title: 'Thành công!',
                            text: data.message || 'Cảm ơn bạn đã gửi đánh giá!',
                            icon: 'success',
                            confirmButtonColor: '#0284c7'
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            title: 'Không thể gửi!',
                            text: (data && data.message) || 'Có lỗi xảy ra, vui lòng thử lại.',
                            icon: 'error',
                            confirmButtonColor: '#0284c7'
                        });
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="bi bi-send-fill me-1"></i> Gửi đánh giá';
                        }
                    }
                })
                .catch(() => {
                    Swal.fire({
                        title: 'Lỗi kết nối!',
                        text: 'Không thể kết nối máy chủ. Vui lòng thử lại sau.',
                        icon: 'error',
                        confirmButtonColor: '#0284c7'
                    });
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-send-fill me-1"></i> Gửi đánh giá';
                    }
                });
            });
        }
    });
</script>
