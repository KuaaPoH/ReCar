                            <div class="rounded-3 d-flex align-items-center justify-content-center text-primary shadow-xs" style="width: 40px; height: 40px; background-color: #e0f2fe;">
                                <i class="bi bi-car-front-fill fs-5"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0 fs-6">Đội xe do chủ xe này sở hữu (@ownedCars.Count)</h5>
                                <span class="text-muted small" style="font-size: 0.75rem;">Các phương tiện đối tác đang đăng tải trên sàn ReCar</span>
                            </div>
                        </div>
