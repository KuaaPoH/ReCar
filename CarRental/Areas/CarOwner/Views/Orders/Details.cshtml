@model CarRental.Models.CarRentalOrder
@using CarRental.Utilities
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.OrderId} — ReCar Host Pro";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";

    var firstDetail = Model.OrderDetails?.FirstOrDefault();
    var car = firstDetail?.Car;
    var customer = Model.Customer;

    int days = 1;
    if (firstDetail?.PickupDate.HasValue == true && firstDetail?.ReturnDate.HasValue == true)
    {
        days = Math.Max(1, (int)(firstDetail.ReturnDate.Value.Date - firstDetail.PickupDate.Value.Date).TotalDays);
    }

    decimal deposit = Model.Deposit ?? 0;
    decimal remainingToCollect = Model.Payment ?? 0;
    decimal totalRent = deposit + remainingToCollect;
    if (totalRent == 0) totalRent = Model.Payment ?? 0;
    decimal platformFee = totalRent * 0.1m;
    decimal payoutFromPlatform = Math.Max(0, deposit - platformFee);
    decimal netEarnings = Math.Max(0, totalRent - platformFee);
    bool isPaidFull = remainingToCollect == 0 && deposit > 0;

    string custName = customer?.Name ?? customer?.FullName ?? "Khách hàng ReCar";
    string initialsStr = "KH";
    if (!string.IsNullOrWhiteSpace(custName))
    {
        var parts = custName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            initialsStr = (parts[0][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper();
        }
        else if (parts.Length == 1 && parts[0].Length >= 2)
        {
            initialsStr = parts[0].Substring(0, 2).ToUpper();
        }
    }

    string cccdFull = !string.IsNullOrEmpty(customer?.Idcard) ? customer.Idcard : "079201008921";
    string cccdMasked = cccdFull.Length > 4 ? cccdFull.Substring(0, cccdFull.Length - 4) + "****" : cccdFull;

    string gplxFull = !string.IsNullOrEmpty(customer?.LicenseNumber) ? customer.LicenseNumber : "790158291042";
    string gplxMasked = gplxFull.Length > 4 ? gplxFull.Substring(0, gplxFull.Length - 4) + "****" : gplxFull;

    var handoverInspection = ViewBag.HandoverInspection as CarRental.Models.VehicleInspection;
    var returnInspection = ViewBag.ReturnInspection as CarRental.Models.VehicleInspection;
    var carPolicy = ViewBag.CarPolicy as CarRental.Utilities.CarPolicy ?? CarRental.Utilities.CarPolicy.Parse(car);

    int allowedKmTotal = days * carPolicy.MileageLimit;
    int? drivenKm = (handoverInspection != null && returnInspection != null && returnInspection.Odometer >= handoverInspection.Odometer && handoverInspection.Odometer > 0)
        ? (returnInspection.Odometer - handoverInspection.Odometer)
        : (int?)null;
    int overKm = drivenKm.HasValue ? Math.Max(0, drivenKm.Value - allowedKmTotal) : 0;
    decimal overKmFee = overKm * carPolicy.ExtraFeePerKm;
    int? fuelDiff = (handoverInspection != null && returnInspection != null)
        ? (returnInspection.FuelLevel - handoverInspection.FuelLevel)
        : (int?)null;
}

@Html.AntiForgeryToken()



<div class="space-y-4">
    <!-- Nút quay lại & Tiêu đề trang -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <a href="/CarOwner/Orders/Index" class="text-secondary text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1.5">
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
            <span>Về danh sách đơn</span>
        </a>
    </div>

    <!-- 1. BANNER TRÊN CÙNG: CHI TIẾT XE & THÔNG TIN ĐƠN (2 CỘT CHUẨN TEMPLATE) -->
    <div class="card-surface overflow-hidden mb-4">
        <div class="row g-0">
            <!-- Cột trái: Ảnh xe lớn -->
            <div class="col-12 col-md-5 col-xl-4 bg-light">
                <img src="@(string.IsNullOrEmpty(car?.Image) ? "/images/cars/car-sedan.jpg" : car.Image)" 
                     alt="@(car?.CarName ?? "Xe ReCar")" 
                     class="order-banner-img" />
            </div>

            <!-- Cột phải: Thông tin xe và thao tác -->
            <div class="col-12 col-md-7 col-xl-8 p-4 p-lg-5 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                        <span class="font-monospace fw-semibold text-muted" style="font-size: 0.95rem;">#RC-@Model.OrderId</span>
                        @if (Model.StatusId == 3)
                        {
                            <span class="status-badge-custom badge-status-3">
                                <span class="dot"></span> Chờ bàn giao
                            </span>
                        }
                        else if (Model.StatusId == 4)
                        {
                            <span class="status-badge-custom badge-status-4">
                                <span class="dot"></span> Đang cho thuê
                            </span>
                        }
                        else if (Model.StatusId == 5)
                        {
                            <span class="status-badge-custom badge-status-5">
                                <span class="dot"></span> Đã hoàn tất
                            </span>
                        }
                        else if (Model.StatusId == 2)
                        {
                            <span class="status-badge-custom badge-status-2">
                                <span class="dot"></span> Đã hủy
                            </span>
                        }
                        else
                        {
                            <span class="status-badge-custom badge-status-other">
                                <span class="dot"></span> @(Model.Status?.StatusDescription ?? "Đã đặt")
                            </span>
                        }
                    </div>

                    <h1 class="h3 fw-bold text-dark mb-2" style="font-size: 1.6rem;">@(car?.CarName ?? "Phương tiện ReCar")</h1>
                    <div class="mb-2">
                        <span class="plate">@(car?.LicensePlate ?? "CHƯA CẤP")</span>
                    </div>

                    <p class="text-muted small mb-3">
                        @(car?.Seat ?? 5) chỗ · @(car?.Transmission ?? "Tự động") · @(car?.Fuel ?? "Xăng") · @(car?.Color ?? "Màu cơ bản")
                    </p>

                    <!-- Khối Lịch trình nhận/trả xe 2 ô -->
                    <div class="row g-2 max-w-md pt-1 mb-4" style="max-width: 480px;">
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <p class="text-muted mb-1" style="font-size: 0.75rem;">Nhận xe</p>
                                <p class="fw-bold text-dark mb-0" style="font-size: 0.875rem;">
                                    @(handoverInspection != null 
                                        ? handoverInspection.CreatedAt.ToString("HH:mm - dd/MM/yyyy") 
                                        : Function.FormatSafeDateTime(firstDetail?.PickupDate, "09:00"))
                                </p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <p class="text-muted mb-1" style="font-size: 0.75rem;">Trả xe</p>
                                <p class="fw-bold text-dark mb-0" style="font-size: 0.875rem;">
                                    @(returnInspection != null 
                                        ? returnInspection.CreatedAt.ToString("HH:mm - dd/MM/yyyy") 
                                        : Function.FormatSafeDateTime(firstDetail?.ReturnDate, "18:00"))
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thao tác nhanh -->
                <div class="pt-3 border-top d-flex flex-wrap gap-2">
                    @if (Model.StatusId == 3 || Model.StatusId == 1)
                    {
                        <button type="button" class="btn btn-success rounded-xl px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-xs"
                                onclick="openInspectionModal('handover', true)" style="background-color: #10b981; border-color: #10b981;">
                            <i data-lucide="camera" style="width: 18px; height: 18px;"></i>
                            <span>Bàn giao xe & Lập biên bản Check-in</span>
                        </button>
                    }
                    else if (Model.StatusId == 4)
                    {
                        <button type="button" class="btn btn-primary rounded-xl px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-xs"
                                onclick="openInspectionModal('return', true)" style="background-color: #0284c7; border-color: #0284c7;">
                            <i data-lucide="clipboard-check" style="width: 18px; height: 18px;"></i>
                            <span>Nhận xe & Lập biên bản Check-out</span>
                        </button>
                    }
                    <a href="#digitalInspectionSection" class="btn btn-outline-primary rounded-xl px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1.5">
                        <i data-lucide="file-check-2" style="width: 16px; height: 16px;"></i>
                        <span>Xem biên bản hiện trạng</span>
                    </a>
                    <a href="/Product/Details/@(car?.CarId)" target="_blank" class="btn btn-light border rounded-xl px-3 py-2 fw-medium text-secondary d-inline-flex align-items-center gap-1.5">
                        <i data-lucide="external-link" style="width: 16px; height: 16px;"></i>
                        <span>Xem xe trên sàn</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. HÀNG 3 CARD TIỂU CHUẨN: KHÁCH THUÊ | CHECKLIST BÀN GIAO | PHÂN RÃ TÀI CHÍNH -->
    <div class="row g-4 mb-4">
        <!-- Card 1: Khách thuê -->
        <div class="col-12 col-lg-4">
            <div class="card-surface p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h2 class="h6 fw-bold text-dark mb-3" style="font-size: 1rem;">Khách thuê</h2>
                    
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="rounded-circle flex-shrink-0 fw-bold d-inline-flex align-items-center justify-content-center" 
                              style="width: 48px; height: 48px; min-width: 48px; min-height: 48px; background-color: #e0f2fe; color: #0284c7; font-size: 1.05rem; line-height: 1; text-align: center;">
                            @initialsStr
                        </span>
                        <div>
                            <p class="fw-bold text-dark mb-0 fs-6">@custName</p>
                            <span class="badge bg-light text-muted border" style="font-size: 0.72rem;">Khách hàng cá nhân</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <a href="tel:@(customer?.PhoneNumber)" class="text-decoration-none d-flex align-items-center gap-2 mb-2" style="color: #0284c7; font-size: 0.875rem;">
                            <i data-lucide="phone" style="width: 16px; height: 16px;"></i>
                            <span>@(customer?.PhoneNumber ?? "0988.xxx.xxx")</span>
                        </a>
                        <p class="text-muted d-flex align-items-center gap-2 mb-0" style="font-size: 0.875rem;">
                            <i data-lucide="mail" style="width: 16px; height: 16px;"></i>
                            <span>@(customer?.Email ?? "khachhang@recar.vn")</span>
                        </p>
                    </div>

                    <!-- Khối CCCD & GPLX -->
                    <div class="p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0; font-size: 0.84rem;">
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="text-muted">CCCD:</span>
                            <span class="font-monospace fw-semibold text-dark" id="displayCccd">@cccdMasked</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">GPLX:</span>
                            <span class="font-monospace fw-semibold text-dark" id="displayGplx">@gplxMasked</span>
                        </div>
                        <button type="button" class="btn btn-link p-0 text-decoration-none d-inline-flex align-items-center gap-1" 
                                style="color: #0284c7; font-size: 0.78rem;" onclick="toggleIdentityReveal()">
                            <i data-lucide="eye" id="iconReveal" style="width: 14px; height: 14px;"></i>
                            <span id="textReveal">Xem đầy đủ để đối chiếu khi bàn giao</span>
                        </button>
                    </div>

                    <!-- Nút Chat trực tiếp với Khách thuê -->
                    <button type="button" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold mt-3 d-flex align-items-center justify-content-center gap-2 shadow-xs" 
                            style="background: #0284c7; border-color: #0284c7; font-size: 0.85rem;"
                            onclick="openChatBox('@custName', 'Chào bạn! Tôi là đối tác chủ xe ở đơn thuê xe #@Model.OrderId.', @(car?.CarId ?? 0), @(customer?.CustomerId ?? 0), '@(car?.CarName ?? "")')">
                        <i class="bi bi-chat-dots-fill"></i>
                        <span>Chat với người thuê xe</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Card 2: Checklist bàn giao an toàn -->
        <div class="col-12 col-lg-4">
            <div class="card-surface p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h2 class="h6 fw-bold text-dark mb-3" style="font-size: 1rem;">Checklist bàn giao an toàn</h2>
                    
                    <ul class="list-unstyled mb-3" style="font-size: 0.875rem;">
                        <li class="d-flex align-items-start mb-3" style="gap: 14px;">
                            <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" 
                                  style="width: 20px; height: 20px; margin-top: 1px; color: @(Model.StatusId >= 4 ? "#10b981" : "#94a3b8") !important;">
                                <i data-lucide="check-circle-2" style="width: 19px; height: 19px; stroke-width: 2;"></i>
                            </span>
                            <span class="text-dark" style="line-height: 1.45;">Đối chiếu bản gốc CCCD/Hộ chiếu người thuê.</span>
                        </li>
                        <li class="d-flex align-items-start mb-3" style="gap: 14px;">
                            <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" 
                                  style="width: 20px; height: 20px; margin-top: 1px; color: @(Model.StatusId >= 4 ? "#10b981" : "#94a3b8") !important;">
                                <i data-lucide="check-circle-2" style="width: 19px; height: 19px; stroke-width: 2;"></i>
                            </span>
                            <span class="text-dark" style="line-height: 1.45;">Kiểm tra GPLX còn hiệu lực (bản gốc/VNeID).</span>
                        </li>
                        <li class="d-flex align-items-start mb-3" style="gap: 14px;">
                            <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" 
                                  style="width: 20px; height: 20px; margin-top: 1px; color: @(Model.StatusId >= 4 ? "#10b981" : "#94a3b8") !important;">
                                <i data-lucide="check-circle-2" style="width: 19px; height: 19px; stroke-width: 2;"></i>
                            </span>
                            @if (isPaidFull)
                            {
                                <span class="text-success fw-semibold" style="line-height: 1.45;"><i class="bi bi-shield-check me-1"></i> Khách đã thanh toán trọn gói 100% qua sàn (Không thu thêm tiền thuê).</span>
                            }
                            else
                            {
                                <span class="text-dark" style="line-height: 1.45;">Thu đủ 70% số tiền thuê còn lại khi giao chìa khóa (@remainingToCollect.ToString("N0") đ).</span>
                            }
                        </li>
                        <li class="d-flex align-items-start mb-3" style="gap: 14px;">
                            <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" 
                                  style="width: 20px; height: 20px; margin-top: 1px; color: @(handoverInspection != null || Model.StatusId >= 4 ? "#10b981" : "#94a3b8") !important;">
                                <i data-lucide="check-circle-2" style="width: 19px; height: 19px; stroke-width: 2;"></i>
                            </span>
                            <span class="text-dark" style="line-height: 1.45;">
                                Chụp ảnh 4 góc xe, mức xăng/pin & số km (ODO).
                                @if (handoverInspection != null)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.68rem;">ODO: @handoverInspection.Odometer.ToString("N0") km · @handoverInspection.FuelLevel%</span>
                                }
                            </span>
                        </li>
                        <li class="d-flex align-items-start mb-1" style="gap: 14px;">
                            <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" 
                                  style="width: 20px; height: 20px; margin-top: 1px; color: @(handoverInspection != null || Model.StatusId >= 4 ? "#10b981" : "#94a3b8") !important;">
                                <i data-lucide="check-circle-2" style="width: 19px; height: 19px; stroke-width: 2;"></i>
                            </span>
                            <span class="text-dark" style="line-height: 1.45;">Ký xác nhận biên bản bàn giao xe thực tế.</span>
                        </li>
                    </ul>
                </div>
                <div class="border-top pt-2.5 d-flex align-items-center justify-content-between gap-2">
                    @if (Model.StatusId == 3 || Model.StatusId == 1)
                    {
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-semibold w-100 d-inline-flex align-items-center justify-content-center gap-1.5"
                                style="background-color: #0284c7; border-color: #0284c7;" onclick="openInspectionModal('handover', true)">
                            <i data-lucide="camera" style="width: 14px; height: 14px;"></i>
                            <span>Lập biên bản bàn giao (Digital Check-in)</span>
                        </button>
                    }
                    else if (Model.StatusId == 4)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold w-100 d-inline-flex align-items-center justify-content-center gap-1.5"
                                onclick="openInspectionModal('return', true)">
                            <i data-lucide="clipboard-check" style="width: 14px; height: 14px;"></i>
                            <span>Lập biên bản nhận lại xe (Check-out)</span>
                        </button>
                    }
                    else
                    {
                        <a href="#digitalInspectionSection" class="text-primary text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1">
                            <i data-lucide="file-check-2" style="width: 14px; height: 14px;"></i>
                            <span>Đã lưu biên bản bàn giao điện tử</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Card 3: Phân rã tài chính -->
        <div class="col-12 col-lg-4">
            <div class="card-surface p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h2 class="h6 fw-bold text-dark mb-3" style="font-size: 1rem;">Phân rã tài chính</h2>
                    
                    <div class="space-y-2 mb-3" style="font-size: 0.84rem;">
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="text-dark">Tổng tiền thuê (@days ngày)</span>
                            <span class="fw-bold text-dark">@totalRent.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="text-muted">@(isPaidFull ? "Đã thanh toán qua sàn (100%)" : "Cọc 30% — sàn thu")</span>
                            <span class="text-dark fw-bold">@deposit.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="text-muted">Thu trực tiếp khi nhận xe</span>
                            <span class="@(isPaidFull ? "text-success fw-bold" : "text-dark")">@(isPaidFull ? "0 đ (Đã thanh toán đủ)" : remainingToCollect.ToString("N0") + " đ")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mb-1.5">
                            <span class="text-muted">Phí dịch vụ sàn 10% (trừ từ cọc)</span>
                            <span class="text-danger">−@platformFee.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Sàn chuyển lại cho bạn</span>
                            <span class="text-dark">@payoutFromPlatform.ToString("N0") đ</span>
                        </div>
                    </div>

                    <!-- Hộp nổi bật thu nhập thực nhận -->
                    <div class="p-3 rounded-3 d-flex justify-content-between align-items-center mb-2" style="background-color: #ecfdf5; border: 1px solid #a7f3d0; color: #047857;">
                        <span class="fw-semibold" style="font-size: 0.84rem;">Thu nhập thực nhận dự kiến</span>
                        <span class="fw-bold fs-6">@netEarnings.ToString("N0") đ</span>
                    </div>
                </div>

                <p class="text-muted mb-0 border-top pt-2" style="font-size: 0.72rem;">
                    Tỷ lệ theo cấu hình nghiệp vụ hiện tại; số liệu chính thức do hệ thống đối soát xác nhận.
                </p>
            </div>
        </div>
    </div>

    <!-- 2.5. BIÊN BẢN BÀN GIAO & ĐỐI CHIẾU HIỆN TRẠNG PHƯƠNG TIỆN (DIGITAL CHECK-IN / CHECK-OUT) -->
    <div id="digitalInspectionSection" class="card-surface p-4 mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-2.5">
                <span class="rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: #e0f2fe; color: #0284c7;">
                    <i data-lucide="camera" style="width: 20px; height: 20px;"></i>
                </span>
                <div>
                    <h2 class="h6 fw-bold text-dark mb-0" style="font-size: 1.05rem;">Biên bản bàn giao & Đối chiếu hiện trạng xe (Digital Check-in / Check-out)</h2>
                    <p class="text-muted mb-0" style="font-size: 0.78rem;">Lưu trữ công tơ mét (ODO), mức xăng/pin và 4 góc ảnh thực tế lúc giao & nhận lại xe để chống tranh chấp.</p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5"
                        onclick="openInspectionModal('handover', @(Model.StatusId == 3 || Model.StatusId == 1 ? "true" : "false"))">
                    <i data-lucide="camera" style="width: 14px; height: 14px;"></i>
                    <span>@(handoverInspection != null ? "Cập nhật biên bản giao xe" : "Lập biên bản giao xe (Check-in)")</span>
                </button>
                @if (Model.StatusId >= 4 || returnInspection != null)
                {
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5"
                            style="background-color: #0284c7; border-color: #0284c7;"
                            onclick="openInspectionModal('return', @(Model.StatusId == 4 ? "true" : "false"))">
                        <i data-lucide="clipboard-check" style="width: 14px; height: 14px;"></i>
                        <span>@(returnInspection != null ? "Cập nhật biên bản nhận xe" : "Lập biên bản nhận xe (Check-out)")</span>
                    </button>
                }
            </div>
        </div>

        <!-- Hộp đối chiếu nhanh ODO & Nhiên liệu nếu đã có cả 2 biên bản -->
        @if (handoverInspection != null && returnInspection != null)
        {
            <div class="p-3 rounded-3 mb-4" style="background: @(overKm > 0 ? "#fffbeb" : "#f0fdf4"); border: 1px solid @(overKm > 0 ? "#fde68a" : "#bbf7d0");">
                <div class="row g-3 align-items-center">
                    <div class="col-12 col-md-3">
                        <div class="text-muted small">Quãng đường đã di chuyển</div>
                        <div class="h5 fw-bold text-dark mb-0">@(drivenKm.HasValue ? $"{drivenKm.Value:N0} km" : "—")</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Hạn mức miễn phí: @allowedKmTotal.ToString("N0") km (@days ngày × @carPolicy.MileageLimit km)</div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="text-muted small">Vượt hạn mức quãng đường</div>
                        @if (overKm > 0)
                        {
                            <div class="h5 fw-bold text-danger mb-0">+@overKm.ToString("N0") km</div>
                            <div class="text-danger fw-semibold" style="font-size: 0.75rem;">Phụ phí: +@overKmFee.ToString("N0")đ (@carPolicy.ExtraFeePerKm.ToString("N0")đ/km)</div>
                        }
                        else
                        {
                            <div class="h6 fw-bold text-success mb-0">Trong hạn mức cho phép ✓</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Không phát sinh phụ phí km</div>
                        }
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="text-muted small">Đối chiếu mức xăng / pin</div>
                        <div class="fw-bold text-dark">
                            @handoverInspection.FuelLevel% → @returnInspection.FuelLevel%
                            @if (fuelDiff.HasValue)
                            {
                                <span class="badge @(fuelDiff.Value < 0 ? "bg-warning text-dark" : "bg-success-subtle text-success") ms-1">
                                    @(fuelDiff.Value >= 0 ? $"+{fuelDiff.Value}%" : $"{fuelDiff.Value}%")
                                </span>
                            }
                        </div>
                        <div class="text-muted" style="font-size: 0.72rem;">@(fuelDiff < -10 ? "Khách trả xe hụt nhiên liệu so với lúc nhận" : "Mức nhiên liệu bàn giao đạt yêu cầu")</div>
                    </div>
                    <div class="col-12 col-md-3 text-md-end">
                        <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background: #0f172a; color: #fff; font-size: 0.78rem;">
                            <i class="bi bi-shield-check me-1 text-info"></i>Đã đối chiếu 2 chiều
                        </span>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- CỘT 1: BIÊN BẢN LÚC BÀN GIAO XE (CHECK-IN) -->
            <div class="col-12 col-lg-6">
                <div class="p-3.5 rounded-3 h-100" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 1.25rem;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill px-2.5 py-1 fw-semibold" style="background: #dcfce7; color: #15803d;">1. LÚC GIAO XE (CHECK-IN)</span>
                            @if (handoverInspection != null)
                            {
                                <span class="text-muted" style="font-size: 0.75rem;">@handoverInspection.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</span>
                            }
                        </div>
                        @if (handoverInspection != null)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small fw-semibold" onclick="openInspectionModal('handover', false)">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </button>
                        }
                    </div>

                    @if (handoverInspection != null)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="p-2.5 bg-white rounded-3 border">
                                    <div class="text-muted" style="font-size: 0.72rem;">Số công tơ mét (ODO)</div>
                                    <div class="fw-bold text-dark fs-6 font-monospace">@handoverInspection.Odometer.ToString("N0") km</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2.5 bg-white rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted" style="font-size: 0.72rem;">Mức xăng / pin</span>
                                        <span class="fw-bold text-primary small">@handoverInspection.FuelLevel%</span>
                                    </div>
                                    <div class="progress mt-1.5" style="height: 7px;">
                                        <div class="progress-bar bg-info" role="progressbar" style="width: @(handoverInspection.FuelLevel)%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="text-muted fw-semibold mb-1.5" style="font-size: 0.75rem;">Ảnh chụp 4 góc xe lúc bàn giao:</div>
                            <div class="row g-2">
                                @{
                                    var hSlots = new[] {
                                        (Label: "Đầu xe", Url: handoverInspection.FrontImage),
                                        (Label: "Đuôi xe", Url: handoverInspection.RearImage),
                                        (Label: "Thân trái", Url: handoverInspection.LeftImage),
                                        (Label: "Thân phải", Url: handoverInspection.RightImage)
                                    };
                                }
                                @foreach (var s in hSlots)
                                {
                                    <div class="col-6 col-sm-3">
                                        <div class="position-relative">
                                            @if (!string.IsNullOrEmpty(s.Url))
                                            {
                                                <img src="@s.Url" alt="@s.Label" class="inspection-thumb" onclick="previewLightbox('@s.Url', 'Lúc giao xe — @s.Label')" />
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-column align-items-center justify-content-center bg-white rounded-2 border text-muted" style="aspect-ratio: 4/3; font-size: 0.7rem;">
                                                    <i class="bi bi-camera mb-1"></i>@s.Label
                                                </div>
                                            }
                                            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-1" style="font-size: 0.62rem;">@s.Label</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="p-2.5 bg-white rounded-3 border small">
                            <span class="text-muted fw-semibold">Ghi chú hiện trạng:</span>
                            <span class="text-dark">@(string.IsNullOrWhiteSpace(handoverInspection.Notes) ? "Ngoại thất nguyên vẹn, lốp căng đều, đầy đủ giấy tờ xe." : handoverInspection.Notes)</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i data-lucide="camera" class="text-muted mb-2" style="width: 32px; height: 32px; opacity: 0.45;"></i>
                            <p class="text-muted small mb-3">Chưa có biên bản bàn giao (Check-in) cho đơn này.</p>
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-semibold"
                                    onclick="openInspectionModal('handover', @(Model.StatusId == 3 || Model.StatusId == 1 ? "true" : "false"))">
                                <i class="bi bi-camera-fill me-1"></i>Chụp 4 góc xe & Nhập ODO lúc giao
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- CỘT 2: BIÊN BẢN LÚC NHẬN LẠI XE (CHECK-OUT) -->
            <div class="col-12 col-lg-6">
                <div class="p-3.5 rounded-3 h-100" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 1.25rem;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill px-2.5 py-1 fw-semibold" style="background: #e0f2fe; color: #0369a1;">2. LÚC NHẬN LẠI XE (CHECK-OUT)</span>
                            @if (returnInspection != null)
                            {
                                <span class="text-muted" style="font-size: 0.75rem;">@returnInspection.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</span>
                            }
                        </div>
                        @if (returnInspection != null)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small fw-semibold" onclick="openInspectionModal('return', false)">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </button>
                        }
                    </div>

                    @if (returnInspection != null)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="p-2.5 bg-white rounded-3 border">
                                    <div class="text-muted" style="font-size: 0.72rem;">Số công tơ mét lúc trả (ODO)</div>
                                    <div class="fw-bold text-dark fs-6 font-monospace">@returnInspection.Odometer.ToString("N0") km</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2.5 bg-white rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted" style="font-size: 0.72rem;">Mức xăng / pin lúc trả</span>
                                        <span class="fw-bold text-primary small">@returnInspection.FuelLevel%</span>
                                    </div>
                                    <div class="progress mt-1.5" style="height: 7px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(returnInspection.FuelLevel)%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="text-muted fw-semibold mb-1.5" style="font-size: 0.75rem;">Ảnh chụp 4 góc xe lúc nhận lại:</div>
                            <div class="row g-2">
                                @{
                                    var rSlots = new[] {
                                        (Label: "Đầu xe", Url: returnInspection.FrontImage),
                                        (Label: "Đuôi xe", Url: returnInspection.RearImage),
                                        (Label: "Thân trái", Url: returnInspection.LeftImage),
                                        (Label: "Thân phải", Url: returnInspection.RightImage)
                                    };
                                }
                                @foreach (var s in rSlots)
                                {
                                    <div class="col-6 col-sm-3">
                                        <div class="position-relative">
                                            @if (!string.IsNullOrEmpty(s.Url))
                                            {
                                                <img src="@s.Url" alt="@s.Label" class="inspection-thumb" onclick="previewLightbox('@s.Url', 'Lúc nhận lại xe — @s.Label')" />
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-column align-items-center justify-content-center bg-white rounded-2 border text-muted" style="aspect-ratio: 4/3; font-size: 0.7rem;">
                                                    <i class="bi bi-camera mb-1"></i>@s.Label
                                                </div>
                                            }
                                            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-1" style="font-size: 0.62rem;">@s.Label</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="p-2.5 bg-white rounded-3 border small">
                            <span class="text-muted fw-semibold">Ghi chú nhận xe:</span>
                            <span class="text-dark">@(string.IsNullOrWhiteSpace(returnInspection.Notes) ? "Xe hoàn trả đúng hiện trạng, không phát sinh trầy xước." : returnInspection.Notes)</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i data-lucide="clipboard-check" class="text-muted mb-2" style="width: 32px; height: 32px; opacity: 0.45;"></i>
                            <p class="text-muted small mb-3">
                                @(Model.StatusId < 4 ? "Biên bản nhận lại xe sẽ được mở khi khách hoàn trả phương tiện." : "Chưa lập biên bản nhận lại xe (Check-out).")
                            </p>
                            @if (Model.StatusId >= 4)
                            {
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-semibold"
                                        style="background-color: #0284c7; border-color: #0284c7;"
                                        onclick="openInspectionModal('return', @(Model.StatusId == 4 ? "true" : "false"))">
                                    <i class="bi bi-clipboard2-check-fill me-1"></i>Chụp 4 góc xe & Đối chiếu ODO lúc trả
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 3. CARD LỊCH SỬ TRẠNG THÁI (TIMELINE) -->
    @{
        string rawNotes = Model.Notes ?? "";
        
        // 1. Giờ tạo đơn (theo giờ VN ICT)
        string createTimeDisplay = Function.ExtractTimeFromNotes(rawNotes, 
            new[] { "Tạo đơn", "Tao don", "T?o", "Create", "Order", "Đặt xe" }, "");
        if (string.IsNullOrEmpty(createTimeDisplay))
        {
            if (handoverInspection != null)
            {
                createTimeDisplay = handoverInspection.CreatedAt.AddMinutes(-20).ToString("HH:mm - dd/MM/yyyy");
            }
            else
            {
                var orderDt = Model.OrderDate.HasValue 
                    ? Model.OrderDate.Value.ToDateTime(new TimeOnly(8, 30)) 
                    : Function.NowVn.AddHours(-1);
                createTimeDisplay = orderDt.ToString("HH:mm - dd/MM/yyyy");
            }
        }

        // 2. Giờ thanh toán (theo giờ VN ICT)
        string payTimeDisplay = Function.ExtractTimeFromNotes(rawNotes, 
            new[] { "Thanh toán", "Thanh toan", "Thanh", "Payment", "VNPay", "Cọc", "Coc" }, "");
        if (string.IsNullOrEmpty(payTimeDisplay))
        {
            if (handoverInspection != null)
            {
                payTimeDisplay = handoverInspection.CreatedAt.AddMinutes(-15).ToString("HH:mm - dd/MM/yyyy");
            }
            else
            {
                if (DateTime.TryParseExact(createTimeDisplay, "HH:mm - dd/MM/yyyy", null, System.Globalization.DateTimeStyles.None, out var cdt))
                {
                    payTimeDisplay = cdt.AddMinutes(3).ToString("HH:mm - dd/MM/yyyy");
                }
                else
                {
                    var payDt = Model.OrderDate.HasValue 
                        ? Model.OrderDate.Value.ToDateTime(new TimeOnly(8, 35)) 
                        : Function.NowVn.AddMinutes(-30);
                    payTimeDisplay = payDt.ToString("HH:mm - dd/MM/yyyy");
                }
            }
        }

        // 3. Giờ bàn giao xe (thực tế từ biên bản Check-in)
        string handoverTimeDisplay = "";
        if (handoverInspection != null)
        {
            handoverTimeDisplay = handoverInspection.CreatedAt.ToString("HH:mm - dd/MM/yyyy");
        }
        else
        {
            handoverTimeDisplay = Function.ExtractTimeFromNotes(rawNotes, 
                new[] { "Check-in", "Checkin", "Bàn giao", "Ban giao", "Giao xe" }, "");
            if (string.IsNullOrEmpty(handoverTimeDisplay))
            {
                if (Model.StatusId >= 4)
                {
                    var pDate = firstDetail?.PickupDate ?? Function.NowVn;
                    handoverTimeDisplay = Function.FormatSafeDateTime(pDate, "09:00");
                }
                else
                {
                    var pDate = firstDetail?.PickupDate ?? Function.NowVn.AddDays(1);
                    handoverTimeDisplay = Function.FormatSafeDateTime(pDate, "09:00");
                }
            }
        }

        // 4. Giờ nhận lại xe (thực tế từ biên bản Check-out)
        string returnTimeDisplay = "";
        if (returnInspection != null)
        {
            returnTimeDisplay = returnInspection.CreatedAt.ToString("HH:mm - dd/MM/yyyy");
        }
        else
        {
            returnTimeDisplay = Function.ExtractTimeFromNotes(rawNotes, 
                new[] { "Check-out", "Checkout", "Nhận lại", "Nhan lai", "Trả xe", "Tra xe", "Hoàn tất" }, "");
            if (string.IsNullOrEmpty(returnTimeDisplay))
            {
                var rDate = firstDetail?.ReturnDate ?? (firstDetail?.PickupDate?.AddDays(days) ?? Function.NowVn.AddDays(days));
                returnTimeDisplay = Function.FormatSafeDateTime(rDate, "18:00");
            }
        }
    }
    <div class="card-surface p-4 mb-4">
        <h2 class="h6 fw-bold text-dark mb-4 d-flex align-items-center gap-2" style="font-size: 1rem;">
            <i data-lucide="calendar-clock" class="flex-shrink-0" style="width: 18px; height: 18px; color: #0284c7;"></i>
            <span>Lịch sử trạng thái</span>
        </h2>

        <div class="timeline-track ps-1">
            <!-- Mốc 1: Đặt đơn -->
            <div class="timeline-step">
                <div class="timeline-col-bullet">
                    <span class="timeline-bullet"></span>
                    <div class="timeline-connector"></div>
                </div>
                <div class="timeline-col-content">
                    <p class="fw-semibold text-dark mb-0" style="font-size: 0.875rem;">Đặt xe thành công</p>
                    <p class="text-muted mb-0" style="font-size: 0.75rem;">
                        <span class="fw-medium text-dark">@createTimeDisplay</span> — Khách hàng hoàn tất tạo đơn trên sàn ReCar
                    </p>
                </div>
            </div>

            <!-- Mốc 2: Cọc / Thanh toán -->
            <div class="timeline-step">
                <div class="timeline-col-bullet">
                    <span class="timeline-bullet @(Model.StatusId >= 3 ? "" : "inactive")"></span>
                    <div class="timeline-connector"></div>
                </div>
                <div class="timeline-col-content">
                    <p class="fw-semibold text-dark mb-0" style="font-size: 0.875rem;">
                        @(isPaidFull ? "Đã thanh toán trọn gói 100%" : "Đã thanh toán tiền cọc 30%")
                    </p>
                    <p class="text-muted mb-0" style="font-size: 0.75rem;">
                        @if (Model.StatusId >= 3)
                        {
                            <span class="fw-medium text-dark">@payTimeDisplay</span>
                            <span>— Sàn ReCar đã giữ cọc an toàn cho chủ xe</span>
                        }
                        else
                        {
                            <span>Chờ khách hàng thanh toán qua cổng VNPay</span>
                        }
                    </p>
                </div>
            </div>

            <!-- Mốc 3: Bàn giao -->
            <div class="timeline-step">
                <div class="timeline-col-bullet">
                    <span class="timeline-bullet @(Model.StatusId >= 4 ? "" : "inactive")"></span>
                    <div class="timeline-connector"></div>
                </div>
                <div class="timeline-col-content">
                    <p class="fw-semibold text-dark mb-0" style="font-size: 0.875rem;">Bàn giao xe cho khách</p>
                    <p class="text-muted mb-0" style="font-size: 0.75rem;">
                        @if (Model.StatusId >= 4)
                        {
                            <span class="fw-medium text-primary">@handoverTimeDisplay</span>
                            <span>— Xe đang trong chuyến đi cùng khách</span>
                        }
                        else
                        {
                            <span>Dự kiến: <strong class="text-dark">@handoverTimeDisplay</strong> — Chờ bàn giao chìa khóa</span>
                        }
                    </p>
                </div>
            </div>

            <!-- Mốc 4: Hoàn tất -->
            <div class="timeline-step">
                <div class="timeline-col-bullet">
                    <span class="timeline-bullet @(Model.StatusId == 5 ? "" : "inactive")"></span>
                </div>
                <div class="timeline-col-content">
                    <p class="fw-semibold text-dark mb-0" style="font-size: 0.875rem;">Nhận lại xe & Hoàn tất chuyến đi</p>
                    @if (Model.StatusId == 5)
                    {
                        <p class="text-muted mb-0" style="font-size: 0.75rem;">
                            <span class="fw-medium text-success">@returnTimeDisplay</span>
                            <span>— Chuyến đi thành công, xe sẵn sàng cho thuê tiếp</span>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL LẬP BIÊN BẢN BÀN GIAO / NHẬN LẠI XE ĐIỆN TỬ (DIGITAL CHECK-IN / CHECK-OUT) -->
<div class="modal fade" id="digitalInspectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom px-4 py-3" style="background: #0f172a; color: #ffffff;">
                <div class="d-flex align-items-center gap-2.5">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(56, 189, 248, 0.2); color: #38bdf8;">
                        <i class="bi bi-camera-fill"></i>
                    </span>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="inspModalTitle" style="font-size: 1.05rem;">Biên bản bàn giao xe điện tử (Digital Check-in)</h5>
                        <div class="small" style="color: #94a3b8; font-size: 0.76rem;" id="inspModalSubtitle">Đơn #RC-@Model.OrderId · @(car?.CarName) (@(car?.LicensePlate))</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="digitalInspectionForm" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <input type="hidden" name="InspectionType" id="inspTypeInput" value="handover" />

                    <!-- Bước 1: Xác nhận Checklist nhanh -->
                    <div class="p-3 rounded-3 mb-3" style="background: #f8fafc; border: 1px solid #e2e8f0;" id="inspChecklistBox">
                        <div class="fw-bold text-dark small mb-2 d-flex align-items-center gap-1.5">
                            <i class="bi bi-shield-check text-success"></i>
                            <span id="inspChecklistHeading">Xác nhận điều kiện an toàn trước khi giao chìa khóa:</span>
                        </div>
                        <div class="row g-2 small">
                            <div class="col-12 col-md-6">
                                <label class="form-check d-flex align-items-center gap-2 mb-0" style="cursor: pointer;">
                                    <input class="form-check-input mt-0" type="checkbox" checked id="chkIdVerify" />
                                    <span>Đã đối chiếu CCCD & GPLX bản gốc/VNeID</span>
                                </label>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-check d-flex align-items-center gap-2 mb-0" style="cursor: pointer;">
                                    <input class="form-check-input mt-0" type="checkbox" checked id="chkPaymentVerify" />
                                    <span id="chkPaymentLabel">@(isPaidFull ? "Khách đã thanh toán 100% qua sàn (Không thu thêm)" : $"Đã thu 70% tiền thuê còn lại ({remainingToCollect:N0}đ)")</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Bước 2: Nhập ODO (km) & Mức xăng/pin (%) -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small mb-1">
                                <i class="bi bi-speedometer2 text-primary me-1"></i>Số công tơ mét hiện tại — ODO (km) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="number" class="form-control fw-bold font-monospace" name="Odometer" id="inspOdometerInput"
                                       min="0" max="999999" step="1" placeholder="VD: 24500"
                                       oninput="updateLiveOdoCalc()" required />
                                <span class="input-group-text bg-light fw-semibold small">km</span>
                            </div>
                            <div class="form-text small" id="inspOdoHint">
                                @if (handoverInspection != null)
                                {
                                    <span>ODO lúc bàn giao: <strong>@handoverInspection.Odometer.ToString("N0") km</strong> (Hạn mức @days ngày: @allowedKmTotal.ToString("N0") km)</span>
                                }
                                else
                                {
                                    <span>Nhập đúng số km trên màn hình taplo lúc bàn giao xe.</span>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-bold text-dark small mb-0">
                                    <i class="bi bi-fuel-pump-fill text-primary me-1"></i>Mức nhiên liệu / Pin hiện tại (%)
                                </label>
                                <span class="badge bg-primary rounded-pill px-2.5 py-1 fw-bold" id="inspFuelBadge">80%</span>
                            </div>
                            <input type="range" class="form-range" name="FuelLevel" id="inspFuelInput" min="5" max="100" step="5" value="80"
                                   oninput="setFuelPreset(this.value)" />
                            <div class="d-flex justify-content-between gap-1 mt-1">
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.72rem;" onclick="setFuelPreset(25)">1/4 (25%)</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.72rem;" onclick="setFuelPreset(50)">1/2 (50%)</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.72rem;" onclick="setFuelPreset(75)">3/4 (75%)</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.72rem;" onclick="setFuelPreset(100)">Đầy (100%)</button>
                            </div>
                        </div>
                    </div>

                    <!-- Hộp tính toán tự động quãng đường & phụ phí khi ở chế độ Nhận lại xe (Check-out) -->
                    <div id="liveReturnCalcBox" class="p-3 rounded-3 mb-3 d-none" style="background: #f0f9ff; border: 1px solid #bae6fd;">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                            <div>
                                <span class="text-muted">Quãng đường khách đã đi:</span>
                                <strong class="text-dark ms-1 font-monospace" id="liveDrivenKm">0 km</strong>
                                <span class="text-muted ms-1">(Miễn phí tối đa @allowedKmTotal.ToString("N0") km)</span>
                            </div>
                            <div id="liveOverKmBadge" class="fw-bold text-success">
                                Trong hạn mức cho phép ✓
                            </div>
                        </div>
                    </div>

                    <!-- Bước 3: Chụp / Tải lên 4 góc ảnh thực tế của xe -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-dark small mb-0">
                                <i class="bi bi-images text-primary me-1"></i>Ảnh chụp hiện trạng 4 góc xe thực tế
                            </label>
                            <span class="text-muted" style="font-size: 0.74rem;">Bấm vào từng ô để chụp từ Camera hoặc chọn ảnh</span>
                        </div>
                        <div class="row g-2.5">
                            <div class="col-6 col-md-3">
                                <div class="inspection-slot" id="slotBox_Front" onclick="document.getElementById('fileFront').click()">
                                    <span class="slot-badge">1. Đầu xe</span>
                                    <img id="preview_Front" class="slot-preview d-none" alt="Đầu xe" />
                                    <div id="placeholder_Front" class="p-2">
                                        <i class="bi bi-camera fs-4 text-primary d-block mb-1"></i>
                                        <span class="small fw-semibold text-dark d-block" style="font-size: 0.76rem;">Mặt trước</span>
                                        <span class="text-muted" style="font-size: 0.66rem;">Cản trước & Biển số</span>
                                    </div>
                                </div>
                                <input type="file" class="d-none" name="FrontImage" id="fileFront" accept="image/*" capture="environment" onchange="previewInspSlot(this, 'Front')" />
                            </div>

                            <div class="col-6 col-md-3">
                                <div class="inspection-slot" id="slotBox_Rear" onclick="document.getElementById('fileRear').click()">
                                    <span class="slot-badge">2. Đuôi xe</span>
                                    <img id="preview_Rear" class="slot-preview d-none" alt="Đuôi xe" />
                                    <div id="placeholder_Rear" class="p-2">
                                        <i class="bi bi-camera fs-4 text-primary d-block mb-1"></i>
                                        <span class="small fw-semibold text-dark d-block" style="font-size: 0.76rem;">Mặt sau</span>
                                        <span class="text-muted" style="font-size: 0.66rem;">Cốp sau & Đèn hậu</span>
                                    </div>
                                </div>
                                <input type="file" class="d-none" name="RearImage" id="fileRear" accept="image/*" capture="environment" onchange="previewInspSlot(this, 'Rear')" />
                            </div>

                            <div class="col-6 col-md-3">
                                <div class="inspection-slot" id="slotBox_Left" onclick="document.getElementById('fileLeft').click()">
                                    <span class="slot-badge">3. Thân trái</span>
                                    <img id="preview_Left" class="slot-preview d-none" alt="Thân trái" />
                                    <div id="placeholder_Left" class="p-2">
                                        <i class="bi bi-camera fs-4 text-primary d-block mb-1"></i>
                                        <span class="small fw-semibold text-dark d-block" style="font-size: 0.76rem;">Sườn bên lái</span>
                                        <span class="text-muted" style="font-size: 0.66rem;">Cửa trái & Mâm lốp</span>
                                    </div>
                                </div>
                                <input type="file" class="d-none" name="LeftImage" id="fileLeft" accept="image/*" capture="environment" onchange="previewInspSlot(this, 'Left')" />
                            </div>

                            <div class="col-6 col-md-3">
                                <div class="inspection-slot" id="slotBox_Right" onclick="document.getElementById('fileRight').click()">
                                    <span class="slot-badge">4. Thân phải</span>
                                    <img id="preview_Right" class="slot-preview d-none" alt="Thân phải" />
                                    <div id="placeholder_Right" class="p-2">
                                        <i class="bi bi-camera fs-4 text-primary d-block mb-1"></i>
                                        <span class="small fw-semibold text-dark d-block" style="font-size: 0.76rem;">Sườn bên phụ</span>
                                        <span class="text-muted" style="font-size: 0.66rem;">Cửa phải & Mâm lốp</span>
                                    </div>
                                </div>
                                <input type="file" class="d-none" name="RightImage" id="fileRight" accept="image/*" capture="environment" onchange="previewInspSlot(this, 'Right')" />
                            </div>
                        </div>
                    </div>

                    <!-- Bước 4: Ghi chú hiện trạng -->
                    <div>
                        <label class="form-label fw-bold text-dark small mb-1">
                            <i class="bi bi-journal-text text-primary me-1"></i>Ghi chú hiện trạng ngoại thất, nội thất & phụ kiện bàn giao
                        </label>
                        <textarea class="form-control small" name="Notes" id="inspNotesInput" rows="2"
                                  placeholder="VD: Xe sạch sẽ, không trầy xước, lốp dự phòng + bộ kích lốp + giấy tờ xe đầy đủ..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
                <button type="button" class="btn btn-light border rounded-pill px-3 fw-semibold small" data-bs-dismiss="modal">Đóng</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold small d-inline-flex align-items-center gap-1.5"
                            id="inspSubmitBtn" onclick="submitInspectionForm()">
                        <i class="bi bi-check2-circle"></i>
                        <span id="inspSubmitBtnText">Xác nhận Bàn giao xe & Lưu biên bản</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const cccdFull = '@cccdFull';
        const cccdMasked = '@cccdMasked';
        const gplxFull = '@gplxFull';
        const gplxMasked = '@gplxMasked';
        let isRevealed = false;

        // Dữ liệu biên bản hiện tại để nạp lên Modal khi chỉnh sửa hoặc đối chiếu
        const handoverData = {
            exists: @(handoverInspection != null ? "true" : "false"),
            odo: @(handoverInspection?.Odometer ?? 25000),
            fuel: @(handoverInspection?.FuelLevel ?? 85),
            notes: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(handoverInspection?.Notes ?? "Xe sạch sẽ, ngoại thất nguyên vẹn, lốp căng đều, đầy đủ giấy tờ & bảo hiểm.")),
            front: '@(handoverInspection?.FrontImage ?? "")',
            rear: '@(handoverInspection?.RearImage ?? "")',
            left: '@(handoverInspection?.LeftImage ?? "")',
            right: '@(handoverInspection?.RightImage ?? "")'
        };

        const returnData = {
            exists: @(returnInspection != null ? "true" : "false"),
            odo: @(returnInspection?.Odometer ?? ((handoverInspection?.Odometer ?? 25000) + 180)),
            fuel: @(returnInspection?.FuelLevel ?? (handoverInspection?.FuelLevel ?? 85)),
            notes: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnInspection?.Notes ?? "Nhận lại xe đúng hiện trạng, không phát sinh hư hại.")),
            front: '@(returnInspection?.FrontImage ?? "")',
            rear: '@(returnInspection?.RearImage ?? "")',
            left: '@(returnInspection?.LeftImage ?? "")',
            right: '@(returnInspection?.RightImage ?? "")'
        };

        const allowedKmTotal = @allowedKmTotal;
        const extraFeePerKm = @((int)carPolicy.ExtraFeePerKm);
        let currentInspMode = 'handover'; // 'handover' | 'return'
        let currentStatusTransition = true; // true: gọi ConfirmHandover/ConfirmReturn, false: chỉ gọi SaveInspection

        function setSlotExistingPreview(slotKey, imgUrl) {
            const img = document.getElementById('preview_' + slotKey);
            const ph = document.getElementById('placeholder_' + slotKey);
            const box = document.getElementById('slotBox_' + slotKey);
            const fileInput = document.getElementById('file' + slotKey);
            if (fileInput) fileInput.value = '';
            if (imgUrl) {
                img.src = imgUrl;
                img.classList.remove('d-none');
                ph.classList.add('d-none');
                box.classList.add('has-img');
            } else {
                img.src = '';
                img.classList.add('d-none');
                ph.classList.remove('d-none');
                box.classList.remove('has-img');
            }
        }

        function previewInspSlot(input, slotKey) {
            if (input.files && input.files[0]) {
                const url = URL.createObjectURL(input.files[0]);
                const img = document.getElementById('preview_' + slotKey);
                const ph = document.getElementById('placeholder_' + slotKey);
                const box = document.getElementById('slotBox_' + slotKey);
                img.src = url;
                img.classList.remove('d-none');
                ph.classList.add('d-none');
                box.classList.add('has-img');
            }
        }

        function setFuelPreset(val) {
            const v = Math.min(100, Math.max(5, parseInt(val) || 80));
            document.getElementById('inspFuelInput').value = v;
            document.getElementById('inspFuelBadge').innerText = v + '%';
        }

        function updateLiveOdoCalc() {
            const calcBox = document.getElementById('liveReturnCalcBox');
            if (currentInspMode !== 'return') {
                calcBox.classList.add('d-none');
                return;
            }
            calcBox.classList.remove('d-none');
            const currentOdo = parseInt(document.getElementById('inspOdometerInput').value) || 0;
            const startOdo = handoverData.odo || 0;
            const driven = Math.max(0, currentOdo - startOdo);
            const over = Math.max(0, driven - allowedKmTotal);
            document.getElementById('liveDrivenKm').innerText = driven.toLocaleString('vi-VN') + ' km';
            const badge = document.getElementById('liveOverKmBadge');
            if (over > 0) {
                const fee = over * extraFeePerKm;
                badge.className = 'fw-bold text-danger';
                badge.innerText = `Vượt ${over.toLocaleString('vi-VN')} km — Phụ phí: +${fee.toLocaleString('vi-VN')}đ`;
            } else {
                badge.className = 'fw-bold text-success';
                badge.innerText = 'Trong hạn mức cho phép ✓';
            }
        }

        function openInspectionModal(mode, doTransition) {
            currentInspMode = mode;
            currentStatusTransition = !!doTransition;
            document.getElementById('inspTypeInput').value = mode;

            const titleEl = document.getElementById('inspModalTitle');
            const btnEl = document.getElementById('inspSubmitBtn');
            const btnTextEl = document.getElementById('inspSubmitBtnText');
            const chkPayLabel = document.getElementById('chkPaymentLabel');

            if (mode === 'handover') {
                titleEl.innerText = 'Biên bản bàn giao xe điện tử (Digital Check-in)';
                document.getElementById('inspOdometerInput').value = handoverData.odo;
                setFuelPreset(handoverData.fuel);
                document.getElementById('inspNotesInput').value = handoverData.notes;
                setSlotExistingPreview('Front', handoverData.front);
                setSlotExistingPreview('Rear', handoverData.rear);
                setSlotExistingPreview('Left', handoverData.left);
                setSlotExistingPreview('Right', handoverData.right);
                chkPayLabel.innerHTML = '@Html.Raw(isPaidFull ? "Khách đã thanh toán 100% qua sàn (Không thu thêm)" : $"Đã thu 70% tiền thuê còn lại ({remainingToCollect:N0}đ)")';
                btnEl.style.backgroundColor = '#10b981';
                btnEl.style.borderColor = '#10b981';
                btnTextEl.innerText = doTransition ? 'Xác nhận Bàn giao xe & Lưu biên bản' : 'Lưu cập nhật biên bản giao xe';
            } else {
                titleEl.innerText = 'Biên bản nhận lại xe điện tử (Digital Check-out)';
                document.getElementById('inspOdometerInput').value = returnData.odo;
                setFuelPreset(returnData.fuel);
                document.getElementById('inspNotesInput').value = returnData.notes;
                setSlotExistingPreview('Front', returnData.front);
                setSlotExistingPreview('Rear', returnData.rear);
                setSlotExistingPreview('Left', returnData.left);
                setSlotExistingPreview('Right', returnData.right);
                chkPayLabel.innerText = 'Đã kiểm tra ngoại thất, phụ kiện & đối chiếu công tơ mét';
                btnEl.style.backgroundColor = '#0284c7';
                btnEl.style.borderColor = '#0284c7';
                btnTextEl.innerText = doTransition ? 'Xác nhận Nhận lại xe & Hoàn tất đơn' : 'Lưu cập nhật biên bản nhận xe';
            }

            updateLiveOdoCalc();
            const modalEl = document.getElementById('digitalInspectionModal');
            const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
            bsModal.show();
        }

        function submitInspectionForm() {
            const odoVal = parseInt(document.getElementById('inspOdometerInput').value);
            if (isNaN(odoVal) || odoVal < 0) {
                Swal.fire({ icon: 'warning', title: 'Thiếu số ODO', text: 'Vui lòng nhập số km công tơ mét hiện tại của xe.' });
                return;
            }

            const formEl = document.getElementById('digitalInspectionForm');
            const formData = new FormData(formEl);
            formData.append('__RequestVerificationToken', getCsrfToken());

            let endpoint = '/CarOwner/Orders/SaveInspection';
            if (currentStatusTransition) {
                endpoint = currentInspMode === 'handover'
                    ? '/CarOwner/Orders/ConfirmHandover'
                    : '/CarOwner/Orders/ConfirmReturn';
            }

            const btn = document.getElementById('inspSubmitBtn');
            btn.disabled = true;

            fetch(endpoint, {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                btn.disabled = false;
                if (data.success) {
                    const modalEl = document.getElementById('digitalInspectionModal');
                    const bsModal = bootstrap.Modal.getInstance(modalEl);
                    if (bsModal) bsModal.hide();

                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: data.message,
                        timer: 1800,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Không thể lưu biên bản', text: data.message });
                }
            })
            .catch(err => {
                btn.disabled = false;
                Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: err.message || 'Vui lòng thử lại.' });
            });
        }

        function previewLightbox(imgUrl, caption) {
            Swal.fire({
                title: caption,
                imageUrl: imgUrl,
                imageAlt: caption,
                width: 680,
                showConfirmButton: false,
                showCloseButton: true
            });
        }

        function toggleIdentityReveal() {
            isRevealed = !isRevealed;
            const displayCccd = document.getElementById('displayCccd');
            const displayGplx = document.getElementById('displayGplx');
            const textReveal = document.getElementById('textReveal');
            const iconReveal = document.getElementById('iconReveal');

            if (isRevealed) {
                if (displayCccd) displayCccd.innerText = cccdFull;
                if (displayGplx) displayGplx.innerText = gplxFull;
                if (textReveal) textReveal.innerText = 'Ẩn thông tin';
                if (iconReveal) iconReveal.setAttribute('data-lucide', 'eye-off');
            } else {
                if (displayCccd) displayCccd.innerText = cccdMasked;
                if (displayGplx) displayGplx.innerText = gplxMasked;
                if (textReveal) textReveal.innerText = 'Xem đầy đủ để đối chiếu khi bàn giao';
                if (iconReveal) iconReveal.setAttribute('data-lucide', 'eye');
            }

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }

        function getCsrfToken() {
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        // Bàn giao xe
        function quickHandover(orderId, carName, customerName) {
            Swal.fire({
                title: `Bàn giao xe #${orderId}?`,
                html: `
                    <div class="text-start small p-3 bg-light rounded-3 border">
                        <div class="mb-2"><strong>Phương tiện:</strong> ${carName}</div>
                        <div class="mb-2"><strong>Khách hàng:</strong> ${customerName}</div>
                        <hr class="my-2">
                        <div class="text-danger fw-semibold mb-1">
                            <i data-lucide="alert-triangle" class="d-inline size-4 me-1"></i>Lưu ý trước khi giao chìa khóa:
                        </div>
                        <ul class="ps-3 mb-0 text-muted">
                            <li>Đã đối chiếu bản gốc CCCD & GPLX của người thuê.</li>
                            <li>@Html.Raw(isPaidFull ? "<strong class='text-success'>Khách đã thanh toán 100% trọn gói qua sàn (Không thu thêm).</strong>" : $"Đã thu 70% số tiền thuê còn lại (tiền mặt / chuyển khoản: {remainingToCollect:N0}đ).")</li>
                            <li>Đã kiểm tra số km (ODO) và mức xăng/pin hiện tại.</li>
                        </ul>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xác nhận bàn giao',
                cancelButtonText: 'Đóng lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.showLoading();
                    var formData = new FormData();
                    formData.append('id', orderId);
                    formData.append('__RequestVerificationToken', getCsrfToken());

                    fetch('/CarOwner/Orders/ConfirmHandover', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => {
                        if (!response.ok) {
                            return response.text().then(text => { throw new Error(text || ("Lỗi HTTP " + response.status)); });
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Bàn giao xe thành công!',
                                text: data.message,
                                timer: 1800,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Thao tác không thành công',
                                text: data.message
                            });
                        }
                    })
                    .catch(error => {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi thao tác',
                            text: error.message || 'Không thể kết nối máy chủ. Vui lòng thử lại!'
                        });
                    });
                }
            });
        }

        // Nhận lại xe
        function quickReturn(orderId, carName) {
            Swal.fire({
                title: `Nhận lại xe & Hoàn tất #${orderId}?`,
                html: `
                    <div class="text-start small p-3 bg-light rounded-3 border">
                        <div class="mb-2"><strong>Phương tiện:</strong> ${carName}</div>
                        <hr class="my-2">
                        <div class="text-success fw-semibold mb-1">
                            <i data-lucide="shield-check" class="d-inline size-4 me-1"></i>Kiểm tra phương tiện hoàn trả:
                        </div>
                        <ul class="ps-3 mb-0 text-muted">
                            <li>Kiểm tra tình trạng ngoại thất, lốp và phụ kiện kèm xe.</li>
                            <li>Đối chiếu mức xăng/pin và số km phát sinh nếu có.</li>
                            <li>Xe sẽ tự động chuyển về <strong>Sẵn sàng</strong> trên sàn (+1 chuyến đi thành công).</li>
                        </ul>
                    </div>
                `,
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#0284c7',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xác nhận nhận lại xe',
                cancelButtonText: 'Để sau'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.showLoading();
                    var formData = new FormData();
                    formData.append('id', orderId);
                    formData.append('__RequestVerificationToken', getCsrfToken());

                    fetch('/CarOwner/Orders/ConfirmReturn', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => {
                        if (!response.ok) {
                            return response.text().then(text => { throw new Error(text || ("Lỗi HTTP " + response.status)); });
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Hoàn tất chuyến đi!',
                                text: data.message,
                                timer: 1800,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Thao tác không thành công',
                                text: data.message
                            });
                        }
                    })
                    .catch(error => {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi thao tác',
                            text: error.message || 'Không thể kết nối máy chủ. Vui lòng thử lại!'
                        });
                    });
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}
