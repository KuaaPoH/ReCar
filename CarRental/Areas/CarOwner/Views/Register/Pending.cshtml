@model CarRental.Models.CarOwnerRegistration
@{
    ViewData["Title"] = "Hồ sơ đang chờ xét duyệt - Đối tác Chủ xe ReCar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pending-pulse-ring {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.25));
        color: #d97706;
        font-size: 3rem;
        position: relative;
        animation: pulseAnimation 2s infinite ease-in-out;
    }

    @@keyframes pulseAnimation {
        0% {
            box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4);
            transform: scale(0.98);
        }
        70% {
            box-shadow: 0 0 0 20px rgba(245, 158, 11, 0);
            transform: scale(1.02);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(245, 158, 11, 0);
            transform: scale(0.98);
        }
    }

    .recar-timeline-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        flex: 1;
        position: relative;
    }

    .recar-timeline-step:not(:last-child)::after {
        content: "";
        position: absolute;
        top: 20px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #e2e8f0;
        z-index: 1;
    }

    .recar-timeline-step.completed:not(:last-child)::after {
        background: #10b981;
    }

    .recar-step-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
        z-index: 2;
        background: #ffffff;
        border: 3px solid #cbd5e1;
        color: #64748b;
        margin-bottom: 0.5rem;
    }

    .recar-timeline-step.completed .recar-step-circle {
        border-color: #10b981;
        background: #10b981;
        color: #ffffff;
    }

    .recar-timeline-step.active .recar-step-circle {
        border-color: #f59e0b;
        background: #fffbeb;
        color: #d97706;
        box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.2);
    }
</style>

<div class="py-5" style="background-color: #f8fafc; min-height: 80vh;">
    <div class="container" style="max-width: 820px;">

        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">

            <!-- Pulse Icon -->
            <div class="mb-4">
                <div class="pending-pulse-ring">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>

            <!-- Header Titles -->
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-semibold mb-3 mx-auto">
                <i class="bi bi-clock-history me-1"></i> Trạng thái: Đang chờ xét duyệt
            </span>

            <h2 class="fw-bold text-dark mb-2" style="letter-spacing: -0.5px;">Hồ sơ đối tác của bạn đang được xét duyệt</h2>
            <p class="text-muted mx-auto mb-4" style="max-width: 580px; font-size: 15px;">
                Cảm ơn bạn đã gửi hồ sơ tham gia mạng lưới <strong>Chủ xe ReCar</strong>. Ban Quản trị sàn đang thẩm định thông tin định danh cá nhân, bằng lái và tài khoản ngân hàng của bạn.
            </p>

            <!-- 3-Step Timeline -->
            <div class="d-flex justify-content-between align-items-center mb-5 px-3">
                <div class="recar-timeline-step completed">
                    <div class="recar-step-circle">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <div class="fw-bold small text-dark">Nộp hồ sơ</div>
                    <div class="text-muted" style="font-size: 11px;">Hoàn tất thông tin</div>
                </div>

                <div class="recar-timeline-step active">
                    <div class="recar-step-circle">2</div>
                    <div class="fw-bold small text-warning">Admin thẩm định</div>
                    <div class="text-muted" style="font-size: 11px;">Đang kiểm duyệt</div>
                </div>

                <div class="recar-timeline-step">
                    <div class="recar-step-circle">3</div>
                    <div class="fw-bold small text-muted">Kích hoạt Chủ xe</div>
                    <div class="text-muted" style="font-size: 11px;">Bắt đầu cho thuê xe</div>
                </div>
            </div>

            <!-- Tóm tắt hồ sơ đã nộp -->
            <div class="text-start p-4 rounded-3 border bg-light mb-4">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-file-earmark-text-fill text-primary me-2"></i> Tóm tắt hồ sơ đã nộp</span>
                    <span class="badge bg-light text-secondary border font-monospace">Mã hồ sơ: #DKCX-@Model.Id</span>
                </h6>

                <div class="row g-3 small">
                    <div class="col-sm-6">
                        <span class="text-muted d-block">Họ và tên:</span>
                        <strong class="text-dark">@Model.FullName</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block">Số điện thoại:</span>
                        <strong class="text-dark">@Model.Phone</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block">Số CCCD / Hộ chiếu:</span>
                        <strong class="text-dark">@Model.IdCard</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block">Giấy phép lái xe:</span>
                        <strong class="text-dark">@Model.LicenseNumber (@Model.LicenseClass)</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block">Ngân hàng thụ hưởng:</span>
                        <strong class="text-dark">@Model.BankName</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block">Số tài khoản nhận tiền:</span>
                        <strong class="text-dark font-monospace">@Model.AccountNumber (@Model.AccountHolder)</strong>
                    </div>
                    <div class="col-12 pt-2 border-top">
                        <span class="text-muted">Thời gian gửi hồ sơ:</span>
                        <span class="text-dark fw-semibold ms-1">@Model.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Hộp lưu ý -->
            <div class="p-3 rounded-3 text-start mb-4" style="background-color: #eff6ff; border: 1px solid #bfdbfe;">
                <div class="d-flex align-items-start gap-2.5">
                    <i class="bi bi-info-circle-fill text-primary fs-5 flex-shrink-0 mt-0.5"></i>
                    <div class="small text-dark">
                        <strong>Thời gian xử lý dự kiến:</strong> Từ <strong>1 đến 24 giờ</strong> làm việc. Khi hồ sơ được phê duyệt, bạn sẽ nhận được thông báo tức thì và nút <strong>"Trang chủ xe"</strong> sẽ tự động đưa bạn vào Dashboard quản lý phương tiện ReCar.
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center justify-content-center gap-3 flex-wrap">
                <a href="/" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 small fw-semibold">
                    <i class="bi bi-house-door me-1"></i> Quay về Trang chủ ReCar
                </a>

                <a asp-action="Index" asp-route-edit="true" class="btn btn-light border rounded-pill px-4 py-2.5 small fw-semibold text-primary">
                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa / Bổ sung hồ sơ
                </a>
            </div>

        </div>

    </div>
</div>
