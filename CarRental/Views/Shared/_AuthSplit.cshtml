@model CarRental.Models.Customer
@using CarRental.Utilities
@{
    Layout = null;
    string mode = (ViewData["AuthMode"] as string) ?? "login";
    bool isRegister = mode.Equals("register", StringComparison.OrdinalIgnoreCase);
    string loginMessage = Function.GetMessage(Context.Session);
    string registerMessage = Function._MessageEmail ?? string.Empty;
    string returnUrl = (ViewData["ReturnUrl"] as string) ?? (ViewBag.ReturnUrl as string) ?? string.Empty;
    string prefillEmail = (Model?.Email) ?? Context.Request.Query["email"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(isRegister ? "Đăng ký thành viên" : "Đăng nhập tài khoản") — ReCar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --recar-navy: #0f172a;
            --recar-blue: #0284c7;
            --recar-blue-dark: #0369a1;
            --recar-border: #e2e8f0;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background: #f8fafc;
            color: #0f172a;
            overflow-x: hidden;
        }
        .auth-stage {
            position: relative;
            width: 100vw;
            min-height: 100vh;
            display: flex;
            background: #ffffff;
            overflow: hidden;
        }
        .auth-form-panel {
            width: 50%;
            min-height: 100vh;
            max-height: 100vh;
            overflow-y: auto;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 3rem;
            background: #ffffff;
            transition: opacity 0.45s ease, transform 0.65s cubic-bezier(0.77, 0, 0.175, 1);
            z-index: 5;
        }
        .auth-form-inner {
            width: 100%;
            max-width: 440px;
            margin: auto 0;
        }
        /* Trạng thái hiển thị form mượt mà khi trượt */
        .auth-stage:not(.is-register) .register-panel {
            opacity: 0;
            pointer-events: none;
            transform: translateX(30px);
        }
        .auth-stage.is-register .login-panel {
            opacity: 0;
            pointer-events: none;
            transform: translateX(-30px);
        }
        .auth-stage.is-register .register-panel,
        .auth-stage:not(.is-register) .login-panel {
            opacity: 1;
            pointer-events: auto;
            transform: translateX(0);
        }

        /* Panel Ảnh trượt đảo ngược 50% */
        .auth-visual-slider {
            position: absolute;
            top: 0;
            left: 50%;
            width: 50%;
            height: 100%;
            z-index: 20;
            overflow: hidden;
            transform: translateX(0%);
            transition: transform 0.72s cubic-bezier(0.77, 0, 0.175, 1);
            box-shadow: -12px 0 40px rgba(15, 23, 42, 0.18);
        }
        .auth-stage.is-register .auth-visual-slider {
            transform: translateX(-100%);
            box-shadow: 12px 0 40px rgba(15, 23, 42, 0.18);
        }
        .visual-slide-bg {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            transition: opacity 0.6s ease, transform 0.8s ease;
        }
        .visual-bg-login {
            background-image: url('/assets/images/banner/car-banner1.jpg');
            opacity: 1;
            transform: scale(1.02);
        }
        .visual-bg-register {
            background-image: url('/assets/images/banner/baner-car2.jpg');
            opacity: 0;
            transform: scale(1.06);
        }
        .auth-stage.is-register .visual-bg-login {
            opacity: 0;
            transform: scale(1.06);
        }
        .auth-stage.is-register .visual-bg-register {
            opacity: 1;
            transform: scale(1.02);
        }
        .visual-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(155deg, rgba(15, 23, 42, 0.86) 0%, rgba(2, 132, 199, 0.58) 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3rem 3.25rem;
            color: #ffffff;
        }
        .visual-copy {
            position: relative;
            min-height: 220px;
        }
        .visual-state {
            position: absolute;
            inset: 0;
            transition: opacity 0.45s ease, transform 0.55s ease;
        }
        .auth-stage:not(.is-register) .visual-state-register,
        .auth-stage.is-register .visual-state-login {
            opacity: 0;
            pointer-events: none;
            transform: translateY(14px);
        }
        .auth-stage:not(.is-register) .visual-state-login,
        .auth-stage.is-register .visual-state-register {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }

        .recar-brand-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #0f172a;
            font-weight: 800;
            font-size: 1.25rem;
        }
        .recar-logo-box {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #0284c7, #0ea5e9);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            box-shadow: 0 6px 16px rgba(2, 132, 199, 0.25);
        }
        .auth-input-wrap {
            position: relative;
        }
        .auth-input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1rem;
            pointer-events: none;
            transition: color 0.2s;
        }
        .auth-input {
            width: 100%;
            height: 48px;
            padding: 0 42px 0 42px;
            border: 1.5px solid var(--recar-border);
            border-radius: 12px;
            font-size: 0.94rem;
            color: #0f172a;
            background: #f8fafc;
            transition: all 0.2s ease;
        }
        .auth-input:focus {
            outline: none;
            background: #ffffff;
            border-color: var(--recar-blue);
            box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.12);
        }
        .auth-input-wrap:focus-within .auth-input-icon {
            color: var(--recar-blue);
        }
        .btn-toggle-pass {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #94a3b8;
            padding: 4px 6px;
            cursor: pointer;
        }
        .btn-toggle-pass:hover { color: #0f172a; }

        .btn-auth-primary {
            width: 100%;
            height: 48px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.96rem;
            box-shadow: 0 8px 20px rgba(2, 132, 199, 0.28);
            transition: all 0.2s ease;
        }
        .btn-auth-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(2, 132, 199, 0.35);
            color: #ffffff;
        }
        .btn-switch-ghost {
            border: 1.5px solid rgba(255, 255, 255, 0.55);
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            color: #ffffff;
            font-weight: 700;
            padding: 0.7rem 1.75rem;
            border-radius: 999px;
            transition: all 0.2s ease;
        }
        .btn-switch-ghost:hover {
            background: #ffffff;
            color: #0f172a;
        }
        .mobile-switch-bar { display: none; }

        @@media (max-width: 991.98px) {
            .auth-visual-slider { display: none; }
            .auth-stage { flex-direction: column; }
            .auth-form-panel {
                width: 100%;
                min-height: auto;
                padding: 2rem 1.25rem;
            }
            .auth-stage:not(.is-register) .register-panel,
            .auth-stage.is-register .login-panel {
                display: none;
            }
            .mobile-switch-bar { display: block; }
        }
    </style>
</head>
<body>
    <div class="auth-stage @(isRegister ? "is-register" : "")" id="authStage">
        <!-- BÊN TRÁI (MẶC ĐỊNH KHI ĐĂNG NHẬP): FORM ĐĂNG NHẬP -->
        <div class="auth-form-panel login-panel">
            <div class="auth-form-inner">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <a href="/" class="recar-brand-pill">
                        <span class="recar-logo-box"><i class="bi bi-car-front-fill"></i></span>
                        <span>ReCar</span>
                    </a>
                    <a href="/" class="text-decoration-none text-muted small fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i>Trang chủ
                    </a>
                </div>

                <div class="mb-4">
                    <h2 class="fw-bold mb-1" style="font-size: 1.65rem;">Chào mừng trở lại</h2>
                    <p class="text-muted small mb-0">Đăng nhập để đặt xe nhanh chóng và quản lý hành trình của bạn</p>
                </div>

                @if (loginMessage == "LOCKED")
                {
                    <div class="alert alert-danger py-2.5 px-3 small rounded-3 mb-3">
                        <strong>Tài khoản đã bị khóa!</strong> Vui lòng liên hệ Admin để được hỗ trợ.
                    </div>
                }
                else if (!string.IsNullOrEmpty(loginMessage))
                {
                    <div class="alert alert-danger py-2.5 px-3 small rounded-3 mb-3">
                        <i class="bi bi-exclamation-circle me-1"></i> @loginMessage
                    </div>
                }

                <form asp-controller="Login" asp-action="Index" asp-route-returnurl="@returnUrl" method="post">
                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Địa chỉ Email</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-envelope auth-input-icon"></i>
                            <input type="email" name="Email" id="loginEmailInput" value="@prefillEmail" class="auth-input" placeholder="name@example.com" required autocomplete="email" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mật khẩu</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-lock auth-input-icon"></i>
                            <input type="password" name="Password" id="loginPasswordInput" class="auth-input" placeholder="Nhập mật khẩu" required autocomplete="current-password" />
                            <button type="button" class="btn-toggle-pass" onclick="toggleAuthPass('loginPasswordInput', this)" aria-label="Hiện mật khẩu">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4 small">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberLogin" />
                            <label class="form-check-label text-muted" for="rememberLogin">Ghi nhớ đăng nhập</label>
                        </div>
                        <button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold small" style="color: var(--recar-blue);" onclick="openForgotPasswordModal()">
                            Quên mật khẩu?
                        </button>
                    </div>

                    <button type="submit" class="btn btn-auth-primary mb-3">
                        Đăng nhập <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>
            </div>
        </div>

        <!-- BÊN PHẢI (HIỆN RA KHI ĐĂNG KÝ TRƯỢT SANG TRÁI): FORM ĐĂNG KÝ -->
        <div class="auth-form-panel register-panel">
            <div class="auth-form-inner">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <a href="/" class="recar-brand-pill">
                        <span class="recar-logo-box"><i class="bi bi-car-front-fill"></i></span>
                        <span>ReCar</span>
                    </a>
                    <a href="/" class="text-decoration-none text-muted small fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i>Trang chủ
                    </a>
                </div>

                <div class="mb-4">
                    <h2 class="fw-bold mb-1" style="font-size: 1.65rem;">Tạo tài khoản mới</h2>
                    <p class="text-muted small mb-0">Tham gia cộng đồng thuê xe tự lái &amp; chia sẻ xe hàng đầu Việt Nam</p>
                </div>

                @if (!string.IsNullOrEmpty(registerMessage))
                {
                    <div class="alert alert-danger py-2.5 px-3 small rounded-3 mb-3">
                        <i class="bi bi-exclamation-circle me-1"></i> @registerMessage
                    </div>
                }

                <form asp-controller="Register" asp-action="Index" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Họ và tên</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-person auth-input-icon"></i>
                            <input type="text" name="Name" value="@(Model?.Name)" class="auth-input" placeholder="Ví dụ: Nguyễn Văn An" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Địa chỉ Email</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-envelope auth-input-icon"></i>
                            <input type="email" name="Email" value="@(isRegister ? Model?.Email : "")" class="auth-input" placeholder="name@example.com" required autocomplete="email" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mật khẩu</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-lock auth-input-icon"></i>
                            <input type="password" name="Password" id="registerPasswordInput" class="auth-input" placeholder="Tối thiểu 6 ký tự" required autocomplete="new-password" />
                            <button type="button" class="btn-toggle-pass" onclick="toggleAuthPass('registerPasswordInput', this)" aria-label="Hiện mật khẩu">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="small text-muted mb-4">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        Bằng việc đăng ký, bạn đồng ý với <a href="/Home/Privacy" target="_blank" class="text-decoration-none fw-semibold" style="color: var(--recar-blue);">Chính sách bảo mật</a> của ReCar.
                    </div>

                    <button type="submit" class="btn btn-auth-primary mb-3">
                        Hoàn tất đăng ký <i class="bi bi-check2-circle ms-1"></i>
                    </button>

                    <div class="text-center pt-3 border-top small text-muted">
                        Đã có tài khoản ReCar?
                        <button type="button" class="btn btn-link p-0 fw-bold text-decoration-none align-baseline" style="color: var(--recar-blue);" onclick="switchAuthMode('login')">
                            Đăng nhập ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- PANEL ẢNH TRƯỢT ĐẢO NGƯỢC 2 BÊN -->
        <div class="auth-visual-slider">
            <div class="visual-slide-bg visual-bg-login"></div>
            <div class="visual-slide-bg visual-bg-register"></div>
            <div class="visual-overlay">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background: rgba(255,255,255,0.16); backdrop-filter: blur(8px); font-size: 0.78rem;">
                        <i class="bi bi-stars me-1"></i> ReCar Smart Mobility
                    </span>
                </div>

                <div class="visual-copy my-auto">
                    <div class="visual-state visual-state-login">
                        <h1 class="fw-bold mb-3" style="font-size: 2.15rem; line-height: 1.2;">
                            Lái xe tự do,<br />khám phá mọi cung đường.
                        </h1>
                        <p class="text-white-50 mb-4" style="font-size: 0.98rem; line-height: 1.6;">
                            Hơn hàng trăm mẫu xe đời mới từ chủ xe uy tín đã sẵn sàng bàn giao nhanh chóng trên toàn quốc.
                        </p>
                    </div>

                    <div class="visual-state visual-state-register">
                        <h1 class="fw-bold mb-3" style="font-size: 2.15rem; line-height: 1.2;">
                            Gia nhập ReCar,<br />đặt xe chỉ trong 2 phút.
                        </h1>
                        <p class="text-white-50 mb-4" style="font-size: 0.98rem; line-height: 1.6;">
                            Bảo lãnh thanh toán an toàn qua VNPay &amp; Ví ReCar, hỗ trợ giao xe tận nơi và thủ tục số hóa 100%.
                        </p>
                        <button type="button" class="btn-switch-ghost" onclick="switchAuthMode('login')">
                            <i class="bi bi-arrow-left me-1"></i> Đã có tài khoản? Đăng nhập
                        </button>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-4 small text-white-50">
                    <span><i class="bi bi-shield-check text-info me-1"></i> Giao dịch bảo lãnh</span>
                    <span><i class="bi bi-geo-alt text-info me-1"></i> Tìm xe qua bản đồ</span>
                    <span><i class="bi bi-clock-history text-info me-1"></i> Hỗ trợ 24/7</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        function switchAuthMode(targetMode) {
            const stage = document.getElementById('authStage');
            if (!stage) return;
            const query = window.location.search || '';
            if (targetMode === 'register') {
                stage.classList.add('is-register');
                document.title = 'Đăng ký thành viên — ReCar';
                if (window.history && window.history.replaceState) {
                    window.history.replaceState({}, '', '/Register' + query);
                }
            } else {
                stage.classList.remove('is-register');
                document.title = 'Đăng nhập tài khoản — ReCar';
                if (window.history && window.history.replaceState) {
                    window.history.replaceState({}, '', '/Login' + query);
                }
            }
        }

        function toggleAuthPass(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) { icon.classList.remove('bi-eye'); icon.classList.add('bi-eye-slash'); }
            } else {
                input.type = 'password';
                if (icon) { icon.classList.remove('bi-eye-slash'); icon.classList.add('bi-eye'); }
            }
        }

        async function openForgotPasswordModal() {
            const currentEmail = (document.getElementById('loginEmailInput')?.value || '').trim();
            const result = await Swal.fire({
                title: 'Quên mật khẩu?',
                html: '<p class="text-muted small mb-2">Nhập địa chỉ Email đã đăng ký để nhận mật khẩu mới qua hộp thư của bạn.</p>',
                input: 'email',
                inputValue: currentEmail,
                inputPlaceholder: 'name@example.com',
                showCancelButton: true,
                confirmButtonText: 'Gửi mật khẩu mới',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#0284c7',
                showLoaderOnConfirm: true,
                inputValidator: (value) => {
                    if (!value || !value.includes('@@')) {
                        return 'Vui lòng nhập địa chỉ Email hợp lệ!';
                    }
                },
                preConfirm: async (email) => {
                    try {
                        const body = new URLSearchParams({ email });
                        const res = await fetch('/Login/ForgotPassword', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                            body: body.toString()
                        });
                        const data = await res.json();
                        if (!data.success) {
                            Swal.showValidationMessage(data.message || 'Không thể cấp lại mật khẩu.');
                            return false;
                        }
                        return data;
                    } catch (err) {
                        Swal.showValidationMessage('Lỗi kết nối máy chủ. Vui lòng thử lại.');
                        return false;
                    }
                },
                allowOutsideClick: () => !Swal.isLoading()
            });

            if (result.isConfirmed && result.value) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Đã gửi mật khẩu mới!',
                    text: result.value.message,
                    confirmButtonText: 'Đăng nhập ngay',
                    confirmButtonColor: '#0284c7'
                });
                const emailInput = document.getElementById('loginEmailInput');
                const passInput = document.getElementById('loginPasswordInput');
                if (emailInput && result.value.email) {
                    emailInput.value = result.value.email;
                }
                if (passInput) {
                    passInput.value = '';
                    passInput.focus();
                }
            }
        }
    </script>
</body>
</html>
