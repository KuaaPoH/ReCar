@model CarRental.Models.SystemSetting
@{
    ViewData["Title"] = "Cấu hình hệ thống";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark tracking-tight">Cấu hình hệ thống</h1>
            <p class="text-muted small mb-0">Thiết lập các thông số tài chính, tỷ lệ cọc, hoa hồng nền tảng và thông tin vận hành sàn ReCar.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.UpdatedAt.HasValue)
            {
                <span class="badge bg-white text-muted border shadow-xs py-2 px-3 fw-normal small d-none d-sm-inline-flex align-items-center gap-1.5 rounded-pill">
                    <i class="bi bi-clock-history text-primary"></i> Đã lưu lần cuối: <strong class="text-dark">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                </span>
            }
            else
            {
                <span class="badge bg-white text-muted border shadow-xs py-2 px-3 fw-normal small d-none d-sm-inline-flex align-items-center gap-1.5 rounded-pill">
                    <i class="bi bi-info-circle text-secondary"></i> Trạng thái: <strong class="text-secondary">Cấu hình ban đầu</strong>
                </span>
            }
            <button type="button" id="btnSaveConfig" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="saveSettings()" style="background-color: var(--recar-primary); border: none;">
                <i class="bi bi-floppy me-1"></i> Lưu cấu hình
            </button>
        </div>
    </div>

    <!-- Alert thông báo kiến trúc Snapshot -->
    <div class="alert alert-info border-0 shadow-sm rounded-3 d-flex align-items-center gap-3 p-3 mb-4" style="background-color: #f0f9ff; border-left: 4px solid var(--recar-primary) !important;">
        <i class="bi bi-shield-check fs-4 text-primary"></i>
        <div class="small text-dark">
            <strong>Bảo vệ dữ liệu tài chính (Snapshot Pattern):</strong> Khi thay đổi tỷ lệ hoa hồng hoặc cọc, hệ thống sẽ chỉ áp dụng cho <strong>các đơn thuê xe tạo mới</strong> từ thời điểm này. Các đơn hàng trong quá khứ vẫn bảo toàn nguyên vẹn tỷ lệ và số tiền hoa hồng ban đầu để phục vụ quyết toán thuế và đối soát chính xác 100%.
        </div>
    </div>

    <div class="row g-4">
        <!-- Cấu hình tài chính -->
        <div class="col-12 col-xl-6">
            <div class="recar-panel mb-4">
                <div class="recar-panel-header">
                    <h2 class="h6 fw-bold mb-0 text-dark">
                        <i class="bi bi-wallet2 text-primary me-2"></i> Cấu hình tỷ lệ tài chính & Đặt cọc
                    </h2>
                </div>
                <div class="p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Tỷ lệ đặt cọc giữ xe (%) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" id="cfgDepositPct" class="form-control rounded-start-3" value="@Model.DepositPct" min="10" max="50" />
                            <span class="input-group-text rounded-end-3 bg-light">% GMV</span>
                        </div>
                        <div class="text-muted" style="font-size: 0.72rem; margin-top: 4px;">Khách hàng thanh toán qua cổng VNPay để giữ xe (Tiêu chuẩn: 30%, cho phép: 10% - 50%).</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Tỷ lệ hoa hồng nền tảng sàn thu (%) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" id="cfgCommissionPct" class="form-control rounded-start-3" value="@Model.CommissionPct" min="5" max="30" />
                            <span class="input-group-text rounded-end-3 bg-light">% GMV</span>
                        </div>
                        <div class="text-muted" style="font-size: 0.72rem; margin-top: 4px;">Sàn ReCar trích phí dịch vụ nền tảng trên mỗi chuyến thuê hoàn thành (Tiêu chuẩn: 10%, cho phép: 5% - 30%).</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label fw-bold small text-dark">Hạn mức di chuyển mặc định</label>
                            <div class="input-group">
                                <input type="number" id="cfgDefaultKm" class="form-control rounded-start-3" value="@Model.DefaultKmPerDay" min="100" max="1000" />
                                <span class="input-group-text rounded-end-3 bg-light">km/ngày</span>
                            </div>
                            <div class="text-muted" style="font-size: 0.72rem; margin-top: 4px;">Áp dụng khi chủ xe chưa cài hạn mức riêng.</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-bold small text-dark">Phụ phí vượt km mặc định</label>
                            <div class="input-group">
                                <input type="number" id="cfgExtraKmPrice" class="form-control rounded-start-3" value="@Convert.ToInt64(Model.ExtraKmPrice)" min="1000" max="20000" step="500" />
                                <span class="input-group-text rounded-end-3 bg-light">đ/km</span>
                            </div>
                            <div class="text-muted" style="font-size: 0.72rem; margin-top: 4px;">Mặc định: 3.000 đ/km.</div>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-bold small text-dark">Chính sách hủy chuyến & Hoàn cọc (Quy chuẩn pháp lý)</label>
                        <textarea class="form-control rounded-3" rows="3" readonly style="background-color: #f8fafc; font-size: 0.85rem;">- Hủy trước 24 giờ nhận xe: Hoàn 100% tiền cọc về tài khoản khách hàng.
- Hủy trong vòng 24 giờ trước chuyến đi: Phạt 50% tiền cọc bồi thường cho chủ xe.
- Khách không đến nhận xe (No-show): Không hoàn cọc (100% tiền cọc chuyển cho chủ xe).</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cấu hình nền tảng & Hỗ trợ -->
        <div class="col-12 col-xl-6">
            <div class="recar-panel mb-4">
                <div class="recar-panel-header">
                    <h2 class="h6 fw-bold mb-0 text-dark">
                        <i class="bi bi-headset text-success me-2"></i> Thông tin hỗ trợ & Vận hành sàn
                    </h2>
                </div>
                <div class="p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Tên thương hiệu nền tảng</label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-3 bg-light"><i class="bi bi-car-front text-primary"></i></span>
                            <input type="text" id="cfgPlatformName" class="form-control rounded-end-3" value="@Model.PlatformName" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Tổng đài Hotline hỗ trợ 24/7</label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-3 bg-light"><i class="bi bi-telephone text-primary"></i></span>
                            <input type="text" id="cfgHotline" class="form-control rounded-end-3" value="@Model.Hotline" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Email hỗ trợ khách hàng & chủ xe</label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-3 bg-light"><i class="bi bi-envelope text-primary"></i></span>
                            <input type="email" id="cfgSupportEmail" class="form-control rounded-end-3" value="@Model.SupportEmail" />
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-bold small text-dark">Địa chỉ trụ sở chính ReCar</label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-3 bg-light"><i class="bi bi-geo-alt text-danger"></i></span>
                            <input type="text" id="cfgAddress" class="form-control rounded-end-3" value="@Model.Address" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function saveSettings() {
        const deposit = parseInt($('#cfgDepositPct').val()) || 30;
        const commission = parseInt($('#cfgCommissionPct').val()) || 10;
        const defaultKm = parseInt($('#cfgDefaultKm').val()) || 350;
        const extraKmPrice = parseFloat($('#cfgExtraKmPrice').val()) || 3000;
        const platformName = $('#cfgPlatformName').val();
        const hotline = $('#cfgHotline').val();
        const email = $('#cfgSupportEmail').val();
        const address = $('#cfgAddress').val();

        if (deposit < 10 || deposit > 50) {
            Swal.fire({
                title: 'Lỗi nhập liệu',
                text: 'Tỷ lệ cọc phải nằm trong khoảng từ 10% đến 50%.',
                icon: 'warning',
                confirmButtonColor: '#0284c7',
                customClass: { popup: 'rounded-4' }
            });
            return;
        }

        if (commission < 5 || commission > 30) {
            Swal.fire({
                title: 'Lỗi nhập liệu',
                text: 'Tỷ lệ hoa hồng nền tảng phải nằm trong khoảng từ 5% đến 30%.',
                icon: 'warning',
                confirmButtonColor: '#0284c7',
                customClass: { popup: 'rounded-4' }
            });
            return;
        }

        Swal.fire({
            title: 'Lưu thay đổi cấu hình?',
            text: `Bạn đang cập nhật: Hoa hồng sàn ${commission}%, Cọc giữ xe ${deposit}%. Cấu hình mới sẽ tự động lưu và áp dụng tức thời cho các đơn đặt xe phát sinh mới.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0284c7',
            confirmButtonText: 'Đồng ý lưu',
            cancelButtonText: 'Hủy bỏ',
            customClass: { popup: 'rounded-4' }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Admin/Settings/SaveSettings',
                    type: 'POST',
                    data: {
                        depositPct: deposit,
                        commissionPct: commission,
                        defaultKmPerDay: defaultKm,
                        extraKmPrice: extraKmPrice,
                        platformName: platformName,
                        hotline: hotline,
                        supportEmail: email,
                        address: address
                    },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                title: 'Thành công!',
                                text: res.message,
                                icon: 'success',
                                timer: 2500,
                                showConfirmButton: false,
                                customClass: { popup: 'rounded-4' }
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                title: 'Thất bại',
                                text: res.message,
                                icon: 'error',
                                confirmButtonColor: '#0284c7',
                                customClass: { popup: 'rounded-4' }
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Lỗi kết nối',
                            text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.',
                            icon: 'error',
                            confirmButtonColor: '#0284c7',
                            customClass: { popup: 'rounded-4' }
                        });
                    }
                });
            }
        });
    }
</script>
}
