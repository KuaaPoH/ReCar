@{
    ViewData["Title"] = "Tin tức";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Banner -->
<div class="page-title-banner" style="background-color: #f8fafc; border-bottom: 1px solid var(--recar-border); padding: 36px 0;">
    <div class="container" style="max-width: 1280px;">
        <h1 class="fs-2 fw-bold m-0" style="color: var(--recar-navy);">Tin tức</h1>
        <p class="text-muted small m-0 mt-2" style="font-size: 15px;">
            Tin tức thị trường xe, công nghệ ô tô và các xu hướng mới nhất từ ReCar.
        </p>
    </div>
</div>

<!-- Lưới danh sách tin tức -->
<div class="container py-5" style="max-width: 1280px;">
    <div class="row g-4">
        @await Component.InvokeAsync("News")
    </div>
</div>