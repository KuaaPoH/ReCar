@model CarRental.Models.Customer
@{
    ViewData["Title"] = "Chi tiết tài khoản";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle p-2 text-muted me-1">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Hồ sơ tài khoản: @(Model.FullName ?? Model.Username)</h1>
            </div>
            <p class="text-muted small mb-0 mt-1 ms-5">Xem thông tin chi tiết người dùng, phân quyền vai trò và lịch sử đăng nhập.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill px-3 border">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="recar-panel mb-4">
                <div class="recar-panel-header">
                    <h2 class="h6 fw-bold mb-0 text-dark">
                        <i class="bi bi-person-badge text-primary me-2"></i> Thông tin cá nhân & Phân quyền
                    </h2>
                    <span class="status-badge @(Model.IsActive ? "badge-ready" : "badge-danger")">
                        @(Model.IsActive ? "Đang hoạt động" : "Đã khóa")
                    </span>
                </div>
                <div class="p-4">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-4" style="width: 64px; height: 64px; background: linear-gradient(135deg, #0284c7, #38bdf8);">
                            @((Model.FullName ?? Model.Username ?? "U")[0].ToString().ToUpper())
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0.5">@(Model.FullName ?? Model.Username)</h5>
                            <div class="text-muted small">
                                <span class="badge @(Model.RoleId == 1 ? "bg-danger" : (Model.RoleId == 3 ? "bg-primary" : "bg-info")) rounded-pill me-1">
                                    @(Model.Role?.RoleName ?? (Model.RoleId == 1 ? "Admin" : (Model.RoleId == 3 ? "Chủ xe" : "Khách hàng")))
                                </span>
                                <span>ID: #@Model.CustomerId</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Tên đăng nhập (Username):</span>
                            <div class="fw-semibold text-dark mt-0.5 font-mono-plate">@(Model.Username ?? "Chưa đặt")</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Địa chỉ Email:</span>
                            <div class="fw-semibold text-dark mt-0.5">@(Model.Email ?? "Chưa cập nhật")</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Số điện thoại:</span>
                            <div class="fw-semibold text-dark mt-0.5"><i class="bi bi-telephone text-primary me-1"></i>@(Model.PhoneNumber ?? Model.Phone ?? "Chưa cập nhật")</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Số CCCD / Định danh:</span>
                            <div class="fw-semibold text-dark mt-0.5">@(Model.Idcard ?? "Chưa cập nhật")</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Giấy phép lái xe (GPLX):</span>
                            <div class="fw-semibold text-dark mt-0.5">@(Model.LicenseNumber ?? "Chưa cập nhật")</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Đăng nhập lần cuối:</span>
                            <div class="text-muted small mt-0.5"><i class="bi bi-clock me-1"></i>@(Model.LastLogin ?? "Chưa có dữ liệu")</div>
                        </div>
                        <div class="col-12">
                            <span class="text-muted small" style="font-size: 0.75rem;">Địa chỉ thường trú:</span>
                            <div class="p-2.5 rounded-3 bg-light border text-dark small mt-1">
                                @(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật địa chỉ." : Model.Address)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
