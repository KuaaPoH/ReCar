@using CarRental.Utilities;
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var ownerName = Function.GetUserName(Context.Session);
    if (string.IsNullOrEmpty(ownerName))
    {
        ownerName = "Trần Quốc Bảo";
    }
    var ownerInitials = ownerName.Length >= 2 ? ownerName.Substring(0, 2).ToUpper() : "CX";
    var ownerAccountId = Function.GetCarOwnerAccountId(Context.Session) > 0 ? Function.GetCarOwnerAccountId(Context.Session) : Function.GetAccountId(Context.Session);
    string pageTitle = ViewData["Title"]?.ToString() ?? "Tổng quan";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(pageTitle) | ReCar Host Pro</title>
    
    <!-- Script khôi phục trạng thái thu gọn Sidebar tránh giật lag -->
    <script>
        (function() {
            try {
                if (localStorage.getItem('recar_host_sidebar_collapsed') === 'true' && window.innerWidth >= 992) {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch(e) {}
        })();
    </script>

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & SweetAlert2 -->
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        :root {
            --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --primary: #0284c7;
            --cyan: #00a8e8;
            --sidebar-bg: #0b1329;
            --sidebar-card: #131c31;
            --sidebar-text: #94a3b8;
            --sidebar-text-active: #ffffff;
            --sidebar-muted: #64748b;
            --bg-canvas: #f8fafc;
            --border-color: #e2e8f0;
            --sidebar-w: 240px;
            --sidebar-w-collapsed: 68px;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--bg-canvas);
            color: #0f172a;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        /* Design System Utilities */
        .card-surface {
            background-color: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 18px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease;
        }

        /* Utility classes Tailwind-compatible */
        .gap-1\.5 { gap: 0.375rem !important; }
        .gap-2\.5 { gap: 0.625rem !important; }
        .gap-3\.5 { gap: 0.875rem !important; }
        .place-items-center { place-items: center !important; }
        .icon-box-fixed {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            flex-shrink: 0 !important;
        }

        /* Sidebar Styling */
        .recar-owner-sidebar {
            width: var(--sidebar-w);
            background-color: var(--sidebar-bg);
            color: var(--sidebar-text);
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            z-index: 1040;
            overflow-y: auto;
            overflow-x: hidden;
            transition: width 0.22s cubic-bezier(0.4, 0, 0.2, 1);
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
        }

        .recar-owner-sidebar::-webkit-scrollbar {
            width: 4px;
        }
        .recar-owner-sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
        }

        .recar-owner-main {
            margin-left: var(--sidebar-w);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-canvas);
            transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Collapsed Sidebar Mode */
        html.sidebar-collapsed .recar-owner-sidebar,
        body.sidebar-collapsed .recar-owner-sidebar {
            width: var(--sidebar-w-collapsed);
        }
        html.sidebar-collapsed .recar-owner-main,
        body.sidebar-collapsed .recar-owner-main {
            margin-left: var(--sidebar-w-collapsed);
        }
        html.sidebar-collapsed .sidebar-hide-on-collapse,
        body.sidebar-collapsed .sidebar-hide-on-collapse {
            display: none !important;
        }
        html.sidebar-collapsed .sidebar-nav-link,
        body.sidebar-collapsed .sidebar-nav-link {
            justify-content: center;
            padding: 10px 0;
        }
        html.sidebar-collapsed .sidebar-brand-box,
        body.sidebar-collapsed .sidebar-brand-box {
            justify-content: center;
            padding: 10px 0;
        }
        html.sidebar-collapsed .recar-host-profile-card,
        body.sidebar-collapsed .recar-host-profile-card {
            padding: 8px 4px;
            justify-content: center;
            background: transparent !important;
        }

        /* Navigation Links */
        .sidebar-nav-header {
            font-size: 0.6875rem; /* 11px */
            text-transform: uppercase;
            letter-spacing: 0.06em;
            font-weight: 700;
            color: var(--sidebar-muted);
            padding: 14px 12px 6px 12px;
        }

        .sidebar-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 12px;
            margin: 1px 6px;
            border-radius: 8px;
            font-size: 0.8125rem; /* 13px */
            font-weight: 500;
            color: var(--sidebar-text);
            text-decoration: none;
            transition: all 0.15s ease;
            position: relative;
        }
        .sidebar-nav-link svg, .sidebar-nav-link i {
            width: 18px;
            height: 18px;
            min-width: 18px;
            stroke-width: 1.8;
            flex-shrink: 0;
            color: var(--sidebar-text);
            transition: color 0.15s ease;
        }
        .sidebar-nav-link:hover {
            background-color: rgba(255, 255, 255, 0.06);
            color: #ffffff;
        }
        .sidebar-nav-link:hover svg, .sidebar-nav-link:hover i {
            color: #ffffff;
        }
        .sidebar-nav-link.active {
            background-color: #00a8e8;
            color: #ffffff;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(0, 168, 232, 0.35);
        }
        .sidebar-nav-link.active svg, .sidebar-nav-link.active i {
            color: #ffffff;
        }

        /* Topbar Header */
        .recar-owner-topbar {
            height: 58px;
            position: sticky;
            top: 0;
            z-index: 1020;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
        }

        /* Nút thu gọn Sidebar tròn tinh tế chuẩn như bên Admin */
        .btn-toggle-sidebar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: none;
            background: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #475569;
            cursor: pointer;
            transition: all 0.15s ease;
            flex-shrink: 0;
        }
        .btn-toggle-sidebar:hover {
            background: #e2e8f0;
            color: #0f172a;
        }
        .btn-toggle-sidebar svg {
            width: 18px;
            height: 18px;
        }

        .btn-owner-bell {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid var(--border-color);
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #475569;
            position: relative;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-owner-bell:hover {
            background: #f8fafc;
            color: #0f172a;
        }
        .btn-owner-bell svg {
            width: 17px;
            height: 17px;
        }

        .owner-profile-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            padding: 3px 12px 3px 3px;
            border-radius: 999px;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .owner-profile-pill:hover {
            background: #f8fafc;
        }

        @@media (max-width: 991px) {
            .recar-owner-sidebar {
                transform: translateX(-100%);
                width: var(--sidebar-w) !important;
            }
            .recar-owner-sidebar.show {
                transform: translateX(0);
            }
            .recar-owner-main {
                margin-left: 0 !important;
            }
            html.sidebar-collapsed .recar-owner-sidebar,
            body.sidebar-collapsed .recar-owner-sidebar {
                transform: translateX(-100%);
            }
            html.sidebar-collapsed .recar-owner-sidebar.show,
            body.sidebar-collapsed .recar-owner-sidebar.show {
                transform: translateX(0);
            }
            html.sidebar-collapsed .sidebar-hide-on-collapse,
            body.sidebar-collapsed .sidebar-hide-on-collapse {
                display: block !important;
            }
            html.sidebar-collapsed .sidebar-nav-link,
            body.sidebar-collapsed .sidebar-nav-link {
                justify-content: flex-start;
                padding: 9px 14px;
            }
        }
    </style>
</head>

<body>
    <!-- Sleek Sidebar Khớp 100% Ảnh 2 Template -->
    <aside class="recar-owner-sidebar" id="hostSidebar">
        <div style="padding: 16px 8px 12px 8px;">
            <!-- Brand Logo: Ô tròn xanh cyan + icon xe ô tô -->
            <div class="d-flex align-items-center gap-2.5 px-2 py-2 mb-3 sidebar-brand-box">
                <div style="width: 42px; height: 42px; min-width: 42px; border-radius: 50%; background: #00a8e8; display: flex; align-items: center; justify-content: center; color: #ffffff; flex-shrink: 0; box-shadow: 0 4px 12px rgba(0, 168, 232, 0.4);">
                    <i data-lucide="car-front" style="width: 22px; height: 22px; stroke-width: 2;"></i>
                </div>
                <div class="sidebar-hide-on-collapse min-w-0">
                    <div class="fw-bold text-white" style="font-size: 15px; letter-spacing: -0.2px; line-height: 1.2;">ReCar Host Pro</div>
                    <div style="color: #64748b; font-size: 11.5px; margin-top: 1px;">Đối tác Chủ xe</div>
                </div>
            </div>



            <!-- Navigation Links Khớp 100% Ảnh 2 -->
            <nav class="d-flex flex-column gap-1">
                <div class="sidebar-nav-header sidebar-hide-on-collapse">QUẢN TRỊ PHƯƠNG TIỆN</div>

                <a href="/CarOwner/Home/Index" class="sidebar-nav-link @(currentController == "Home" ? "active" : "")" title="Tổng quan">
                    <i data-lucide="layout-grid"></i>
                    <span class="sidebar-hide-on-collapse">Tổng quan</span>
                </a>

                <a href="/CarOwner/Cars/Index" class="sidebar-nav-link @((currentController == "Cars" && currentAction == "Index") ? "active" : "")" title="Quản lý xe">
                    <i data-lucide="car"></i>
                    <span class="sidebar-hide-on-collapse">Quản lý xe</span>
                </a>

                <!-- Đã loại bỏ chữ "mới" theo yêu cầu người dùng -->
                <a href="/CarOwner/Cars/Create" class="sidebar-nav-link @((currentController == "Cars" && currentAction == "Create") ? "active" : "")" title="Thêm xe">
                    <i data-lucide="plus-circle"></i>
                    <span class="sidebar-hide-on-collapse">Thêm xe</span>
                </a>

                <div class="sidebar-nav-header sidebar-hide-on-collapse">KINH DOANH & THU NHẬP</div>

                <a href="/CarOwner/Orders/Index" class="sidebar-nav-link @(currentController == "Orders" ? "active" : "")" title="Lịch trình & Đơn xe">
                    <i data-lucide="calendar-range"></i>
                    <span class="sidebar-hide-on-collapse">Lịch trình & Đơn xe</span>
                </a>

                <a href="/CarOwner/Register/Pending" class="sidebar-nav-link @(currentController == "Register" ? "active" : "")" title="Hồ sơ pháp lý & Ngân hàng">
                    <i data-lucide="file-text"></i>
                    <span class="sidebar-hide-on-collapse">Hồ sơ pháp lý & Ngân hàng</span>
                </a>

                <div class="sidebar-nav-header sidebar-hide-on-collapse">SẮP RA MẮT</div>

                <a href="/CarOwner/Home/Roadmap" class="sidebar-nav-link @(currentAction == "Roadmap" ? "active" : "") text-white" title="Tính năng tương lai">
                    <i data-lucide="sparkles"></i>
                    <span class="sidebar-hide-on-collapse">Tính năng tương lai</span>
                </a>
            </nav>
        </div>

        <!-- Chân Sidebar Khớp Ảnh 2 -->
        <div style="padding: 12px 8px; border-top: 1px solid rgba(255, 255, 255, 0.08);">
            <a href="/" class="sidebar-nav-link mb-1 text-white" title="Về sàn khách thuê">
                <i data-lucide="store" style="color: #38bdf8;"></i>
                <span class="sidebar-hide-on-collapse">Về sàn khách thuê</span>
            </a>
            <a href="/CarOwner/Home/Logout" class="sidebar-nav-link text-danger" title="Đăng xuất">
                <i data-lucide="log-out"></i>
                <span class="sidebar-hide-on-collapse">Đăng xuất</span>
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="recar-owner-main">
        <!-- Topbar Header Căn Chỉnh Chuẩn Như Admin: Nút tròn + Breadcrumb 1 hàng thẳng tắp -->
        <header class="recar-owner-topbar">
            <div class="d-flex align-items-center gap-3">
                <!-- Nút Thu gọn/Mở rộng Sidebar tròn tinh tế -->
                <button class="btn-toggle-sidebar" type="button" id="btnToggleSidebar" title="Thu gọn / Mở rộng Sidebar">
                    <i data-lucide="panel-left" id="sidebarToggleIcon"></i>
                </button>
                
                <!-- Breadcrumbs 1 hàng gọn gàng, không bị đội tiêu đề làm lệch -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0" style="font-size: 0.8125rem;">
                        <li class="breadcrumb-item text-muted">Host Pro</li>
                        <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">@(pageTitle)</li>
                    </ol>
                </nav>
            </div>

            <div class="d-flex align-items-center gap-2.5">
                <!-- Chuông thông báo Real-time -->
                <div class="dropdown">
                    <button class="btn-owner-bell" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btnOwnerBell" title="Thông báo đối tác">
                        <i data-lucide="bell"></i>
                        <span id="ownerNotificationDot" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="display: none; width: 8px; height: 8px; margin-top: 6px; margin-left: -6px;"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg p-2 border-0" style="width: 340px; border-radius: 16px; margin-top: 10px;">
                        <li>
                            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-1">
                                    <i data-lucide="bell" style="width: 15px; height: 15px; color: #0284c7;"></i> Thông báo đối tác
                                </h6>
                                <span class="badge bg-light text-muted small">Realtime</span>
                            </div>
                        </li>
                        <li id="ownerNotificationEmpty" class="text-center py-4 text-muted small">
                            <i data-lucide="inbox" style="width: 32px; height: 32px; margin: 0 auto 6px auto; display: block; opacity: 0.4;"></i>
                            Chưa có thông báo mới nào
                        </li>
                        <div id="ownerNotificationList"></div>
                    </ul>
                </div>

                <!-- Host Profile Pill -->
                <div class="dropdown">
                    <div class="owner-profile-pill" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div style="width: 30px; height: 30px; font-size: 11px; font-weight: 700; background: #00a8e8; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            @ownerInitials
                        </div>
                        <span class="fw-semibold text-dark small d-none d-md-inline" style="font-size: 0.82rem;">@ownerName</span>
                        <i data-lucide="chevron-down" style="width: 14px; height: 14px; color: #94a3b8;"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-2" style="border-radius: 14px; min-width: 220px; margin-top: 8px;">
                        <li class="px-3 py-2 border-bottom mb-1">
                            <div class="fw-bold text-dark">@ownerName</div>
                            <div class="text-muted small">Đối tác Chủ xe ReCar</div>
                        </li>
                        <li><a class="dropdown-item rounded-3 py-2 small" href="/Accounts/Index"><i class="bi bi-person me-2"></i>Tài khoản cá nhân</a></li>
                        <li><a class="dropdown-item rounded-3 py-2 small" href="/CarOwner/Register/Pending"><i class="bi bi-bank2 me-2"></i>Tài khoản thụ hưởng</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item rounded-3 py-2 small text-danger" href="/CarOwner/Home/Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Body Content -->
        <div class="p-3 p-md-4 p-xl-5 flex-grow-1">
            @RenderBody()
        </div>

        <!-- Footer -->
        <footer class="py-3 px-4 border-top text-center text-muted small" style="background: #ffffff; font-size: 0.78rem;">
            &copy; @DateTime.Now.Year ReCar Host Pro — Hệ thống quản trị phương tiện dành cho Đối tác Chủ xe.
        </footer>
    </main>

    <!-- Scripts -->
    <script src="~/assets/js/vendor/jquery.min.js"></script>
    <script src="~/assets/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // Toggle Sidebar & Persist state in localStorage
        function toggleHostSidebar() {
            if (window.innerWidth < 992) {
                var sb = document.getElementById('hostSidebar');
                if (sb) sb.classList.toggle('show');
            } else {
                var isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
                document.body.classList.toggle('sidebar-collapsed', isCollapsed);
                localStorage.setItem('recar_host_sidebar_collapsed', isCollapsed ? 'true' : 'false');
            }
        }

        document.getElementById('btnToggleSidebar')?.addEventListener('click', toggleHostSidebar);

        // Khởi tạo Lucide Icons
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
