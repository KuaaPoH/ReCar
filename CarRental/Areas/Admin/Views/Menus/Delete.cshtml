@model CarRental.Models.Menu
@{
    ViewData["Title"] = "Xác nhận xóa Menu";
}

<div class="container-fluid px-0" style="max-width: 600px;">
    <div class="mb-4">
        <a asp-action="Index" asp-route-tab="@Model.Subsystem" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách Menu
        </a>
        <h1 class="h3 fw-bold mb-1 text-danger tracking-tight">Xóa mục Menu</h1>
        <p class="text-muted small mb-0">Hành động này sẽ xóa mục menu khỏi phân hệ <strong>@Model.Subsystem</strong>.</p>
    </div>

    <div class="card border-danger border-opacity-25 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 24px;">
                    <i class="bi @(string.IsNullOrWhiteSpace(Model.Icon) ? "bi-trash" : Model.Icon)"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark">@Model.Title</h5>
                    <div class="text-muted small">Phân hệ: <span class="badge bg-light text-dark border">@Model.Subsystem</span> · Cấp @Model.Levels</div>
                </div>
            </div>

            <div class="alert alert-warning border-0 rounded-3 small mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Nếu menu này có chứa các menu con bên trong, các menu con sẽ tự động được chuyển lên Menu cấp 1 (Menu gốc) để tránh mất dữ liệu liên kết.
            </div>

            <dl class="row mb-0 small">
                <dt class="col-sm-4 text-muted">Đường dẫn (URL):</dt>
                <dd class="col-sm-8 fw-semibold font-monospace">@Model.Url</dd>

                <dt class="col-sm-4 text-muted">Mô tả:</dt>
                <dd class="col-sm-8 text-muted">@(string.IsNullOrEmpty(Model.Description) ? "Không có" : Model.Description)</dd>

                <dt class="col-sm-4 text-muted">Thứ tự hiển thị:</dt>
                <dd class="col-sm-8">@Model.Position</dd>
            </dl>
        </div>
        <div class="card-footer bg-light p-3 border-top d-flex justify-content-end gap-2">
            <a asp-action="Index" asp-route-tab="@Model.Subsystem" class="btn btn-light rounded-pill px-4 small border">Hủy bỏ</a>
            <form asp-action="Delete" method="post" class="d-inline m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MenuId" />
                <button type="submit" class="btn btn-danger rounded-pill px-4 small fw-semibold shadow-sm">
                    <i class="bi bi-trash me-1"></i> Xác nhận xóa
                </button>
            </form>
        </div>
    </div>
</div>
