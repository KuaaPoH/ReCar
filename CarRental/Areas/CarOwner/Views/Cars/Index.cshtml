@model IList<CarRental.Models.Car>
@using CarRental.Utilities
@{
    ViewData["Title"] = "Quản lý xe";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";

    int totalCars = Model?.Count ?? 0;
    var uniqueBrands = Model?.Where(c => !string.IsNullOrEmpty(c.CarBrand)).Select(c => c.CarBrand!).Distinct().OrderBy(b => b).ToList() ?? new List<string>();
    var uniqueTypes = Model?.Where(c => c.Type != null && !string.IsNullOrEmpty(c.Type.CarTypeName)).Select(c => c.Type!.CarTypeName!).Distinct().OrderBy(t => t).ToList() ?? new List<string>();
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark tracking-tight mb-1">Quản lý xe</h1>
        <p class="text-muted small mb-0">@totalCars xe thuộc đội xe của bạn</p>
    </div>
    <a href="/CarOwner/Cars/Create" class="btn btn-primary rounded-pill px-3.5 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" style="background: #0284c7; border-color: #0284c7;">
        <i class="bi bi-plus-lg"></i> Thêm xe mới
    </a>
</div>

<!-- Search & Filter Controls -->
<div class="card-surface p-3 mb-4 d-flex flex-column flex-lg-row gap-3 align-items-lg-center">
    <!-- Input Search -->
    <div class="position-relative flex-grow-1" style="min-width: 240px;">
        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
        <input type="text" id="carSearchInput" class="form-control rounded-3 ps-5 bg-white border" placeholder="Tìm tên xe hoặc biển số…" oninput="applyFilters()" />
    </div>

    <!-- Filter Brand -->
    <select id="brandFilter" class="form-select rounded-3 border bg-white" style="width: auto; min-width: 140px;" onchange="applyFilters()">
        <option value="all">Tất cả hãng</option>
        @foreach (var b in uniqueBrands)
        {
            <option value="@b">@b</option>
        }
    </select>

    <!-- Filter Segment / Type -->
    <select id="typeFilter" class="form-select rounded-3 border bg-white" style="width: auto; min-width: 150px;" onchange="applyFilters()">
        <option value="all">Mọi phân khúc</option>
        @foreach (var t in uniqueTypes)
        {
            <option value="@t">@t</option>
        }
    </select>

    <!-- Filter Status -->
    <select id="statusFilter" class="form-select rounded-3 border bg-white" style="width: auto; min-width: 150px;" onchange="applyFilters()">
        <option value="all">Mọi trạng thái</option>
        <option value="Sẵn sàng">Sẵn sàng</option>
        <option value="Đang bận">Đang bận</option>
        <option value="Chờ duyệt">Chờ duyệt</option>
        <option value="Chờ cập nhật">Chờ cập nhật</option>
        <option value="Tạm ngưng">Tạm ngưng</option>
        <option value="Từ chối">Từ chối</option>
    </select>

    <!-- Sort Dropdown -->
    <select id="sortFilter" class="form-select rounded-3 border bg-white" style="width: auto; min-width: 160px;" onchange="applySorting()">
        <option value="newest">Mới đăng nhất</option>
        <option value="priceAsc">Giá thấp → cao</option>
        <option value="priceDesc">Giá cao → thấp</option>
        <option value="trips">Nhiều chuyến nhất</option>
    </select>
</div>

<!-- Table Card Surface -->
<div class="card-surface overflow-hidden">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-car-front fs-1 text-secondary opacity-50 d-block mb-3"></i>
            <h5 class="fw-bold text-dark">Chưa có phương tiện nào trong đội xe</h5>
            <p class="text-muted small mb-3">Bắt đầu bằng cách đăng ký chiếc xe đầu tiên của bạn lên sàn ReCar.</p>
            <a href="/CarOwner/Cars/Create" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                <i class="bi bi-plus-lg me-1"></i>Thêm xe ngay
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="carTable" style="font-size: 0.88rem; min-width: 1050px;">
                <thead class="bg-light text-muted text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4 py-3">Xe</th>
                        <th class="py-3">Giá/ngày</th>
                        <th class="py-3">Nhận xe</th>
                        <th class="py-3">Chuyến</th>
                        <th class="py-3">Đánh giá</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="py-3">Hoạt động</th>
                        <th class="py-3">Khuyến mãi</th>
                        <th class="pe-4 py-3 text-end"></th>
                    </tr>
                </thead>
                <tbody class="divide-y" id="carTableBody">
                    @foreach (var car in Model)
                    {
                        var status = car.CarStatus ?? "Sẵn sàng";
                        bool isAvailable = status == "Sẵn sàng" || (status == "active" && car.IsActive);
                        bool isBusy = status == "Đang bận" || status == "Đang có khách" || status == "busy";
                        bool isPending = status == "Chờ duyệt" || status == "pending";
                        bool isPendingUpdate = status == "Chờ cập nhật" || status == "pending_update";
                        bool isPaused = status == "Tạm ngưng" || status == "paused";
                        bool isRejected = status == "Từ chối" || status == "rejected";

                        decimal regularPrice = car.Price ?? 0;
                        decimal? salePrice = car.SalePrice;
                        bool hasSale = car.IsSale && salePrice.HasValue && salePrice.Value > 0 && salePrice.Value < regularPrice;

                        <tr class="car-row" 
                            data-name="@(car.CarName?.ToLower())" 
                            data-plate="@(car.LicensePlate?.ToLower())"
                            data-brand="@car.CarBrand"
                            data-type="@(car.Type?.CarTypeName)"
                            data-status="@status"
                            data-price="@(hasSale && salePrice.HasValue ? salePrice.Value : regularPrice)"
                            data-trips="@(car.Trips ?? 0)"
                            data-id="@car.CarId">
                            
                            <!-- Cột 1: Xe -->
                            <td class="ps-4 py-3.5">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(car.Image) ? "/images/cars/car-sedan.jpg" : car.Image)" 
                                         alt="@car.CarName" 
                                         class="rounded-3 border object-fit-cover shadow-xs flex-shrink-0" 
                                         style="width: 82px; height: 54px;" />
                                    <div>
                                        <a href="/CarOwner/Cars/Details/@car.CarId" class="fw-bold text-dark text-decoration-none hover-primary d-block">
                                            @car.CarName
                                        </a>
                                        <div class="text-muted" style="font-size: 0.75rem;">
                                            @car.CarBrand · @(car.Model > 0 ? car.Model.ToString() : "2024") · @(car.Type?.CarTypeName ?? "Sedan")
                                        </div>
                                        <span class="plate mt-1">@(string.IsNullOrEmpty(car.LicensePlate) ? "CHƯA CẤP" : car.LicensePlate)</span>
                                    </div>
                                </div>
                            </td>

                            <!-- Cột 2: Giá/ngày -->
                            <td class="py-3.5">
                                @if (hasSale)
                                {
                                    <div class="fw-bold text-primary">@salePrice!.Value.ToString("N0")đ</div>
                                    <div class="text-muted text-decoration-line-through" style="font-size: 0.72rem;">@regularPrice.ToString("N0")đ</div>
                                }
                                else
                                {
                                    <div class="fw-bold text-dark">@regularPrice.ToString("N0")đ</div>
                                }
                            </td>

                            <!-- Cột 3: Nhận xe (Location) -->
                            <td class="py-3.5">
                                <div class="d-flex align-items-center gap-1.5 text-muted" style="font-size: 0.78rem;">
                                    <i class="bi bi-geo-alt-fill text-danger flex-shrink-0"></i>
                                    <span class="text-truncate" style="max-width: 150px;" title="@car.Location">
                                        @(string.IsNullOrEmpty(car.Location) ? "Toàn quốc" : car.Location)
                                    </span>
                                </div>
                            </td>

                            <!-- Cột 4: Chuyến hoàn thành -->
                            <td class="py-3.5 fw-bold text-dark">
                                @(car.Trips ?? 0)
                            </td>

                            <!-- Cột 5: Đánh giá -->
                            <td class="py-3.5">
                                @if (car.Rate.HasValue && car.Rate > 0)
                                {
                                    <span class="d-flex align-items-center gap-1 fw-bold text-dark" style="font-size: 0.8rem;">
                                        <i class="bi bi-star-fill text-warning"></i> @car.Rate.Value.ToString("0.0")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có</span>
                                }
                            </td>

                            <!-- Cột 6: Trạng thái badge -->
                            <td class="py-3.5" id="badge-container-@car.CarId">
                                @if (isAvailable)
                                {
                                    <span class="status-badge status-badge-ready">Sẵn sàng</span>
                                }
                                else if (isBusy)
                                {
                                    <span class="status-badge status-badge-busy">Đang có khách</span>
                                }
                                else if (isPending)
                                {
                                    <span class="status-badge status-badge-pending">Chờ duyệt</span>
                                }
                                else if (isPendingUpdate)
                                {
                                    <span class="status-badge" style="background: #fff7ed; color: #c2410c; border: 1px solid #ffedd5;">Chờ cập nhật</span>
                                }
                                else if (isPaused)
                                {
                                    <span class="status-badge status-badge-paused">Tạm ngưng</span>
                                }
                                else if (isRejected)
                                {
                                    <span class="status-badge status-badge-rejected">Từ chối</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-paused">@status</span>
                                }
                            </td>

                            <!-- Cột 7: Switch Hoạt động (ToggleStatus) -->
                            <td class="py-3.5">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" 
                                           id="toggleStatus-@car.CarId" 
                                           @(isAvailable ? "checked" : "") 
                                           @(isBusy || isPending || isPendingUpdate || isRejected ? "disabled" : "")
                                           onchange="toggleCarStatus(@car.CarId, this)" />
                                </div>
                            </td>

                            <!-- Cột 8: Switch Khuyến mãi (ToggleSale) -->
                            <td class="py-3.5">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" 
                                           id="toggleSale-@car.CarId" 
                                           @(car.IsSale ? "checked" : "")
                                           onchange="toggleCarSale(@car.CarId, this)" />
                                </div>
                            </td>

                            <!-- Cột 9: Thao tác dropdown -->
                            <td class="pe-4 py-3.5 text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border rounded-pill px-2 py-1 text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2" style="border-radius: 12px; font-size: 0.84rem;">
                                        <li>
                                            <a class="dropdown-item rounded-2 py-2" href="/CarOwner/Cars/Details/@car.CarId">
                                                <i class="bi bi-eye me-2 text-primary"></i>Chi tiết xe
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-2 py-2" href="/CarOwner/Cars/Edit/@car.CarId">
                                                <i class="bi bi-pencil me-2 text-warning"></i>Chỉnh sửa
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-2 py-2" href="/product/@(car.Alias)-@(car.CarId).html" target="_blank">
                                                <i class="bi bi-box-arrow-up-right me-2 text-muted"></i>Xem trên sàn
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item rounded-2 py-2 text-danger" href="/CarOwner/Cars/Delete/@car.CarId">
                                                <i class="bi bi-trash3 me-2"></i>Gỡ xe khỏi sàn
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="noResultState" class="text-center py-5 d-none">
            <i class="bi bi-search fs-2 text-secondary opacity-50 d-block mb-2"></i>
            <h6 class="fw-bold text-dark">Không tìm thấy xe phù hợp</h6>
            <p class="text-muted small mb-0">Thử thay đổi từ khóa hoặc bộ lọc của bạn.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        // 1. Bộ lọc xe tổng hợp
        function applyFilters() {
            const q = document.getElementById('carSearchInput').value.toLowerCase().trim();
            const brand = document.getElementById('brandFilter').value;
            const type = document.getElementById('typeFilter').value;
            const status = document.getElementById('statusFilter').value;

            const rows = document.querySelectorAll('.car-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.getAttribute('data-name') || '';
                const plate = row.getAttribute('data-plate') || '';
                const rBrand = row.getAttribute('data-brand') || '';
                const rType = row.getAttribute('data-type') || '';
                const rStatus = row.getAttribute('data-status') || '';

                const matchesQ = !q || name.includes(q) || plate.replace(/[-.]/g, '').includes(q.replace(/[-.]/g, ''));
                const matchesBrand = (brand === 'all') || (rBrand === brand);
                const matchesType = (type === 'all') || (rType === type);
                const matchesStatus = (status === 'all') || (rStatus === status);

                if (matchesQ && matchesBrand && matchesType && matchesStatus) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const noResult = document.getElementById('noResultState');
            if (noResult) {
                noResult.classList.toggle('d-none', visibleCount > 0);
            }
        }

        // 2. Sắp xếp xe
        function applySorting() {
            const sortBy = document.getElementById('sortFilter').value;
            const tbody = document.getElementById('carTableBody');
            const rows = Array.from(document.querySelectorAll('.car-row'));

            rows.sort((a, b) => {
                const priceA = parseFloat(a.getAttribute('data-price')) || 0;
                const priceB = parseFloat(b.getAttribute('data-price')) || 0;
                const tripsA = parseInt(a.getAttribute('data-trips')) || 0;
                const tripsB = parseInt(b.getAttribute('data-trips')) || 0;
                const idA = parseInt(a.getAttribute('data-id')) || 0;
                const idB = parseInt(b.getAttribute('data-id')) || 0;

                if (sortBy === 'priceAsc') return priceA - priceB;
                if (sortBy === 'priceDesc') return priceB - priceA;
                if (sortBy === 'trips') return tripsB - tripsA;
                return idB - idA; // newest by id
            });

            rows.forEach(r => tbody.appendChild(r));
        }

        // 3. AJAX Toggle trạng thái xe
        function toggleCarStatus(carId, checkbox) {
            const isChecked = checkbox.checked;
            var formData = new FormData();
            formData.append('id', carId);
            formData.append('__RequestVerificationToken', getCsrfToken());

            fetch('/CarOwner/Cars/ToggleStatus', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: data.message || 'Cập nhật trạng thái thành công!',
                        showConfirmButton: false,
                        timer: 2000
                    });

                    // Cập nhật badge
                    const badgeContainer = document.getElementById(`badge-container-${carId}`);
                    if (badgeContainer) {
                        if (data.newStatus === 'Sẵn sàng') {
                            badgeContainer.innerHTML = '<span class="status-badge status-badge-ready">Sẵn sàng</span>';
                        } else {
                            badgeContainer.innerHTML = '<span class="status-badge status-badge-paused">Tạm ngưng</span>';
                        }
                    }
                } else {
                    checkbox.checked = !isChecked; // revert
                    Swal.fire({
                        icon: 'error',
                        title: 'Không thể chuyển đổi',
                        text: data.message
                    });
                }
            })
            .catch(() => {
                checkbox.checked = !isChecked;
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Không thể kết nối máy chủ'
                });
            });
        }

        // 4. AJAX Toggle giảm giá
        function toggleCarSale(carId, checkbox) {
            const isChecked = checkbox.checked;
            var formData = new FormData();
            formData.append('id', carId);

            fetch('/CarOwner/Cars/ToggleSale', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: data.message,
                        showConfirmButton: false,
                        timer: 1800
                    });
                } else {
                    checkbox.checked = !isChecked;
                    Swal.fire({
                        icon: 'warning',
                        title: 'Lưu ý',
                        text: data.message || 'Vui lòng thiết lập giá khuyến mãi trong trang Chỉnh sửa trước khi bật.'
                    });
                }
            })
            .catch(() => {
                checkbox.checked = !isChecked;
            });
        }
    </script>
}
