</div>

<!-- Modal xem ảnh lớn chuẩn Bootstrap 5 -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom py-2.5 px-4 bg-dark text-white">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-card-image text-info"></i>
                    <h6 class="modal-title fw-bold mb-0" id="imageModalTitle">Xem hình ảnh tài liệu</h6>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a id="imageModalNewTab" href="#" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1" style="font-size: 0.75rem;">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Mở tab mới
                    </a>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-3 text-center bg-black d-flex align-items-center justify-content-center" style="min-height: 380px;">
                <img id="imageModalSrc" src="" alt="Document Image" class="img-fluid rounded-2 shadow-sm" style="max-height: 75vh; max-width: 100%; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function prepareImageModal(src, title) {
            if (!src) return;
            var imgEl = document.getElementById('imageModalSrc');
            var titleEl = document.getElementById('imageModalTitle');
            var tabLink = document.getElementById('imageModalNewTab');
            
            if (imgEl) imgEl.src = src;
            if (titleEl) titleEl.innerText = title || 'Xem hình ảnh tài liệu';
            if (tabLink) tabLink.href = src;
        }

        function viewLargeImage(src, title) {
            prepareImageModal(src, title);
            var modalEl = document.getElementById('imageModal');
            if (!modalEl) {
                window.open(src, '_blank');
                return;
            }

            // Thử khởi tạo Bootstrap modal tương thích mọi phiên bản Bootstrap 5
            try {
                if (window.bootstrap && bootstrap.Modal) {
                    if (typeof bootstrap.Modal.getOrCreateInstance === 'function') {
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                        return;
                    }
                    var inst = bootstrap.Modal.getInstance ? bootstrap.Modal.getInstance(modalEl) : null;
                    if (!inst) {
                        inst = new bootstrap.Modal(modalEl);
                    }
                    inst.show();
                    return;
                }
            } catch(e) {
                console.warn('Bootstrap modal error:', e);
            }

            // Thử dùng jQuery modal
            try {
                if (window.jQuery && typeof $('#imageModal').modal === 'function') {
                    $('#imageModal').modal('show');
                    return;
                }
            } catch(e) { }

            // Dự phòng mở tab mới
            window.open(src, '_blank');
        }

        function toggleLockUser(id, name, isCurrentlyLocked) {
            const actionText = isCurrentlyLocked ? 'Mở khóa' : 'Khóa';
            const confirmBtnColor = isCurrentlyLocked ? '#10b981' : '#ef4444';

            Swal.fire({
                title: actionText + ' tài khoản?',
                html: 'Bạn có chắc chắn muốn ' + actionText.toLowerCase() + ' tài khoản <strong>"' + name + '"</strong>?<br><span class="text-muted small">' + 
                      (isCurrentlyLocked ? 'Người dùng sẽ có thể đăng nhập lại vào hệ thống ReCar.' : 'Người dùng sẽ bị chặn đăng nhập và ngừng toàn bộ giao dịch trên sàn.') + '</span>',
                icon: isCurrentlyLocked ? 'question' : 'warning',
                showCancelButton: true,
                confirmButtonColor: confirmBtnColor,
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="bi ' + (isCurrentlyLocked ? 'bi-unlock' : 'bi-lock') + ' me-1"></i> Đồng ý ' + actionText.toLowerCase(),
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Admin/UserManagement/ToggleLock/' + id,
                        type: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        success: function (res) {
                            if (res && res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công',
                                    text: res.message || 'Cập nhật trạng thái tài khoản thành công',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Không thể thực hiện',
                                    text: (res && res.message) || 'Có lỗi xảy ra.'
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: 'Có lỗi xảy ra khi kết nối máy chủ.'
                            });
                        }
                    });
                }
            });
        }
    </script>
}
