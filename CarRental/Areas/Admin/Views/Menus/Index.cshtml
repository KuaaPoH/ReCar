@model IEnumerable<CarRental.Models.Menu>
@{
    ViewData["Title"] = "Quản lý Menu";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Quản lý Menu sàn ReCar</h1>
                <span class="badge bg-light text-dark border rounded-pill fw-semibold px-2.5 py-1">@Model.Count() mục</span>
            </div>
            <p class="text-muted small mb-0 mt-1">Cấu hình hệ thống menu điều hướng trên thanh header, footer và các trang liên kết.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3.5 py-2 fw-semibold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                <i class="bi bi-plus-circle me-1"></i> Thêm menu mới
            </a>
        </div>
    </div>

    <!-- Table Panel -->
    <div class="recar-panel mb-0">
        <div class="table-responsive">
            <table class="table recar-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 60px;">STT</th>
                        <th>Tiêu đề Menu</th>
                        <th>Alias (Đường dẫn)</th>
                        <th>Cấp bậc</th>
                        <th>Thứ tự</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-menu-button-wide fs-2 text-secondary d-block mb-2"></i>
                                Chưa có menu nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        foreach (var item in Model.OrderBy(m => m.Position))
                        {
                            <tr>
                                <td class="fw-bold text-muted">@(index++)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width: 32px; height: 32px; border-radius: 8px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                                            <i class="bi bi-link-45deg"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.Title</div>
                                            @if (!string.IsNullOrEmpty(item.Description))
                                            {
                                                <div class="text-muted small" style="font-size: 0.75rem;">@item.Description</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <code class="bg-light px-2 py-1 rounded small border">@item.Alias</code>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">Cấp @item.Levels</span>
                                </td>
                                <td>
                                    <span class="fw-semibold">@item.Position</span>
                                </td>
                                <td>
                                    @if (item.IsActive.HasValue && item.IsActive.Value)
                                    {
                                        <span class="status-badge badge-active">
                                            <i class="bi bi-check-circle-fill me-1"></i> Hiển thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-neutral">
                                            <i class="bi bi-eye-slash-fill me-1"></i> Tạm ẩn
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.MenuId" class="btn btn-sm btn-light border" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square text-primary"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MenuId" class="btn btn-sm btn-light border text-danger" title="Xóa menu" onclick="return confirm('Bạn có chắc chắn muốn xóa menu này không?');">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
