@using CarRental.Utilities
@model CarRental.Models.Customer
@{
    ViewData["Title"] = "Đăng ký thành viên";
}

<!-- Breadcrumb Area -->
<div class="recar-section bg-light py-4 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="font-size: 14px;">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">Đăng ký</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1" style="color: var(--recar-dark);">Đăng ký tài khoản ReCar</h2>
        <p class="text-muted mb-0">Trở thành thành viên để dễ dàng đặt thuê xe ô tô tự lái và có lái trên toàn quốc</p>
    </div>
</div>

<div class="recar-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 64px; height: 64px; font-size: 28px;">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">Tạo tài khoản mới</h4>
                        <p class="text-muted small">Điền các thông tin cơ bản để bắt đầu trải nghiệm</p>
                    </div>

                    <form asp-controller="Register" asp-action="Index">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Họ và tên của bạn <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input type="text" asp-for="Name" class="form-control form-control-lg border-start-0 rounded-end-3 fs-6" placeholder="Ví dụ: Nguyễn Văn An" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Địa chỉ Email <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" asp-for="Email" class="form-control form-control-lg border-start-0 rounded-end-3 fs-6" placeholder="name@example.com" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Mật khẩu đăng nhập <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input type="password" asp-for="Password" class="form-control form-control-lg border-start-0 rounded-end-3 fs-6" placeholder="Tối thiểu 6 ký tự" required>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Function._MessageEmail))
                        {
                            <div class="alert alert-danger py-2 small mb-3 rounded-3" role="alert">
                                @Function._MessageEmail
                            </div>
                        }

                        <div class="form-text text-muted small mb-4">
                            <i class="bi bi-shield-check text-success me-1"></i> Bằng việc đăng ký, bạn đồng ý với <a href="/Home/Privacy" target="_blank" class="text-decoration-none">Quy chế hoạt động & Bảo mật</a> của ReCar.
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Hoàn tất đăng ký
                        </button>

                        <div class="text-center mt-4 pt-3 border-top small text-muted">
                            Đã có tài khoản ReCar? 
                            <a asp-controller="Login" asp-action="Index" class="text-decoration-none text-primary fw-bold">Đăng nhập tại đây</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
