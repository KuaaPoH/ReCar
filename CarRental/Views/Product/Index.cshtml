@{
    ViewData["Title"] = "Danh sách xe cho thuê | ReCar";
}

<style>
    .page-title-banner {
        background-color: var(--recar-secondary);
        border-bottom: 1px solid var(--recar-border);
        padding: 32px 0;
    }
    .filter-section-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--recar-navy);
        margin-bottom: 12px;
    }
    .filter-group-divider {
        border-bottom: 1px solid var(--recar-border);
        padding-bottom: 20px;
        margin-bottom: 20px;
    }
    .price-slider-input {
        width: 100%;
        accent-color: var(--recar-primary);
        cursor: pointer;
    }
</style>

<!-- Page Header Banner (Pixel-perfect Ảnh 5) -->
<div class="page-title-banner">
    <div class="container" style="max-width: 1280px;">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3">
            <div>
                <h1 class="fs-2 fw-bold m-0" style="color: var(--recar-navy);">Danh sách xe cho thuê</h1>
                <p class="text-muted small m-0 mt-2">
                    Tất cả khu vực · <b style="color: var(--recar-navy);" id="totalCarCount">8 xe phù hợp</b>
                </p>
            </div>
            <a href="/" class="btn btn-outline-secondary btn-sm bg-white text-dark rounded-3 px-3 py-2 fw-medium text-decoration-none">
                Sửa tiêu chí tìm kiếm
            </a>
        </div>
    </div>
</div>

<div class="container py-4" style="max-width: 1280px;">
    <div class="row g-4">
        <!-- Sidebar Filter (Cột bộ lọc dạng Chip pills - Ảnh 5) -->
        <div class="col-lg-3 col-md-4">
            <aside class="pe-lg-3">
                <!-- 0. Hình thức thuê Pill chips -->
                <div class="filter-group-divider">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <p class="filter-section-title m-0">Hình thức thuê</p>
                        <span class="badge bg-light text-primary border" style="font-size: 11px;" id="driveModeActiveBadge">Tất cả</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-2" id="driveModeChipsWrap">
                        <button type="button" class="recar-chip chip-drive-mode active" data-drive-mode="">Tất cả</button>
                        <button type="button" class="recar-chip chip-drive-mode" data-drive-mode="Tự lái"><i class="bi bi-car-front me-1"></i> Tự lái</button>
                        <button type="button" class="recar-chip chip-drive-mode" data-drive-mode="Có tài xế"><i class="bi bi-person-badge me-1"></i> Có tài xế</button>
                    </div>
                </div>

                <!-- 1. Khoảng giá kéo từ Min đến Max (Thẩm mỹ & chuẩn xác) -->
                <div class="filter-group-divider">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <p class="filter-section-title m-0">Khoảng giá thuê</p>
                        <span class="badge bg-light text-primary border fw-semibold" id="priceRangeBadge" style="font-size: 11px;">500k - 5tr</span>
                    </div>
                    <p class="small fw-semibold mb-2" id="priceLabel" style="font-size: 12px; color: var(--recar-primary);">
                        Từ 500.000đ đến 5.000.000đ/ngày
                    </p>
                    <div class="range-sliders-box p-2 rounded-3 border bg-light">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="small text-muted fw-medium" style="min-width: 32px; font-size: 11px;">Từ:</span>
                            <input type="range" class="price-slider-input w-100" id="minPriceSlider" min="500000" max="3000000" step="50000" value="500000">
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-muted fw-medium" style="min-width: 32px; font-size: 11px;">Đến:</span>
                            <input type="range" class="price-slider-input w-100" id="maxPriceSlider" min="1000000" max="5000000" step="50000" value="5000000">
                        </div>
                    </div>
                </div>

                <!-- 2. Hãng xe Pill chips -->
                <div class="filter-group-divider">
                    <p class="filter-section-title">Hãng xe</p>
                    <div class="d-flex flex-wrap gap-2" id="brandChipsWrap">
                        <button type="button" class="recar-chip chip-brand" data-brand="VinFast">VinFast</button>
                        <button type="button" class="recar-chip chip-brand" data-brand="Toyota">Toyota</button>
                        <button type="button" class="recar-chip chip-brand" data-brand="Mazda">Mazda</button>
                        <button type="button" class="recar-chip chip-brand" data-brand="Hyundai">Hyundai</button>
                        <button type="button" class="recar-chip chip-brand" data-brand="Kia">Kia</button>
                        <button type="button" class="recar-chip chip-brand" data-brand="Honda">Honda</button>
                        <button type="button" class="recar-chip chip-brand" data-brand="Ford">Ford</button>
                    </div>
                </div>

                <!-- 3. Dòng xe Pill chips -->
                <div class="filter-group-divider">
                    <p class="filter-section-title">Dòng xe</p>
                    <div class="d-flex flex-wrap gap-2" id="typeChipsWrap">
                        <button type="button" class="recar-chip chip-type active" data-type="">Tất cả</button>
                        <button type="button" class="recar-chip chip-type" data-type="1">Xe mini đô thị</button>
                        <button type="button" class="recar-chip chip-type" data-type="2">Sedan 5 chỗ</button>
                        <button type="button" class="recar-chip chip-type" data-type="3">Crossover/SUV 7 chỗ</button>
                        <button type="button" class="recar-chip chip-type" data-type="4">MPV đa dụng</button>
                        <button type="button" class="recar-chip chip-type" data-type="5">Xe bán tải</button>
                    </div>
                </div>

                <!-- 4. Số chỗ Pill chips -->
                <div class="filter-group-divider">
                    <p class="filter-section-title">Số chỗ</p>
                    <div class="d-flex flex-wrap gap-2" id="seatChipsWrap">
                        <button type="button" class="recar-chip chip-seat active" data-seat="0">Tất cả</button>
                        <button type="button" class="recar-chip chip-seat" data-seat="5">5 chỗ</button>
                        <button type="button" class="recar-chip chip-seat" data-seat="7">7 chỗ</button>
                    </div>
                </div>

                <!-- 5. Nhiên liệu Pill chips -->
                <div class="filter-group-divider">
                    <p class="filter-section-title">Nhiên liệu</p>
                    <div class="d-flex flex-wrap gap-2" id="fuelChipsWrap">
                        <button type="button" class="recar-chip chip-fuel active" data-fuel="">Tất cả</button>
                        <button type="button" class="recar-chip chip-fuel" data-fuel="Xăng">Xăng</button>
                        <button type="button" class="recar-chip chip-fuel" data-fuel="Dầu">Dầu</button>
                        <button type="button" class="recar-chip chip-fuel" data-fuel="Điện">Điện</button>
                    </div>
                </div>

                <!-- Xóa bộ lọc -->
                <div>
                    <button type="button" id="resetFilterBtn" class="btn btn-link p-0 text-decoration-none fw-medium small" style="color: var(--recar-primary);">
                        Xóa bộ lọc
                    </button>
                </div>
            </aside>
        </div>

        <!-- Car Listing Area (Cột danh sách xe bên phải - Ảnh 5) -->
        <div class="col-lg-9 col-md-8">
            <!-- Dropdown sắp xếp bên phải -->
            <div class="d-flex justify-content-end mb-4">
                <select id="sortSelect" class="form-select form-select-sm rounded-3" style="width: auto; min-width: 140px; padding: 8px 12px; font-size: 14px; border: 1px solid var(--recar-border);">
                    <option value="featured">Phổ biến</option>
                    <option value="price-asc">Giá thấp đến cao</option>
                    <option value="price-desc">Giá cao đến thấp</option>
                    <option value="rating">Đánh giá cao</option>
                </select>
            </div>

            <!-- Grid Xe -->
            <div class="row g-4" id="carListContainer">
                @await Component.InvokeAsync("Product")
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            let minPrice = 500000;
            let maxPrice = 5000000;
            let selectedBrands = [];
            let selectedType = "";
            let selectedSeat = 0;
            let selectedFuel = "";
            let sortType = "featured";

            // Format VND
            function formatVND(num) {
                return num.toLocaleString('vi-VN') + 'đ';
            }

            function updatePriceUI() {
                $('#priceLabel').text('Từ ' + formatVND(minPrice) + ' đến ' + formatVND(maxPrice) + '/ngày');
                let minK = Math.round(minPrice / 1000) >= 1000 ? (minPrice / 1000000).toFixed(1).replace('.0','') + 'tr' : Math.round(minPrice / 1000) + 'k';
                let maxK = (maxPrice / 1000000).toFixed(1).replace('.0','') + 'tr';
                $('#priceRangeBadge').text(minK + ' - ' + maxK);
            }

            // Slider giá Min
            $('#minPriceSlider').on('input', function () {
                minPrice = parseInt($(this).val());
                if (minPrice > maxPrice) {
                    maxPrice = minPrice;
                    $('#maxPriceSlider').val(maxPrice);
                }
                updatePriceUI();
            });

            $('#minPriceSlider').on('change', function () {
                applyFilter();
            });

            // Slider giá Max
            $('#maxPriceSlider').on('input', function () {
                maxPrice = parseInt($(this).val());
                if (maxPrice < minPrice) {
                    minPrice = maxPrice;
                    $('#minPriceSlider').val(minPrice);
                }
                updatePriceUI();
            });

            $('#maxPriceSlider').on('change', function () {
                applyFilter();
            });

            // Chọn chip Hãng xe
            $('.chip-brand').on('click', function () {
                const brand = $(this).data('brand');
                $(this).toggleClass('active');
                if ($(this).hasClass('active')) {
                    if (!selectedBrands.includes(brand)) selectedBrands.push(brand);
                } else {
                    selectedBrands = selectedBrands.filter(b => b !== brand);
                }
                applyFilter();
            });

            // Chọn chip Dòng xe
            $('.chip-type').on('click', function () {
                $('.chip-type').removeClass('active');
                $(this).addClass('active');
                selectedType = $(this).data('type') || "";
                applyFilter();
            });

            // Chọn chip Số chỗ
            $('.chip-seat').on('click', function () {
                $('.chip-seat').removeClass('active');
                $(this).addClass('active');
                selectedSeat = parseInt($(this).data('seat') || 0);
                applyFilter();
            });

            // Chọn chip Nhiên liệu
            $('.chip-fuel').on('click', function () {
                $('.chip-fuel').removeClass('active');
                $(this).addClass('active');
                selectedFuel = $(this).data('fuel') || "";
                applyFilter();
            });

            // Sắp xếp
            $('#sortSelect').on('change', function () {
                sortType = $(this).val();
                applyFilter();
            });

            // Nút reset
            $('#resetFilterBtn').on('click', function () {
                minPrice = 500000;
                maxPrice = 5000000;
                $('#minPriceSlider').val(500000);
                $('#maxPriceSlider').val(5000000);
                updatePriceUI();
                selectedBrands = [];
                $('.chip-brand').removeClass('active');
                selectedType = "";
                $('.chip-type').removeClass('active');
                $('.chip-type[data-type=""]').addClass('active');
                selectedSeat = 0;
                $('.chip-seat').removeClass('active');
                $('.chip-seat[data-seat="0"]').addClass('active');
                selectedFuel = "";
                $('.chip-fuel').removeClass('active');
                $('.chip-fuel[data-fuel=""]').addClass('active');
                sortType = "featured";
                $('#sortSelect').val("featured");
                applyFilter();
            });

            var selectedDriveMode = "";

            // Chọn hình thức thuê (Tự lái / Có tài xế)
            $('.chip-drive-mode').on('click', function () {
                $('.chip-drive-mode').removeClass('active');
                $(this).addClass('active');
                selectedDriveMode = $(this).data('drive-mode') || "";
                $('#driveModeActiveBadge').text(selectedDriveMode ? selectedDriveMode : "Tất cả");
                updateCardLinks();
            });

            function updateCardLinks() {
                if (selectedDriveMode) {
                    $('#carListContainer a').each(function () {
                        var href = $(this).attr('href');
                        if (href && href.indexOf('/product') !== -1) {
                            var cleanHref = href.split('?')[0];
                            $(this).attr('href', cleanHref + '?driveMode=' + encodeURIComponent(selectedDriveMode));
                        }
                    });
                }
            }

            // Gửi AJAX filter
            function applyFilter() {
                let params = {
                    minPrice: minPrice,
                    maxPrice: maxPrice,
                    brands: selectedBrands.join(','),
                    TypeId: selectedType,
                    seats: selectedSeat,
                    fuel: selectedFuel,
                    sort: sortType
                };

                $.ajax({
                    url: '/Product/FilterProducts',
                    type: 'GET',
                    data: params,
                    beforeSend: function () {
                        $('#carListContainer').css('opacity', '0.6');
                    },
                    success: function (data) {
                        $('#carListContainer').html(data);
                        $('#carListContainer').css('opacity', '1');
                        updateCardLinks();
                    },
                    error: function () {
                        $('#carListContainer').css('opacity', '1');
                    }
                });
            }

            // Nhận TypeId & driveMode từ query param nếu có (từ Trang chủ tìm kiếm)
            const urlParams = new URLSearchParams(window.location.search);
            const queryTypeId = urlParams.get('TypeId');
            if (queryTypeId) {
                $('.chip-type').removeClass('active');
                $(`.chip-type[data-type="${queryTypeId}"]`).addClass('active');
                selectedType = queryTypeId;
            }

            const queryDriveMode = urlParams.get('driveMode');
            if (queryDriveMode) {
                $('.chip-drive-mode').removeClass('active');
                $(`.chip-drive-mode[data-drive-mode="${queryDriveMode}"]`).addClass('active');
                selectedDriveMode = queryDriveMode;
                $('#driveModeActiveBadge').text(queryDriveMode);
                updateCardLinks();
            }
        });
    </script>
}