@model CarRental.Models.Car
@using CarRental.Utilities
@{
    ViewData["Title"] = Model.CarName + " – Chi tiết thuê xe";
    List<CarRental.Models.Car> productRelated = ViewBag.productRelated ?? new List<CarRental.Models.Car>();
    List<CarRental.Models.CarReview> productReviews = ViewBag.productRviews ?? new List<CarRental.Models.CarReview>();

    string todayStr = DateTime.Now.ToString("yyyy-MM-dd");
    string nextDayStr = DateTime.Now.AddDays(2).ToString("yyyy-MM-dd");

    decimal finalPrice = (Model.SalePrice > 0 ? Model.SalePrice : Model.Price) ?? 0;
    string carImg = string.IsNullOrEmpty(Model.Image) ? "/images/cars/car-sedan.jpg" : Model.Image;
}

<!-- Breadcrumb Area Start -->
<div class="py-3 bg-light border-bottom mb-4">
    <div class="container" style="max-width: 1280px;">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb m-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-decoration-none">Thuê xe</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.CarName</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Breadcrumb Area End -->

<div class="container mb-5" style="max-width: 1280px;">
    <div class="row g-4">
        <!-- Cột trái: Thông tin chi tiết xe (8 cột) -->
        <div class="col-lg-8">
            <!-- Ảnh xe chính -->
            <div class="position-relative rounded-4 overflow-hidden mb-4 border shadow-sm" style="aspect-ratio: 16/10; background: #f8fafc;">
                <img src="@carImg" alt="@Model.CarName" class="w-100 h-100 object-fit-cover" id="mainCarImage" />
                @if (Model.IsSale)
                {
                    <span class="position-absolute top-0 start-0 m-3 badge bg-danger fs-6 px-3 py-2 shadow-sm">
                        <i class="bi bi-lightning-fill"></i> Đang ưu đãi
                    </span>
                }
            </div>

            <!-- Tiêu đề & Thông tin cơ bản -->
            <div class="mb-4">
                <span class="text-uppercase fw-bold text-muted small letter-spacing-1">@Model.CarBrand</span>
                <h1 class="fs-2 fw-bold text-dark mt-1 mb-2">@Model.CarName</h1>
                <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                    <span class="d-flex align-items-center gap-1 text-warning fw-bold">
                        <i class="bi bi-star-fill"></i> @(Model.Rate ?? 4.8)
                        <span class="text-muted fw-normal">(@(productReviews.Count) đánh giá)</span>
                    </span>
                    <span>·</span>
                    <span class="d-flex align-items-center gap-1">
                        <i class="bi bi-geo-alt-fill text-danger"></i> @(string.IsNullOrEmpty(Model.Descriptions) ? "Toàn quốc" : Model.Descriptions)
                    </span>
                    <span>·</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="bi bi-shield-check"></i> Đã kiểm định an toàn
                    </span>
                </div>
            </div>

            <!-- 4 Thông số chính dạng Card Icon -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <i class="bi bi-people-fill text-primary fs-4"></i>
                        <p class="small text-muted m-0 mt-1">Số chỗ ngồi</p>
                        <p class="fw-bold text-dark m-0">@(Model.Seat ?? 5) chỗ</p>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <i class="bi bi-gear-fill text-primary fs-4"></i>
                        <p class="small text-muted m-0 mt-1">Hộp số</p>
                        <p class="fw-bold text-dark m-0">Số tự động</p>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <i class="bi bi-fuel-pump-fill text-primary fs-4"></i>
                        <p class="small text-muted m-0 mt-1">Nhiên liệu</p>
                        <p class="fw-bold text-dark m-0">@(Model.CarBrand != null && Model.CarBrand.ToLower().Contains("vinfast") ? "Điện" : "Xăng / Dầu")</p>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <i class="bi bi-calendar3 text-primary fs-4"></i>
                        <p class="small text-muted m-0 mt-1">Năm sản xuất</p>
                        <p class="fw-bold text-dark m-0">Đời @(Model.Model ?? 2023)</p>
                    </div>
                </div>
            </div>

            <!-- Tiện nghi trên xe -->
            <div class="p-4 bg-white rounded-3 border mb-4 shadow-sm">
                <h3 class="fs-5 fw-bold text-dark mb-3"><i class="bi bi-stars text-primary me-2"></i>Tiện nghi trang bị trên xe</h3>
                <div class="row g-3 small">
                    <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i> Bản đồ định vị GPS
                    </div>
                    <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i> Camera lùi & Cảm biến
                    </div>
                    <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i> Kết nối Bluetooth / Apple CarPlay
                    </div>
                    <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i> Túi khí an toàn đa điểm
                    </div>
                    <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i> Khe cắm sạc USB / Type-C
                    </div>
                    <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success"></i> Lốp dự phòng & Bộ cứu hộ
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Details))
                {
                    <hr class="my-3 text-muted" />
                    <h5 class="fs-6 fw-bold text-dark mb-2">Mô tả chi tiết từ chủ xe:</h5>
                    <p class="text-secondary small m-0" style="line-height: 1.7;">@Model.Details</p>
                }
            </div>

            <!-- Giấy tờ & Điều kiện thuê xe -->
            <div class="p-4 bg-white rounded-3 border mb-4 shadow-sm">
                <h3 class="fs-5 fw-bold text-dark mb-3"><i class="bi bi-card-checklist text-primary me-2"></i>Thủ tục & Giấy tờ cần chuẩn bị</h3>
                <div class="alert alert-info d-flex align-items-start gap-2 mb-0 py-2 small">
                    <i class="bi bi-info-circle-fill fs-5 mt-1"></i>
                    <div>
                        <strong>Yêu cầu bắt buộc khi nhận bàn giao xe:</strong>
                        <ul class="mb-0 ps-3 mt-1">
                            <li>Căn cước công dân (CCCD) gắn chip hoặc Hộ chiếu còn hạn.</li>
                            <li>Giấy phép lái xe ô tô hạng B1/B2 trở lên (bản gốc để chủ xe đối chiếu).</li>
                            <li>Thanh toán khoản tiền thuê 70% còn lại và hoàn tất ký Hợp đồng điện tử.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Đánh giá nhận xét của khách hàng -->
            <div class="p-4 bg-white rounded-3 border mb-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fs-5 fw-bold text-dark m-0"><i class="bi bi-chat-heart text-primary me-2"></i>Đánh giá từ khách hàng</h3>
                    <span class="badge bg-primary px-3 py-2 fw-semibold">@(productReviews.Count) Đánh giá</span>
                </div>

                @if (productReviews != null && productReviews.Any())
                {
                    <div class="d-flex flex-column gap-3 mb-4">
                        @foreach (var r in productReviews)
                        {
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark small">@r.Name</span>
                                    <div class="text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= (r.Star ?? 5))
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                </div>
                                <p class="text-muted small m-0">@r.Detail</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-4">Xe chưa có đánh giá nào. Hãy là người đầu tiên trải nghiệm và để lại nhận xét!</p>
                }

                <!-- Form gửi đánh giá mới -->
                <div class="pt-3 border-top">
                    <h5 class="fs-6 fw-bold text-dark mb-3">Gửi đánh giá trải nghiệm của bạn</h5>
                    <form asp-controller="Product" asp-action="Reviews" method="post" class="row g-2">
                        <input type="hidden" name="id" value="@Model.CarId" />
                        <div class="col-md-6">
                            <input type="text" name="name" class="form-control form-control-sm" placeholder="Họ và tên của bạn" required />
                        </div>
                        <div class="col-md-6">
                            <input type="email" name="email" class="form-control form-control-sm" placeholder="Email nhận phản hồi" required />
                        </div>
                        <div class="col-12">
                            <select name="star" class="form-select form-select-sm">
                                <option value="5">⭐⭐⭐⭐⭐ Rất hài lòng (5 sao)</option>
                                <option value="4">⭐⭐⭐⭐ Hài lòng (4 sao)</option>
                                <option value="3">⭐⭐⭐ Bình thường (3 sao)</option>
                                <option value="2">⭐⭐ Không hài lòng (2 sao)</option>
                                <option value="1">⭐ Thất vọng (1 sao)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <textarea name="detail" rows="2" class="form-control form-control-sm" placeholder="Chia sẻ cảm nhận về tình trạng xe, độ sạch sẽ, thái độ chủ xe..." required></textarea>
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-sm btn-outline-primary fw-semibold px-4">Gửi nhận xét</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột phải: Sticky Booking Widget (4 cột) -->
        <div class="col-lg-4">
            <div class="card p-4 border rounded-4 shadow-sm sticky-top" style="top: 90px; background: #ffffff;">
                <!-- Giá xe -->
                <div class="mb-3 pb-3 border-bottom">
                    <span class="text-muted small">Giá thuê xe</span>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="fs-2 fw-bold text-primary">@finalPrice.ToString("N0")đ</span>
                        <span class="text-muted fw-normal">/ ngày</span>
                    </div>
                    @if (Model.SalePrice > 0)
                    {
                        <span class="text-muted text-decoration-line-through small">@((Model.Price ?? 0).ToString("N0"))đ/ngày</span>
                    }
                </div>

                <!-- Form Đặt xe sang Cart -->
                <form asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.CarId" method="post" id="detailBookingForm">
                    <input type="hidden" name="quantity" value="1" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark"><i class="bi bi-calendar-event text-primary me-1"></i> Ngày nhận xe</label>
                        <input type="date" class="form-control form-control-sm" id="detailPickupDate" name="pickupDate" min="@todayStr" value="@todayStr" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark"><i class="bi bi-calendar-check text-primary me-1"></i> Ngày trả xe</label>
                        <input type="date" class="form-control form-control-sm" id="detailReturnDate" name="returnDate" min="@todayStr" value="@nextDayStr" required />
                    </div>

                    <!-- Bảng tính tự động tài chính -->
                    <div class="p-3 bg-light rounded-3 mb-3 border small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Thời gian thuê:</span>
                            <span class="fw-bold text-dark" id="rentalDaysText">2 ngày</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tổng tiền thuê:</span>
                            <span class="fw-bold text-dark" id="totalPriceText">@((finalPrice * 2).ToString("N0"))đ</span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-bold text-primary">Tiền đặt cọc giữ chỗ (30%):</span>
                            <span class="fw-bold text-primary fs-6" id="depositPriceText">@((finalPrice * 2 * 0.3m).ToString("N0"))đ</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted" style="font-size: 0.78rem;">
                            <span>Thanh toán khi nhận xe (70%):</span>
                            <span id="remainPriceText">@((finalPrice * 2 * 0.7m).ToString("N0"))đ</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2 fw-bold text-dark fs-6 rounded-3 shadow-sm mb-2">
                        <i class="bi bi-credit-card me-1"></i> Tiến hành đặt cọc giữ xe
                    </button>
                    
                    <p class="text-muted text-center m-0" style="font-size: 0.75rem;">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Đặt cọc 30% trực tuyến an toàn qua cổng VNPay.
                    </p>
                </form>
            </div>
        </div>
    </div>

    <!-- Xe tương tự -->
    @if (productRelated != null && productRelated.Any())
    {
        <div class="mt-5 pt-4 border-top">
            <h3 class="fs-4 fw-bold text-dark mb-4">Các mẫu xe tương tự cùng phân khúc</h3>
            <div class="row g-4">
                @foreach (var car in productRelated.Take(4))
                {
                    string carUrl = $"/product/{car.Alias}-{car.CarId}.html";
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="recar-car-card h-100">
                            <div class="recar-card-img-wrap">
                                <a href="@carUrl">
                                    <img src="@(string.IsNullOrEmpty(car.Image) ? "/images/cars/car-sedan.jpg" : car.Image)" alt="@car.CarName" class="recar-card-img" />
                                </a>
                            </div>
                            <div class="recar-card-body">
                                <div class="recar-card-brand">@car.CarBrand</div>
                                <a href="@carUrl" class="recar-card-title">@car.CarName</a>
                                <div class="recar-card-location">
                                    <i class="bi bi-geo-alt-fill text-danger"></i> @(string.IsNullOrEmpty(car.Descriptions) ? "Toàn quốc" : car.Descriptions)
                                </div>
                                <div class="recar-card-footer">
                                    <div class="recar-price-main">@(((car.SalePrice > 0 ? car.SalePrice : car.Price) ?? 0).ToString("N0"))đ</div>
                                    <a href="@carUrl" class="btn-card-rent">Xem xe</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            var unitPrice = @finalPrice;

            function calculateTotals() {
                var pickup = new Date($('#detailPickupDate').val());
                var returnD = new Date($('#detailReturnDate').val());

                if (returnD <= pickup) {
                    returnD = new Date(pickup);
                    returnD.setDate(returnD.getDate() + 1);
                    var yyyy = returnD.getFullYear();
                    var mm = String(returnD.getMonth() + 1).padStart(2, '0');
                    var dd = String(returnD.getDate()).padStart(2, '0');
                    $('#detailReturnDate').val(yyyy + '-' + mm + '-' + dd);
                }

                var diffTime = Math.abs(returnD - pickup);
                var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                if (diffDays < 1) diffDays = 1;

                var total = unitPrice * diffDays;
                var deposit = total * 0.3;
                var remain = total - deposit;

                $('#rentalDaysText').text(diffDays + ' ngày');
                $('#totalPriceText').text(total.toLocaleString('vi-VN') + 'đ');
                $('#depositPriceText').text(deposit.toLocaleString('vi-VN') + 'đ');
                $('#remainPriceText').text(remain.toLocaleString('vi-VN') + 'đ');
            }

            $('#detailPickupDate, #detailReturnDate').on('change', calculateTotals);
            calculateTotals();
        });
    </script>
}