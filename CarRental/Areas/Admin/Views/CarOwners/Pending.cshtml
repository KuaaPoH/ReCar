@model IEnumerable<CarRental.Models.CarOwnerRegistration>
@{
    ViewData["Title"] = "Duyệt hồ sơ Đối tác Chủ xe";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    int pendingCount = ViewBag.PendingCount ?? 0;
    string? searchQuery = ViewBag.SearchQuery as string;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h4 class="fw-bold mb-1" style="color: #0f172a;">
            <i class="bi bi-person-check-fill text-primary me-2"></i> Duyệt hồ sơ Đối tác Chủ xe
        </h4>
        <div class="text-muted small">Kiểm tra thông tin định danh (CCCD), giấy phép lái xe (GPLX) và tài khoản ngân hàng thụ hưởng.</div>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-semibold">
            <i class="bi bi-clock-history me-1"></i> Có <strong>@pendingCount</strong> hồ sơ đang chờ duyệt
        </span>
    </div>
</div>

<!-- Thanh tìm kiếm & Bộ lọc -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="q" value="@searchQuery" class="form-control border-start-0" placeholder="Tìm theo tên, SĐT, email, CCCD, GPLX..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary rounded-3 w-100 fw-semibold" style="background-color: #0284c7; border: none;">
                    <i class="bi bi-funnel me-1"></i> Lọc hồ sơ
                </button>
            </div>
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <div class="col-auto">
                    <a asp-action="Pending" class="btn btn-light border rounded-3 text-secondary small">
                        <i class="bi bi-x-circle me-1"></i> Xóa lọc
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Bảng danh sách hồ sơ -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
            <thead class="bg-light text-secondary">
                <tr>
                    <th class="ps-3 py-3">Mã & Thời gian</th>
                    <th class="py-3">Họ và tên / Liên hệ</th>
                    <th class="py-3">Định danh CCCD</th>
                    <th class="py-3">Bằng lái xe (GPLX)</th>
                    <th class="py-3">Ngân hàng thụ hưởng</th>
                    <th class="py-3 text-center">Trạng thái</th>
                    <th class="pe-3 py-3 text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-folder2-open fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            Không có hồ sơ nào khớp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="badge bg-light text-dark border font-monospace mb-1">#DKCX-@item.Id</span>
                                <div class="text-muted" style="font-size: 11px;">@item.CreatedAt.ToString("HH:mm dd/MM/yy")</div>
                            </td>

                            <td>
                                <div class="fw-bold text-dark">@item.FullName</div>
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@item.Phone</div>
                                <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@item.Email</div>
                                @if (!string.IsNullOrEmpty(item.Address))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 180px;" title="@item.Address"><i class="bi bi-geo-alt me-1"></i>@item.Address</div>
                                }
                            </td>

                            <td>
                                <div class="fw-semibold font-monospace text-dark">@item.IdCard</div>
                                <div class="text-muted" style="font-size: 11px;">Nơi cấp: @(string.IsNullOrEmpty(item.IdCardIssuePlace) ? "Cục CS QLHC" : item.IdCardIssuePlace)</div>
                                <div class="d-flex gap-1 mt-1">
                                    @if (!string.IsNullOrEmpty(item.IdCardFrontImage))
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-1.5" style="font-size: 11px;" onclick="viewImageModal('/files/KYC/@item.IdCardFrontImage', 'Mặt trước CCCD: @item.FullName')">
                                            <i class="bi bi-card-image"></i> Trước
                                        </button>
                                    }
                                    @if (!string.IsNullOrEmpty(item.IdCardBackImage))
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-1.5" style="font-size: 11px;" onclick="viewImageModal('/files/KYC/@item.IdCardBackImage', 'Mặt sau CCCD: @item.FullName')">
                                            <i class="bi bi-card-image"></i> Sau
                                        </button>
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="fw-semibold font-monospace text-dark">@item.LicenseNumber</div>
                                <span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size: 11px;">Hạng: @item.LicenseClass</span>
                                @if (!string.IsNullOrEmpty(item.LicenseImage))
                                {
                                    <div class="mt-1">
                                        <button type="button" class="btn btn-outline-info btn-sm py-0 px-1.5" style="font-size: 11px;" onclick="viewImageModal('/files/KYC/@item.LicenseImage', 'Ảnh GPLX: @item.FullName')">
                                            <i class="bi bi-person-vcard"></i> Xem ảnh GPLX
                                        </button>
                                    </div>
                                }
                            </td>

                            <td>
                                <div class="fw-bold text-dark">@item.BankName</div>
                                <div class="text-primary font-monospace fw-semibold">@item.AccountNumber</div>
                                <div class="text-muted" style="font-size: 11px;">Chủ TK: @item.AccountHolder</div>
                            </td>

                            <td class="text-center">
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1.5 rounded-pill">
                                        <i class="bi bi-clock-history me-1"></i> Chờ duyệt
                                    </span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill">
                                        <i class="bi bi-check-circle me-1"></i> Đã duyệt
                                    </span>
                                    <div class="text-muted" style="font-size: 10px; margin-top: 2px;">@item.ApprovedAt?.ToString("dd/MM HH:mm")</div>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill" title="@item.RejectReason">
                                        <i class="bi bi-x-circle me-1"></i> Bị từ chối
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.RejectReason))
                                    {
                                        <div class="text-danger text-truncate" style="font-size: 10.5px; max-width: 120px;" title="@item.RejectReason">@item.RejectReason</div>
                                    }
                                }
                            </td>

                            <td class="pe-3 text-end">
                                @if (item.Status == "Pending")
                                {
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-success btn-sm rounded-start-pill px-3 py-1.5 fw-semibold" onclick="approveOwner(@item.Id, '@item.FullName')">
                                            <i class="bi bi-check-lg me-1"></i> Duyệt
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-end-pill px-2.5 py-1.5 fw-semibold" onclick="openRejectModal(@item.Id, '@item.FullName')">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Đã xử lý</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal xem ảnh lớn -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="imageModalTitle">Xem tài liệu pháp lý</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <img id="imageModalSrc" src="" class="img-fluid rounded-3 shadow-sm" style="max-height: 520px; object-fit: contain;" alt="Hình ảnh tài liệu" />
            </div>
        </div>
    </div>
</div>

<!-- Modal từ chối hồ sơ -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom">
                <h6 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle-fill me-1"></i> Từ chối hồ sơ đăng ký Chủ xe</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-3">Vui lòng nhập lý do từ chối cụ thể để thông báo cho đối tác <strong id="rejectOwnerName" class="text-dark"></strong>:</p>
                <input type="hidden" id="rejectId" />
                <textarea id="rejectReasonInput" class="form-control rounded-3" rows="3" placeholder="Ví dụ: Ảnh chụp CCCD bị mờ không đọc được số, hoặc Số tài khoản không trùng khớp tên chủ xe..."></textarea>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold" onclick="submitReject()">Xác nhận từ chối</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function viewImageModal(src, title) {
        document.getElementById('imageModalSrc').src = src;
        document.getElementById('imageModalTitle').innerText = title;
        new bootstrap.Modal(document.getElementById('imageModal')).show();
    }

    function approveOwner(id, name) {
        Swal.fire({
            title: 'Phê duyệt đối tác?',
            html: `Xác nhận phê duyệt hồ sơ của <b>${name}</b> thành Đối tác Chủ xe chính thức?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#10b981',
            cancelButtonColor: '#64748b',
            confirmButtonText: '<i class="bi bi-check2"></i> Đồng ý duyệt',
            cancelButtonText: 'Đóng'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Admin/CarOwners/Approve',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: getAntiForgeryToken()
                    },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire('Thành công!', res.message, 'success').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi!', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra khi gửi yêu cầu tới máy chủ.', 'error');
                    }
                });
            }
        });
    }

    function openRejectModal(id, name) {
        document.getElementById('rejectId').value = id;
        document.getElementById('rejectOwnerName').innerText = name;
        document.getElementById('rejectReasonInput').value = '';
        new bootstrap.Modal(document.getElementById('rejectModal')).show();
    }

    function submitReject() {
        var id = document.getElementById('rejectId').value;
        var reason = document.getElementById('rejectReasonInput').value.trim();

        if (!reason) {
            Swal.fire('Lưu ý', 'Vui lòng nhập lý do từ chối.', 'warning');
            return;
        }

        $.ajax({
            url: '/Admin/CarOwners/Reject',
            type: 'POST',
            data: {
                id: id,
                reason: reason,
                __RequestVerificationToken: getAntiForgeryToken()
            },
            success: function (res) {
                if (res.success) {
                    Swal.fire('Đã từ chối', res.message, 'info').then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Lỗi!', res.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Lỗi!', 'Có lỗi xảy ra khi gửi yêu cầu.', 'error');
            }
        });
    }
</script>
}
