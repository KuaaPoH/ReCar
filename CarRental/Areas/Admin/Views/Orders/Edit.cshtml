@model CarRental.Models.CarRentalOrder
@{
    ViewData["Title"] = $"Đơn thuê #RC-{Model.OrderId}";
    var detail = Model.OrderDetails != null && Model.OrderDetails.Count > 0 ? Model.OrderDetails.FirstOrDefault() : null;
    var car = detail?.Car;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle p-2 text-muted me-1">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Chi tiết & Cập nhật Đơn #RC-@Model.OrderId</h1>
            </div>
            <p class="text-muted small mb-0 mt-1 ms-5">Xem thông tin hợp đồng thuê xe và cập nhật trạng thái đơn hàng.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill px-3 border">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Thông tin xe & khách hàng -->
        <div class="col-12 col-xl-7">
            <div class="recar-panel mb-4">
                <div class="recar-panel-header">
                    <h2 class="h6 fw-bold mb-0 text-dark">
                        <i class="bi bi-car-front text-primary me-2"></i> Thông tin xe & Lịch thuê
                    </h2>
                    <span class="font-mono-plate">#RC-@Model.OrderId</span>
                </div>
                <div class="p-4">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <img src="@(car?.Image ?? "/images/cars/car-sedan.jpg")" alt="Car" class="rounded-3 object-fit-cover shadow-sm" style="width: 100px; height: 70px;" />
                        <div>
                            <h5 class="fw-bold text-dark mb-1">@(car?.CarName ?? "Thuê xe tự lái ReCar")</h5>
                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <span class="font-mono-plate">@(car?.LicensePlate ?? "Đang cập nhật")</span>
                                <span>·</span>
                                <span>@(car?.CarBrand ?? "ReCar")</span>
                                <span>·</span>
                                <span>@(car?.Seat ?? 5) chỗ</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Ngày nhận xe:</span>
                            <div class="fw-bold text-dark mt-0.5">@(Model.OrderDate?.ToString("dd/MM/yyyy") ?? "Hôm nay")</div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Ngày hoàn trả:</span>
                            <div class="fw-bold text-dark mt-0.5">@(Model.ReturnDate?.ToString("dd/MM/yyyy") ?? "Chưa trả")</div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Tiền cọc 30% giữ qua sàn:</span>
                            <div class="fw-bold text-primary mt-0.5">@((Model.Deposit ?? 0).ToString("N0")) đ</div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Số tiền thanh toán 70%:</span>
                            <div class="fw-bold text-dark mt-0.5">@((Model.Payment ?? 0).ToString("N0")) đ</div>
                        </div>
                        <div class="col-12">
                            <span class="text-muted small" style="font-size: 0.75rem;">Ghi chú hợp đồng:</span>
                            <div class="p-2.5 rounded-3 bg-light border text-dark small mt-1">
                                @(string.IsNullOrEmpty(Model.Notes) ? "Không có ghi chú thêm." : Model.Notes)
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Khách hàng -->
            <div class="recar-panel mb-0">
                <div class="recar-panel-header">
                    <h2 class="h6 fw-bold mb-0 text-dark">
                        <i class="bi bi-person text-info me-2"></i> Thông tin khách thuê xe
                    </h2>
                </div>
                <div class="p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="text-muted small">Họ và tên:</span>
                            <div class="fw-bold text-dark">@(Model.Customer?.Name ?? "Khách hàng")</div>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small">Số điện thoại:</span>
                            <div class="fw-bold text-dark"><i class="bi bi-telephone text-primary me-1"></i>@(Model.Customer?.PhoneNumber ?? "09xx.xxx.xxx")</div>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small">Email:</span>
                            <div class="text-dark small">@(Model.Customer?.Email ?? "Chưa cập nhật")</div>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small">Địa chỉ liên hệ:</span>
                            <div class="text-dark small">@(Model.Customer?.Address ?? "Hà Nội / TP.HCM")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cập nhật trạng thái đơn -->
        <div class="col-12 col-xl-5">
            <div class="recar-panel mb-0">
                <div class="recar-panel-header">
                    <h2 class="h6 fw-bold mb-0 text-dark">
                        <i class="bi bi-sliders text-success me-2"></i> Cập nhật trạng thái đơn
                    </h2>
                </div>
                <div class="p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="OrderId" />
                        <input type="hidden" asp-for="CustomerId" />
                        <input type="hidden" asp-for="OrderDate" />
                        <input type="hidden" asp-for="ReturnDate" />
                        <input type="hidden" asp-for="Deposit" />
                        <input type="hidden" asp-for="Payment" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-dark">Trạng thái hợp đồng <span class="text-danger">*</span></label>
                            <select asp-for="StatusId" class="form-select rounded-3" asp-items="ViewBag.OrderStatuses"></select>
                            <span asp-validation-for="StatusId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-dark">Ghi chú xử lý của Quản trị viên</label>
                            <textarea asp-for="Notes" class="form-control rounded-3" rows="4" placeholder="Nhập ghi chú hoặc lý do thay đổi trạng thái..."></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-light btn-sm flex-grow-1 rounded-pill">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary btn-sm flex-grow-1 rounded-pill fw-semibold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                                <i class="bi bi-check2 me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>