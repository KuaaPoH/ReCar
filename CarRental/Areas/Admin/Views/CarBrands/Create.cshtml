@model CarRental.Models.CarBrand
@{
    ViewData["Title"] = "Thêm hãng xe mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 1050px;">
    <!-- Header chuẩn Admin ReCar -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle p-2 text-muted me-1 shadow-xs" title="Quay lại danh sách">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Thêm hãng xe mới</h1>
                <span class="badge bg-light text-primary border font-monospace">+ Khởi tạo</span>
            </div>
            <p class="text-muted small mb-0 mt-1 ms-5">Thêm thương hiệu ô tô mới vào hệ thống phục vụ bộ lọc tìm kiếm và đăng ký xe của đối tác.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3.5 py-1.5 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post" id="createCarBrandForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

        <div class="row g-4">
            <!-- Cột trái: Thông tin chính của hãng xe -->
            <div class="col-lg-7">
                <div class="recar-panel p-4 mb-4 shadow-sm border rounded-4 bg-white">
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-tag-fill text-primary me-2"></i> Thông tin thương hiệu
                        </h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small">
                            Thương hiệu mới
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BrandName" class="form-label fw-semibold small text-dark">
                            Tên hãng xe / Thương hiệu <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                <i class="bi bi-patch-check"></i>
                            </span>
                            <input asp-for="BrandName" class="form-control border-start-0 rounded-end-3" placeholder="VD: Toyota, Porsche, Lexus, BMW, Mercedes-Benz, Audi, VinFast..." required autofocus />
                        </div>
                        <span asp-validation-for="BrandName" class="text-danger small"></span>
                        <div class="form-text small text-muted">Tên thương hiệu sẽ hiển thị trong bộ lọc của khách thuê và form đăng ký xe của Chủ xe.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Country" class="form-label fw-semibold small text-dark">Quốc gia xuất xứ / Trụ sở chính</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                <i class="bi bi-geo-alt"></i>
                            </span>
                            <input asp-for="Country" class="form-control border-start-0 rounded-end-3" placeholder="VD: Nhật Bản, Hàn Quốc, Việt Nam, Đức, Mỹ..." id="countryInput" />
                        </div>
                        <span asp-validation-for="Country" class="text-danger small"></span>
                        <!-- Gợi ý nhanh các quốc gia phổ biến -->
                        <div class="d-flex flex-wrap gap-1.5 mt-2">
                            <span class="small text-muted me-1">Gợi ý nhanh:</span>
                            <button type="button" class="badge bg-light text-dark border border-dashed rounded-pill text-decoration-none py-1 px-2 btn-quick-country" onclick="selectCountry('Việt Nam')">Việt Nam</button>
                            <button type="button" class="badge bg-light text-dark border border-dashed rounded-pill text-decoration-none py-1 px-2 btn-quick-country" onclick="selectCountry('Nhật Bản')">Nhật Bản</button>
                            <button type="button" class="badge bg-light text-dark border border-dashed rounded-pill text-decoration-none py-1 px-2 btn-quick-country" onclick="selectCountry('Hàn Quốc')">Hàn Quốc</button>
                            <button type="button" class="badge bg-light text-dark border border-dashed rounded-pill text-decoration-none py-1 px-2 btn-quick-country" onclick="selectCountry('Đức')">Đức</button>
                            <button type="button" class="badge bg-light text-dark border border-dashed rounded-pill text-decoration-none py-1 px-2 btn-quick-country" onclick="selectCountry('Mỹ')">Mỹ</button>
                            <button type="button" class="badge bg-light text-dark border border-dashed rounded-pill text-decoration-none py-1 px-2 btn-quick-country" onclick="selectCountry('Anh')">Anh</button>
                            <button type="button" class="badge bg-light text-dark border border-dashed rounded-pill text-decoration-none py-1 px-2 btn-quick-country" onclick="selectCountry('Pháp')">Pháp</button>
                            <button type="button" class="badge bg-light text-dark border border-dashed rounded-pill text-decoration-none py-1 px-2 btn-quick-country" onclick="selectCountry('Trung Quốc')">Trung Quốc</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold small text-dark">Thứ tự ưu tiên hiển thị</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                <i class="bi bi-sort-numeric-down"></i>
                            </span>
                            <input asp-for="DisplayOrder" type="number" min="0" max="999" class="form-control border-start-0 rounded-end-3" placeholder="VD: 1, 2, 3..." />
                        </div>
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                        <div class="form-text small text-muted">Số nhỏ hơn sẽ được ưu tiên hiển thị trước trong danh sách chọn và bộ lọc.</div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mt-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle text-primary fs-5"></i>
                            <div class="small text-muted">
                                Sau khi thêm mới, hãng xe sẽ tự động đồng bộ vào bộ lọc của khách thuê và menu chọn hãng xe của Đối tác Chủ xe.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Trạng thái & Hành động -->
            <div class="col-lg-5">
                <div class="recar-panel p-4 mb-4 shadow-sm border rounded-4 bg-white">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-sliders text-success me-2"></i> Trạng thái & Hành động
                    </h6>

                    <div class="form-check form-switch mb-3 p-3 bg-light rounded-3 border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsActive" id="switchBrandActive" checked />
                        <label class="form-check-label fw-semibold small text-dark" for="switchBrandActive">
                            Kích hoạt hiển thị công khai
                        </label>
                        <div class="form-text small text-muted mt-1">Khi bật, hãng xe sẽ sẵn sàng cho Chủ xe đăng ký và Khách hàng tìm kiếm.</div>
                    </div>

                    <div class="p-3 bg-light rounded-3 small text-muted mb-4 border">
                        <div class="d-flex justify-content-between mb-1.5">
                            <span>Phân loại:</span>
                            <strong class="text-dark">Hãng xe ReCar</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1.5">
                            <span>Quyền hạn:</span>
                            <span class="text-dark fw-semibold">Quản trị viên (Admin)</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Đồng bộ:</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5">Tự động toàn sàn</span>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                            <i class="bi bi-check2-circle me-1.5"></i> Hoàn tất & Lưu hãng xe
                        </button>
                        <a asp-action="Index" class="btn btn-light w-100 rounded-pill py-2 text-muted fw-semibold border">
                            Hủy bỏ & Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function selectCountry(country) {
            document.getElementById('countryInput').value = country;
        }
    </script>
}

