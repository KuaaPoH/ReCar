@model IList<CarRental.Models.Customer>
@{
    ViewData["Title"] = "Người dùng & đối tác";
    string currentFilter = ViewBag.FilterType as string ?? "all";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Quản lý Người dùng & Đối tác</h1>
                <span class="badge bg-light text-dark border rounded-pill fw-semibold px-2.5 py-1">@Model.Count tài khoản</span>
            </div>
            <p class="text-muted small mb-0 mt-1">Danh sách toàn bộ tài khoản người dùng, đối tác chủ xe và phân quyền quản trị viên trên hệ thống ReCar.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                <i class="bi bi-person-plus me-1"></i> Thêm tài khoản mới
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-3 alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3 alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter & Tabs Bar -->
    <div class="recar-panel mb-4 p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 10px; font-size: 0.85rem;"></i>
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control form-control-sm ps-5 rounded-3" placeholder="Tìm theo họ tên, email, tên đăng nhập, số điện thoại..." />
                </div>
            </div>
            <div class="col-6 col-md-4">
                <select name="filterType" class="form-select form-select-sm rounded-3">
                    <option value="" selected="@(string.IsNullOrEmpty(currentFilter) || currentFilter == "all")">-- Tất cả vai trò người dùng --</option>
                    <option value="customer" selected="@(currentFilter == "customer")">Khách hàng thuê xe (Role 2)</option>
                    <option value="carowner" selected="@(currentFilter == "carowner")">Chủ xe đối tác (Role 3)</option>
                    <option value="banned" selected="@(currentFilter == "banned")">Tài khoản đang bị khóa</option>
                </select>
            </div>
            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm rounded-3 flex-grow-1" style="background-color: var(--recar-primary); border: none;">
                    <i class="bi bi-funnel"></i> Lọc tài khoản
                </button>
                <a asp-action="Index" class="btn btn-light btn-sm rounded-3 border" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Data Table Panel -->
    <div class="recar-panel mb-0">
        <div class="table-responsive">
            <table class="table recar-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Email liên hệ</th>
                        <th>Số điện thoại</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Đăng nhập cuối</th>
                        <th class="text-end" style="width: 80px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-2 text-secondary d-block mb-2"></i>
                                Không tìm thấy tài khoản người dùng nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var name = item.FullName ?? item.Name ?? item.Username ?? "User";
                            var initials = name.Length >= 2 ? name.Substring(0, 2).ToUpper() : "US";
                            var isLocked = item.IsActive == false;

                            <tr id="row-user-@item.CustomerId">
                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center fw-bold text-dark border shadow-xs" style="width: 38px; height: 38px; font-size: 0.8rem; background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);">
                                            @initials
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@item.CustomerId" class="fw-bold small text-dark text-decoration-none hover-primary">
                                                @name
                                            </a>
                                            <div class="text-muted" style="font-size: 0.72rem;">@@@item.Username · #@item.CustomerId</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted">@item.Email</span>
                                </td>
                                <td>
                                    <span class="small text-muted">@(string.IsNullOrEmpty(item.Phone) ? (string.IsNullOrEmpty(item.PhoneNumber) ? "Chưa cập nhật" : item.PhoneNumber) : item.Phone)</span>
                                </td>
                                <td>
                                    @if (item.RoleId == 1)
                                    {
                                        <span class="badge rounded-pill fw-semibold" style="background-color: #fee2e2; color: #991b1b; font-size: 0.75rem;">
                                            <i class="bi bi-shield-lock-fill me-1"></i> Quản trị viên
                                        </span>
                                    }
                                    else if (item.RoleId == 3)
                                    {
                                        <span class="badge rounded-pill fw-semibold" style="background-color: #e0f2fe; color: #0369a1; font-size: 0.75rem;">
                                            <i class="bi bi-person-badge-fill me-1"></i> Chủ xe đối tác
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill fw-semibold" style="background-color: #f1f5f9; color: #475569; font-size: 0.75rem;">
                                            <i class="bi bi-person-fill me-1"></i> Khách hàng
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.RoleId == 1)
                                    {
                                        <span class="badge rounded-pill fw-semibold bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                                            <i class="bi bi-shield-check me-1"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" 
                                                id="btn-status-user-@item.CustomerId"
                                                onclick="toggleUserLock(@item.CustomerId, '@Html.Raw(name.Replace("'", "\\'"))', @(isLocked ? "true" : "false"))"
                                                class="btn btn-sm rounded-pill px-2.5 py-0.5 fw-semibold border shadow-xs d-inline-flex align-items-center gap-1.5 @(isLocked ? "btn-light text-danger border-danger-subtle" : "btn-success-subtle text-success border-success-subtle")"
                                                style="font-size: 0.75rem;"
                                                title="Bấm để @(isLocked ? "mở khóa" : "khóa") tài khoản">
                                            <i class="bi @(isLocked ? "bi-lock-fill text-danger" : "bi-check-circle-fill text-success")"></i>
                                            <span class="status-text">@(isLocked ? "Đã khóa" : "Hoạt động")</span>
                                        </button>
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">@(item.LastLogin ?? "Chưa ghi nhận")</span>
                                </td>
                                <td class="text-end">
                                    @if (item.RoleId == 1)
                                    {
                                        <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-light border rounded-pill px-2.5 py-1 text-muted" title="Xem thông tin Admin">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-sm btn-light border-0 rounded-circle p-1.5 shadow-none text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Tác vụ">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 py-1 font-monospace-normal" style="min-width: 180px; font-size: 0.85rem;">
                                                <li>
                                                    <a asp-action="Details" asp-route-id="@item.CustomerId" class="dropdown-item py-2 d-flex align-items-center gap-2">
                                                        <i class="bi bi-person-badge text-primary"></i> Xem hồ sơ chi tiết
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-action="Edit" asp-route-id="@item.CustomerId" class="dropdown-item py-2 d-flex align-items-center gap-2">
                                                        <i class="bi bi-pencil-square text-secondary"></i> Chỉnh sửa tài khoản
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider my-1"></li>
                                                <li>
                                                    <a href="javascript:void(0)" 
                                                       id="menu-lock-user-@item.CustomerId"
                                                       onclick="toggleUserLock(@item.CustomerId, '@Html.Raw(name.Replace("'", "\\'"))', @(isLocked ? "true" : "false"))"
                                                       class="dropdown-item py-2 d-flex align-items-center gap-2 @(isLocked ? "text-success" : "text-danger")">
                                                        <i class="bi @(isLocked ? "bi-unlock" : "bi-lock")"></i> 
                                                        <span class="menu-lock-text">@(isLocked ? "Mở khóa tài khoản" : "Khóa tài khoản")</span>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true
        });

        // AJAX Toggle Lock Account
        function toggleUserLock(id, name, isCurrentlyLocked) {
            const actionText = isCurrentlyLocked ? "mở khóa" : "khóa";
            const confirmBtnText = isCurrentlyLocked ? "Mở khóa ngay" : "Khóa tài khoản";
            const confirmColor = isCurrentlyLocked ? "#10b981" : "#ef4444";

            Swal.fire({
                title: `Xác nhận ${actionText}?`,
                html: `Bạn có chắc chắn muốn <b>${actionText}</b> quyền truy cập của tài khoản <b>${name}</b>?`,
                icon: isCurrentlyLocked ? 'question' : 'warning',
                showCancelButton: true,
                confirmButtonColor: confirmColor,
                cancelButtonColor: '#64748b',
                confirmButtonText: confirmBtnText,
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    const $btn = $(`#btn-status-user-${id}`);
                    const $menuItem = $(`#menu-lock-user-${id}`);
                    $btn.prop('disabled', true);

                    $.ajax({
                        url: '/Admin/UserManagement/ToggleLock/' + id,
                        type: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        success: function (res) {
                            $btn.prop('disabled', false);
                            if (res && res.success) {
                                Toast.fire({
                                    icon: 'success',
                                    title: res.message
                                });

                                const isNowActive = res.isActive;
                                const isNowLocked = !isNowActive;

                                // Update status pill button
                                if (isNowLocked) {
                                    $btn.removeClass('btn-success-subtle text-success border-success-subtle')
                                        .addClass('btn-light text-danger border-danger-subtle')
                                        .attr('title', 'Bấm để mở khóa tài khoản');
                                    $btn.find('i').removeClass('bi-check-circle-fill text-success').addClass('bi-lock-fill text-danger');
                                    $btn.find('.status-text').text('Đã khóa');
                                    $btn.attr('onclick', `toggleUserLock(${id}, '${name}', true)`);

                                    // Update dropdown menu
                                    if ($menuItem.length) {
                                        $menuItem.removeClass('text-danger').addClass('text-success');
                                        $menuItem.find('i').removeClass('bi-lock').addClass('bi-unlock');
                                        $menuItem.find('.menu-lock-text').text('Mở khóa tài khoản');
                                        $menuItem.attr('onclick', `toggleUserLock(${id}, '${name}', true)`);
                                    }
                                } else {
                                    $btn.removeClass('btn-light text-danger border-danger-subtle')
                                        .addClass('btn-success-subtle text-success border-success-subtle')
                                        .attr('title', 'Bấm để khóa tài khoản');
                                    $btn.find('i').removeClass('bi-lock-fill text-danger').addClass('bi-check-circle-fill text-success');
                                    $btn.find('.status-text').text('Hoạt động');
                                    $btn.attr('onclick', `toggleUserLock(${id}, '${name}', false)`);

                                    // Update dropdown menu
                                    if ($menuItem.length) {
                                        $menuItem.removeClass('text-success').addClass('text-danger');
                                        $menuItem.find('i').removeClass('bi-unlock').addClass('bi-lock');
                                        $menuItem.find('.menu-lock-text').text('Khóa tài khoản');
                                        $menuItem.attr('onclick', `toggleUserLock(${id}, '${name}', false)`);
                                    }
                                }
                            } else {
                                Swal.fire('Lỗi', res.message || 'Không thể thực hiện thao tác.', 'error');
                            }
                        },
                        error: function (xhr) {
                            $btn.prop('disabled', false);
                            Swal.fire('Lỗi', 'Có lỗi kết nối xảy ra khi cập nhật trạng thái tài khoản.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
