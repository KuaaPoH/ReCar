@model CarRental.Models.Blog
@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    string currentImg = !string.IsNullOrEmpty(Model.Image) ? Model.Image : "";
}

<div class="container-fluid px-0" style="max-width: 1100px;">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle p-2 text-muted me-1">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Chỉnh sửa bài viết</h1>
                <span class="badge bg-light text-muted border font-monospace">#ID-@Model.BlogId</span>
            </div>
            <p class="text-muted small mb-0 mt-1 ms-5">Cập nhật nội dung, ảnh bìa và trạng thái hiển thị của bài viết trên sàn ReCar.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Delete" asp-route-id="@Model.BlogId" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold">
                <i class="bi bi-trash me-1"></i> Xóa bài viết
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3.5 py-1.5 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BlogId" />
        <input type="hidden" asp-for="CreatedBy" />
        <input type="hidden" asp-for="CreatedDate" />
        <input type="hidden" asp-for="Alias" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

        <div class="row g-4">
            <!-- Cột trái: Nội dung bài viết -->
            <div class="col-lg-8">
                <div class="recar-panel p-4 mb-4">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-card-heading text-primary me-2"></i> Nội dung bài viết
                    </h5>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold small">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Tiêu đề bài viết" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                        <div class="form-text small text-muted">Đường dẫn tĩnh (Slug): <span class="text-primary font-monospace">/blog/@Model.Alias</span></div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold small">Tóm tắt ngắn (Lead / Sapo) <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" rows="3" class="form-control" placeholder="Mô tả tóm tắt nội dung chính" required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Detail" class="form-label fw-semibold small">Nội dung chi tiết bài viết <span class="text-danger">*</span></label>
                        <textarea asp-for="Detail" id="BlogDetail" rows="12" class="form-control" placeholder="Nội dung bài viết chi tiết..." required></textarea>
                        <span asp-validation-for="Detail" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Cài đặt & Ảnh bìa -->
            <div class="col-lg-4">
                <!-- Card Xuất bản -->
                <div class="recar-panel p-4 mb-4">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-sliders text-success me-2"></i> Trạng thái & Thông tin
                    </h6>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="switchIsActive">
                        <label class="form-check-label fw-semibold small text-dark" for="switchIsActive">
                            Hiển thị công khai trên sàn ReCar
                        </label>
                        <div class="form-text small text-muted">Bật để xuất bản bài viết hoặc tắt để chuyển về Bản nháp.</div>
                    </div>

                    <div class="p-3 bg-light rounded-3 small text-muted mb-3 border">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Người tạo:</span>
                            <strong class="text-dark">@(Model.CreatedBy ?? "Admin")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Ngày tạo:</span>
                            <span class="text-dark">@(Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</span>
                        </div>
                        @if (Model.ModifiedDate.HasValue)
                        {
                            <div class="d-flex justify-content-between">
                                <span>Sửa lần cuối:</span>
                                <span class="text-dark">@Model.ModifiedDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                            <i class="bi bi-check2-circle me-1"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-light w-100 rounded-pill py-2 text-muted fw-semibold border">
                            Hủy bỏ
                        </a>
                    </div>
                </div>

                <!-- Card Ảnh bìa -->
                <div class="recar-panel p-4 mb-4">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-image text-info me-2"></i> Ảnh bìa bài viết
                    </h6>
                    <p class="text-muted small mb-3">Thay đổi ảnh đại diện cho bài viết.</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Tải lên tệp ảnh mới:</label>
                        <input type="file" id="imageFileInput" name="ImageFile" accept="image/*" class="form-control form-control-sm rounded-3 mb-2" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Hoặc sửa đường dẫn ảnh (URL):</label>
                        <input asp-for="Image" id="imageInputUrl" class="form-control form-control-sm" placeholder="https://... hoặc /images/blogs/..." />
                    </div>

                    <!-- Khung xem trước ảnh Live Preview -->
                    <div class="border rounded-3 p-2 bg-light text-center">
                        <img id="imagePreview" src="@(!string.IsNullOrEmpty(currentImg) ? currentImg : "/images/cars/hero.jpg")" 
                             alt="Xem trước ảnh bìa" class="img-fluid rounded-3 object-fit-cover w-100 shadow-xs" 
                             style="max-height: 180px; @(!string.IsNullOrEmpty(currentImg) ? "" : "display: none;")" />
                        <div id="noPreviewText" class="text-muted small py-4" style="@(!string.IsNullOrEmpty(currentImg) ? "display: none;" : "")">
                            <i class="bi bi-card-image fs-1 d-block text-secondary opacity-50 mb-1"></i>
                            Chưa có ảnh bìa
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Xem trước ảnh Live Preview khi chọn file
        document.getElementById('imageFileInput')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById('imagePreview');
                    const noText = document.getElementById('noPreviewText');
                    img.src = e.target.result;
                    img.style.display = 'block';
                    if (noText) noText.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });

        // Xem trước ảnh Live Preview khi nhập URL
        document.getElementById('imageInputUrl')?.addEventListener('input', function (e) {
            const url = e.target.value.trim();
            const img = document.getElementById('imagePreview');
            const noText = document.getElementById('noPreviewText');
            if (url) {
                img.src = url;
                img.style.display = 'block';
                if (noText) noText.style.display = 'none';
            } else if (!document.getElementById('imageFileInput').files.length) {
                img.style.display = 'none';
                if (noText) noText.style.display = 'block';
            }
        });
    </script>
}
