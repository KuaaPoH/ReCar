@model CarRental.Models.Car
@using CarRental.Utilities
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Thêm xe mới";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";
    var carTypes = ViewBag.CarTypes as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <!-- Panel Thêm xe mới (Pixel-Perfect Template) -->
        <div class="recar-panel">
            <div class="recar-panel-header">
                <div>
                    <h2 class="recar-panel-title">Đăng ký phương tiện cho thuê</h2>
                    <div class="text-muted small mt-1">Cung cấp đầy đủ và chính xác thông tin để hồ sơ được duyệt nhanh chóng.</div>
                </div>
                <a href="/CarOwner/Cars/Index" class="btn btn-light btn-sm rounded-pill px-3 border text-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>

            <div class="p-4 p-md-5">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row g-4">
                        <!-- Tên xe -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Tên phương tiện <span class="text-danger">*</span></label>
                            <input asp-for="CarName" class="recar-input" placeholder="Ví dụ: VinFast VF 5 Plus, Toyota Vios G..." required />
                            <span asp-validation-for="CarName" class="text-danger small"></span>
                        </div>

                        <!-- Hãng xe -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Hãng sản xuất <span class="text-danger">*</span></label>
                            <select asp-for="CarBrand" class="recar-input" required>
                                <option value="">-- Chọn hãng xe --</option>
                                <option value="VinFast">VinFast</option>
                                <option value="Toyota">Toyota</option>
                                <option value="Hyundai">Hyundai</option>
                                <option value="Mazda">Mazda</option>
                                <option value="Kia">Kia</option>
                                <option value="Ford">Ford</option>
                                <option value="Honda">Honda</option>
                                <option value="Mitsubishi">Mitsubishi</option>
                            </select>
                            <span asp-validation-for="CarBrand" class="text-danger small"></span>
                        </div>

                        <!-- Phân khúc loại xe -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Phân khúc xe <span class="text-danger">*</span></label>
                            <select asp-for="TypeId" class="recar-input" asp-items="carTypes" required>
                            </select>
                            <span asp-validation-for="TypeId" class="text-danger small"></span>
                        </div>

                        <!-- Biển số xe -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Biển số xe kiểm định <span class="text-danger">*</span></label>
                            <input asp-for="LicensePlate" class="recar-input font-monospace text-uppercase" placeholder="Ví dụ: 30H-988.22" required />
                            <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                        </div>

                        <!-- Giá thuê ngày -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Giá thuê niêm yết (VNĐ/ngày) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Price" type="number" min="300000" step="50000" class="recar-input rounded-start" placeholder="850000" required />
                                <span class="input-group-text bg-light text-muted small border-start-0" style="border-radius: 0 10px 10px 0;">đ/ngày</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <!-- Số chỗ ngồi -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Số lượng chỗ ngồi <span class="text-danger">*</span></label>
                            <select asp-for="Seat" class="recar-input" required>
                                <option value="4">4 chỗ</option>
                                <option value="5" selected>5 chỗ</option>
                                <option value="7">7 chỗ</option>
                                <option value="8">8 chỗ</option>
                            </select>
                        </div>

                        <!-- Hộp số -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Hộp số truyền động <span class="text-danger">*</span></label>
                            <select asp-for="Transmission" class="recar-input" required>
                                <option value="Tự động" selected>Tự động</option>
                                <option value="Số sàn">Số sàn</option>
                            </select>
                        </div>

                        <!-- Nhiên liệu -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Loại nhiên liệu <span class="text-danger">*</span></label>
                            <select asp-for="Fuel" class="recar-input" required>
                                <option value="Xăng" selected>Xăng</option>
                                <option value="Dầu">Dầu (Diesel)</option>
                                <option value="Điện">Điện (EV)</option>
                            </select>
                        </div>

                        <!-- Địa điểm nhận bàn giao xe -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark small">Địa điểm bàn giao xe cho khách <span class="text-danger">*</span></label>
                            <input asp-for="Location" class="recar-input" placeholder="Ví dụ: Cầu Giấy, Hà Nội hoặc Quận 7, TP.HCM" required />
                            <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                                Khách hàng sẽ tìm kiếm xe theo địa điểm này trên bản đồ ReCar.
                            </div>
                        </div>

                        <!-- Ảnh đại diện xe -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark small">Đường dẫn hình ảnh đại diện (URL hoặc tải lên) <span class="text-danger">*</span></label>
                            <input asp-for="Image" class="recar-input" placeholder="Ví dụ: /images/cars/car-suv.jpg hoặc liên kết hình ảnh trực tuyến" required />
                            <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                                Hãy sử dụng hình ảnh rõ nét góc 3/4 phía trước của xe để đạt tỷ lệ đặt xe cao nhất.
                            </div>
                        </div>

                        <!-- Mô tả chi tiết -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark small">Mô tả chi tiết và tiện nghi trang bị</label>
                            <textarea asp-for="Details" rows="4" class="recar-input" placeholder="Giới thiệu về tình trạng xe, tiện nghi nổi bật (Camera 360, Apple CarPlay, Cảm biến áp suất lốp, cửa sổ trời...)..."></textarea>
                        </div>

                        <!-- Thông báo quy định -->
                        <div class="col-12">
                            <div class="alert alert-info d-flex align-items-center gap-2 mb-0 py-2.5 rounded-3 border-0" style="background-color: #f0f9ff; color: #0369a1;">
                                <i class="bi bi-info-circle-fill fs-5"></i>
                                <span class="small">
                                    Phương tiện mới sau khi gửi sẽ ở trạng thái <b>"Chờ duyệt"</b> để ban quản trị ReCar kiểm định hồ sơ trước khi công khai trên sàn cho thuê.
                                </span>
                            </div>
                        </div>

                        <!-- Nút gửi duyệt -->
                        <div class="col-12 pt-2">
                            <button type="submit" class="btn-recar-primary px-5 py-2.5 shadow-sm">
                                <i class="bi bi-send-check-fill me-1"></i> Gửi hồ sơ duyệt xe
                            </button>
                            <a href="/CarOwner/Cars/Index" class="btn btn-light rounded-pill px-4 py-2.5 border ms-2 text-secondary fw-semibold">
                                Hủy bỏ
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
