@model CarRental.ViewModels.CarCreateVM
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Thêm xe mới";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";
    var carTypes = ViewBag.CarTypes as List<SelectListItem> ?? new List<SelectListItem>();
    var carBrands = ViewBag.CarBrands as List<CarRental.Models.CarBrand> ?? new List<CarRental.Models.CarBrand>();
    var locations = ViewBag.Locations as List<CarRental.Models.Location> ?? new List<CarRental.Models.Location>();
    var dbAmenities = ViewBag.Amenities as List<CarRental.Models.Amenity> ?? new List<CarRental.Models.Amenity>();
}

<div class="container-fluid px-0 pb-5">
    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h4 fw-bold text-dark tracking-tight mb-1" style="font-size: 1.45rem;">Đăng ký xe mới</h1>
        <p class="text-muted small mb-0" style="font-size: 0.875rem;">Hoàn thành 6 bước để gửi hồ sơ xe cho Admin phê duyệt.</p>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createCarForm" onsubmit="return validateAllBeforeSubmit()">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Cột Trái (240px): Vertical Stepper Navigation -->
            <div class="col-12 col-lg-3">
                <div class="card-surface p-2 sticky-top" style="top: 80px; z-index: 10;">
                    <ol class="list-unstyled mb-0 d-flex flex-column gap-1" id="stepperNavList">
                        <li>
                            <button type="button" class="stepper-nav-btn active" data-step="0" onclick="goToStep(0)">
                                <span class="stepper-bubble" id="stepBubble-0">1</span>
                                <span>Thông tin cơ bản</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="1" onclick="goToStep(1)">
                                <span class="stepper-bubble" id="stepBubble-1">2</span>
                                <span>Giá thuê</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="2" onclick="goToStep(2)">
                                <span class="stepper-bubble" id="stepBubble-2">3</span>
                                <span>Quy định</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="3" onclick="goToStep(3)">
                                <span class="stepper-bubble" id="stepBubble-3">4</span>
                                <span>Tiện nghi</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="4" onclick="goToStep(4)">
                                <span class="stepper-bubble" id="stepBubble-4">5</span>
                                <span>Hình ảnh & giấy tờ</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="stepper-nav-btn" data-step="5" onclick="goToStep(5)">
                                <span class="stepper-bubble" id="stepBubble-5">6</span>
                                <span>Kiểm tra & gửi</span>
                            </button>
                        </li>
                    </ol>
                </div>
            </div>

            <!-- Cột Phải: Step Form Panes -->
            <div class="col-12 col-lg-9">
                <div class="card-surface p-4 p-md-5">

                    <!-- ============================================== -->
                    <!-- BƯỚC 1: THÔNG TIN CƠ BẢN                       -->
                    <!-- ============================================== -->
                    <div class="form-step-pane active" id="stepPane-0">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 1: Thông tin cơ bản</h2>

                        <div class="row g-4">
                            <!-- Hàng 1 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="CarName" class="form-label-recar">Tên xe <span class="text-danger">*</span></label>
                                <input asp-for="CarName" class="form-control form-control-recar" id="inputCarName" placeholder="VD: Toyota Vios G 2023" required />
                                <span asp-validation-for="CarName" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="CarBrand" class="form-label-recar">Hãng xe <span class="text-danger">*</span></label>
                                <select asp-for="CarBrand" class="form-select form-select-recar" id="selectCarBrand" required>
                                    <option value="">-- Chọn hãng xe --</option>
                                    @if (carBrands != null && carBrands.Any())
                                    {
                                        foreach (var b in carBrands)
                                        {
                                            <option value="@b.BrandName">@b.BrandName</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="Toyota">Toyota</option>
                                        <option value="VinFast">VinFast</option>
                                        <option value="Mitsubishi">Mitsubishi</option>
                                        <option value="Mazda">Mazda</option>
                                        <option value="Honda">Honda</option>
                                        <option value="Hyundai">Hyundai</option>
                                        <option value="Kia">Kia</option>
                                        <option value="Ford">Ford</option>
                                    }
                                </select>
                                <span asp-validation-for="CarBrand" class="text-danger small"></span>
                            </div>

                            <!-- Hàng 2 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="TypeId" class="form-label-recar">Phân khúc <span class="text-danger">*</span></label>
                                <select asp-for="TypeId" asp-items="carTypes" class="form-select form-select-recar" id="selectCarType" required>
                                    <option value="">-- Chọn phân khúc --</option>
                                </select>
                                <span asp-validation-for="TypeId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="ModelYear" class="form-label-recar">Năm sản xuất <span class="text-danger">*</span></label>
                                <input asp-for="ModelYear" type="number" min="2012" max="2027" class="form-control form-control-recar" id="selectModelYear" value="2024" required />
                                <span asp-validation-for="ModelYear" class="text-danger small"></span>
                            </div>

                            <!-- Hàng 3 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="LicensePlate" class="form-label-recar">Biển số xe kiểm định <span class="text-danger">*</span></label>
                                <input asp-for="LicensePlate" class="form-control form-control-recar font-monospace text-uppercase" id="inputLicensePlate" placeholder="VD: 51K-238.45" required />
                                <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Color" class="form-label-recar">Màu xe <span class="text-danger">*</span></label>
                                <input asp-for="Color" class="form-control form-control-recar" id="inputColor" placeholder="VD: Trắng, Đen, Xám, Đỏ..." required />
                                <span asp-validation-for="Color" class="text-danger small"></span>
                            </div>

                            <!-- Hàng 4 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Seat" class="form-label-recar">Số chỗ ngồi <span class="text-danger">*</span></label>
                                <select asp-for="Seat" class="form-select form-select-recar" id="selectSeat" required>
                                    <option value="4">4 chỗ</option>
                                    <option value="5" selected>5 chỗ</option>
                                    <option value="7">7 chỗ</option>
                                    <option value="8">8 chỗ</option>
                                    <option value="16">16 chỗ</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Transmission" class="form-label-recar">Hộp số <span class="text-danger">*</span></label>
                                <select asp-for="Transmission" class="form-select form-select-recar" id="selectTransmission" required>
                                    <option value="Tự động" selected>Tự động</option>
                                    <option value="Số sàn">Số sàn</option>
                                </select>
                            </div>

                            <!-- Hàng 5 -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Fuel" class="form-label-recar">Nhiên liệu <span class="text-danger">*</span></label>
                                <select asp-for="Fuel" class="form-select form-select-recar" id="selectFuel" required>
                                    <option value="Xăng" selected>Xăng</option>
                                    <option value="Dầu">Dầu</option>
                                    <option value="Điện">Điện</option>
                                    <option value="Hybrid">Hybrid</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="FuelConsumption" class="form-label-recar">Mức tiêu thụ nhiên liệu <span class="text-danger">*</span></label>
                                <input asp-for="FuelConsumption" class="form-control form-control-recar" id="inputConsumption" placeholder="VD: 6.5L/100km hoặc 14kWh/100km" required />
                                <span asp-validation-for="FuelConsumption" class="text-danger small"></span>
                            </div>

                            <!-- Hàng 6: Địa điểm -->
                            <div class="col-12">
                                <label asp-for="Location" class="form-label-recar">Địa điểm giao nhận xe <span class="text-danger">*</span></label>
                                <input asp-for="Location" class="form-control form-control-recar" id="inputLocation" placeholder="VD: Số 123 Nguyễn Thị Thập, Tân Phú, Quận 7, TP.HCM" required />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 2: GIÁ THUÊ                               -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-1">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 2: Giá thuê</h2>

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="Price" class="form-label-recar">Giá thuê niêm yết/ngày (VND) <span class="text-danger">*</span></label>
                                <input asp-for="Price" type="number" min="200000" step="10000" class="form-control form-control-recar" id="inputPrice" placeholder="VD: 850000" required />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                                <div class="form-text small text-muted">Giá thuê tối thiểu 200.000 đ/ngày.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="SalePrice" class="form-label-recar">Giá khuyến mãi/ngày (không bắt buộc)</label>
                                <input asp-for="SalePrice" type="number" min="0" step="10000" class="form-control form-control-recar" id="inputSalePrice" placeholder="Để trống nếu không áp dụng ưu đãi" />
                            </div>

                            <div class="col-12">
                                <div class="rounded-xl border p-4" style="background-color: #f8fafc;">
                                    <p class="text-xs text-muted mb-1 font-semibold uppercase tracking-wider">Khách thuê sẽ nhìn thấy:</p>
                                    <div class="d-flex align-items-baseline gap-2 mb-1" id="previewPriceContainer">
                                        <span class="fs-3 fw-bold text-primary" id="previewPriceDisplay">850.000 đ</span>
                                        <span class="text-sm text-muted text-decoration-line-through d-none" id="previewOriginalPrice"></span>
                                    </div>
                                    <p class="text-xs text-muted mb-0">/ ngày · Bạn sẽ nhận trực tiếp tiền thuê và thanh toán quyết toán từ sàn ReCar.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 3: QUY ĐỊNH                               -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-2">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 3: Quy định di chuyển</h2>

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="MileageLimit" class="form-label-recar">Giới hạn quãng đường (km/ngày) <span class="text-danger">*</span></label>
                                <input asp-for="MileageLimit" type="number" min="50" step="10" class="form-control form-control-recar" id="inputMileageLimit" value="350" required />
                                <div class="form-text small text-muted">Khuyến nghị từ 300 - 400 km/ngày.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="ExtraFeePerKm" class="form-label-recar">Phụ phí vượt giới hạn km (VND/km) <span class="text-danger">*</span></label>
                                <input asp-for="ExtraFeePerKm" type="number" min="1000" step="500" class="form-control form-control-recar" id="inputExtraFeePerKm" value="3000" required />
                                <div class="form-text small text-muted">Phụ phí tính trên mỗi km vượt hạn mức.</div>
                            </div>

                            <div class="col-12">
                                <div class="rounded-xl border p-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                                    <div>
                                        <div class="fw-bold text-dark text-sm">Hỗ trợ giao xe tận nơi cho khách</div>
                                        <div class="text-xs text-muted">Bật để tăng cơ hội nhận được nhiều đơn thuê xe hơn</div>
                                    </div>
                                    <div class="form-check form-switch m-0 fs-5">
                                        <input asp-for="DeliverySupported" class="form-check-input" type="checkbox" id="checkDelivery" role="switch" onchange="toggleDeliverySwitch(this.checked)" checked />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6" id="boxDeliveryFee">
                                <label asp-for="DeliveryFee" class="form-label-recar">Phí giao nhận xe tận nơi (VND)</label>
                                <input asp-for="DeliveryFee" type="number" min="0" step="10000" class="form-control form-control-recar" id="inputDeliveryFee" value="100000" />
                            </div>

                            <div class="col-12 col-md-6 mt-3">
                                <label asp-for="DriverFee" class="form-label-recar">
                                    <i class="bi bi-person-badge text-primary me-1"></i> Phụ phí tài xế riêng (VND/ngày)
                                </label>
                                <input asp-for="DriverFee" type="number" min="0" step="50000" class="form-control form-control-recar" id="inputDriverFee" value="300000" placeholder="VD: 300000" />
                                <span class="text-xs text-muted">Phụ phí cộng thêm mỗi ngày khi khách hàng có nhu cầu thuê xe kèm tài xế riêng.</span>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 4: TIỆN NGHI                              -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-3">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 4: Tiện nghi & Mô tả xe</h2>

                        <p class="text-sm text-muted mb-3">Chọn các tính năng và trang bị có sẵn trên xe của bạn:</p>

                        <div class="row g-3 mb-4">
                            @{
                                var dbAmenitiesList = ViewBag.Amenities as List<CarRental.Models.Amenity> ?? new List<CarRental.Models.Amenity>();
                                string GetAmenityLucideIcon(string name)
                                {
                                    if (string.IsNullOrEmpty(name)) return "check-circle";
                                    string lower = name.ToLower();
                                    if (lower.Contains("bản đồ") || lower.Contains("gps")) return "map";
                                    if (lower.Contains("bluetooth")) return "bluetooth";
                                    if (lower.Contains("camera lùi") || lower.Contains("camera 360")) return "camera";
                                    if (lower.Contains("hành trình")) return "video";
                                    if (lower.Contains("lốp")) return "gauge";
                                    if (lower.Contains("cửa sổ trời")) return "sun";
                                    if (lower.Contains("điều hòa") || lower.Contains("lạnh")) return "snowflake";
                                    if (lower.Contains("usb") || lower.Contains("sạc")) return "zap";
                                    if (lower.Contains("trẻ em")) return "baby";
                                    if (lower.Contains("va chạm") || lower.Contains("cảnh báo")) return "shield-alert";
                                    if (lower.Contains("carplay") || lower.Contains("android")) return "smartphone";
                                    if (lower.Contains("etc") || lower.Contains("thu phí")) return "credit-card";
                                    if (lower.Contains("ghế")) return "armchair";
                                    if (lower.Contains("khóa") || lower.Contains("smartkey")) return "key";
                                    if (lower.Contains("cốp")) return "package";
                                    return "check-circle";
                                }
                            }

                            @if (dbAmenitiesList.Any())
                            {
                                @foreach (var item in dbAmenitiesList)
                                {
                                    string iconName = GetAmenityLucideIcon(item.Name);
                                    <div class="col-6 col-sm-4 col-md-3">
                                        <button type="button" class="amenity-toggle-btn" data-id="@item.AmenityId" data-name="@item.Name" onclick="toggleAmenity(this)">
                                            <i data-lucide="@iconName" class="size-5"></i>
                                            <span>@item.Name</span>
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                var fallbackCatalog = new List<(int Id, string Name, string Icon)>
                                {
                                    (1, "Bản đồ", "map"),
                                    (15, "Bluetooth", "bluetooth"),
                                    (2, "Camera lùi", "camera"),
                                    (4, "Cảm biến lốp", "gauge"),
                                    (6, "Cửa sổ trời", "sun"),
                                    (16, "Điều hòa", "snowflake"),
                                    (3, "Camera hành trình", "video"),
                                    (17, "Cổng sạc USB", "zap"),
                                    (9, "Ghế trẻ em", "baby"),
                                    (11, "Cảnh báo va chạm", "shield-alert")
                                };
                                @foreach (var item in fallbackCatalog)
                                {
                                    <div class="col-6 col-sm-4 col-md-3">
                                        <button type="button" class="amenity-toggle-btn" data-id="@item.Id" data-name="@item.Name" onclick="toggleAmenity(this)">
                                            <i data-lucide="@item.Icon" class="size-5"></i>
                                            <span>@item.Name</span>
                                        </button>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Ẩn các inputs checkbox để submit dữ liệu -->
                        <div id="hiddenAmenityInputs"></div>

                        <div class="mt-4 pt-3 border-top">
                            <div class="p-3.5 rounded-3 border bg-light">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <label asp-for="Details" class="form-label mb-0 fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 0.95rem;">
                                        <i class="bi bi-chat-left-text-fill text-primary"></i> Mô tả & Nội quy của chủ xe
                                    </label>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-normal" style="font-size: 0.72rem;">Đồng bộ với Khách hàng & Admin</span>
                                </div>
                                <p class="text-muted small mb-2" style="font-size: 0.8rem; line-height: 1.4;">
                                    Ghi rõ các đặc điểm nổi bật của xe và nội quy dành cho khách thuê (ví dụ: giữ gìn vệ sinh sạch sẽ, không hút thuốc trong xe, không chở thú cưng / hải sản nặng mùi, quy định mức xăng khi trả xe...).
                                </p>
                                <textarea asp-for="Details" rows="4" class="form-control bg-white rounded-3 shadow-2xs" id="inputDetails" placeholder="Ví dụ: Xe gia đình bảo dưỡng định kỳ, nội thất sạch sẽ thơm tho. Quý khách vui lòng không hút thuốc, không chở thú cưng và giữ vệ sinh chung khi sử dụng xe..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 5: HÌNH ẢNH & GIẤY TỜ                     -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-4">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 5: Hình ảnh & Giấy tờ</h2>

                        <!-- 1. Ảnh đại diện chính -->
                        <div class="mb-4 pb-3 border-bottom">
                            <label class="form-label-recar fw-bold">1. Ảnh đại diện chính của xe <span class="text-danger">*</span></label>
                            <div class="d-flex flex-wrap align-items-center gap-3 mt-2">
                                <div class="position-relative overflow-hidden rounded-xl border bg-light d-grid place-items-center" style="width: 180px; height: 115px;">
                                    <img id="previewAvatarImg" src="" alt="Ảnh đại diện" class="w-100 h-100 object-fit-cover d-none" />
                                    <div id="emptyAvatarPlaceholder" class="text-muted text-center p-2">
                                        <i data-lucide="image-plus" class="size-6 d-block mx-auto mb-1 opacity-50"></i>
                                        <span class="text-xs">Chưa có ảnh</span>
                                    </div>
                                </div>
                                <div>
                                    <label class="btn btn-sm btn-outline-primary rounded-xl px-3 py-2 cursor-pointer mb-1 d-inline-flex align-items-center gap-1.5">
                                        <i data-lucide="image-plus" class="size-4"></i>
                                        <span>Chọn ảnh đại diện</span>
                                        <input type="file" asp-for="ImageFile" id="inputImageFile" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewAvatarImg', 'emptyAvatarPlaceholder')" required />
                                    </label>
                                    <div class="text-xs text-muted">Ảnh chụp góc nghiêng đẹp nhất làm đại diện trên sàn (tối đa 5MB).</div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Ảnh 4 góc chi tiết xung quanh xe (MỚI BỔ SUNG THEO YÊU CẦU) -->
                        <div class="mb-4 pb-3 border-bottom">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <label class="form-label-recar fw-bold mb-0">2. Ảnh chụp 4 góc xung quanh xe <span class="text-danger">*</span></label>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">Bắt buộc đủ 4 góc</span>
                            </div>
                            <p class="text-xs text-muted mb-3">Hiển thị trong album ảnh để khách hàng ngắm xe và Admin kiểm tra ngoại quan.</p>

                            <div class="row g-3">
                                <!-- Góc 1: Đầu xe (Mặt trước) -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 140px;">
                                        <img id="previewImg1" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Đầu xe" />
                                        <div id="placeholderImg1" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="camera" class="size-6 text-primary mb-1"></i>
                                            <span class="text-xs fw-bold text-dark">Đầu xe (Mặt trước)</span>
                                            <span class="text-xs text-muted" style="font-size: 11px;">Rõ logo & biển số</span>
                                        </div>
                                        <input type="file" asp-for="Image1File" id="inputImage1File" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewImg1', 'placeholderImg1')" required />
                                    </label>
                                </div>

                                <!-- Góc 2: Đuôi xe (Mặt sau) -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 140px;">
                                        <img id="previewImg2" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Đuôi xe" />
                                        <div id="placeholderImg2" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="camera" class="size-6 text-primary mb-1"></i>
                                            <span class="text-xs fw-bold text-dark">Đuôi xe (Mặt sau)</span>
                                            <span class="text-xs text-muted" style="font-size: 11px;">Rõ cụm đèn & cốp</span>
                                        </div>
                                        <input type="file" asp-for="Image2File" id="inputImage2File" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewImg2', 'placeholderImg2')" required />
                                    </label>
                                </div>

                                <!-- Góc 3: Nội thất khoang lái -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 140px;">
                                        <img id="previewImg3" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Nội thất xe" />
                                        <div id="placeholderImg3" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="camera" class="size-6 text-primary mb-1"></i>
                                            <span class="text-xs fw-bold text-dark">Nội thất khoang lái</span>
                                            <span class="text-xs text-muted" style="font-size: 11px;">Toàn cảnh taplo & ghế</span>
                                        </div>
                                        <input type="file" asp-for="Image3File" id="inputImage3File" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewImg3', 'placeholderImg3')" required />
                                    </label>
                                </div>

                                <!-- Góc 4: Sườn xe (Góc nghiêng) -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 140px;">
                                        <img id="previewImg4" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Sườn xe" />
                                        <div id="placeholderImg4" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="camera" class="size-6 text-primary mb-1"></i>
                                            <span class="text-xs fw-bold text-dark">Sườn xe (Góc nghiêng)</span>
                                            <span class="text-xs text-muted" style="font-size: 11px;">Toàn cảnh thân xe</span>
                                        </div>
                                        <input type="file" asp-for="Image4File" id="inputImage4File" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewImg4', 'placeholderImg4')" required />
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Giấy tờ pháp lý (KYC) -->
                        <div>
                            <label class="form-label-recar fw-bold">3. Ảnh giấy tờ pháp lý (Đăng ký xe, Đăng kiểm, Bảo hiểm) <span class="text-danger">*</span></label>
                            <div class="row g-3 mt-1">
                                <!-- Đăng ký xe / Cà vẹt -->
                                <div class="col-12 col-sm-4">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 130px;">
                                        <img id="previewDocReg" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Cà vẹt xe" />
                                        <div id="placeholderDocReg" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="file-text" class="size-6 text-warning mb-1"></i>
                                            <span class="text-xs fw-bold text-dark">Đăng ký xe / Cà vẹt <span class="text-danger">*</span></span>
                                        </div>
                                        <input type="file" asp-for="RegistrationImageFile" id="inputDocReg" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewDocReg', 'placeholderDocReg')" required />
                                    </label>
                                </div>

                                <!-- Sổ đăng kiểm -->
                                <div class="col-12 col-sm-4">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 130px;">
                                        <img id="previewDocInsp" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Sổ đăng kiểm" />
                                        <div id="placeholderDocInsp" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="file-check" class="size-6 text-success mb-1"></i>
                                            <span class="text-xs fw-bold text-dark">Sổ đăng kiểm <span class="text-danger">*</span></span>
                                        </div>
                                        <input type="file" asp-for="InspectionImageFile" id="inputDocInsp" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewDocInsp', 'placeholderDocInsp')" required />
                                    </label>
                                </div>

                                <!-- Bảo hiểm xe -->
                                <div class="col-12 col-sm-4">
                                    <label class="d-flex flex-column align-items-center justify-content-center p-3 rounded-xl border border-dashed bg-light text-center cursor-pointer h-100 position-relative overflow-hidden" style="min-height: 130px;">
                                        <img id="previewDocIns" src="" class="position-absolute inset-0 w-100 h-100 object-fit-cover d-none" alt="Bảo hiểm xe" />
                                        <div id="placeholderDocIns" class="d-flex flex-column align-items-center justify-content-center gap-1 text-muted">
                                            <i data-lucide="shield" class="size-6 text-info mb-1"></i>
                                            <span class="text-xs fw-bold text-dark">Bảo hiểm TNDS <span class="text-danger">*</span></span>
                                        </div>
                                        <input type="file" asp-for="InsuranceImageFile" id="inputDocIns" accept="image/*" class="d-none" onchange="previewImageFile(this, 'previewDocIns', 'placeholderDocIns')" required />
                                    </label>
                                </div>
                            </div>
                            <p class="text-xs text-muted mt-2 mb-0">Ảnh giấy tờ chỉ Admin xét duyệt mới xem được, không hiển thị công khai trên sàn.</p>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- BƯỚC 6: KIỂM TRA & GỬI                         -->
                    <!-- ============================================== -->
                    <div class="form-step-pane" id="stepPane-5">
                        <h2 class="h5 fw-bold text-dark mb-4 pb-2 border-bottom" style="font-size: 1.15rem;">Bước 6: Kiểm tra & Gửi hồ sơ</h2>

                        <!-- Card preview tóm tắt thông tin xe -->
                        <div class="card-surface p-4 mb-4 border d-flex flex-column flex-md-row gap-4 align-items-start">
                            <div class="rounded-xl overflow-hidden flex-shrink-0" style="width: 100%; max-width: 220px; aspect-ratio: 16/10; background-color: #0f172a;">
                                <img id="summaryPreviewImg" src="/images/cars/default-car.jpg" alt="Tóm tắt xe" class="w-100 h-100 object-fit-cover" />
                            </div>

                            <div class="flex-grow-1">
                                <h3 class="fs-5 fw-bold text-dark mb-1" id="summaryCarName">Tên xe</h3>
                                <div class="text-muted text-sm mb-2" id="summarySubInfo">
                                    Hãng xe · Phân khúc · Năm 2024 · Màu xe
                                </div>

                                <div class="mb-2">
                                    <span class="plate-badge" id="summaryPlate">51K-238.45</span>
                                </div>

                                <div class="text-sm text-dark mb-2" id="summaryTechSpecs">
                                    5 chỗ · Tự động · Xăng
                                </div>

                                <div class="fs-6 fw-bold text-primary mb-2" id="summaryPriceText">
                                    850.000 đ / ngày
                                </div>

                                <div class="text-xs text-muted mb-2" id="summaryRuleText">
                                    Giới hạn 350 km/ngày · Vượt 3.000 đ/km
                                </div>

                                <div class="text-xs text-muted mb-3" id="summaryAmenitiesText">
                                    Tiện nghi: Chưa chọn tiện nghi
                                </div>

                                <!-- Dải 4 ảnh góc xung quanh xe preview -->
                                <div class="pt-2 border-top">
                                    <div class="text-xs fw-bold text-dark mb-2">4 Ảnh góc xung quanh xe đã tải lên:</div>
                                    <div class="d-flex gap-2" id="summaryGalleryRow">
                                        <img id="summaryThumb1" src="" class="rounded-2 border object-fit-cover d-none" style="width: 60px; height: 42px;" alt="Đầu xe" />
                                        <img id="summaryThumb2" src="" class="rounded-2 border object-fit-cover d-none" style="width: 60px; height: 42px;" alt="Đuôi xe" />
                                        <img id="summaryThumb3" src="" class="rounded-2 border object-fit-cover d-none" style="width: 60px; height: 42px;" alt="Nội thất" />
                                        <img id="summaryThumb4" src="" class="rounded-2 border object-fit-cover d-none" style="width: 60px; height: 42px;" alt="Sườn xe" />
                                    </div>
                                </div>
