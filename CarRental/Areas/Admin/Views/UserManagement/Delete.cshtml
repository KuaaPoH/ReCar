@model CarRental.Models.Customer
@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle p-2 text-muted me-1">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Xác nhận xóa tài khoản</h1>
            </div>
            <p class="text-muted small mb-0 mt-1 ms-5">Cân nhắc kỹ trước khi xóa tài khoản người dùng khỏi cơ sở dữ liệu.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill px-3 border">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="recar-panel mb-4 border-danger">
                <div class="recar-panel-header" style="background-color: #fef2f2;">
                    <h2 class="h6 fw-bold mb-0 text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Cảnh báo thao tác xóa vĩnh viễn
                    </h2>
                </div>
                <div class="p-4">
                    <div class="alert alert-warning border-0 rounded-3 small mb-4" style="background-color: #fffbeb;">
                        <strong>Lưu ý:</strong> Hành động này sẽ xóa tài khoản người dùng khỏi hệ thống. Nếu tài khoản này đã có lịch sử đặt xe hoặc quản lý xe, khuyến nghị bạn nên chọn tính năng <strong>Khóa tài khoản</strong> tại danh sách thay vì xóa cứng.
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-4 bg-secondary" style="width: 56px; height: 56px;">
                            @((Model.FullName ?? Model.Username ?? "U")[0].ToString().ToUpper())
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0.5">@(Model.FullName ?? Model.Username)</h5>
                            <div class="text-muted small">
                                <span class="badge bg-secondary rounded-pill me-1">@(Model.Role?.RoleName ?? "Người dùng")</span>
                                <span>ID: #@Model.CustomerId</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Username:</span>
                            <div class="fw-semibold text-dark mt-0.5 font-mono-plate">@Model.Username</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Email:</span>
                            <div class="fw-semibold text-dark mt-0.5">@Model.Email</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Số điện thoại:</span>
                            <div class="fw-semibold text-dark mt-0.5">@(Model.PhoneNumber ?? Model.Phone ?? "Chưa có")</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small" style="font-size: 0.75rem;">Vai trò:</span>
                            <div class="fw-semibold text-dark mt-0.5">@(Model.Role?.RoleName ?? "Khách hàng")</div>
                        </div>
                    </div>

                    <form asp-action="DeleteConfirmed" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.CustomerId" />
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill px-3">Hủy bỏ</a>
                            <button type="submit" class="btn btn-danger btn-sm rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="bi bi-trash3 me-1"></i> Xác nhận xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
