@using CarRental.Models
@{
    ViewData["Title"] = "ReCar – Chủ động mọi hành trình | Thuê ô tô trực tuyến";
    List<Car> productFeatured = ViewBag.productFeatured ?? new List<Car>();
    List<Blog> blogs = ViewBag.Blog ?? new List<Blog>();
    List<CarType> carTypes = ViewBag.CarTypes ?? new List<CarType>();

    string todayStr = DateTime.Now.ToString("yyyy-MM-dd");
    string nextDayStr = DateTime.Now.AddDays(2).ToString("yyyy-MM-dd");
}

<style>
    /* Hero Section Styling (Pixel-perfect Ảnh 1) */
    .hero-banner-wrap {
        position: relative;
        background-color: var(--recar-navy);
        overflow: hidden;
    }
    .hero-bg-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.85;
    }
    .hero-gradient-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, #0f172a 0%, rgba(15, 23, 42, 0.75) 60%, rgba(15, 23, 42, 0.2) 100%);
    }
    .hero-container {
        position: relative;
        max-width: 1280px;
        margin: 0 auto;
        padding: 80px 16px 140px 16px;
    }
    .hero-pill-tag {
        display: inline-block;
        border-radius: 9999px;
        background: rgba(2, 132, 199, 0.25);
        color: #ffffff;
        font-size: 14px;
        font-weight: 500;
        padding: 6px 18px;
        margin-bottom: 20px;
    }
    .hero-main-title {
        font-size: 48px;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.15;
        max-width: 720px;
        margin-bottom: 18px;
    }
    .hero-sub-title {
        font-size: 18px;
        color: rgba(255, 255, 255, 0.85);
        max-width: 540px;
        line-height: 1.5;
        margin-bottom: 0;
    }

    /* Floating Search Box */
    .search-box-float {
        position: relative;
        z-index: 20;
        max-width: 1280px;
        margin: -80px auto 0 auto;
        padding: 0 16px;
    }

    @@media (max-width: 768px) {
        .hero-main-title { font-size: 32px; }
        .hero-container { padding: 50px 16px 100px 16px; }
        .search-box-float { margin-top: -50px; }
    }
</style>

<!-- Hero Section (Ảnh 1) -->
<section class="hero-banner-wrap">
    <img src="/images/cars/hero.jpg" alt="SUV trên đại lộ thành phố" class="hero-bg-img" />
    <div class="hero-gradient-overlay"></div>
    <div class="hero-container">
        <span class="hero-pill-tag">Chuyến đi của bạn, lựa chọn của bạn.</span>
        <h1 class="hero-main-title">Chủ động mọi hành trình cùng ReCar</h1>
        <p class="hero-sub-title">Khám phá hàng trăm mẫu xe phù hợp với nhu cầu di chuyển của bạn.</p>
    </div>
</section>

<!-- Floating Search Box (Ảnh 1) -->
<div class="search-box-float">
    <div class="recar-search-card">
        <form method="get" asp-controller="Product" asp-action="Index" id="quickSearchForm">
            <!-- Tabs Tự lái / Có tài xế -->
            <div class="d-flex gap-2 mb-3">
                <button type="button" class="search-mode-tab active" id="btnSelfDrive">Tự lái</button>
                <button type="button" class="search-mode-tab" id="btnWithDriver">Có tài xế</button>
                <input type="hidden" name="driveMode" id="driveModeInput" value="Tự lái" />
            </div>

            <!-- Form inputs grid -->
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="recar-field-label">Địa điểm nhận xe</label>
                    <select class="recar-field-input" name="city">
                        <option value="Hà Nội" selected>Hà Nội</option>
                        <option value="TP. Hồ Chí Minh">TP. Hồ Chí Minh</option>
                        <option value="Đà Nẵng">Đà Nẵng</option>
                        <option value="Nha Trang">Nha Trang</option>
                        <option value="Đà Lạt">Đà Lạt</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="recar-field-label">Ngày nhận xe</label>
                    <input type="date" class="recar-field-input" name="pickupDate" min="@todayStr" value="@todayStr" required />
                </div>

                <div class="col-md-2">
                    <label class="recar-field-label">Giờ nhận</label>
                    <input type="time" class="recar-field-input" name="pickupTime" value="08:00" required />
                </div>

                <div class="col-md-2">
                    <label class="recar-field-label">Ngày trả xe</label>
                    <input type="date" class="recar-field-input" name="returnDate" min="@todayStr" value="@nextDayStr" required />
                </div>

                <div class="col-md-1">
                    <label class="recar-field-label">Giờ trả</label>
                    <input type="time" class="recar-field-input" name="returnTime" value="08:00" required />
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn-recar-search w-100">
                        <i class="bi bi-search"></i> Tìm kiếm xe
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="container py-5" style="max-width: 1280px;">
    <!-- 6 Perks Section -->
    <section class="row g-3 mb-5 mt-2">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100" style="background-color: var(--recar-secondary);">
                <i class="bi bi-car-front fs-4" style="color: var(--recar-primary);"></i>
                <h6 class="fw-bold mt-2 mb-1" style="color: var(--recar-navy); font-size: 14px;">Đa dạng lựa chọn xe</h6>
                <p class="small text-muted mb-0" style="font-size: 12px;">Từ xe mini đến SUV 7 chỗ.</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100" style="background-color: var(--recar-secondary);">
                <i class="bi bi-calendar-check fs-4" style="color: var(--recar-primary);"></i>
                <h6 class="fw-bold mt-2 mb-1" style="color: var(--recar-navy); font-size: 14px;">Đặt xe trực tuyến</h6>
                <p class="small text-muted mb-0" style="font-size: 12px;">Vài bước, xác nhận nhanh.</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100" style="background-color: var(--recar-secondary);">
                <i class="bi bi-headset fs-4" style="color: var(--recar-primary);"></i>
                <h6 class="fw-bold mt-2 mb-1" style="color: var(--recar-navy); font-size: 14px;">Hỗ trợ 24/7</h6>
                <p class="small text-muted mb-0" style="font-size: 12px;">Luôn sẵn sàng khi bạn cần.</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100" style="background-color: var(--recar-secondary);">
                <i class="bi bi-patch-check fs-4" style="color: var(--recar-primary);"></i>
                <h6 class="fw-bold mt-2 mb-1" style="color: var(--recar-navy); font-size: 14px;">Minh bạch</h6>
                <p class="small text-muted mb-0" style="font-size: 12px;">Thông tin xe rõ ràng.</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100" style="background-color: var(--recar-secondary);">
                <i class="bi bi-truck fs-4" style="color: var(--recar-primary);"></i>
                <h6 class="fw-bold mt-2 mb-1" style="color: var(--recar-navy); font-size: 14px;">Giao xe tận nơi</h6>
                <p class="small text-muted mb-0" style="font-size: 12px;">Theo điều kiện từng chủ xe.</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-3 rounded-3 h-100" style="background-color: var(--recar-secondary);">
                <i class="bi bi-file-earmark-check fs-4" style="color: var(--recar-primary);"></i>
                <h6 class="fw-bold mt-2 mb-1" style="color: var(--recar-navy); font-size: 14px;">Điều khoản rõ ràng</h6>
                <p class="small text-muted mb-0" style="font-size: 12px;">Hợp đồng và chính sách cụ thể.</p>
            </div>
        </div>
    </section>

    <!-- Danh mục dòng xe (Khớp 100% Ảnh 3) -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fs-4 fw-bold m-0" style="color: var(--recar-navy);">Danh mục dòng xe</h2>
        </div>
        <div class="row row-cols-2 row-cols-md-5 g-3 align-items-stretch">
            @if (carTypes != null && carTypes.Any())
            {
                foreach (var ct in carTypes.Take(5))
                {
                    <div class="col d-flex">
                        <a href="/Product?TypeId=@ct.TypeId" class="recar-cat-card w-100">
                            <img src="@ct.Image" alt="@ct.CarTypeName" class="recar-cat-img" loading="lazy" />
                            <div class="recar-cat-body">
                                <span class="recar-cat-title" title="@ct.CarTypeName">@ct.CarTypeName</span>
                                <span class="recar-cat-arrow">Xem xe →</span>
                            </div>
                        </a>
                    </div>
                }
            }
        </div>
    </section>

    <!-- Xe nổi bật và ưu đãi (Khớp 100% Ảnh 3) -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fs-4 fw-bold m-0" style="color: var(--recar-navy);">Xe nổi bật và ưu đãi</h2>
            <a href="/Product" class="text-decoration-none fw-semibold small" style="color: var(--recar-primary);">
                Xem tất cả →
            </a>
        </div>

        <div class="row g-4">
            @if (productFeatured != null && productFeatured.Any())
            {
                foreach (var car in productFeatured.Take(4))
                {
                    string detailUrl = $"/product/{car.Alias}-{car.CarId}.html";

                    // Tag
                    string tag = car.Badge ?? car.Descriptions;
                    string tagClass = "recar-badge-featured";
                    if (tag == "Xe điện" || (car.Fuel != null && car.Fuel.Contains("Điện")) || (car.CarBrand != null && car.CarBrand.ToLower().Contains("vinfast")))
                    {
                        tag = "Xe điện";
                        tagClass = "recar-badge-electric";
                    }
                    else if (tag == "Ưu đãi" || car.IsSale)
                    {
                        tag = "Ưu đãi";
                        tagClass = "recar-badge-promo";
                    }
                    else if (tag == "Nổi bật")
                    {
                        tagClass = "recar-badge-featured";
                    }

                    // Specs từ database thật
                    string gear = car.Transmission ?? "Tự động";
                    string fuel = car.Fuel ?? "Xăng";
                    string location = car.Location ?? "Hà Nội";
                    int reviews = car.Trips ?? 50;

                    decimal finalPrice = (car.SalePrice > 0 ? car.SalePrice : car.Price) ?? 0;

                    <div class="col-12 col-sm-6 col-lg-3">
                        <article class="recar-car-card">
                            <div class="recar-car-media">
                                <img src="@car.Image" alt="@car.CarName" class="recar-car-img" loading="lazy">
                                @if (!string.IsNullOrEmpty(tag))
                                {
                                    <span class="recar-badge-tag @tagClass">@tag</span>
                                }
                            </div>
                            <div class="recar-car-content">
                                <div>
                                    <p class="recar-car-brand">@car.CarBrand</p>
                                    <h3 class="recar-car-name">@car.CarName</h3>
                                </div>
                                <div class="recar-specs-grid">
                                    <span class="recar-spec-item"><i class="bi bi-people"></i> @(car.Seat ?? 5) chỗ</span>
                                    <span class="recar-spec-item"><i class="bi bi-gear"></i> @gear</span>
                                    <span class="recar-spec-item"><i class="bi bi-fuel-pump"></i> @fuel</span>
                                </div>
                                <div class="recar-meta-row">
                                    <span class="recar-location-txt"><i class="bi bi-geo-alt"></i> @location</span>
                                    <span class="recar-rating-txt"><i class="bi bi-star-fill text-warning"></i> @(car.Rate?.ToString("0.0") ?? "4.8") (@reviews)</span>
                                </div>
                                <div class="recar-price-box">
                                    <span class="recar-price-amount">@finalPrice.ToString("N0")đ</span>
                                    <span class="recar-price-unit">/ngày</span>
                                </div>
                                <div class="recar-card-actions">
                                    <a href="@detailUrl" class="btn-card-outline">Xem chi tiết</a>
                                    <a href="@detailUrl" class="btn-card-primary">Thuê ngay</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            }
        </div>
    </section>

    <!-- Thuê xe chỉ với 3 bước -->
    <section class="mb-5">
        <h2 class="fs-4 fw-bold mb-4" style="color: var(--recar-navy);">Thuê xe chỉ với 3 bước</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 rounded-3 border h-100 bg-white" style="box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);">
                    <div style="font-size: 40px; font-weight: 800; color: rgba(2, 132, 199, 0.2); line-height: 1;">01</div>
                    <i class="bi bi-search fs-3 my-2 d-block" style="color: var(--recar-primary);"></i>
                    <h6 class="fw-bold mb-0" style="color: var(--recar-navy); font-size: 16px;">Chọn xe và thời gian thuê</h6>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-3 border h-100 bg-white" style="box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);">
                    <div style="font-size: 40px; font-weight: 800; color: rgba(2, 132, 199, 0.2); line-height: 1;">02</div>
                    <i class="bi bi-wallet2 fs-3 my-2 d-block" style="color: var(--recar-primary);"></i>
                    <h6 class="fw-bold mb-0" style="color: var(--recar-navy); font-size: 16px;">Đặt cọc 30% trực tuyến</h6>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-3 border h-100 bg-white" style="box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);">
                    <div style="font-size: 40px; font-weight: 800; color: rgba(2, 132, 199, 0.2); line-height: 1;">03</div>
                    <i class="bi bi-key fs-3 my-2 d-block" style="color: var(--recar-primary);"></i>
                    <h6 class="fw-bold mb-0" style="color: var(--recar-navy); font-size: 16px;">Nhận xe, kiểm tra giấy tờ và ký hợp đồng</h6>
                </div>
            </div>
        </div>
    </section>

    <!-- Cẩm nang và tin tức (Theo template chuẩn) -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fs-4 fw-bold m-0" style="color: var(--recar-navy);">Cẩm nang và tin tức</h2>
            <a href="/Blog" class="text-decoration-none fw-semibold small" style="color: var(--recar-primary);">
                Xem tất cả bài viết →
            </a>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <article class="h-100 rounded-3 border bg-white overflow-hidden" style="box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04); display: flex; flex-direction: column;">
                    <img src="/images/cars/car-sedan.jpg" alt="Kinh nghiệm thuê xe" style="aspect-ratio: 16/9; width: 100%; object-fit: cover;" />
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <p class="small text-muted mb-2">Cẩm nang · 08/10/2026</p>
                        <h5 class="fw-bold mb-2" style="color: var(--recar-navy); font-size: 16px;">Kinh nghiệm thuê xe tự lái lần đầu</h5>
                        <p class="small text-muted mb-3 flex-grow-1">Những điều cần kiểm tra trước khi nhận xe để chuyến đi suôn sẻ và an toàn.</p>
                        <a href="/Blog" class="text-decoration-none fw-semibold small" style="color: var(--recar-primary);">Đọc thêm →</a>
                    </div>
                </article>
            </div>
            <div class="col-md-4">
                <article class="h-100 rounded-3 border bg-white overflow-hidden" style="box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04); display: flex; flex-direction: column;">
                    <img src="/images/cars/car-suv.jpg" alt="Giấy tờ cần chuẩn bị" style="aspect-ratio: 16/9; width: 100%; object-fit: cover;" />
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <p class="small text-muted mb-2">Cẩm nang · 02/10/2026</p>
                        <h5 class="fw-bold mb-2" style="color: var(--recar-navy); font-size: 16px;">Giấy tờ cần chuẩn bị khi thuê ô tô</h5>
                        <p class="small text-muted mb-3 flex-grow-1">CCCD, giấy phép lái xe và các giấy tờ đối chiếu khi ký hợp đồng thuê xe.</p>
                        <a href="/Blog" class="text-decoration-none fw-semibold small" style="color: var(--recar-primary);">Đọc thêm →</a>
                    </div>
                </article>
            </div>
            <div class="col-md-4">
                <article class="h-100 rounded-3 border bg-white overflow-hidden" style="box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04); display: flex; flex-direction: column;">
                    <img src="/images/cars/hero.jpg" alt="Cung đường Đà Lạt" style="aspect-ratio: 16/9; width: 100%; object-fit: cover;" />
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <p class="small text-muted mb-2">Tin tức · 25/09/2026</p>
                        <h5 class="fw-bold mb-2" style="color: var(--recar-navy); font-size: 16px;">5 cung đường đẹp quanh Đà Lạt</h5>
                        <p class="small text-muted mb-3 flex-grow-1">Gợi ý lộ trình cuối tuần tuyệt vời cho những ai yêu thích lái xe đường đèo.</p>
                        <a href="/News" class="text-decoration-none fw-semibold small" style="color: var(--recar-primary);">Đọc thêm →</a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Kết thúc danh sách Cẩm nang & tin tức -->
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Chuyển đổi tab Tự lái / Có tài xế
            $('#btnSelfDrive').on('click', function () {
                $('.search-mode-tab').removeClass('active');
                $(this).addClass('active');
                $('#driveModeInput').val('Tự lái');
            });

            $('#btnWithDriver').on('click', function () {
                $('.search-mode-tab').removeClass('active');
                $(this).addClass('active');
                $('#driveModeInput').val('Có tài xế');
            });
        });
    </script>
}
