@{
    ViewData["Title"] = "Cẩm nang";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Banner -->
<div class="page-title-banner" style="background-color: #f8fafc; border-bottom: 1px solid var(--recar-border); padding: 36px 0;">
    <div class="container" style="max-width: 1280px;">
        <h1 class="fs-2 fw-bold m-0" style="color: var(--recar-navy);">Cẩm nang</h1>
        <p class="text-muted small m-0 mt-2" style="font-size: 15px;">
            Kinh nghiệm thuê xe, lái xe an toàn và gợi ý hành trình du lịch từ ReCar.
        </p>
    </div>
</div>

<!-- Lưới danh sách bài viết -->
<div class="container py-5" style="max-width: 1280px;">
    <div class="row g-4">
        @await Component.InvokeAsync("Blog")
    </div>
</div>