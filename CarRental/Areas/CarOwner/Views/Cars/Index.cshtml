@model IList<CarRental.Models.Car>
@using CarRental.Utilities
@{
    ViewData["Title"] = "Quản lý xe";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";
}

<div class="space-y-4">
    <!-- Panel Quản lý xe của tôi (Pixel-Perfect Template) -->
    <div class="recar-panel">
        <div class="recar-panel-header flex-wrap gap-2">
            <div>
                <h2 class="recar-panel-title">Danh sách xe của tôi</h2>
                <div class="text-muted small mt-1">Quản lý phương tiện, tình trạng sẵn sàng đón khách và giá niêm yết theo ngày.</div>
            </div>
            <a href="/CarOwner/Cars/Create" class="btn-recar-primary">
                <i class="bi bi-plus-lg"></i> Thêm xe mới
            </a>
        </div>

        <div class="table-responsive">
            <table class="recar-table">
                <thead>
                    <tr>
                        <th>Phương tiện</th>
                        <th>Biển số xe</th>
                        <th>Khu vực nhận xe</th>
                        <th>Thông số</th>
                        <th>Giá thuê / ngày</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var car in Model)
                        {
                            string statusClass = "status-ready";
                            string statusText = "Sẵn sàng";
                            if (car.CarStatus == "Đang bận")
                            {
                                statusClass = "status-busy";
                                statusText = "Đang có khách";
                            }
                            else if (car.CarStatus == "Bảo trì")
                            {
                                statusClass = "status-maintenance";
                                statusText = "Đang bảo trì";
                            }

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(car.Image) ? "/images/cars/car-sedan.jpg" : car.Image)" 
                                             alt="@car.CarName" 
                                             class="rounded-3 border shadow-sm" 
                                             style="width: 64px; height: 46px; object-fit: cover;" />
                                        <div>
                                            <div class="fw-bold text-dark fs-6">@car.CarName</div>
                                            <div class="text-muted small">@car.CarBrand · @(car.Type?.CarTypeName ?? "Ô tô")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2.5 py-1.5 font-monospace fw-bold" style="font-size: 0.8rem;">
                                        @(string.IsNullOrEmpty(car.LicensePlate) ? "Chưa cấp" : car.LicensePlate)
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1 text-dark small">
                                        <i class="bi bi-geo-alt-fill text-danger"></i>
                                        <span>@(string.IsNullOrEmpty(car.Location) ? "Toàn quốc" : car.Location)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-muted">
                                        <span><i class="bi bi-people-fill text-secondary me-1"></i>@car.Seat chỗ</span> · 
                                        <span>@car.Transmission</span>
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-fuel-pump-fill text-secondary me-1"></i>@car.Fuel
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-primary fs-6">
                                        @((car.Price ?? 0).ToString("N0"))đ
                                    </div>
                                    @if (car.IsSale && car.SalePrice.HasValue && car.SalePrice > 0 && car.SalePrice < car.Price)
                                    {
                                        <div class="text-danger small" style="font-size: 0.75rem;">
                                            Ưu đãi: @car.SalePrice.Value.ToString("N0")đ
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="recar-status-badge @statusClass">
                                        @statusText
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="/CarOwner/Cars/Edit/@car.CarId" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-semibold" title="Chỉnh sửa xe">
                                            <i class="bi bi-pencil-square me-1"></i>Sửa
                                        </a>
                                        <a href="/product/@(car.Alias)-@(car.CarId).html" target="_blank" class="btn btn-light btn-sm rounded-pill px-2.5 py-1 text-muted border" title="Xem trên sàn ReCar">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                        <a href="/CarOwner/Cars/Delete/@car.CarId" class="btn btn-outline-danger btn-sm rounded-pill px-2.5 py-1" onclick="return confirm('Bạn có chắc muốn tạm dừng hoạt động chiếc xe này?');" title="Xóa / Dừng">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="mb-3">
                                    <i class="bi bi-car-front fs-1 text-secondary opacity-50"></i>
                                </div>
                                <h5>Chưa có xe nào trong danh sách</h5>
                                <p class="small text-muted">Đăng ký chiếc xe đầu tiên của bạn để tiếp cận hàng nghìn khách hàng thuê xe trên ReCar.</p>
                                <a href="/CarOwner/Cars/Create" class="btn-recar-primary mt-2">
                                    <i class="bi bi-plus-lg"></i> Thêm xe ngay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
