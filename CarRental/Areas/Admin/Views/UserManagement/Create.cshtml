@model CarRental.Models.Customer
@{
    ViewData["Title"] = "Thêm tài khoản mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-0" style="max-width: 1050px;">
    <!-- Header chuẩn Admin ReCar -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle p-2 text-muted me-1 shadow-xs" title="Quay lại danh sách">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 fw-bold mb-0 text-dark tracking-tight">Thêm tài khoản người dùng mới</h1>
            </div>
            <p class="text-muted small mb-0 mt-1 ms-5">Khởi tạo tài khoản Quản trị viên, Đối tác Chủ xe hoặc Khách hàng trên hệ thống ReCar.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3.5 py-1.5 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

        <div class="row g-4">
            <!-- Cột trái: Thông tin cá nhân & Liên hệ -->
            <div class="col-lg-7">
                <div class="recar-panel p-4 mb-4 shadow-sm border rounded-4 bg-white">
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-person-plus-fill text-primary me-2"></i> Thông tin định danh & Liên hệ
                        </h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">
                            Tạo mới
                        </span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small text-dark">
                                Họ và tên <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" asp-for="FullName" class="form-control border-start-0 rounded-end-3" placeholder="Ví dụ: Nguyễn Văn A" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-dark">
                                Email đăng nhập <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" asp-for="Email" class="form-control border-start-0 rounded-end-3" placeholder="Ví dụ: nguyenvana@gmail.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold small text-dark">Số điện thoại</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                    <i class="bi bi-telephone"></i>
                                </span>
                                <input type="tel" asp-for="PhoneNumber" class="form-control border-start-0 rounded-end-3" placeholder="Ví dụ: 0912345678" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Idcard" class="form-label fw-semibold small text-dark">Số CCCD / CMND</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                    <i class="bi bi-person-vcard"></i>
                                </span>
                                <input type="text" asp-for="Idcard" class="form-control border-start-0 rounded-end-3 font-mono-plate" placeholder="12 số CCCD" />
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold small text-dark">Địa chỉ liên hệ</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <input type="text" asp-for="Address" class="form-control border-start-0 rounded-end-3" placeholder="Ví dụ: Cầu Giấy, Hà Nội" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Phân quyền, Mật khẩu & Lưu -->
            <div class="col-lg-5">
                <div class="recar-panel p-4 mb-4 shadow-sm border rounded-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                        <i class="bi bi-shield-lock-fill text-primary me-2"></i> Phân quyền & Mật khẩu
                    </h5>

                    <div class="mb-3">
                        <label asp-for="RoleId" class="form-label fw-semibold small text-dark">
                            Vai trò hệ thống <span class="text-danger">*</span>
                        </label>
                        <select asp-for="RoleId" class="form-select rounded-3" asp-items="ViewBag.RoleId"></select>
                        <div class="form-text small text-muted mt-1">
                            Lựa chọn phân quyền phù hợp cho tài khoản mới.
                        </div>
                    </div>

                    <div class="mb-1">
                        <label class="form-label fw-semibold small text-dark">
                            Mật khẩu khởi tạo <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-secondary border-end-0 rounded-start-3">
                                <i class="bi bi-key"></i>
                            </span>
                            <input type="password" name="rawPassword" id="createUserPwd" class="form-control border-start-0 border-end-0" placeholder="••••••••" required />
                            <button type="button" class="btn btn-light border border-start-0 rounded-end-3 text-muted" onclick="togglePwd('createUserPwd', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text small text-muted">Mật khẩu tối thiểu 3 ký tự (được mã hóa bảo mật MD5).</div>
                    </div>
                </div>

                <div class="recar-panel p-4 shadow-sm border rounded-4 bg-white">
                    <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-pill fw-bold shadow-sm mb-2" style="background-color: var(--recar-primary); border: none;">
                        <i class="bi bi-person-check-fill me-1"></i> Tạo tài khoản mới
                    </button>
                    <a asp-action="Index" class="btn btn-light w-100 py-2 rounded-pill fw-semibold border text-secondary">
                        Hủy bỏ & Quay lại
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function togglePwd(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }
</script>
