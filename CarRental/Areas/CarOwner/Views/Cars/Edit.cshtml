@model CarRental.Models.Car
@using CarRental.Utilities
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = $"Chỉnh sửa xe: {Model.CarName}";
    Layout = "~/Areas/CarOwner/Views/Shared/_Layout.cshtml";
    var carTypes = ViewBag.CarTypes as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <!-- Panel Chỉnh sửa xe (Pixel-Perfect Template) -->
        <div class="recar-panel">
            <div class="recar-panel-header">
                <div>
                    <h2 class="recar-panel-title">Chỉnh sửa thông tin phương tiện</h2>
                    <div class="text-muted small mt-1">Cập nhật giá thuê, trạng thái sẵn sàng đón khách và các tiện nghi của xe.</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="/product/@(Model.Alias)-@(Model.CarId).html" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Xem trên sàn
                    </a>
                    <a href="/CarOwner/Cars/Index" class="btn btn-light btn-sm rounded-pill px-3 border text-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>

            <div class="p-4 p-md-5">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CarId" />
                    <input type="hidden" asp-for="OwnerId" />
                    <input type="hidden" asp-for="Alias" />

                    <div class="row g-4">
                        <!-- Tên xe -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Tên phương tiện <span class="text-danger">*</span></label>
                            <input asp-for="CarName" class="recar-input" required />
                            <span asp-validation-for="CarName" class="text-danger small"></span>
                        </div>

                        <!-- Trạng thái xe -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Trạng thái xe hiện tại <span class="text-danger">*</span></label>
                            <select asp-for="CarStatus" class="recar-input fw-semibold" required>
                                <option value="Sẵn sàng" selected="@(Model.CarStatus == "Sẵn sàng")">🟢 Sẵn sàng (Bình thường)</option>
                                <option value="Đang bận" selected="@(Model.CarStatus == "Đang bận")">🟡 Đang bận (Đang có khách thuê)</option>
                                <option value="Bảo trì" selected="@(Model.CarStatus == "Bảo trì")">🔴 Bảo trì (Bảo dưỡng định kỳ)</option>
                            </select>
                            <span asp-validation-for="CarStatus" class="text-danger small"></span>
                        </div>

                        <!-- Hãng xe -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Hãng sản xuất <span class="text-danger">*</span></label>
                            <select asp-for="CarBrand" class="recar-input" required>
                                <option value="VinFast">VinFast</option>
                                <option value="Toyota">Toyota</option>
                                <option value="Hyundai">Hyundai</option>
                                <option value="Mazda">Mazda</option>
                                <option value="Kia">Kia</option>
                                <option value="Ford">Ford</option>
                                <option value="Honda">Honda</option>
                                <option value="Mitsubishi">Mitsubishi</option>
                            </select>
                        </div>

                        <!-- Phân khúc -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Phân khúc xe <span class="text-danger">*</span></label>
                            <select asp-for="TypeId" class="recar-input" asp-items="carTypes" required>
                            </select>
                        </div>

                        <!-- Biển số xe -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Biển số xe kiểm định <span class="text-danger">*</span></label>
                            <input asp-for="LicensePlate" class="recar-input font-monospace text-uppercase fw-bold" required />
                        </div>

                        <!-- Giá thuê ngày -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold text-dark small">Giá thuê niêm yết (VNĐ/ngày) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Price" type="number" min="300000" step="50000" class="recar-input rounded-start fw-bold text-primary" required />
                                <span class="input-group-text bg-light text-muted small border-start-0" style="border-radius: 0 10px 10px 0;">đ/ngày</span>
                            </div>
                        </div>

                        <!-- Số chỗ ngồi -->
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-bold text-dark small">Số chỗ ngồi <span class="text-danger">*</span></label>
                            <select asp-for="Seat" class="recar-input" required>
                                <option value="4">4 chỗ</option>
                                <option value="5">5 chỗ</option>
                                <option value="7">7 chỗ</option>
                                <option value="8">8 chỗ</option>
                            </select>
                        </div>

                        <!-- Hộp số -->
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-bold text-dark small">Hộp số <span class="text-danger">*</span></label>
                            <select asp-for="Transmission" class="recar-input" required>
                                <option value="Tự động">Tự động</option>
                                <option value="Số sàn">Số sàn</option>
                            </select>
                        </div>

                        <!-- Nhiên liệu -->
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-bold text-dark small">Nhiên liệu <span class="text-danger">*</span></label>
                            <select asp-for="Fuel" class="recar-input" required>
                                <option value="Xăng">Xăng</option>
                                <option value="Dầu">Dầu (Diesel)</option>
                                <option value="Điện">Điện (EV)</option>
                            </select>
                        </div>

                        <!-- Địa điểm nhận xe -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark small">Địa điểm bàn giao xe <span class="text-danger">*</span></label>
                            <input asp-for="Location" class="recar-input" required />
                        </div>

                        <!-- Hình ảnh -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark small">Hình ảnh đại diện của xe (URL) <span class="text-danger">*</span></label>
                            <input asp-for="Image" class="recar-input" required />
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <div class="mt-2">
                                    <img src="@Model.Image" alt="@Model.CarName" class="rounded-3 border shadow-sm" style="max-height: 120px; object-fit: cover;" />
                                </div>
                            }
                        </div>

                        <!-- Mô tả chi tiết -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark small">Mô tả tiện nghi xe</label>
                            <textarea asp-for="Details" rows="4" class="recar-input"></textarea>
                        </div>

                        <!-- Nút lưu -->
                        <div class="col-12 pt-3 border-top">
                            <button type="submit" class="btn-recar-primary px-5 py-2.5 shadow-sm">
                                <i class="bi bi-floppy-fill me-1"></i> Lưu thay đổi
                            </button>
                            <a href="/CarOwner/Cars/Index" class="btn btn-light rounded-pill px-4 py-2.5 border ms-2 text-secondary fw-semibold">
                                Hủy bỏ
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
