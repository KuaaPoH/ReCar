@model CarRental.Models.Menu
@{
    ViewData["Title"] = "Thêm Menu mới";
    var parentCandidates = ViewBag.ParentCandidates as List<CarRental.Models.Menu> ?? new List<CarRental.Models.Menu>();
    var availableIcons = ViewBag.AvailableIcons as List<(string Icon, string Name)> ?? new List<(string Icon, string Name)>();
    string targetSub = ViewBag.TargetSubsystem as string ?? "Customer";
    int selectedParentId = ViewBag.SelectedParentId ?? 0;
}

<div class="container-fluid px-0" style="max-width: 900px;">
    <!-- Breadcrumb & Header -->
    <div class="mb-4">
        <a asp-action="Index" asp-route-tab="@targetSub" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách Menu
        </a>
        <h1 class="h3 fw-bold mb-1 text-dark tracking-tight">Thêm Menu mới</h1>
        <p class="text-muted small mb-0">Tạo mục điều hướng mới cho phân hệ <strong>@(targetSub == "Customer" ? "Khách hàng" : (targetSub == "CarOwner" ? "Chủ xe" : "Quản trị viên"))</strong>.</p>
    </div>

    <form asp-action="Create" method="post" id="menuForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 px-3 small mb-3"></div>

        <div class="recar-panel mb-4">
            <div class="recar-panel-header py-3 px-4 bg-light border-bottom">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-info-circle text-primary me-2"></i> Thiết lập cấu trúc Menu
                </h6>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <!-- 1. Phân hệ -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-dark">Phân hệ điều hướng <span class="text-danger">*</span></label>
                        <select asp-for="Subsystem" class="form-select rounded-3" id="selectSubsystem">
                            <option value="Customer" selected="@(targetSub == "Customer")">1. Khách hàng (Sàn thuê xe)</option>
                            <option value="CarOwner" selected="@(targetSub == "CarOwner")">2. Chủ xe (Cổng Host Pro)</option>
                            <option value="Admin" selected="@(targetSub == "Admin")">3. Quản trị viên (Hệ thống Admin)</option>
                        </select>
                        <div class="text-muted" style="font-size: 0.72rem; margin-top: 4px;">Xác định menu này hiển thị ở giao diện người dùng nào.</div>
                    </div>

                    <!-- 2. Menu Cha (Parent) -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-dark">Menu Cha (Cấp bậc) <span class="text-danger">*</span></label>
                        <select asp-for="ParentId" class="form-select rounded-3" id="selectParentId">
                            <option value="0" selected="@(selectedParentId == 0)">-- Là Menu gốc chính / Tiêu đề nhóm (Cấp 1) --</option>
                            @foreach (var parent in parentCandidates)
                            {
                                bool isGroup = parent.Url == "#" || string.IsNullOrWhiteSpace(parent.Url);
                                <option value="@parent.MenuId" selected="@(selectedParentId == parent.MenuId)">
                                    @(isGroup ? "📁 [Nhóm] " : "↳ Thuộc cha: ")@parent.Title
                                </option>
                            }
                        </select>
                        <div class="text-muted" style="font-size: 0.72rem; margin-top: 4px;">Chọn menu cha nếu đây là menu con (dropdown), hoặc để cấp 1 nếu là menu chính.</div>
                    </div>

                    <!-- 3. Tiêu đề Menu -->
                    <div class="col-md-7">
                        <label class="form-label fw-bold small text-dark">Tiêu đề hiển thị <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="VD: Quản lý đội xe, Thuê xe tự lái..." required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- 4. Thứ tự sắp xếp -->
                    <div class="col-md-5">
                        <label class="form-label fw-bold small text-dark">Thứ tự hiển thị (Position)</label>
                        <input asp-for="Position" type="number" class="form-control rounded-3" min="1" max="99" value="1" />
                    </div>

                    <!-- 5. Đường dẫn URL -->
                    <div class="col-12">
                        <label class="form-label fw-bold small text-dark">Đường dẫn liên kết (URL / Route) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light rounded-start-3 text-muted"><i class="bi bi-link"></i></span>
                            <input asp-for="Url" class="form-control rounded-end-3 font-monospace" placeholder="VD: /Product, /CarOwner/Cars/Index, /Admin/Orders..." />
                        </div>
                        <div class="text-muted" style="font-size: 0.72rem; margin-top: 4px;">Đường dẫn URL nội bộ hoặc liên kết web khi người dùng click vào menu.</div>
                    </div>

                    <!-- 6. Chọn & Xem trước Icon -->
                    <div class="col-12">
                        <label class="form-label fw-bold small text-dark">Biểu tượng Icon (Bootstrap Icons)</label>
                        <div class="row g-2 align-items-center">
                            <div class="col-auto">
                                <!-- Live Icon Preview -->
                                <div id="iconPreviewBox" style="width: 46px; height: 46px; border-radius: 12px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 22px; border: 1px solid #bae6fd;">
                                    <i class="bi bi-link-45deg" id="iconPreviewEl"></i>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <select class="form-select rounded-3" id="iconPresetSelect" onchange="applyPresetIcon(this.value)">
                                    <option value="">-- Chọn icon phổ biến gợi ý --</option>
                                    @foreach (var ic in availableIcons)
                                    {
                                        <option value="@ic.Icon">@ic.Icon (@ic.Name)</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <input asp-for="Icon" id="txtIconClass" class="form-control rounded-3 font-monospace" value="bi-link-45deg" placeholder="Hoặc gõ mã icon (VD: bi-speedometer2)" oninput="updateIconPreview(this.value)" />
                            </div>
                        </div>
                    </div>

                    <!-- 7. Mô tả ngắn -->
                    <div class="col-12">
                        <label class="form-label fw-bold small text-dark">Mô tả / Ghi chú mục đích menu</label>
                        <input asp-for="Description" class="form-control rounded-3" placeholder="Ghi chú tóm tắt vai trò của menu này..." />
                    </div>

                    <!-- 8. Trạng thái -->
                    <div class="col-12 pt-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="switchActive" name="IsActive" value="true" checked />
                            <label class="form-check-label fw-semibold text-dark small" for="switchActive">
                                Kích hoạt hiển thị menu này ngay lập tức
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="recar-panel-footer p-3 bg-light border-top d-flex justify-content-end gap-2">
                <a asp-action="Index" asp-route-tab="@targetSub" class="btn btn-light rounded-pill px-4 small border">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4 small fw-semibold shadow-sm" style="background-color: var(--recar-primary); border: none;">
                    <i class="bi bi-floppy me-1"></i> Lưu Menu
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function updateIconPreview(val) {
        val = val.trim();
        if (!val) val = 'bi-link-45deg';
        $('#iconPreviewEl').attr('class', 'bi ' + val);
    }

    function applyPresetIcon(val) {
        if (val) {
            $('#txtIconClass').val(val);
            updateIconPreview(val);
        }
    }

    // Khi đổi phân hệ, tải lại danh sách menu cha tương ứng
    $('#selectSubsystem').on('change', function () {
        const sub = $(this).val();
        window.location.href = `/Admin/Menus/Create?subsystem=${sub}`;
    });
</script>
}
